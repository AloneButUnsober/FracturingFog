<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Class library form for now. Once Phase 2.3 swaps Program.cs to launch
      the Avalonia shell as the primary UI, switch OutputType to WinExe.
      Keeping it a library lets the existing FracturingFogCLD.csproj reference
      this project and start the Avalonia window behind an avalonia CLI flag
      without dragging in a second entry point.
    -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Platforms>x64;AnyCPU</Platforms>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <RootNamespace>FracturingFog.UI.Avalonia</RootNamespace>
    <AssemblyName>FracturingFog.UI.Avalonia</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Avalonia 11.2 is the current LTS line as of 2026-05.
      Avalonia.Desktop pulls in Win32 / X11 / macOS backends so this single
      assembly runs on all three desktops with no per-platform RID switching.
      Themes.Fluent matches the existing dark aesthetic of the WinForms UI.
    -->
    <!--
      PrivateAssets=analyzers prevents the Avalonia XAML source generators
      from flowing transitively into the WinExe project (which references
      this assembly but has no XAML of its own and is missing the Avalonia
      base types the generator emits against). Without this, the WinExe
      build fails with CS1929 inside generated MainWindow.g.cs files placed
      in the WinExe's obj/ tree.
    -->
    <PackageReference Include="Avalonia" Version="12.0.4">
      <PrivateAssets>analyzers</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Avalonia.Desktop" Version="12.0.4">
      <PrivateAssets>analyzers</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.4">
      <PrivateAssets>analyzers</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.4">
      <PrivateAssets>analyzers</PrivateAssets>
    </PackageReference>
    <!-- Color wheel control for ColorThemeEditor swatches (UI-gap #19). -->
    <PackageReference Include="Avalonia.Controls.ColorPicker" Version="12.0.4">
      <PrivateAssets>analyzers</PrivateAssets>
    </PackageReference>
    <PackageReference Include="ReactiveUI.Avalonia" Version="12.0.3" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Reference the shared abstractions library only. Avalonia shell does NOT
      depend on the WinForms WinExe — that direction is owned by the WinExe
      so it can launch the Avalonia shell via the avalonia flag. Phase 2.1 will
      grow this list (Core project with calculators/models) but for the
      bootstrap step IGpuSurface is the only shared contract needed.
    -->
    <ProjectReference Include="..\Abstractions\FracturingFog.Abstractions.csproj" />
    <!--
      Phase 3 — FFClient dialog + ServerAdmin dialog consume the mTLS
      JSON-RPC client + the AES-GCM credential vault. ServerAdmin also
      polls the server.status RPC and surfaces the same protocol DTOs.
    -->
    <ProjectReference Include="..\Server\FracturingFog.Server.csproj" />
    <ProjectReference Include="..\Client\FracturingFog.Client.csproj" />
    <!--
      CalculatorGen.Lib — the UserEquation dialog's "Generate via CalcGen"
      button calls CalculatorGenApi.Generate() to render a calculator
      from the user's equation source. Ref points at the Lib (not the
      Exe) so a self-contained publish of FracturingFog.App doesn't
      trip NETSDK1150.
    -->
    <ProjectReference Include="..\CalculatorGen.Lib\CalculatorGen.Lib.csproj" />
    <!--
      ColorGen.Lib — ColorGenEditor view-model calls
      ColorGenApi.Generate() to render a colour theme from the user's DSL.
    -->
    <ProjectReference Include="..\ColorGen.Lib\ColorGen.Lib.csproj" />
  </ItemGroup>

<ItemGroup>
  <AvaloniaResource Include="Assets\**" />
  <!--
    In-app Help viewer loads project markdown docs via the avares: URI scheme.
    Sibling `Docs\` folder is embedded as Avalonia resources so the viewer
    works from any deploy layout (no filesystem snooping into ../../../Docs).
    Resource name preserves "Docs/" so HelpDocId can address each guide by
    a stable path (e.g. avares://.../Docs/CalcGen-UserGuide.md).
  -->
  <!--
    `**\*.md` walks subdirs (Docs\User\, Docs\Technical\, …). RecursiveDir
    expands to the matched subpath so the embedded resource keeps its
    folder layout — HelpViewerViewModel addresses docs as e.g.
      avares://FracturingFog.UI.Avalonia/Docs/User/CalcGen-UserGuide.md
  -->
  <AvaloniaResource Include="..\Docs\**\*.md" Link="Docs\%(RecursiveDir)%(Filename)%(Extension)" />
  <!-- Inline images referenced from the docs via standard ![](path) markdown. -->
  <AvaloniaResource Include="..\Docs\Images\**\*.png" Link="Docs\Images\%(RecursiveDir)%(Filename)%(Extension)" />
  <AvaloniaResource Include="..\Docs\Images\**\*.svg" Link="Docs\Images\%(RecursiveDir)%(Filename)%(Extension)" />
  <AvaloniaResource Include="..\Docs\Images\**\*.jpg" Link="Docs\Images\%(RecursiveDir)%(Filename)%(Extension)" />
</ItemGroup>

</Project>

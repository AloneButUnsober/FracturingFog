<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FracturingFog.UI.Avalonia.ViewModels"
        x:Class="FracturingFog.UI.Avalonia.Views.FractalParamsView"
        x:DataType="vm:FractalParamsViewModel"
        Title="{Binding Title}"
        Width="400"
        SizeToContent="Height"
        MinWidth="320"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#282828"
        Foreground="White">

    <!--
      DIP-only layout. Each fractal type owns one StackPanel section bound to
      an IsXxx visibility flag on the VM. The empty-state TextBlock shows for
      fractals with no tunable parameters.
    -->
    <Grid Margin="14" RowDefinitions="*,Auto">

        <StackPanel Grid.Row="0" Spacing="6">

            <!-- Julia -->
            <StackPanel IsVisible="{Binding IsJulia}" Spacing="6">
                <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,Auto">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Julia c (real):" VerticalAlignment="Center" />
                    <NumericUpDown Grid.Row="0" Grid.Column="1"
                                   Minimum="-2" Maximum="2" Increment="0.0001" FormatString="F5"
                                   Value="{Binding JuliaR, Mode=TwoWay}" Margin="0,2" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Julia c (imag):" VerticalAlignment="Center" />
                    <NumericUpDown Grid.Row="1" Grid.Column="1"
                                   Minimum="-2" Maximum="2" Increment="0.0001" FormatString="F5"
                                   Value="{Binding JuliaI, Mode=TwoWay}" Margin="0,2" />
                </Grid>

                <!-- Animation: orbit c around the origin at user-chosen speed/direction. -->
                <Border BorderBrush="#404040" BorderThickness="0,1,0,0" Padding="0,6,0,0" Margin="0,4,0,0">
                    <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,Auto,Auto">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Animate direction:" VerticalAlignment="Center" />
                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="12">
                            <RadioButton GroupName="JuliaAnimDir"
                                         Content="Forward"
                                         IsChecked="{Binding JuliaAnimateForward, Mode=TwoWay}" />
                            <RadioButton GroupName="JuliaAnimDir"
                                         Content="Reverse"
                                         IsChecked="{Binding JuliaAnimateReverse, Mode=TwoWay}" />
                        </StackPanel>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Speed (rad/s):" VerticalAlignment="Center" />
                        <NumericUpDown Grid.Row="1" Grid.Column="1"
                                       Minimum="0.001" Maximum="6.283" Increment="0.05" FormatString="F3"
                                       Value="{Binding JuliaAnimateSpeed, Mode=TwoWay}" Margin="0,2" />

                        <Button Grid.Row="2" Grid.Column="1"
                                Content="{Binding JuliaAnimateButtonText}"
                                Command="{Binding ToggleJuliaAnimateCommand}"
                                HorizontalAlignment="Stretch"
                                Margin="0,4,0,0" />
                    </Grid>
                </Border>
            </StackPanel>

            <!-- Multibrot -->
            <Grid IsVisible="{Binding IsMultibrot}" ColumnDefinitions="160,*">
                <TextBlock Grid.Column="0" Text="Exponent d:" VerticalAlignment="Center" />
                <NumericUpDown Grid.Column="1"
                               Minimum="2" Maximum="8" Increment="1" FormatString="F0"
                               Value="{Binding MultibrotExponent, Mode=TwoWay}" Margin="0,2" />
            </Grid>

            <!-- Phoenix -->
            <Grid IsVisible="{Binding IsPhoenix}"
                  ColumnDefinitions="160,*" RowDefinitions="Auto,Auto">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="p (real):" VerticalAlignment="Center" />
                <NumericUpDown Grid.Row="0" Grid.Column="1"
                               Minimum="-2" Maximum="2" Increment="0.0001" FormatString="F5"
                               Value="{Binding PhoenixR, Mode=TwoWay}" Margin="0,2" />
                <TextBlock Grid.Row="1" Grid.Column="0" Text="p (imag):" VerticalAlignment="Center" />
                <NumericUpDown Grid.Row="1" Grid.Column="1"
                               Minimum="-2" Maximum="2" Increment="0.0001" FormatString="F5"
                               Value="{Binding PhoenixI, Mode=TwoWay}" Margin="0,2" />
            </Grid>

            <!-- Glynn -->
            <Grid IsVisible="{Binding IsGlynn}"
                  ColumnDefinitions="160,*" RowDefinitions="Auto,Auto">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Glynn c (real):" VerticalAlignment="Center" />
                <NumericUpDown Grid.Row="0" Grid.Column="1"
                               Minimum="-2" Maximum="2" Increment="0.001" FormatString="F4"
                               Value="{Binding GlynnR, Mode=TwoWay}" Margin="0,2" />
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Glynn c (imag):" VerticalAlignment="Center" />
                <NumericUpDown Grid.Row="1" Grid.Column="1"
                               Minimum="-2" Maximum="2" Increment="0.001" FormatString="F4"
                               Value="{Binding GlynnI, Mode=TwoWay}" Margin="0,2" />
            </Grid>

            <!-- Spider -->
            <Grid IsVisible="{Binding IsSpider}"
                  ColumnDefinitions="160,*">
                <TextBlock Grid.Column="0" Text="c decay:" VerticalAlignment="Center"
                           ToolTip.Tip="c := decay·c + z each step. 0.5 canonical, 1.0 = Mandelbrot, 0 = c collapses onto z." />
                <NumericUpDown Grid.Column="1"
                               Minimum="0" Maximum="1" Increment="0.01" FormatString="F4"
                               Value="{Binding SpiderCDecay, Mode=TwoWay}" Margin="0,2" />
            </Grid>

            <!-- Logistic -->
            <Grid IsVisible="{Binding IsLogistic}"
                  ColumnDefinitions="160,*" RowDefinitions="Auto,Auto">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Burn-in iters:" VerticalAlignment="Center"
                           ToolTip.Tip="Iterations discarded before density accumulation. Plot = MaxIter − BurnIn." />
                <NumericUpDown Grid.Row="0" Grid.Column="1"
                               Minimum="0" Maximum="100000" Increment="100" FormatString="F0"
                               Value="{Binding LogisticBurnIn, Mode=TwoWay}" Margin="0,2" />
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Seed x₀:" VerticalAlignment="Center"
                           ToolTip.Tip="Initial value for the logistic map iteration. Any non-fixed-point seed in (0,1) converges to the same attractor." />
                <NumericUpDown Grid.Row="1" Grid.Column="1"
                               Minimum="0.001" Maximum="0.999" Increment="0.01" FormatString="F4"
                               Value="{Binding LogisticSeed, Mode=TwoWay}" Margin="0,2" />
            </Grid>

            <!-- Newton / Nova / Halley / Secant — shared d + R -->
            <Grid IsVisible="{Binding IsNewtonOrNova}"
                  ColumnDefinitions="160,*" RowDefinitions="Auto,Auto">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Exponent d:" VerticalAlignment="Center" />
                <NumericUpDown Grid.Row="0" Grid.Column="1"
                               Minimum="2" Maximum="8" Increment="1" FormatString="F0"
                               Value="{Binding NewtonExponent, Mode=TwoWay}" Margin="0,2" />
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Relaxation R:" VerticalAlignment="Center" />
                <NumericUpDown Grid.Row="1" Grid.Column="1"
                               Minimum="0.1" Maximum="2" Increment="0.05" FormatString="F3"
                               Value="{Binding NewtonRelaxation, Mode=TwoWay}" Margin="0,2" />
            </Grid>

            <!-- Secant initial-offset add-on -->
            <Grid IsVisible="{Binding IsSecant}"
                  ColumnDefinitions="160,*" RowDefinitions="Auto,Auto">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Prev offset (real):" VerticalAlignment="Center"
                           ToolTip.Tip="Initial prev-z displacement. Recurrence is undefined if prev = z." />
                <NumericUpDown Grid.Row="0" Grid.Column="1"
                               Minimum="-2" Maximum="2" Increment="0.01" FormatString="F4"
                               Value="{Binding SecantOffsetR, Mode=TwoWay}" Margin="0,2" />
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Prev offset (imag):" VerticalAlignment="Center" />
                <NumericUpDown Grid.Row="1" Grid.Column="1"
                               Minimum="-2" Maximum="2" Increment="0.01" FormatString="F4"
                               Value="{Binding SecantOffsetI, Mode=TwoWay}" Margin="0,2" />
            </Grid>

            <!-- IFS -->
            <Grid IsVisible="{Binding IsIFS}"
                  ColumnDefinitions="160,*" RowDefinitions="Auto,Auto">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Preset:" VerticalAlignment="Center" />
                <ComboBox Grid.Row="0" Grid.Column="1"
                          ItemsSource="{Binding IfsPresets}"
                          SelectedItem="{Binding IfsPresetName, Mode=TwoWay}"
                          HorizontalAlignment="Stretch" Margin="0,2" />
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Iterations:" VerticalAlignment="Center" />
                <NumericUpDown Grid.Row="1" Grid.Column="1"
                               Minimum="100000" Maximum="20000000" Increment="100000" FormatString="N0"
                               Value="{Binding IfsIterations, Mode=TwoWay}" Margin="0,2" />
            </Grid>

            <!-- LSystem -->
            <StackPanel IsVisible="{Binding IsLSystem}" Spacing="6">
                <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,Auto">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Preset:" VerticalAlignment="Center" />
                    <ComboBox Grid.Row="0" Grid.Column="1"
                              ItemsSource="{Binding LSystemPresets}"
                              SelectedItem="{Binding LSystemPresetName, Mode=TwoWay}"
                              HorizontalAlignment="Stretch" Margin="0,2" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Depth:" VerticalAlignment="Center" />
                    <NumericUpDown Grid.Row="1" Grid.Column="1"
                                   Minimum="0" Maximum="12" Increment="1" FormatString="F0"
                                   Value="{Binding LSystemDepth, Mode=TwoWay}" Margin="0,2" />
                </Grid>

                <!-- Depth sweep: ramps Depth across its range like Adaptive sweep. -->
                <Border BorderBrush="#404040" BorderThickness="0,1,0,0" Padding="0,6,0,0" Margin="0,4,0,0">
                    <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,Auto,Auto,Auto">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Sweep mode:" VerticalAlignment="Center" />
                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="10">
                            <RadioButton GroupName="LSysDepthSweepMode"
                                         Content="Forward"
                                         IsChecked="{Binding IsLSystemForwardMode, Mode=TwoWay}" />
                            <RadioButton GroupName="LSysDepthSweepMode"
                                         Content="Reverse"
                                         IsChecked="{Binding IsLSystemReverseMode, Mode=TwoWay}" />
                            <RadioButton GroupName="LSysDepthSweepMode"
                                         Content="Ping-Pong"
                                         IsChecked="{Binding IsLSystemPingPongMode, Mode=TwoWay}" />
                        </StackPanel>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Duration (s):" VerticalAlignment="Center" />
                        <NumericUpDown Grid.Row="1" Grid.Column="1"
                                       Minimum="0.25" Maximum="600" Increment="0.25" FormatString="F2"
                                       Value="{Binding LSystemSweepDurationSeconds, Mode=TwoWay}" Margin="0,2" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Loop:" VerticalAlignment="Center" />
                        <CheckBox Grid.Row="2" Grid.Column="1"
                                  IsChecked="{Binding LSystemSweepLoop, Mode=TwoWay}"
                                  Content="Repeat until stopped" />

                        <Button Grid.Row="3" Grid.Column="1"
                                Content="{Binding LSystemSweepButtonLabel}"
                                Command="{Binding ToggleLSystemSweepCommand}"
                                HorizontalAlignment="Stretch"
                                Margin="0,4,0,0" />
                    </Grid>
                </Border>
            </StackPanel>

            <!-- Strange Attractor -->
            <Grid IsVisible="{Binding IsStrangeAttractor}"
                  ColumnDefinitions="160,*"
                  RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Preset:" VerticalAlignment="Center" />
                <ComboBox Grid.Row="0" Grid.Column="1"
                          ItemsSource="{Binding AttractorPresets}"
                          SelectedItem="{Binding AttractorPresetName, Mode=TwoWay}"
                          HorizontalAlignment="Stretch" Margin="0,2" />
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Iterations:" VerticalAlignment="Center" />
                <NumericUpDown Grid.Row="1" Grid.Column="1"
                               Minimum="100000" Maximum="20000000" Increment="100000" FormatString="N0"
                               Value="{Binding AttractorIterations, Mode=TwoWay}" Margin="0,2" />
                <TextBlock Grid.Row="2" Grid.Column="0" Text="a:" VerticalAlignment="Center" />
                <NumericUpDown Grid.Row="2" Grid.Column="1"
                               Minimum="-3" Maximum="3" Increment="0.01" FormatString="F4"
                               Value="{Binding AttractorA, Mode=TwoWay}" Margin="0,2" />
                <TextBlock Grid.Row="3" Grid.Column="0" Text="b:" VerticalAlignment="Center" />
                <NumericUpDown Grid.Row="3" Grid.Column="1"
                               Minimum="-3" Maximum="3" Increment="0.01" FormatString="F4"
                               Value="{Binding AttractorB, Mode=TwoWay}" Margin="0,2" />
                <TextBlock Grid.Row="4" Grid.Column="0" Text="c:" VerticalAlignment="Center" />
                <NumericUpDown Grid.Row="4" Grid.Column="1"
                               Minimum="-3" Maximum="3" Increment="0.01" FormatString="F4"
                               Value="{Binding AttractorC, Mode=TwoWay}" Margin="0,2" />
                <TextBlock Grid.Row="5" Grid.Column="0" Text="d:" VerticalAlignment="Center" />
                <NumericUpDown Grid.Row="5" Grid.Column="1"
                               Minimum="-3" Maximum="3" Increment="0.01" FormatString="F4"
                               Value="{Binding AttractorD, Mode=TwoWay}" Margin="0,2" />
            </Grid>

            <!-- BuddhaBrot / Nebulabrot / Anti-* family -->
            <Grid IsVisible="{Binding IsBuddhaBrot}"
                  ColumnDefinitions="160,*"
                  RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Samples:" VerticalAlignment="Center" />
                <NumericUpDown Grid.Row="0" Grid.Column="1"
                               Minimum="50000" Maximum="50000000" Increment="50000" FormatString="N0"
                               Value="{Binding BuddhaSamples, Mode=TwoWay}" Margin="0,2" />
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Iter low:" VerticalAlignment="Center" />
                <NumericUpDown Grid.Row="1" Grid.Column="1"
                               Minimum="50" Maximum="100000" Increment="50" FormatString="F0"
                               Value="{Binding BuddhaIterLow, Mode=TwoWay}" Margin="0,2" />
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Iter mid:" VerticalAlignment="Center" />
                <NumericUpDown Grid.Row="2" Grid.Column="1"
                               Minimum="100" Maximum="200000" Increment="100" FormatString="F0"
                               Value="{Binding BuddhaIterMid, Mode=TwoWay}" Margin="0,2" />
                <TextBlock Grid.Row="3" Grid.Column="0" Text="Iter high:" VerticalAlignment="Center" />
                <NumericUpDown Grid.Row="3" Grid.Column="1"
                               Minimum="500" Maximum="500000" Increment="500" FormatString="F0"
                               Value="{Binding BuddhaIterHigh, Mode=TwoWay}" Margin="0,2" />
                <TextBlock Grid.Row="4" Grid.Column="0" Text="Color mode:" VerticalAlignment="Center" />
                <ComboBox  Grid.Row="4" Grid.Column="1"
                           ItemsSource="{Binding BuddhaColorModes}"
                           SelectedItem="{Binding BuddhaColorMode, Mode=TwoWay}"
                           Margin="0,2" />
                <TextBlock Grid.Row="5" Grid.Column="0" Text="Quality:" VerticalAlignment="Center" />
                <ComboBox  Grid.Row="5" Grid.Column="1"
                           ItemsSource="{Binding BuddhaQualityModes}"
                           SelectedItem="{Binding BuddhaQualityMode, Mode=TwoWay}"
                           Margin="0,2"
                           ToolTip.Tip="HighDefinition = bilinear splat + real-axis mirror + joint norm + noise-floor reject. Slower but smoother." />
                <CheckBox Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2"
                          Content="Metropolis-Hastings sampling"
                          IsChecked="{Binding BuddhaMetropolis, Mode=TwoWay}"
                          Margin="0,2"
                          ToolTip.Tip="Importance sampling: concentrates samples on c values whose orbits hit the viewport. Big gain when zoomed in." />
                <CheckBox Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2"
                          Content="Progressive accumulation"
                          IsChecked="{Binding BuddhaProgressive, Mode=TwoWay}"
                          Margin="0,2"
                          ToolTip.Tip="Composites image in 8 chunks. Cancel mid-render keeps a usable partial result." />
            </Grid>

            <!-- Mandelbulb -->
            <Grid IsVisible="{Binding IsMandelbulb}"
                  ColumnDefinitions="160,*"
                  RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Power N:" VerticalAlignment="Center" />
                <NumericUpDown Grid.Row="0" Grid.Column="1"
                               Minimum="2" Maximum="16" Increment="0.1" FormatString="F1"
                               Value="{Binding BulbPower, Mode=TwoWay}" Margin="0,2" />
                <TextBlock Grid.Row="1" Grid.Column="0" Text="DE iter:" VerticalAlignment="Center" />
                <NumericUpDown Grid.Row="1" Grid.Column="1"
                               Minimum="2" Maximum="16" Increment="1" FormatString="F0"
                               Value="{Binding BulbIterations, Mode=TwoWay}" Margin="0,2" />
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Cam θ (azim):" VerticalAlignment="Center" />
                <NumericUpDown Grid.Row="2" Grid.Column="1"
                               Minimum="-10" Maximum="10" Increment="0.05" FormatString="F3"
                               Value="{Binding BulbCameraTheta, Mode=TwoWay}" Margin="0,2" />
                <TextBlock Grid.Row="3" Grid.Column="0" Text="Cam φ (elev):" VerticalAlignment="Center" />
                <NumericUpDown Grid.Row="3" Grid.Column="1"
                               Minimum="0.01" Maximum="3.13" Increment="0.05" FormatString="F3"
                               Value="{Binding BulbCameraPhi, Mode=TwoWay}" Margin="0,2" />
                <TextBlock Grid.Row="4" Grid.Column="0" Text="Cam dist:" VerticalAlignment="Center" />
                <NumericUpDown Grid.Row="4" Grid.Column="1"
                               Minimum="0.1" Maximum="500" Increment="0.1" FormatString="F2"
                               Value="{Binding BulbCameraDistance, Mode=TwoWay}" Margin="0,2" />
            </Grid>

            <!-- Mandelbox -->
            <Grid IsVisible="{Binding IsMandelbox}"
                  ColumnDefinitions="160,*"
                  RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Scale:" VerticalAlignment="Center" />
                <NumericUpDown Grid.Row="0" Grid.Column="1"
                               Minimum="-4" Maximum="4" Increment="0.1" FormatString="F2"
                               Value="{Binding MandelboxScale, Mode=TwoWay}" Margin="0,2"
                               ToolTip.Tip="Per-iter scale (z = scale·sphereFold(boxFold(z)) + c). Classics: −1.5, 2.0, 3.0." />
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Fixed radius:" VerticalAlignment="Center" />
                <NumericUpDown Grid.Row="1" Grid.Column="1"
                               Minimum="0.1" Maximum="4" Increment="0.05" FormatString="F3"
                               Value="{Binding MandelboxFixedRadius, Mode=TwoWay}" Margin="0,2" />
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Min radius:" VerticalAlignment="Center" />
                <NumericUpDown Grid.Row="2" Grid.Column="1"
                               Minimum="0.05" Maximum="2" Increment="0.05" FormatString="F3"
                               Value="{Binding MandelboxMinRadius, Mode=TwoWay}" Margin="0,2" />
                <TextBlock Grid.Row="3" Grid.Column="0" Text="DE iter:" VerticalAlignment="Center" />
                <NumericUpDown Grid.Row="3" Grid.Column="1"
                               Minimum="2" Maximum="32" Increment="1" FormatString="F0"
                               Value="{Binding MandelboxIterations, Mode=TwoWay}" Margin="0,2" />
                <TextBlock Grid.Row="4" Grid.Column="0" Text="Cam θ (azim):" VerticalAlignment="Center" />
                <NumericUpDown Grid.Row="4" Grid.Column="1"
                               Minimum="-10" Maximum="10" Increment="0.05" FormatString="F3"
                               Value="{Binding MandelboxCameraTheta, Mode=TwoWay}" Margin="0,2" />
                <TextBlock Grid.Row="5" Grid.Column="0" Text="Cam φ (elev):" VerticalAlignment="Center" />
                <NumericUpDown Grid.Row="5" Grid.Column="1"
                               Minimum="0.01" Maximum="3.13" Increment="0.05" FormatString="F3"
                               Value="{Binding MandelboxCameraPhi, Mode=TwoWay}" Margin="0,2" />
                <TextBlock Grid.Row="6" Grid.Column="0" Text="Cam dist:" VerticalAlignment="Center" />
                <NumericUpDown Grid.Row="6" Grid.Column="1"
                               Minimum="0.1" Maximum="500" Increment="0.1" FormatString="F2"
                               Value="{Binding MandelboxCameraDistance, Mode=TwoWay}" Margin="0,2" />
            </Grid>

            <!-- KIFS -->
            <Grid IsVisible="{Binding IsKifs}"
                  ColumnDefinitions="160,*"
                  RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Fold:" VerticalAlignment="Center" />
                <ComboBox  Grid.Row="0" Grid.Column="1"
                           ItemsSource="{Binding KifsFoldKinds}"
                           SelectedItem="{Binding KifsFold, Mode=TwoWay}" Margin="0,2"
                           ToolTip.Tip="Menger sponge (sort-3, scale 3) or Sierpinski tetrahedron (3 vertex reflections, scale 2)." />
                <TextBlock Grid.Row="1" Grid.Column="0" Text="DE iter:" VerticalAlignment="Center" />
                <NumericUpDown Grid.Row="1" Grid.Column="1"
                               Minimum="2" Maximum="32" Increment="1" FormatString="F0"
                               Value="{Binding KifsIterations, Mode=TwoWay}" Margin="0,2" />
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Scale (0=auto):" VerticalAlignment="Center" />
                <NumericUpDown Grid.Row="2" Grid.Column="1"
                               Minimum="0" Maximum="6" Increment="0.1" FormatString="F2"
                               Value="{Binding KifsScale, Mode=TwoWay}" Margin="0,2"
                               ToolTip.Tip="Per-iter linear scale after fold. 0 = use the fold's canonical default (3 Menger, 2 Sierpinski)." />
                <TextBlock Grid.Row="3" Grid.Column="0" Text="Offset X:" VerticalAlignment="Center" />
                <NumericUpDown Grid.Row="3" Grid.Column="1"
                               Minimum="-3" Maximum="3" Increment="0.05" FormatString="F3"
                               Value="{Binding KifsOffsetX, Mode=TwoWay}" Margin="0,2" />
                <TextBlock Grid.Row="4" Grid.Column="0" Text="Offset Y:" VerticalAlignment="Center" />
                <NumericUpDown Grid.Row="4" Grid.Column="1"
                               Minimum="-3" Maximum="3" Increment="0.05" FormatString="F3"
                               Value="{Binding KifsOffsetY, Mode=TwoWay}" Margin="0,2" />
                <TextBlock Grid.Row="5" Grid.Column="0" Text="Offset Z:" VerticalAlignment="Center" />
                <NumericUpDown Grid.Row="5" Grid.Column="1"
                               Minimum="-3" Maximum="3" Increment="0.05" FormatString="F3"
                               Value="{Binding KifsOffsetZ, Mode=TwoWay}" Margin="0,2" />
                <TextBlock Grid.Row="6" Grid.Column="0" Text="Cam θ (azim):" VerticalAlignment="Center" />
                <NumericUpDown Grid.Row="6" Grid.Column="1"
                               Minimum="-10" Maximum="10" Increment="0.05" FormatString="F3"
                               Value="{Binding KifsCameraTheta, Mode=TwoWay}" Margin="0,2" />
                <TextBlock Grid.Row="7" Grid.Column="0" Text="Cam φ (elev):" VerticalAlignment="Center" />
                <NumericUpDown Grid.Row="7" Grid.Column="1"
                               Minimum="0.01" Maximum="3.13" Increment="0.05" FormatString="F3"
                               Value="{Binding KifsCameraPhi, Mode=TwoWay}" Margin="0,2" />
                <TextBlock Grid.Row="8" Grid.Column="0" Text="Cam dist:" VerticalAlignment="Center" />
                <NumericUpDown Grid.Row="8" Grid.Column="1"
                               Minimum="0.1" Maximum="500" Increment="0.1" FormatString="F2"
                               Value="{Binding KifsCameraDistance, Mode=TwoWay}" Margin="0,2" />
            </Grid>

            <!-- Quaternion Julia -->
            <Grid IsVisible="{Binding IsQuatJulia}"
                  ColumnDefinitions="160,*"
                  RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="c.X:" VerticalAlignment="Center" />
                <NumericUpDown Grid.Row="0" Grid.Column="1"
                               Minimum="-2" Maximum="2" Increment="0.01" FormatString="F3"
                               Value="{Binding QJuliaCX, Mode=TwoWay}" Margin="0,2"
                               ToolTip.Tip="Constant quaternion c — X (first) component." />
                <TextBlock Grid.Row="1" Grid.Column="0" Text="c.Y:" VerticalAlignment="Center" />
                <NumericUpDown Grid.Row="1" Grid.Column="1"
                               Minimum="-2" Maximum="2" Increment="0.01" FormatString="F3"
                               Value="{Binding QJuliaCY, Mode=TwoWay}" Margin="0,2" />
                <TextBlock Grid.Row="2" Grid.Column="0" Text="c.Z:" VerticalAlignment="Center" />
                <NumericUpDown Grid.Row="2" Grid.Column="1"
                               Minimum="-2" Maximum="2" Increment="0.01" FormatString="F3"
                               Value="{Binding QJuliaCZ, Mode=TwoWay}" Margin="0,2" />
                <TextBlock Grid.Row="3" Grid.Column="0" Text="c.W:" VerticalAlignment="Center" />
                <NumericUpDown Grid.Row="3" Grid.Column="1"
                               Minimum="-2" Maximum="2" Increment="0.01" FormatString="F3"
                               Value="{Binding QJuliaCW, Mode=TwoWay}" Margin="0,2" />
                <TextBlock Grid.Row="4" Grid.Column="0" Text="Slice w:" VerticalAlignment="Center" />
                <NumericUpDown Grid.Row="4" Grid.Column="1"
                               Minimum="-2" Maximum="2" Increment="0.01" FormatString="F3"
                               Value="{Binding QJuliaSliceW, Mode=TwoWay}" Margin="0,2"
                               ToolTip.Tip="W component of the 3D slice plane through 4D ℍ. Move to see different cross-sections of the same set." />
                <TextBlock Grid.Row="5" Grid.Column="0" Text="DE iter:" VerticalAlignment="Center" />
                <NumericUpDown Grid.Row="5" Grid.Column="1"
                               Minimum="2" Maximum="32" Increment="1" FormatString="F0"
                               Value="{Binding QJuliaIterations, Mode=TwoWay}" Margin="0,2" />
                <TextBlock Grid.Row="6" Grid.Column="0" Text="Cam θ (azim):" VerticalAlignment="Center" />
                <NumericUpDown Grid.Row="6" Grid.Column="1"
                               Minimum="-10" Maximum="10" Increment="0.05" FormatString="F3"
                               Value="{Binding QJuliaCameraTheta, Mode=TwoWay}" Margin="0,2" />
                <TextBlock Grid.Row="7" Grid.Column="0" Text="Cam φ (elev):" VerticalAlignment="Center" />
                <NumericUpDown Grid.Row="7" Grid.Column="1"
                               Minimum="0.01" Maximum="3.13" Increment="0.05" FormatString="F3"
                               Value="{Binding QJuliaCameraPhi, Mode=TwoWay}" Margin="0,2" />
                <TextBlock Grid.Row="8" Grid.Column="0" Text="Cam dist:" VerticalAlignment="Center" />
                <NumericUpDown Grid.Row="8" Grid.Column="1"
                               Minimum="0.1" Maximum="500" Increment="0.1" FormatString="F2"
                               Value="{Binding QJuliaCameraDistance, Mode=TwoWay}" Margin="0,2" />
            </Grid>

            <!-- Quaternion Mandelbrot -->
            <Grid IsVisible="{Binding IsQuatMandelbrot}"
                  ColumnDefinitions="160,*"
                  RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Slice w:" VerticalAlignment="Center" />
                <NumericUpDown Grid.Row="0" Grid.Column="1"
                               Minimum="-2" Maximum="2" Increment="0.01" FormatString="F3"
                               Value="{Binding QMandelSliceW, Mode=TwoWay}" Margin="0,2"
                               ToolTip.Tip="W component of the 3D slice plane through 4D c-space. Pixel (x,y,z) → c = (x,y,z, sliceW)." />
                <TextBlock Grid.Row="1" Grid.Column="0" Text="DE iter:" VerticalAlignment="Center" />
                <NumericUpDown Grid.Row="1" Grid.Column="1"
                               Minimum="2" Maximum="32" Increment="1" FormatString="F0"
                               Value="{Binding QMandelIterations, Mode=TwoWay}" Margin="0,2" />
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Cam θ (azim):" VerticalAlignment="Center" />
                <NumericUpDown Grid.Row="2" Grid.Column="1"
                               Minimum="-10" Maximum="10" Increment="0.05" FormatString="F3"
                               Value="{Binding QMandelCameraTheta, Mode=TwoWay}" Margin="0,2" />
                <TextBlock Grid.Row="3" Grid.Column="0" Text="Cam φ (elev):" VerticalAlignment="Center" />
                <NumericUpDown Grid.Row="3" Grid.Column="1"
                               Minimum="0.01" Maximum="3.13" Increment="0.05" FormatString="F3"
                               Value="{Binding QMandelCameraPhi, Mode=TwoWay}" Margin="0,2" />
                <TextBlock Grid.Row="4" Grid.Column="0" Text="Cam dist:" VerticalAlignment="Center" />
                <NumericUpDown Grid.Row="4" Grid.Column="1"
                               Minimum="0.1" Maximum="500" Increment="0.1" FormatString="F2"
                               Value="{Binding QMandelCameraDistance, Mode=TwoWay}" Margin="0,2" />
            </Grid>

            <!-- Plasma -->
            <Grid IsVisible="{Binding IsPlasma}"
                  ColumnDefinitions="160,*"
                  RowDefinitions="Auto,Auto">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Roughness:" VerticalAlignment="Center" />
                <NumericUpDown Grid.Row="0" Grid.Column="1"
                               Minimum="0.0" Maximum="1.0" Increment="0.05" FormatString="F2"
                               Value="{Binding PlasmaRoughness, Mode=TwoWay}" Margin="0,2"
                               ToolTip.Tip="Per-subdivision displacement decay. 0 = smooth gradient, 1 = full amplitude (jagged)." />
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Seed:" VerticalAlignment="Center" />
                <NumericUpDown Grid.Row="1" Grid.Column="1"
                               Minimum="-2147483648" Maximum="2147483647" Increment="1" FormatString="F0"
                               Value="{Binding PlasmaSeed, Mode=TwoWay}" Margin="0,2"
                               ToolTip.Tip="PRNG seed — same seed + roughness + size = identical field." />
            </Grid>

            <!-- Flame -->
            <Grid IsVisible="{Binding IsFlame}"
                  ColumnDefinitions="160,*"
                  RowDefinitions="Auto,Auto,Auto,Auto">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Preset:" VerticalAlignment="Center" />
                <ComboBox Grid.Row="0" Grid.Column="1"
                          ItemsSource="{Binding FlamePresets}"
                          SelectedItem="{Binding FlamePresetName, Mode=TwoWay}"
                          Margin="0,2"
                          ToolTip.Tip="Built-in Apophysis-style flame map table." />
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Iterations:" VerticalAlignment="Center" />
                <NumericUpDown Grid.Row="1" Grid.Column="1"
                               Minimum="100000" Maximum="100000000" Increment="500000" FormatString="F0"
                               Value="{Binding FlameIterations, Mode=TwoWay}" Margin="0,2"
                               ToolTip.Tip="Chaos-game sample count. Density quality scales with √N." />
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Gamma:" VerticalAlignment="Center" />
                <NumericUpDown Grid.Row="2" Grid.Column="1"
                               Minimum="0.5" Maximum="5.0" Increment="0.1" FormatString="F2"
                               Value="{Binding FlameGamma, Mode=TwoWay}" Margin="0,2"
                               ToolTip.Tip="Tone-map gamma. 2.2 = Apophysis default. Lower = punchier highlights." />
                <TextBlock Grid.Row="3" Grid.Column="0" Text="Vibrancy:" VerticalAlignment="Center" />
                <NumericUpDown Grid.Row="3" Grid.Column="1"
                               Minimum="0.0" Maximum="1.0" Increment="0.05" FormatString="F2"
                               Value="{Binding FlameVibrancy, Mode=TwoWay}" Margin="0,2"
                               ToolTip.Tip="Highlight saturation 0..1. 0 = linear, 1 = full gamma-on-colour." />
            </Grid>

            <!-- DLA -->
            <Grid IsVisible="{Binding IsDla}"
                  ColumnDefinitions="160,*"
                  RowDefinitions="Auto,Auto">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Particles:" VerticalAlignment="Center" />
                <NumericUpDown Grid.Row="0" Grid.Column="1"
                               Minimum="100" Maximum="500000" Increment="500" FormatString="F0"
                               Value="{Binding DlaParticles, Mode=TwoWay}" Margin="0,2"
                               ToolTip.Tip="Random-walk particles launched into the aggregate. Higher = denser tree, slower render." />
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Seed:" VerticalAlignment="Center" />
                <NumericUpDown Grid.Row="1" Grid.Column="1"
                               Minimum="-2147483648" Maximum="2147483647" Increment="1" FormatString="F0"
                               Value="{Binding DlaSeed, Mode=TwoWay}" Margin="0,2"
                               ToolTip.Tip="PRNG seed — same seed + particles + canvas size = identical tree." />
            </Grid>

            <!-- Bicomplex Mandelbrot -->
            <Grid IsVisible="{Binding IsBicomplexMandelbrot}"
                  ColumnDefinitions="160,*"
                  RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Slice k:" VerticalAlignment="Center" />
                <NumericUpDown Grid.Row="0" Grid.Column="1"
                               Minimum="-2" Maximum="2" Increment="0.01" FormatString="F3"
                               Value="{Binding BicomplexSliceW, Mode=TwoWay}" Margin="0,2"
                               ToolTip.Tip="k-component of the 3D slice plane through 4D bicomplex c-space. 0 = extrudes the standard 2D Mandelbrot." />
                <TextBlock Grid.Row="1" Grid.Column="0" Text="DE iter:" VerticalAlignment="Center" />
                <NumericUpDown Grid.Row="1" Grid.Column="1"
                               Minimum="2" Maximum="32" Increment="1" FormatString="F0"
                               Value="{Binding BicomplexIterations, Mode=TwoWay}" Margin="0,2" />
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Cam θ (azim):" VerticalAlignment="Center" />
                <NumericUpDown Grid.Row="2" Grid.Column="1"
                               Minimum="-10" Maximum="10" Increment="0.05" FormatString="F3"
                               Value="{Binding BicomplexCameraTheta, Mode=TwoWay}" Margin="0,2" />
                <TextBlock Grid.Row="3" Grid.Column="0" Text="Cam φ (elev):" VerticalAlignment="Center" />
                <NumericUpDown Grid.Row="3" Grid.Column="1"
                               Minimum="0.01" Maximum="3.13" Increment="0.05" FormatString="F3"
                               Value="{Binding BicomplexCameraPhi, Mode=TwoWay}" Margin="0,2" />
                <TextBlock Grid.Row="4" Grid.Column="0" Text="Cam dist:" VerticalAlignment="Center" />
                <NumericUpDown Grid.Row="4" Grid.Column="1"
                               Minimum="0.1" Maximum="500" Increment="0.1" FormatString="F2"
                               Value="{Binding BicomplexCameraDistance, Mode=TwoWay}" Margin="0,2" />
            </Grid>

            <!-- Kleinian -->
            <Grid IsVisible="{Binding IsKleinian}"
                  ColumnDefinitions="160,*"
                  RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Inversion iter:" VerticalAlignment="Center" />
                <NumericUpDown Grid.Row="0" Grid.Column="1"
                               Minimum="2" Maximum="64" Increment="1" FormatString="F0"
                               Value="{Binding KleinianIterations, Mode=TwoWay}" Margin="0,2"
                               ToolTip.Tip="Sphere-inversion iteration cap. Higher = sharper limit-set boundary, slower per sample." />
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Sphere scale:" VerticalAlignment="Center" />
                <NumericUpDown Grid.Row="1" Grid.Column="1"
                               Minimum="0.25" Maximum="4.0" Increment="0.05" FormatString="F3"
                               Value="{Binding KleinianSphereScale, Mode=TwoWay}" Margin="0,2"
                               ToolTip.Tip="Tetrahedral arrangement scale. 1 = tangent at edge midpoints; smaller separates the spheres." />
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Cam θ (azim):" VerticalAlignment="Center" />
                <NumericUpDown Grid.Row="2" Grid.Column="1"
                               Minimum="-10" Maximum="10" Increment="0.05" FormatString="F3"
                               Value="{Binding KleinianCameraTheta, Mode=TwoWay}" Margin="0,2" />
                <TextBlock Grid.Row="3" Grid.Column="0" Text="Cam φ (elev):" VerticalAlignment="Center" />
                <NumericUpDown Grid.Row="3" Grid.Column="1"
                               Minimum="0.01" Maximum="3.13" Increment="0.05" FormatString="F3"
                               Value="{Binding KleinianCameraPhi, Mode=TwoWay}" Margin="0,2" />
                <TextBlock Grid.Row="4" Grid.Column="0" Text="Cam dist:" VerticalAlignment="Center" />
                <NumericUpDown Grid.Row="4" Grid.Column="1"
                               Minimum="0.1" Maximum="500" Increment="0.1" FormatString="F2"
                               Value="{Binding KleinianCameraDistance, Mode=TwoWay}" Margin="0,2" />
            </Grid>

            <!-- Apollonian -->
            <Grid IsVisible="{Binding IsApollonian}"
                  ColumnDefinitions="160,*"
                  RowDefinitions="Auto,Auto,Auto">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Depth:" VerticalAlignment="Center" />
                <NumericUpDown Grid.Row="0" Grid.Column="1"
                               Minimum="0" Maximum="40" Increment="1" FormatString="F0"
                               Value="{Binding ApollonianDepth, Mode=TwoWay}" Margin="0,2"
                               ToolTip.Tip="Maximum Vieta-jump recursion depth. Pixel cutoff usually fires first; raise only when zoomed deep." />
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Min px radius:" VerticalAlignment="Center" />
                <NumericUpDown Grid.Row="1" Grid.Column="1"
                               Minimum="0.25" Maximum="16.0" Increment="0.25" FormatString="F2"
                               Value="{Binding ApollonianMinPixelRadius, Mode=TwoWay}" Margin="0,2"
                               ToolTip.Tip="Stop recursing when the next circle would draw smaller than this many device pixels." />
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Colour by depth:" VerticalAlignment="Center" />
                <CheckBox Grid.Row="2" Grid.Column="1"
                          IsChecked="{Binding ApollonianColorByDepth, Mode=TwoWay}" Margin="0,2"
                          ToolTip.Tip="On = palette indexed by recursion depth (banded). Off = log(radius) gradient (smooth)." />
            </Grid>

            <!-- Empty state -->
            <TextBlock IsVisible="{Binding HasNoParams}"
                       Text="{Binding EmptyStateText}"
                       Foreground="#B4B4B4"
                       FontStyle="Italic"
                       Margin="0,8" />

            <!--
              ── Shared Lighting & FX (Phase 1) ────────────────────────────
              Visible only for 3D raymarchers. Backed by FractalParameters.Lighting
              (LightingFxData). Defaults preserve legacy single-light look so
              existing renders stay pixel-identical until a knob is moved.

              Grouped into Expanders so the dialog stays compact; user opens
              only the panel they're tuning.
            -->
            <Border IsVisible="{Binding IsAny3DRaymarcher}"
                    BorderBrush="#3C3C3C"
                    BorderThickness="0,1,0,0"
                    Margin="0,10,0,0"
                    Padding="0,8,0,0">
                <StackPanel Spacing="4">

                    <TextBlock Text="Lighting &amp; FX"
                               FontWeight="Bold"
                               Foreground="#FFCC00"
                               Margin="0,0,0,4" />

                    <!-- Lights -->
                    <Expander Header="Lights" IsExpanded="True">
                        <Grid ColumnDefinitions="160,*"
                              RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="L1 θ (azim):" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Row="0" Grid.Column="1"
                                           Minimum="-10" Maximum="10" Increment="0.05" FormatString="F3"
                                           Value="{Binding Light1Theta, Mode=TwoWay}" Margin="0,2" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="L1 φ (elev):" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Row="1" Grid.Column="1"
                                           Minimum="0.01" Maximum="3.13" Increment="0.05" FormatString="F3"
                                           Value="{Binding Light1Phi, Mode=TwoWay}" Margin="0,2" />
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="L1 intensity:" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Row="2" Grid.Column="1"
                                           Minimum="0" Maximum="4" Increment="0.05" FormatString="F2"
                                           Value="{Binding Light1Intensity, Mode=TwoWay}" Margin="0,2" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="L2 θ (azim):" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Row="3" Grid.Column="1"
                                           Minimum="-10" Maximum="10" Increment="0.05" FormatString="F3"
                                           Value="{Binding Light2Theta, Mode=TwoWay}" Margin="0,2" />
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="L2 φ (elev):" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Row="4" Grid.Column="1"
                                           Minimum="0.01" Maximum="3.13" Increment="0.05" FormatString="F3"
                                           Value="{Binding Light2Phi, Mode=TwoWay}" Margin="0,2" />
                            <TextBlock Grid.Row="5" Grid.Column="0" Text="L2 intensity:" VerticalAlignment="Center"
                                       ToolTip.Tip="0 = light off. Fill light. Default off so legacy single-light look stays unchanged." />
                            <NumericUpDown Grid.Row="5" Grid.Column="1"
                                           Minimum="0" Maximum="4" Increment="0.05" FormatString="F2"
                                           Value="{Binding Light2Intensity, Mode=TwoWay}" Margin="0,2" />

                            <TextBlock Grid.Row="6" Grid.Column="0" Text="L3 θ (azim):" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Row="6" Grid.Column="1"
                                           Minimum="-10" Maximum="10" Increment="0.05" FormatString="F3"
                                           Value="{Binding Light3Theta, Mode=TwoWay}" Margin="0,2" />
                            <TextBlock Grid.Row="7" Grid.Column="0" Text="L3 φ (elev):" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Row="7" Grid.Column="1"
                                           Minimum="0.01" Maximum="3.13" Increment="0.05" FormatString="F3"
                                           Value="{Binding Light3Phi, Mode=TwoWay}" Margin="0,2" />
                            <TextBlock Grid.Row="8" Grid.Column="0" Text="L3 intensity:" VerticalAlignment="Center"
                                       ToolTip.Tip="0 = light off. Rim/back light." />
                            <NumericUpDown Grid.Row="8" Grid.Column="1"
                                           Minimum="0" Maximum="4" Increment="0.05" FormatString="F2"
                                           Value="{Binding Light3Intensity, Mode=TwoWay}" Margin="0,2" />

                            <TextBlock Grid.Row="9" Grid.Column="0" Text="Ambient:" VerticalAlignment="Center"
                                       ToolTip.Tip="Flat floor brightness. Legacy 0.15. Higher = brighter shadows / less contrast." />
                            <NumericUpDown Grid.Row="9" Grid.Column="1"
                                           Minimum="0" Maximum="1" Increment="0.01" FormatString="F3"
                                           Value="{Binding AmbientStrength, Mode=TwoWay}" Margin="0,2" />

                            <TextBlock Grid.Row="10" Grid.Column="0" Text="Orbit speed (rad/s):" VerticalAlignment="Center"
                                       ToolTip.Tip="Animates L1 around world Y. 0 = static. Drives slideshow / video export." />
                            <NumericUpDown Grid.Row="10" Grid.Column="1"
                                           Minimum="-10" Maximum="10" Increment="0.05" FormatString="F3"
                                           Value="{Binding LightOrbitSpeed, Mode=TwoWay}" Margin="0,2" />
                            <TextBlock Grid.Row="11" Grid.Column="0" Text="Caustics speed:" VerticalAlignment="Center"
                                       ToolTip.Tip="Caustic-pattern phase rate. 0 = static. Drives host animation tick." />
                            <NumericUpDown Grid.Row="11" Grid.Column="1"
                                           Minimum="-10" Maximum="10" Increment="0.05" FormatString="F3"
                                           Value="{Binding CausticsAnimSpeed, Mode=TwoWay}" Margin="0,2" />
                        </Grid>
                    </Expander>

                    <!-- AO -->
                    <Expander Header="Ambient Occlusion">
                        <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="DE-AO samples:" VerticalAlignment="Center"
                                       ToolTip.Tip="DE-cone AO (micro-crease detail). 0 = off. 4–8 typical; each sample = one DE eval." />
                            <NumericUpDown Grid.Row="0" Grid.Column="1"
                                           Minimum="0" Maximum="16" Increment="1" FormatString="F0"
                                           Value="{Binding AoSamples, Mode=TwoWay}" Margin="0,2" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="DE-AO strength:" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Row="1" Grid.Column="1"
                                           Minimum="0" Maximum="1" Increment="0.05" FormatString="F2"
                                           Value="{Binding AoStrength, Mode=TwoWay}" Margin="0,2" />
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="SSAO samples:" VerticalAlignment="Center"
                                       ToolTip.Tip="Screen-space AO (macro neighbor occlusion). Hemisphere sample count. 0 = off. 8–16 typical." />
                            <NumericUpDown Grid.Row="2" Grid.Column="1"
                                           Minimum="0" Maximum="64" Increment="1" FormatString="F0"
                                           Value="{Binding SsaoSamples, Mode=TwoWay}" Margin="0,2" />
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="SSAO radius:" VerticalAlignment="Center"
                                       ToolTip.Tip="Hemisphere radius in world units. Smaller = crevice detail; larger = soft global shadow." />
                            <NumericUpDown Grid.Row="3" Grid.Column="1"
                                           Minimum="0.001" Maximum="4" Increment="0.01" FormatString="F3"
                                           Value="{Binding SsaoRadius, Mode=TwoWay}" Margin="0,2" />
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="SSAO strength:" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Row="4" Grid.Column="1"
                                           Minimum="0" Maximum="1" Increment="0.05" FormatString="F2"
                                           Value="{Binding SsaoStrength, Mode=TwoWay}" Margin="0,2" />
                        </Grid>
                    </Expander>

                    <!-- Shadow -->
                    <Expander Header="Shadow">
                        <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,Auto">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Shadow steps:" VerticalAlignment="Center"
                                       ToolTip.Tip="Soft-shadow DE-march count per light. 0 = no shadows. 24–32 typical." />
                            <NumericUpDown Grid.Row="0" Grid.Column="1"
                                           Minimum="0" Maximum="64" Increment="1" FormatString="F0"
                                           Value="{Binding ShadowSteps, Mode=TwoWay}" Margin="0,2" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Softness k:" VerticalAlignment="Center"
                                       ToolTip.Tip="IQ soft-shadow sharpness. Higher = harder edge. 0 = pure hard shadow." />
                            <NumericUpDown Grid.Row="1" Grid.Column="1"
                                           Minimum="0" Maximum="64" Increment="1" FormatString="F1"
                                           Value="{Binding ShadowSoftK, Mode=TwoWay}" Margin="0,2" />
                        </Grid>
                    </Expander>

                    <!-- Fog / Volumetric -->
                    <Expander Header="Fog / Volumetric">
                        <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Fog density:" VerticalAlignment="Center"
                                       ToolTip.Tip="Beer–Lambert exponential. 0 = no fog. Scales by ray distance." />
                            <NumericUpDown Grid.Row="0" Grid.Column="1"
                                           Minimum="0" Maximum="2" Increment="0.005" FormatString="F4"
                                           Value="{Binding FogDensity, Mode=TwoWay}" Margin="0,2" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Height falloff:" VerticalAlignment="Center"
                                       ToolTip.Tip="Density scaled by exp(-coef * y). 0 = uniform; higher = fog hugs ground." />
                            <NumericUpDown Grid.Row="1" Grid.Column="1"
                                           Minimum="0" Maximum="4" Increment="0.05" FormatString="F2"
                                           Value="{Binding FogHeightFalloff, Mode=TwoWay}" Margin="0,2" />
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Volume steps:" VerticalAlignment="Center"
                                       ToolTip.Tip="In-scatter raymarch step count (light shafts). 0 = exp fog only. Cost = steps × shadow per sample." />
                            <NumericUpDown Grid.Row="2" Grid.Column="1"
                                           Minimum="0" Maximum="64" Increment="1" FormatString="F0"
                                           Value="{Binding VolumeSteps, Mode=TwoWay}" Margin="0,2" />
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Volume noise:" VerticalAlignment="Center"
                                       ToolTip.Tip="FBM cloud modulation [0,1]. 0 = uniform medium; 1 = cloud-like." />
                            <NumericUpDown Grid.Row="3" Grid.Column="1"
                                           Minimum="0" Maximum="1" Increment="0.05" FormatString="F2"
                                           Value="{Binding VolumeNoiseAmount, Mode=TwoWay}" Margin="0,2" />
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Noise scale:" VerticalAlignment="Center"
                                       ToolTip.Tip="FBM frequency. Higher = finer cloud detail. Default 1.0." />
                            <NumericUpDown Grid.Row="4" Grid.Column="1"
                                           Minimum="0.01" Maximum="100" Increment="0.1" FormatString="F2"
                                           Value="{Binding VolumeNoiseScale, Mode=TwoWay}" Margin="0,2" />
                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Noise speed:" VerticalAlignment="Center"
                                       ToolTip.Tip="Cloud drift along (1, 0.3, 0.7). 0 = static. Drives host animation tick." />
                            <NumericUpDown Grid.Row="5" Grid.Column="1"
                                           Minimum="-10" Maximum="10" Increment="0.05" FormatString="F3"
                                           Value="{Binding VolumeNoiseSpeed, Mode=TwoWay}" Margin="0,2" />
                            <TextBlock Grid.Row="6" Grid.Column="0" Text="Noise octaves:" VerticalAlignment="Center"
                                       ToolTip.Tip="FBM octaves [1..6]. More = finer cloud detail. Default 3 matches Phase 22." />
                            <NumericUpDown Grid.Row="6" Grid.Column="1"
                                           Minimum="1" Maximum="6" Increment="1" FormatString="F0"
                                           Value="{Binding VolumeNoiseOctaves, Mode=TwoWay}" Margin="0,2" />
                            <TextBlock Grid.Row="7" Grid.Column="0" Text="Self-shadow:" VerticalAlignment="Center"
                                       ToolTip.Tip="Cloud self-shadow strength [0..4]. 0 = off. Produces god-ray banding inside dense clouds." />
                            <NumericUpDown Grid.Row="7" Grid.Column="1"
                                           Minimum="0" Maximum="4" Increment="0.05" FormatString="F2"
                                           Value="{Binding VolumeSelfShadow, Mode=TwoWay}" Margin="0,2" />
                            <TextBlock Grid.Row="8" Grid.Column="0" Text="Self-shadow steps:" VerticalAlignment="Center"
                                       ToolTip.Tip="FBM samples per volume step along light direction [0..16]. Higher = smoother, costlier." />
                            <NumericUpDown Grid.Row="8" Grid.Column="1"
                                           Minimum="0" Maximum="16" Increment="1" FormatString="F0"
                                           Value="{Binding VolumeSelfShadowSteps, Mode=TwoWay}" Margin="0,2" />
                        </Grid>
                    </Expander>

                    <!-- Material (PBR-lite + SSS) -->
                    <Expander Header="Material">
                        <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,Auto,Auto,Auto">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Roughness:" VerticalAlignment="Center"
                                       ToolTip.Tip="GGX roughness. 0 = mirror, 1 = lambert." />
                            <NumericUpDown Grid.Row="0" Grid.Column="1"
                                           Minimum="0" Maximum="1" Increment="0.05" FormatString="F2"
                                           Value="{Binding Roughness, Mode=TwoWay}" Margin="0,2" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Metallic:" VerticalAlignment="Center"
                                       ToolTip.Tip="0 = dielectric (white spec), 1 = metal (albedo-tinted, no diffuse)." />
                            <NumericUpDown Grid.Row="1" Grid.Column="1"
                                           Minimum="0" Maximum="1" Increment="0.05" FormatString="F2"
                                           Value="{Binding Metallic, Mode=TwoWay}" Margin="0,2" />
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Specular:" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Row="2" Grid.Column="1"
                                           Minimum="0" Maximum="4" Increment="0.05" FormatString="F2"
                                           Value="{Binding SpecularStrength, Mode=TwoWay}" Margin="0,2" />
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Sub-surface:" VerticalAlignment="Center"
                                       ToolTip.Tip="Translucency. Back-lit lobe via dot(-L,V) * exp(-distInside * k)." />
                            <NumericUpDown Grid.Row="3" Grid.Column="1"
                                           Minimum="0" Maximum="1" Increment="0.05" FormatString="F2"
                                           Value="{Binding SubSurfaceStrength, Mode=TwoWay}" Margin="0,2" />
                        </Grid>
                    </Expander>

                    <!-- Sky / IBL -->
                    <Expander Header="Sky / Environment">
                        <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,Auto,Auto">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Sky mode:" VerticalAlignment="Center" />
                            <ComboBox  Grid.Row="0" Grid.Column="1"
                                       ItemsSource="{Binding SkyModes}"
                                       SelectedItem="{Binding SkyMode, Mode=TwoWay}" Margin="0,2" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="HDRI preset:" VerticalAlignment="Center"
                                       ToolTip.Tip="Environment-map name. Studio/Sunset/Overcast/Void. Empty = default." />
                            <TextBox   Grid.Row="1" Grid.Column="1"
                                       Text="{Binding EnvironmentName, Mode=TwoWay}" Margin="0,2" />
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="IBL strength:" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Row="2" Grid.Column="1"
                                           Minimum="0" Maximum="1" Increment="0.05" FormatString="F2"
                                           Value="{Binding IblStrength, Mode=TwoWay}" Margin="0,2" />
                        </Grid>
                    </Expander>

                    <!-- Post -->
                    <Expander Header="Tone Map / Bloom / Lens">
                        <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Tone map:" VerticalAlignment="Center" />
                            <ComboBox  Grid.Row="0" Grid.Column="1"
                                       ItemsSource="{Binding ToneMapOperators}"
                                       SelectedItem="{Binding ToneMap, Mode=TwoWay}" Margin="0,2" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Exposure:" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Row="1" Grid.Column="1"
                                           Minimum="0.0625" Maximum="16" Increment="0.05" FormatString="F2"
                                           Value="{Binding Exposure, Mode=TwoWay}" Margin="0,2" />
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Bloom threshold:" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Row="2" Grid.Column="1"
                                           Minimum="0" Maximum="20" Increment="0.1" FormatString="F2"
                                           Value="{Binding BloomThreshold, Mode=TwoWay}" Margin="0,2" />
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Bloom strength:" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Row="3" Grid.Column="1"
                                           Minimum="0" Maximum="1" Increment="0.05" FormatString="F2"
                                           Value="{Binding BloomStrength, Mode=TwoWay}" Margin="0,2" />
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Chromatic ab.:" VerticalAlignment="Center"
                                       ToolTip.Tip="Radial RGB channel offset (pixels). 0 = off." />
                            <NumericUpDown Grid.Row="4" Grid.Column="1"
                                           Minimum="0" Maximum="16" Increment="0.5" FormatString="F2"
                                           Value="{Binding ChromaticAberration, Mode=TwoWay}" Margin="0,2" />
                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Lens distortion:" VerticalAlignment="Center"
                                       ToolTip.Tip="Barrel (positive) / pincushion (negative). 0 = none." />
                            <NumericUpDown Grid.Row="5" Grid.Column="1"
                                           Minimum="-0.5" Maximum="0.5" Increment="0.02" FormatString="F3"
                                           Value="{Binding LensDistortion, Mode=TwoWay}" Margin="0,2" />
                            <TextBlock Grid.Row="6" Grid.Column="0" Text="Vignette:" VerticalAlignment="Center"
                                       ToolTip.Tip="Corner falloff [0..1]. 0 = uniform. Applied after lens warp." />
                            <NumericUpDown Grid.Row="6" Grid.Column="1"
                                           Minimum="0" Maximum="1" Increment="0.05" FormatString="F2"
                                           Value="{Binding Vignette, Mode=TwoWay}" Margin="0,2" />
                            <TextBlock Grid.Row="7" Grid.Column="0" Text="Tangential p1:" VerticalAlignment="Center"
                                       ToolTip.Tip="Brown decentring p1 (X coefficient). Simulates lens shift." />
                            <NumericUpDown Grid.Row="7" Grid.Column="1"
                                           Minimum="-0.1" Maximum="0.1" Increment="0.005" FormatString="F4"
                                           Value="{Binding LensTangentialX, Mode=TwoWay}" Margin="0,2" />
                            <TextBlock Grid.Row="8" Grid.Column="0" Text="Tangential p2:" VerticalAlignment="Center"
                                       ToolTip.Tip="Brown decentring p2 (Y coefficient). Simulates lens shift." />
                            <NumericUpDown Grid.Row="8" Grid.Column="1"
                                           Minimum="-0.1" Maximum="0.1" Increment="0.005" FormatString="F4"
                                           Value="{Binding LensTangentialY, Mode=TwoWay}" Margin="0,2" />
                            <TextBlock Grid.Row="9" Grid.Column="0" Text="Anamorphic squeeze:" VerticalAlignment="Center"
                                       ToolTip.Tip="Vertical-to-horizontal aspect ratio [0.25..4]. 1 = isotropic. >1 = scope/wide look." />
                            <NumericUpDown Grid.Row="9" Grid.Column="1"
                                           Minimum="0.25" Maximum="4" Increment="0.05" FormatString="F2"
                                           Value="{Binding AnamorphicSqueeze, Mode=TwoWay}" Margin="0,2" />
                        </Grid>
                    </Expander>

                    <!-- Reflection / Edge / Stereo / DoF -->
                    <Expander Header="Reflection / Edge / Stereo / DoF">
                        <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Reflection:" VerticalAlignment="Center"
                                       ToolTip.Tip="One-bounce DE-march along reflect(V,N). 0 = off." />
                            <NumericUpDown Grid.Row="0" Grid.Column="1"
                                           Minimum="0" Maximum="1" Increment="0.05" FormatString="F2"
                                           Value="{Binding ReflectionStrength, Mode=TwoWay}" Margin="0,2" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Reflection steps:" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Row="1" Grid.Column="1"
                                           Minimum="0" Maximum="64" Increment="1" FormatString="F0"
                                           Value="{Binding ReflectionSteps, Mode=TwoWay}" Margin="0,2" />
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Edge contour:" VerticalAlignment="Center"
                                       ToolTip.Tip="Sobel-on-normal ink overlay. 0 = off." />
                            <NumericUpDown Grid.Row="2" Grid.Column="1"
                                           Minimum="0" Maximum="1" Increment="0.05" FormatString="F2"
                                           Value="{Binding EdgeStrength, Mode=TwoWay}" Margin="0,2" />
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Edge threshold:" VerticalAlignment="Center"
                                       ToolTip.Tip="Sobel magnitude below which no ink is drawn (0..2.83). Default 0.4." />
                            <NumericUpDown Grid.Row="3" Grid.Column="1"
                                           Minimum="0" Maximum="2.83" Increment="0.05" FormatString="F2"
                                           Value="{Binding EdgeThreshold, Mode=TwoWay}" Margin="0,2" />
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Edge kernel:" VerticalAlignment="Center"
                                       ToolTip.Tip="Sobel = fast, isotropic-ish. FreiChen = 9-tap edge subspace, more uniform on diagonals." />
                            <ComboBox Grid.Row="4" Grid.Column="1"
                                      ItemsSource="{Binding EdgeKernels}"
                                      SelectedItem="{Binding EdgeKernel, Mode=TwoWay}"
                                      Margin="0,2" />
                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Edge color (BGRA hex):" VerticalAlignment="Center"
                                       ToolTip.Tip="Ink color in AARRGGBB hex (FF000000 = opaque black, FFFFCC00 = colorblind-safe yellow)." />
                            <TextBox Grid.Row="5" Grid.Column="1"
                                     Text="{Binding EdgeColorHex, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                     Margin="0,2" />
                            <TextBlock Grid.Row="6" Grid.Column="0" Text="Stereo eye sep:" VerticalAlignment="Center"
                                       ToolTip.Tip="Side-by-side stereo IPD in world units. 0 = mono. Doubles output width." />
                            <NumericUpDown Grid.Row="6" Grid.Column="1"
                                           Minimum="0" Maximum="0.25" Increment="0.005" FormatString="F4"
                                           Value="{Binding StereoEyeSeparation, Mode=TwoWay}" Margin="0,2" />
                            <TextBlock Grid.Row="7" Grid.Column="0" Text="Stereo FOV°:" VerticalAlignment="Center"
                                       ToolTip.Tip="Per-eye horizontal field-of-view in degrees. Default 60°. Used only when eye-sep > 0." />
                            <NumericUpDown Grid.Row="7" Grid.Column="1"
                                           Minimum="20" Maximum="120" Increment="1" FormatString="F1"
                                           Value="{Binding StereoFovDegrees, Mode=TwoWay}" Margin="0,2" />
                            <TextBlock Grid.Row="8" Grid.Column="0" Text="DoF aperture:" VerticalAlignment="Center"
                                       ToolTip.Tip="Hex bokeh radius (world units). 0 = pinhole." />
                            <NumericUpDown Grid.Row="8" Grid.Column="1"
                                           Minimum="0" Maximum="0.5" Increment="0.01" FormatString="F3"
                                           Value="{Binding DofAperture, Mode=TwoWay}" Margin="0,2" />
                            <TextBlock Grid.Row="9" Grid.Column="0" Text="DoF focus dist:" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Row="9" Grid.Column="1"
                                           Minimum="0.1" Maximum="100" Increment="0.1" FormatString="F2"
                                           Value="{Binding DofFocusDistance, Mode=TwoWay}" Margin="0,2" />
                            <TextBlock Grid.Row="10" Grid.Column="0" Text="DoF samples:" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Row="10" Grid.Column="1"
                                           Minimum="1" Maximum="32" Increment="1" FormatString="F0"
                                           Value="{Binding DofSamples, Mode=TwoWay}" Margin="0,2" />
                        </Grid>
                    </Expander>

                    <!-- Triplanar material (Phase 14b) -->
                    <Expander Header="Triplanar Material">
                        <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,Auto,Auto,Auto">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Pattern:" VerticalAlignment="Center"
                                       ToolTip.Tip="World-space projected pattern blended with the calculator's albedo. None = off." />
                            <ComboBox Grid.Row="0" Grid.Column="1"
                                      ItemsSource="{Binding TriplanarKinds}"
                                      SelectedItem="{Binding TriplanarKind, Mode=TwoWay}"
                                      Margin="0,2" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Scale:" VerticalAlignment="Center"
                                       ToolTip.Tip="Pattern frequency. Higher = finer detail." />
                            <NumericUpDown Grid.Row="1" Grid.Column="1"
                                           Minimum="0.01" Maximum="100" Increment="0.1" FormatString="F2"
                                           Value="{Binding TriplanarScale, Mode=TwoWay}" Margin="0,2" />
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Strength:" VerticalAlignment="Center"
                                       ToolTip.Tip="Blend weight against base albedo. 0 = bypass, 1 = full pattern." />
                            <NumericUpDown Grid.Row="2" Grid.Column="1"
                                           Minimum="0" Maximum="1" Increment="0.05" FormatString="F2"
                                           Value="{Binding TriplanarStrength, Mode=TwoWay}" Margin="0,2" />
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Tint (BGRA hex):" VerticalAlignment="Center"
                                       ToolTip.Tip="AARRGGBB tint hex multiplied with the pattern. FFFFFFFF = no tint. Examples: FFFFCC00 = colorblind-safe yellow." />
                            <TextBox Grid.Row="3" Grid.Column="1"
                                     Text="{Binding TriplanarTintHex, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                     Margin="0,2" />
                        </Grid>
                    </Expander>

                    <!-- Debug HUD bits (Phase 19b) -->
                    <Expander Header="Debug HUD">
                        <StackPanel Spacing="4" Margin="6,4,0,4">
                            <CheckBox Content="Light-direction compass"
                                      IsChecked="{Binding DebugHudCompass, Mode=TwoWay}"
                                      ToolTip.Tip="Top-right compass showing L1/L2/L3 azimuth + elevation. Pure visual, no text." />
                            <CheckBox Content="Parameter bars"
                                      IsChecked="{Binding DebugHudBars, Mode=TwoWay}"
                                      ToolTip.Tip="Bottom-left bars: Ambient / AO / Fog / Reflection / Caustics." />
                            <CheckBox Content="Scene-time clock"
                                      IsChecked="{Binding DebugHudClock, Mode=TwoWay}"
                                      ToolTip.Tip="Top-left rotating dial that visualises SceneTime advance." />
                        </StackPanel>
                    </Expander>

                </StackPanel>
            </Border>

        </StackPanel>

        <!-- Close button -->
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8"
                    Margin="0,14,0,0">
            <Button Content="?"
                    Click="OnHelpClick"
                    ToolTip.Tip="Open the Params section of the Avalonia user guide"
                    Padding="10,6"
                    Background="#283C50"
                    Foreground="#FFCC00"
                    FontWeight="Bold" />
            <Button Content="Close"
                    Command="{Binding CloseCommand}"
                    IsCancel="True"
                    Padding="18,6"
                    Background="#464646"
                    Foreground="White" />
        </StackPanel>

    </Grid>

</Window>

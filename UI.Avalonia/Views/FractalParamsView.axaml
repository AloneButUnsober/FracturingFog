<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FracturingFog.UI.Avalonia.ViewModels"
        xmlns:ps="using:FracturingFog.UI.Avalonia.Views.ParamSections"
        x:Class="FracturingFog.UI.Avalonia.Views.FractalParamsView"
        x:DataType="vm:FractalParamsViewModel"
        Foreground="White">

    <!--
      DIP-only layout. Each fractal type owns one IsVisible-gated section. Wave
      5.8 extracted those sections out of this monolith into three per-family
      UserControls under Views/ParamSections/ (2D escape-time, procedural,
      3D/4D raymarch). All share this window's FractalParamsViewModel
      DataContext, so bindings resolve exactly as before. Only one type's
      section is visible at a time; the others collapse to zero height. The
      empty-state TextBlock shows for fractals with no tunable parameters.
    -->
    <Grid Margin="14" RowDefinitions="*,Auto">

        <StackPanel Grid.Row="0" Spacing="6">

            <!-- Per-family param sections (Wave 5.8 extract). -->
            <ps:EscapeTimeParamsView />
            <ps:ProceduralParamsView />
            <ps:Raymarch3DParamsView />

            <!-- Empty state -->
            <TextBlock IsVisible="{Binding HasNoParams}"
                       Text="{Binding EmptyStateText}"
                       Foreground="#B4B4B4"
                       FontStyle="Italic"
                       Margin="0,8" />

            <!--
              ── Lighting & FX launcher ────────────────────────────────────
              Visible only for 3D raymarchers. The full knob tree (Lights, AO,
              Shadow, Fog, Material, Sky, Post, Reflection/Stereo/DoF,
              Triplanar, Debug HUD) lives in LightingFxDialog so this dialog
              stays compact. The button below opens it; both windows share
              the same FractalParamsViewModel so edits propagate live.
            -->
            <Border IsVisible="{Binding IsAny3DRaymarcher}"
                    BorderBrush="#3C3C3C"
                    BorderThickness="0,1,0,0"
                    Margin="0,10,0,0"
                    Padding="0,8,0,0">
                <StackPanel Spacing="6">
                    <TextBlock Text="Lighting &amp; FX"
                               FontWeight="Bold"
                               Foreground="#FFCC00" />
                    <Button Content="Open Lighting &amp; FX…"
                            Click="OnOpenLightingFxClick"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Padding="0,8"
                            Background="#283C50"
                            Foreground="White"
                            ToolTip.Tip="Open the full Lighting / Shading / Post-process dialog." />
                </StackPanel>
            </Border>

        </StackPanel>

        <!-- Close button -->
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8"
                    Margin="0,14,0,0">
            <Button Content="?"
                    Click="OnHelpClick"
                    ToolTip.Tip="Open the Params section of the Avalonia user guide"
                    Padding="10,6"
                    Background="#283C50"
                    Foreground="#FFCC00"
                    FontWeight="Bold" />
            <Button Content="Close"
                    Command="{Binding CloseCommand}"
                    IsCancel="True"
                    Padding="18,6"
                    Background="#464646"
                    Foreground="White" />
        </StackPanel>

    </Grid>

</UserControl>

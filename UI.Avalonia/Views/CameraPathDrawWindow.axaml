<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FracturingFog.UI.Avalonia.ViewModels"
        x:Class="FracturingFog.UI.Avalonia.Views.CameraPathDrawWindow"
        x:DataType="vm:CameraPathDrawViewModel"
        Title="{Binding Title}"
        Width="560" SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        Foreground="#DCDCDC"
        Background="#141414">
    <!-- #1056 — draw a shot's camera orbit top-down; fitted into camera keys by
         CameraPathFit. Canvas content (rings, centre shape, stroke, key dots)
         is drawn in code-behind from the VM. -->
    <Window.Styles>
        <Style Selector="TextBlock.label">
            <Setter Property="Foreground" Value="#B4B4B4" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.action">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="4,0,0,0" />
        </Style>
    </Window.Styles>

    <StackPanel Margin="10" Spacing="8">
        <TextBlock Text="{Binding Hint}" TextWrapping="Wrap" Foreground="#A0A0A0" />

        <Border BorderBrush="#404040" BorderThickness="1" HorizontalAlignment="Center">
            <Canvas x:Name="DrawCanvas" Width="520" Height="520" Background="#0C0C10"
                    Cursor="Cross" ClipToBounds="True" />
        </Border>

        <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto,Auto,Auto">
            <TextBlock Classes="label" Grid.Row="0" Grid.Column="0" Text="Duration (s):" Margin="0,0,6,4" />
            <NumericUpDown Grid.Row="0" Grid.Column="1" Value="{Binding DurationSeconds}"
                           Minimum="0.25" Maximum="3600" Increment="0.5" FormatString="0.##" Margin="0,0,10,4" />
            <TextBlock Classes="label" Grid.Row="0" Grid.Column="2" Text="Max keys:" Margin="0,0,6,4" />
            <NumericUpDown Grid.Row="0" Grid.Column="3" Value="{Binding MaxKeys}"
                           Minimum="2" Maximum="64" Increment="1" FormatString="0" Margin="0,0,0,4" />

            <TextBlock Classes="label" Grid.Row="1" Grid.Column="0" Text="Elevation start (°):" Margin="0,0,6,4" />
            <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding StartElevationDeg}"
                           Minimum="-89" Maximum="89" Increment="5" FormatString="0.#" Margin="0,0,10,4" />
            <TextBlock Classes="label" Grid.Row="1" Grid.Column="2" Text="end (°):" Margin="0,0,6,4" />
            <NumericUpDown Grid.Row="1" Grid.Column="3" Value="{Binding EndElevationDeg}"
                           Minimum="-89" Maximum="89" Increment="5" FormatString="0.#" Margin="0,0,0,4" />

            <TextBlock Classes="label" Grid.Row="2" Grid.Column="0" Text="Object radius:" Margin="0,0,6,0" />
            <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding ObjectRadius}"
                           Minimum="0.05" Maximum="15" Increment="0.1" FormatString="0.##" Margin="0,0,10,0"
                           ToolTip.Tip="Size of the centre shape — the closest the camera may come" />
            <TextBlock Classes="label" Grid.Row="2" Grid.Column="2" Text="View radius:" Margin="0,0,6,0" />
            <NumericUpDown Grid.Row="2" Grid.Column="3" Value="{Binding ViewRadius}"
                           Minimum="1" Maximum="20" Increment="0.5" FormatString="0.#"
                           ToolTip.Tip="Distance shown at the edge of the drawing area" />
        </Grid>

        <!-- Validation / result. Errors in #FFCC00 (red/green colourblind-safe). -->
        <TextBlock x:Name="StatusText" Text="{Binding Status}" TextWrapping="Wrap" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Classes="action" Background="#3A3A3A" Content="Clear" Command="{Binding ClearCommand}" />
            <Button Classes="action" Background="#3A3A3A" Content="Cancel" Command="{Binding CancelCommand}" />
            <Button Classes="action" Background="#1E5034" Content="Apply" Command="{Binding ApplyCommand}"
                    IsEnabled="{Binding CanApply}" />
        </StackPanel>
    </StackPanel>
</Window>

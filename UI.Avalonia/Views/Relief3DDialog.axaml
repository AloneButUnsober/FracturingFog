<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FracturingFog.UI.Avalonia.ViewModels"
        x:Class="FracturingFog.UI.Avalonia.Views.Relief3DDialog"
        x:DataType="vm:FractalParamsViewModel"
        Foreground="White">

    <UserControl.Styles>
        <!-- #305 — armed "Confirm reset?" state: yellow (#FFCC00, colorblind-safe). -->
        <Style Selector="Button.armed">
            <Setter Property="Foreground" Value="#FFCC00" />
            <Setter Property="BorderBrush" Value="#FFCC00" />
        </Style>
    </UserControl.Styles>

    <!--
      Standalone Relief 3D (2D heightfield) panel (#137). Extracted from the
      inline block in EscapeTimeParamsView so the compact Params dialog stays
      short. Bound to the SAME FractalParamsViewModel as FractalParamsView, so
      every knob still routes through the existing Relief2D* bindings. Reusable:
      shown for any fractal type where IsRelief2DApplicable is true, so extending
      relief to more 2D families reuses this dialog unchanged.
    -->

    <Grid Margin="14" RowDefinitions="*,Auto">
        <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="6">
                <TextBlock Text="Relief 3D (2D heightfield)" FontWeight="Bold" Foreground="#FFCC00" />
                <CheckBox Content="Enable raised relief + cast shadows"
                          IsChecked="{Binding Relief2DEnabled, Mode=TwoWay}"
                          ToolTip.Tip="Treats the escape potential as a height field and adds real raised relief + horizon cast shadows on top of the active theme. Reads best on smooth (non-noisy) themes and when zoomed into filament structure." />

                <Expander Header="Relief lighting" HorizontalAlignment="Stretch"
                          IsExpanded="{Binding Relief2DEnabled, Mode=OneWay}"
                          IsEnabled="{Binding Relief2DEnabled}">
                <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Height scale:" VerticalAlignment="Center"
                               ToolTip.Tip="Vertical exaggeration. Higher = deeper carving and longer shadows." />
                    <NumericUpDown Grid.Row="0" Grid.Column="1"
                                   Minimum="0" Maximum="6" Increment="0.1" FormatString="F1"
                                   Value="{Binding Relief2DHeightScale, Mode=TwoWay}" Margin="0,2" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Light azimuth (°):" VerticalAlignment="Center"
                               ToolTip.Tip="Compass direction of the light. 0 = right, 90 = up." />
                    <NumericUpDown Grid.Row="1" Grid.Column="1"
                                   Minimum="0" Maximum="360" Increment="5" FormatString="F0"
                                   Value="{Binding Relief2DLightAzimuthDeg, Mode=TwoWay}" Margin="0,2" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Light elevation (°):" VerticalAlignment="Center"
                               ToolTip.Tip="Light height above the plane. Lower = longer, more dramatic cast shadows." />
                    <NumericUpDown Grid.Row="2" Grid.Column="1"
                                   Minimum="1" Maximum="89" Increment="1" FormatString="F0"
                                   Value="{Binding Relief2DLightElevationDeg, Mode=TwoWay}" Margin="0,2" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Shadow strength:" VerticalAlignment="Center"
                               ToolTip.Tip="How dark cast shadows go. 0 = no shadows; 1 = fully black." />
                    <Slider Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="1"
                            Value="{Binding Relief2DShadowStrength, Mode=TwoWay}" Margin="0,2" />

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Relief strength:" VerticalAlignment="Center"
                               ToolTip.Tip="Blend of relief lighting vs the flat themed colour. 1 = full relief." />
                    <Slider Grid.Row="4" Grid.Column="1" Minimum="0" Maximum="1"
                            Value="{Binding Relief2DStrength, Mode=TwoWay}" Margin="0,2" />

                    <CheckBox Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,2"
                              Content="Absolute height (shade whole surface)"
                              IsChecked="{Binding Relief2DAbsolute, Mode=TwoWay}"
                              ToolTip.Tip="Shade the entire surface by its orientation to the light instead of only real slopes. Restores a strong overall 3D read on shallow / whole-set views, where the near-flat exterior otherwise nets to neutral and only inner detail changes. No effect with Oblique 3D raymarch (already an absolute surface)." />
                </Grid>
                </Expander>

                <!-- Phase 2 — oblique 3D raymarch -->
                <CheckBox Content="Oblique 3D raymarch (perspective + volumetric)"
                          IsChecked="{Binding Relief2DRaymarch, Mode=TwoWay}"
                          IsEnabled="{Binding Relief2DEnabled}"
                          ToolTip.Tip="Replaces the flat image with a true 3D raymarch of the height field from an oblique camera: real perspective relief, a silhouette, and volumetric fog / god-rays (set Fog density + Volume steps in the Lighting FX dialog). Heavier than the screen-space relief above." />
                <Expander Header="Camera &amp; quality" HorizontalAlignment="Stretch"
                          IsExpanded="{Binding Relief2DRaymarch, Mode=OneWay}"
                          IsEnabled="{Binding Relief2DRaymarch}">
                <StackPanel Spacing="6">
                <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Camera azimuth (°):" VerticalAlignment="Center"
                               ToolTip.Tip="Orbit the terrain around the up axis. 0 = looking straight at the scene." />
                    <NumericUpDown Grid.Row="0" Grid.Column="1"
                                   Minimum="-180" Maximum="180" Increment="5" FormatString="F0"
                                   Value="{Binding Relief2DCameraAzimuthDeg, Mode=TwoWay}" Margin="0,2" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Camera elevation (°):" VerticalAlignment="Center"
                               ToolTip.Tip="Camera height above the ground plane. 90 = top-down (flat-looking); low = raking, dramatic silhouette." />
                    <NumericUpDown Grid.Row="1" Grid.Column="1"
                                   Minimum="5" Maximum="89" Increment="1" FormatString="F0"
                                   Value="{Binding Relief2DCameraElevationDeg, Mode=TwoWay}" Margin="0,2" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Camera FOV (°):" VerticalAlignment="Center"
                               ToolTip.Tip="Vertical field of view. Wider = more perspective distortion." />
                    <NumericUpDown Grid.Row="2" Grid.Column="1"
                                   Minimum="15" Maximum="100" Increment="1" FormatString="F0"
                                   Value="{Binding Relief2DCameraFovDeg, Mode=TwoWay}" Margin="0,2" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Frame-fill zoom:" VerticalAlignment="Center"
                               ToolTip.Tip="How much of the window the terrain fills. 1.0 = auto-fit that fills the frame; &gt;1 pulls the camera in (terrain larger, edges may clip); &lt;1 pulls back for more margin." />
                    <NumericUpDown Grid.Row="3" Grid.Column="1"
                                   Minimum="0.2" Maximum="5" Increment="0.1" FormatString="F2"
                                   Value="{Binding Relief2DCameraZoom, Mode=TwoWay}" Margin="0,2" />

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Anti-alias (N×N):" VerticalAlignment="Center"
                               ToolTip.Tip="Supersampling: N×N rays per pixel, averaged. 1 = off (fastest), 2–4 = progressively smoother edges/silhouette at N² render cost." />
                    <NumericUpDown Grid.Row="4" Grid.Column="1"
                                   Minimum="1" Maximum="4" Increment="1" FormatString="F0"
                                   Value="{Binding Relief2DSupersample, Mode=TwoWay}" Margin="0,2" />

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Height curve:" VerticalAlignment="Center"
                               ToolTip.Tip="Tone curve on the height field. Log (default) tames boundary spikes into terrain; Sqrt is gentler; Linear is the un-tamed raw smooth-count (spiky)." />
                    <ComboBox Grid.Row="5" Grid.Column="1" Margin="0,2" HorizontalAlignment="Stretch"
                              ItemsSource="{Binding Relief2DHeightCurves}"
                              SelectedItem="{Binding Relief2DHeightCurve, Mode=TwoWay}" />

                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Edge fade:" VerticalAlignment="Center"
                               ToolTip.Tip="Ramp the height field to the base plane near each image edge so fractal structure that runs off the frame tapers out instead of forming streaky 'arms' at the border (seen when panned/zoomed). 0 = off." />
                    <Slider Grid.Row="6" Grid.Column="1" Minimum="0" Maximum="0.5" Margin="0,2"
                            Value="{Binding Relief2DEdgeFade, Mode=TwoWay}" />

                    <TextBlock Grid.Row="7" Grid.Column="0" Text="Field floor (px):" VerticalAlignment="Center"
                               IsEnabled="{Binding Relief2DHiResField}"
                               ToolTip.Tip="Short-axis pixel resolution the height field is computed at, independent of the window size (#143). At small windows the display-resolution field undersamples the fractal boundary into spiky needles; a higher floor makes every window match the maximized look, at extra escape-time compute on the base frame. Only applies when 'Hi-res height field' is on and the window is smaller than this." />
                    <NumericUpDown Grid.Row="7" Grid.Column="1"
                                   Minimum="480" Maximum="2160" Increment="120" FormatString="F0"
                                   IsEnabled="{Binding Relief2DHiResField}"
                                   Value="{Binding Relief2DFieldFloor, Mode=TwoWay}" Margin="0,2" />

                    <!-- Depth of field (roadmap S3, #389). Perspective only. -->
                    <TextBlock Grid.Row="8" Grid.Column="0" Text="DOF aperture:" VerticalAlignment="Center"
                               ToolTip.Tip="Thin-lens depth of field: lens radius. 0 = pinhole (everything sharp, byte-identical). Larger = shallower focus / stronger bokeh. Integrated over the anti-alias taps, so raise Anti-alias (N×N) for smoother blur. Perspective camera only." />
                    <NumericUpDown Grid.Row="8" Grid.Column="1"
                                   Minimum="0" Maximum="1" Increment="0.01" FormatString="F2"
                                   Value="{Binding Relief2DDofApertureRadius, Mode=TwoWay}" Margin="0,2" />

                    <TextBlock Grid.Row="9" Grid.Column="0" Text="DOF focus dist:" VerticalAlignment="Center"
                               IsEnabled="{Binding DofEnabled}"
                               ToolTip.Tip="World-space distance to the plane kept sharp. 0 = auto-focus on the fractal centre (the world origin). Only used when DOF aperture > 0." />
                    <NumericUpDown Grid.Row="9" Grid.Column="1"
                                   Minimum="0" Maximum="100" Increment="0.1" FormatString="F2"
                                   IsEnabled="{Binding DofEnabled}"
                                   Value="{Binding Relief2DDofFocusDistance, Mode=TwoWay}" Margin="0,2" />

                    <!-- Guided À-Trous denoise (roadmap S4, #389). Keyed on the
                         render's own float normal/depth AOVs. 0 passes = off. -->
                    <TextBlock Grid.Row="10" Grid.Column="0" Text="Denoise passes:" VerticalAlignment="Center"
                               ToolTip.Tip="Edge-avoiding À-Trous wavelet denoise over the relief image, guided by the render's own normal + depth passes. Pays down Monte-Carlo noise (AO / soft shadow / reflections) so you need fewer anti-alias samples for the same quality, while geometric edges stay crisp. 0 = off (byte-identical); each pass widens the filter footprint. Forces the CPU relief trace (the GPU kernel emits no guides yet)." />
                    <NumericUpDown Grid.Row="10" Grid.Column="1"
                                   Minimum="0" Maximum="8" Increment="1" FormatString="F0"
                                   Value="{Binding Relief2DDenoiseIterations, Mode=TwoWay}" Margin="0,2" />

                    <TextBlock Grid.Row="11" Grid.Column="0" Text="Denoise colour σ:" VerticalAlignment="Center"
                               IsEnabled="{Binding DenoiseEnabled}"
                               ToolTip.Tip="Colour edge-stop. Smaller keeps fainter colour edges sharp (less smoothing); larger blurs more. Only used when Denoise passes > 0." />
                    <NumericUpDown Grid.Row="11" Grid.Column="1"
                                   Minimum="0.001" Maximum="4" Increment="0.02" FormatString="F3"
                                   IsEnabled="{Binding DenoiseEnabled}"
                                   Value="{Binding Relief2DDenoiseColorSigma, Mode=TwoWay}" Margin="0,2" />

                    <TextBlock Grid.Row="12" Grid.Column="0" Text="Denoise normal σ:" VerticalAlignment="Center"
                               IsEnabled="{Binding DenoiseEnabled}"
                               ToolTip.Tip="Normal edge-stop — smaller keeps geometric creases crisp. Uses the captured normal pass. Only used when Denoise passes > 0." />
                    <NumericUpDown Grid.Row="12" Grid.Column="1"
                                   Minimum="0.001" Maximum="4" Increment="0.02" FormatString="F3"
                                   IsEnabled="{Binding DenoiseEnabled}"
                                   Value="{Binding Relief2DDenoiseNormalSigma, Mode=TwoWay}" Margin="0,2" />

                    <TextBlock Grid.Row="13" Grid.Column="0" Text="Denoise depth σ:" VerticalAlignment="Center"
                               IsEnabled="{Binding DenoiseEnabled}"
                               ToolTip.Tip="Depth edge-stop — smaller keeps silhouettes crisp. Uses the captured depth pass. Only used when Denoise passes > 0." />
                    <NumericUpDown Grid.Row="13" Grid.Column="1"
                                   Minimum="0.001" Maximum="4" Increment="0.02" FormatString="F3"
                                   IsEnabled="{Binding DenoiseEnabled}"
                                   Value="{Binding Relief2DDenoiseDepthSigma, Mode=TwoWay}" Margin="0,2" />
                </Grid>

                <CheckBox Content="Hi-res height field (window-independent quality)"
                          IsChecked="{Binding Relief2DHiResField, Mode=TwoWay}"
                          IsEnabled="{Binding Relief2DRaymarch}"
                          ToolTip.Tip="Compute the relief height field at the 'Field floor' resolution instead of the display size (#143), so shrinking the window no longer turns the terrain into a spiky needle-forest — every size matches the maximized look. Costs an extra escape-time field render on the base frame when the window is below the floor. No effect at or above the floor (e.g. maximized / Span)." />

                <CheckBox Content="Orthographic camera (no perspective stretch)"
                          IsChecked="{Binding Relief2DCameraOrthographic, Mode=TwoWay}"
                          IsEnabled="{Binding Relief2DRaymarch}"
                          ToolTip.Tip="Parallel projection instead of perspective — a clean relief-map look with no perspective distortion (which grows with frame-fill / FOV)." />
                <CheckBox Content="Base ground plane (grounds silhouette + catches shadows)"
                          IsChecked="{Binding Relief2DGroundPlane, Mode=TwoWay}"
                          IsEnabled="{Binding Relief2DRaymarch}"
                          ToolTip.Tip="Render a floor around the terrain so the fractal sits on the ground and cast shadows land on it, instead of a slab floating against the sky." />
                <CheckBox Content="Bicubic height sampling (smoother, slower)"
                          IsChecked="{Binding Relief2DBicubicHeight, Mode=TwoWay}"
                          IsEnabled="{Binding Relief2DRaymarch}"
                          ToolTip.Tip="Catmull-Rom height interpolation instead of bilinear — smoother terrain when zoomed in, at extra sample cost." />
                <CheckBox Content="Auto lighting defaults (AO / shadow / spec)"
                          IsChecked="{Binding Relief2DAutoShade, Mode=TwoWay}"
                          IsEnabled="{Binding Relief2DRaymarch}"
                          ToolTip.Tip="Fills sensible ambient-occlusion, soft-shadow and specular defaults for the 3D view whenever those Lighting FX knobs are still at zero. Any value you set explicitly in the Lighting FX dialog always wins." />
                <CheckBox Content="Froxel volumetrics (fog volume, not per-pixel march)"
                          IsChecked="{Binding Relief2DFroxelVolumetrics, Mode=TwoWay}"
                          IsEnabled="{Binding Relief2DRaymarch}"
                          ToolTip.Tip="Composite fog from a camera-frustum froxel volume built once, sampled per pixel by depth — instead of the per-pixel in-scatter march. Only affects a scene with fog (set Fog density in Lighting FX). Renders on the CPU." />
                <CheckBox Content="Temporal reprojection (stable animated fog)"
                          IsChecked="{Binding Relief2DFroxelTemporal, Mode=TwoWay}"
                          IsEnabled="{Binding Relief2DFroxelVolumetrics}"
                          ToolTip.Tip="Blend each frame's froxel volume with the previous one so drifting-noise / pulsing / moving-light fog reads as a stable volume across an animation instead of flickering. Only matters across a sequence (live animation / scene playback). Forces the CPU froxel post-pass." />
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="24,0,0,0"
                            IsEnabled="{Binding Relief2DFroxelTemporal}">
                    <TextBlock Text="Feedback" VerticalAlignment="Center" />
                    <Slider Width="140" Minimum="0" Maximum="0.99"
                            Value="{Binding Relief2DFroxelTemporalFeedback, Mode=TwoWay}"
                            ToolTip.Tip="Fraction of the previous frame kept each frame (higher = smoother but slower to react). Default 0.9." />
                    <TextBlock Text="{Binding Relief2DFroxelTemporalFeedback, StringFormat='{}{0:0.00}'}"
                               VerticalAlignment="Center" Width="36" />
                </StackPanel>
                </StackPanel>
                </Expander>

                <!-- #135 — isolate filaments as a standalone 3D object -->
                <CheckBox Content="Isolate object (drop background → transparent)"
                          IsChecked="{Binding Relief2DIsolate, Mode=TwoWay}"
                          IsEnabled="{Binding Relief2DRaymarch}"
                          ToolTip.Tip="Keep only the selected fractal structure as a standalone 3D object over a transparent background (exports as a cutout). Best paired with Show-sky-backdrop OFF (Lighting FX) and the base ground plane OFF." />
                <Expander Header="Isolation cull" HorizontalAlignment="Stretch"
                          IsExpanded="{Binding Relief2DIsolate, Mode=OneWay}"
                          IsEnabled="{Binding Relief2DIsolate}">
                <StackPanel Spacing="6">
                <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,Auto,Auto">
                    <CheckBox Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                              Content="Drop low-detail (keep filaments)"
                              IsChecked="{Binding Relief2DIsolateByDetail, Mode=TwoWay}"
                              ToolTip.Tip="Cull cells whose local surface detail (height gradient) is below the threshold — removes the flat background and smooth plateau, leaving the fine filaments." />
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Drop amount:" VerticalAlignment="Center"
                               ToolTip.Tip="Fraction of the flattest cells to remove (a quantile). Higher = drop more background, keeping only the sharpest filaments." />
                    <Slider Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="1" Margin="0,2"
                            Value="{Binding Relief2DDetailThreshold, Mode=TwoWay}"
                            IsEnabled="{Binding Relief2DIsolateByDetail}" />
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Detail level:" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="2" Grid.Column="1" VerticalAlignment="Center"
                               Text="{Binding Relief2DDetailThreshold, StringFormat={}{0:F2}}" />
                </Grid>
                <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,Auto,Auto">
                    <CheckBox Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                              Content="Drop colours"
                              IsChecked="{Binding Relief2DIsolateByColor, Mode=TwoWay}"
                              ToolTip.Tip="Also cull cells whose themed colour matches the listed colours within the tolerance." />
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Drop colours (hex):" VerticalAlignment="Center"
                               ToolTip.Tip="Comma-separated RGB or ARGB hex, e.g. FF102030, 405060. These colours are removed. Use Pick to eyedrop a colour from the screen." />
                    <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="*,Auto" Margin="0,2">
                        <TextBox Grid.Column="0" Watermark="FF102030, 405060"
                                 Text="{Binding Relief2DDropColorsCsv, Mode=TwoWay}"
                                 IsEnabled="{Binding Relief2DIsolateByColor}" />
                        <Button Grid.Column="1" Content="Pick" Margin="6,0,0,0"
                                Command="{Binding PickDropColorCommand}"
                                IsEnabled="{Binding Relief2DIsolate}"
                                ToolTip.Tip="Eyedrop a colour from anywhere on screen and add it to the drop list." />
                    </Grid>
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Colour tolerance:" VerticalAlignment="Center"
                               ToolTip.Tip="How close a cell colour must be to a drop colour to be removed. Higher = drops a wider range." />
                    <Slider Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="1" Margin="0,2"
                            Value="{Binding Relief2DColorTolerance, Mode=TwoWay}"
                            IsEnabled="{Binding Relief2DIsolateByColor}" />
                </Grid>
                </StackPanel>
                </Expander>

                <!-- #140 — Lighting & FX launcher (copied from the params panel)
                     so the shading knobs are reachable while editing Relief 3D. -->
                <Button Content="Open Lighting &amp; FX…"
                        Click="OnOpenLightingFxClick"
                        IsEnabled="{Binding Relief2DRaymarch}"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Padding="0,8" Margin="0,8,0,0"
                        Background="#283C50" Foreground="White"
                        ToolTip.Tip="Open the full Lighting / Shading / Post-process dialog (soft shadows, AO, PBR, IBL/HDRI, reflections, volumetric fog, sky backdrop)." />

                <!-- #138 — mesh export knobs -->
                <Expander Header="Mesh export" HorizontalAlignment="Stretch"
                          IsExpanded="False" Margin="0,8,0,0">
                <StackPanel Spacing="6">
                <Grid ColumnDefinitions="150,*,54" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Height:" VerticalAlignment="Center"
                               ToolTip.Tip="Relief (emboss) height of the exported mesh. Lower reads as a clean bas-relief from any angle; higher is more dramatic but spikier when viewed from the side. Independent of the on-screen 3D height." />
                    <Slider Grid.Row="0" Grid.Column="1" Minimum="0.02" Maximum="0.6" Margin="0,2"
                            Value="{Binding Relief2DMeshHeight, Mode=TwoWay}"
                            IsEnabled="{Binding Relief2DRaymarch}" />
                    <TextBlock Grid.Row="0" Grid.Column="2" VerticalAlignment="Center"
                               Text="{Binding Relief2DMeshHeight, StringFormat={}{0:F2}}" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Smoothing:" VerticalAlignment="Center"
                               ToolTip.Tip="0 = raw detail (spiky), 1 = heavy smoothing (despike + merge dendrites into a clean ridge). 0.5 is the tuned default." />
                    <Slider Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="1" Margin="0,2"
                            Value="{Binding Relief2DMeshSmoothing, Mode=TwoWay}"
                            IsEnabled="{Binding Relief2DRaymarch}" />
                    <TextBlock Grid.Row="1" Grid.Column="2" VerticalAlignment="Center"
                               Text="{Binding Relief2DMeshSmoothing, StringFormat={}{0:F2}}" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Detail (grid):" VerticalAlignment="Center"
                               ToolTip.Tip="Grid resolution on the longer axis. Higher = finer fractal detail AND a bigger file." />
                    <Slider Grid.Row="2" Grid.Column="1" Minimum="128" Maximum="1536" Margin="0,2"
                            TickFrequency="64" IsSnapToTickEnabled="True"
                            Value="{Binding Relief2DMeshGrid, Mode=TwoWay}"
                            IsEnabled="{Binding Relief2DRaymarch}" />
                    <TextBlock Grid.Row="2" Grid.Column="2" VerticalAlignment="Center"
                               Text="{Binding Relief2DMeshGrid}" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="File size cap (MB):" VerticalAlignment="Center"
                               ToolTip.Tip="Upper bound on the exported file. When above 0, the grid is clamped down so the estimate stays under this size. 0 = unlimited." />
                    <Slider Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="50" Margin="0,2"
                            TickFrequency="1" IsSnapToTickEnabled="True"
                            Value="{Binding Relief2DMeshMaxMB, Mode=TwoWay}"
                            IsEnabled="{Binding Relief2DRaymarch}" />
                    <TextBlock Grid.Row="3" Grid.Column="2" VerticalAlignment="Center"
                               Text="{Binding Relief2DMeshMaxMB, StringFormat={}{0:F0}}" />

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Underside:" VerticalAlignment="Center"
                               ToolTip.Tip="Contour the back of the mesh with the same (smoothed) relief instead of a flat base. 0 = flat back, 1 = the back bulges as deep as the top rises. No spikiness — it reuses the smoothed height field." />
                    <Slider Grid.Row="4" Grid.Column="1" Minimum="0" Maximum="1" Margin="0,2"
                            Value="{Binding Relief2DMeshUnderside, Mode=TwoWay}"
                            IsEnabled="{Binding Relief2DRaymarch}" />
                    <TextBlock Grid.Row="4" Grid.Column="2" VerticalAlignment="Center"
                               Text="{Binding Relief2DMeshUnderside, StringFormat={}{0:F2}}" />
                </Grid>
                <TextBlock HorizontalAlignment="Right" Opacity="0.75"
                           Text="{Binding Relief2DMeshSizeEstimate, StringFormat=Estimated size: {0}}" />
                <!-- Live "will this print?" verdict (roadmap S9, #391) — set from the
                     MeshValidator report after each export. -->
                <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" FontFamily="Consolas,monospace"
                           FontSize="11" Opacity="0.9"
                           Text="{Binding ReliefMeshPrintStatus}"
                           ToolTip.Tip="Print-readiness of the last relief mesh export: watertight / 2-manifold check from the mesh validator, plus size, volume and triangle count." />
                </StackPanel>
                </Expander>

                <!-- #138 — export the 3D object as a mesh -->
                <Button Content="Export mesh (OBJ / PLY / glTF / 3MF / STL)…"
                        Command="{Binding ExportReliefMeshCommand}"
                        IsEnabled="{Binding Relief2DRaymarch}"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Padding="0,8" Margin="0,4,0,0"
                        Background="#284C3C" Foreground="White"
                        ToolTip.Tip="Export the current Oblique 3D object as a watertight mesh (OBJ with vertex colour + smooth normals, or binary STL). Honours the mesh height / smoothing / detail knobs and the isolation cull." />
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" Margin="0,12,0,0">
            <!-- #305 — two-click reset of the Relief2D* look to defaults (the
                 Enable / raymarch mode toggles are preserved). -->
            <Button Grid.Column="0"
                    Content="{Binding Relief3DResetLabel}"
                    Classes.armed="{Binding Relief3DResetArmed}"
                    Command="{Binding ResetRelief3DCommand}"
                    Padding="14,6"
                    ToolTip.Tip="Reset the Relief 3D settings to sane defaults (keeps the Enable / Oblique-raymarch toggles). Click once to arm, again to confirm (destructive of your in-session tuning)." />
            <Button Grid.Column="2" Content="Close" Click="OnCloseClick" Padding="16,6" />
        </Grid>
    </Grid>
</UserControl>

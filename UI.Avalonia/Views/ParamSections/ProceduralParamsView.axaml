<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FracturingFog.UI.Avalonia.ViewModels"
             x:Class="FracturingFog.UI.Avalonia.Views.ParamSections.ProceduralParamsView"
             x:DataType="vm:FractalParamsViewModel">

    <!--
      Wave 5.8 — per-family extract of FractalParamsView. Procedural / stochastic
      families (own renderers). Sections IsVisible-gated on the shared VM.
    -->
    <StackPanel Spacing="6">

        <!-- IFS -->
        <Grid IsVisible="{Binding IsIFS}"
              ColumnDefinitions="160,*" RowDefinitions="Auto,Auto">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Preset:" VerticalAlignment="Center" />
            <ComboBox Grid.Row="0" Grid.Column="1"
                      ItemsSource="{Binding IfsPresets}"
                      SelectedItem="{Binding IfsPresetName, Mode=TwoWay}"
                      HorizontalAlignment="Stretch" Margin="0,2" />
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Iterations:" VerticalAlignment="Center" />
            <NumericUpDown Grid.Row="1" Grid.Column="1"
                           Minimum="100000" Maximum="20000000" Increment="100000" FormatString="N0"
                           Value="{Binding IfsIterations, Mode=TwoWay}" Margin="0,2" />
        </Grid>

        <!-- LSystem -->
        <StackPanel IsVisible="{Binding IsLSystem}" Spacing="6">
            <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,Auto">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Preset:" VerticalAlignment="Center" />
                <ComboBox Grid.Row="0" Grid.Column="1"
                          ItemsSource="{Binding LSystemPresets}"
                          SelectedItem="{Binding LSystemPresetName, Mode=TwoWay}"
                          HorizontalAlignment="Stretch" Margin="0,2" />
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Depth:" VerticalAlignment="Center" />
                <NumericUpDown Grid.Row="1" Grid.Column="1"
                               Minimum="0" Maximum="12" Increment="1" FormatString="F0"
                               Value="{Binding LSystemDepth, Mode=TwoWay}" Margin="0,2" />
            </Grid>

            <!-- Depth sweep: ramps Depth across its range like Adaptive sweep. -->
            <Border BorderBrush="#404040" BorderThickness="0,1,0,0" Padding="0,6,0,0" Margin="0,4,0,0">
                <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,Auto,Auto,Auto">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Sweep mode:" VerticalAlignment="Center" />
                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="10">
                        <RadioButton GroupName="LSysDepthSweepMode"
                                     Content="Forward"
                                     IsChecked="{Binding IsLSystemForwardMode, Mode=TwoWay}" />
                        <RadioButton GroupName="LSysDepthSweepMode"
                                     Content="Reverse"
                                     IsChecked="{Binding IsLSystemReverseMode, Mode=TwoWay}" />
                        <RadioButton GroupName="LSysDepthSweepMode"
                                     Content="Ping-Pong"
                                     IsChecked="{Binding IsLSystemPingPongMode, Mode=TwoWay}" />
                    </StackPanel>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Duration (s):" VerticalAlignment="Center" />
                    <NumericUpDown Grid.Row="1" Grid.Column="1"
                                   Minimum="0.25" Maximum="600" Increment="0.25" FormatString="F2"
                                   Value="{Binding LSystemSweepDurationSeconds, Mode=TwoWay}" Margin="0,2" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Loop:" VerticalAlignment="Center" />
                    <CheckBox Grid.Row="2" Grid.Column="1"
                              IsChecked="{Binding LSystemSweepLoop, Mode=TwoWay}"
                              Content="Repeat until stopped" />

                    <Button Grid.Row="3" Grid.Column="1"
                            Content="{Binding LSystemSweepButtonLabel}"
                            Command="{Binding ToggleLSystemSweepCommand}"
                            HorizontalAlignment="Stretch"
                            Margin="0,4,0,0" />
                </Grid>
            </Border>
        </StackPanel>

        <!-- Strange Attractor -->
        <Grid IsVisible="{Binding IsStrangeAttractor}"
              ColumnDefinitions="160,*"
              RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Preset:" VerticalAlignment="Center" />
            <ComboBox Grid.Row="0" Grid.Column="1"
                      ItemsSource="{Binding AttractorPresets}"
                      SelectedItem="{Binding AttractorPresetName, Mode=TwoWay}"
                      HorizontalAlignment="Stretch" Margin="0,2" />
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Iterations:" VerticalAlignment="Center" />
            <NumericUpDown Grid.Row="1" Grid.Column="1"
                           Minimum="100000" Maximum="20000000" Increment="100000" FormatString="N0"
                           Value="{Binding AttractorIterations, Mode=TwoWay}" Margin="0,2" />
            <TextBlock Grid.Row="2" Grid.Column="0" Text="a:" VerticalAlignment="Center" />
            <NumericUpDown Grid.Row="2" Grid.Column="1"
                           Minimum="-3" Maximum="3" Increment="0.01" FormatString="F4"
                           Value="{Binding AttractorA, Mode=TwoWay}" Margin="0,2" />
            <TextBlock Grid.Row="3" Grid.Column="0" Text="b:" VerticalAlignment="Center" />
            <NumericUpDown Grid.Row="3" Grid.Column="1"
                           Minimum="-3" Maximum="3" Increment="0.01" FormatString="F4"
                           Value="{Binding AttractorB, Mode=TwoWay}" Margin="0,2" />
            <TextBlock Grid.Row="4" Grid.Column="0" Text="c:" VerticalAlignment="Center" />
            <NumericUpDown Grid.Row="4" Grid.Column="1"
                           Minimum="-3" Maximum="3" Increment="0.01" FormatString="F4"
                           Value="{Binding AttractorC, Mode=TwoWay}" Margin="0,2" />
            <TextBlock Grid.Row="5" Grid.Column="0" Text="d:" VerticalAlignment="Center" />
            <NumericUpDown Grid.Row="5" Grid.Column="1"
                           Minimum="-3" Maximum="3" Increment="0.01" FormatString="F4"
                           Value="{Binding AttractorD, Mode=TwoWay}" Margin="0,2" />
        </Grid>

        <!-- BuddhaBrot / Nebulabrot / Anti-* family -->
        <Grid IsVisible="{Binding IsBuddhaBrot}"
              ColumnDefinitions="160,*"
              RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Samples:" VerticalAlignment="Center" />
            <NumericUpDown Grid.Row="0" Grid.Column="1"
                           Minimum="50000" Maximum="50000000" Increment="50000" FormatString="N0"
                           Value="{Binding BuddhaSamples, Mode=TwoWay}" Margin="0,2" />
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Iter low:" VerticalAlignment="Center" />
            <NumericUpDown Grid.Row="1" Grid.Column="1"
                           Minimum="50" Maximum="100000" Increment="50" FormatString="F0"
                           Value="{Binding BuddhaIterLow, Mode=TwoWay}" Margin="0,2" />
            <TextBlock Grid.Row="2" Grid.Column="0" Text="Iter mid:" VerticalAlignment="Center" />
            <NumericUpDown Grid.Row="2" Grid.Column="1"
                           Minimum="100" Maximum="200000" Increment="100" FormatString="F0"
                           Value="{Binding BuddhaIterMid, Mode=TwoWay}" Margin="0,2" />
            <TextBlock Grid.Row="3" Grid.Column="0" Text="Iter high:" VerticalAlignment="Center" />
            <NumericUpDown Grid.Row="3" Grid.Column="1"
                           Minimum="500" Maximum="500000" Increment="500" FormatString="F0"
                           Value="{Binding BuddhaIterHigh, Mode=TwoWay}" Margin="0,2" />
            <!-- #836 — Color mode is now decided by the fractal TYPE
                 (Buddhabrot/AntiBuddhabrot = single-channel ColorMap;
                 Nebulabrot/AntiNebulabrot = RGB NebulabrotBands), so the four
                 types cover the whole escape×composite matrix and this override
                 combo is redundant. Hidden to avoid an inert control; the
                 binding stays so nothing else breaks. -->
            <TextBlock Grid.Row="4" Grid.Column="0" Text="Color mode:" VerticalAlignment="Center"
                       IsVisible="False" />
            <ComboBox  Grid.Row="4" Grid.Column="1"
                       ItemsSource="{Binding BuddhaColorModes}"
                       SelectedItem="{Binding BuddhaColorMode, Mode=TwoWay}"
                       Margin="0,2"
                       IsVisible="False" />
            <TextBlock Grid.Row="5" Grid.Column="0" Text="Quality:" VerticalAlignment="Center" />
            <ComboBox  Grid.Row="5" Grid.Column="1"
                       ItemsSource="{Binding BuddhaQualityModes}"
                       SelectedItem="{Binding BuddhaQualityMode, Mode=TwoWay}"
                       Margin="0,2"
                       ToolTip.Tip="HighDefinition = bilinear splat + real-axis mirror + joint norm + noise-floor reject. Slower but smoother." />
            <CheckBox Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2"
                      Content="Metropolis-Hastings sampling"
                      IsChecked="{Binding BuddhaMetropolis, Mode=TwoWay}"
                      Margin="0,2"
                      ToolTip.Tip="Importance sampling: concentrates samples on c values whose orbits hit the viewport. Big gain when zoomed in." />
            <CheckBox Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2"
                      Content="Progressive accumulation"
                      IsChecked="{Binding BuddhaProgressive, Mode=TwoWay}"
                      Margin="0,2"
                      ToolTip.Tip="Composites image in 8 chunks. Cancel mid-render keeps a usable partial result." />
            <TextBlock Grid.Row="8" Grid.Column="0" Text="Seed:" VerticalAlignment="Center" />
            <NumericUpDown Grid.Row="8" Grid.Column="1"
                           Minimum="0" Maximum="2147483647" Increment="1" FormatString="F0"
                           Value="{Binding BuddhaSeed, Mode=TwoWay}" Margin="0,2"
                           ToolTip.Tip="Deterministic Monte Carlo seed. Fixed seed = identical image on every re-render (no morph when unrelated settings change). Change it to draw a different but reproducible sampling." />
            <CheckBox Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="2"
                      Content="Auto zoom-detail compensation"
                      IsChecked="{Binding BuddhaZoomCompensation, Mode=TwoWay}"
                      Margin="0,2"
                      ToolTip.Tip="When zoomed in, scale the sample budget with zoom (up to 64×) so the viewport stays populated instead of going dark/grainy. Past zoom 100 it also turns on Metropolis sampling (Dual Buddhabrot: past zoom 1.2). No effect when zoomed out." />
            <TextBlock Grid.Row="11" Grid.Column="0" Text="Min escape iter:" VerticalAlignment="Center" />
            <NumericUpDown Grid.Row="11" Grid.Column="1"
                           Minimum="0" Maximum="10000" Increment="1" FormatString="F0"
                           Value="{Binding BuddhaMinIter, Mode=TwoWay}" Margin="0,2"
                           ToolTip.Tip="Orbits that escape in fewer steps are not drawn. Removes the flat haze the fast escapers lay over the |c| &lt;= 2 disc. 0 = draw every orbit. Ignored by the Anti types (they draw bounded orbits)." />
            <CheckBox Grid.Row="12" Grid.Column="0" Grid.ColumnSpan="2"
                      Content="Scale samples with window size"
                      IsChecked="{Binding BuddhaScaleSamplesWithWindow, Mode=TwoWay}"
                      Margin="0,2"
                      ToolTip.Tip="Samples is the budget for a 640×480 frame. A larger window or export samples proportionally more, so it is as bright and smooth as the preview (and takes proportionally longer). Off = the same Samples at every size." />
            <TextBlock Grid.Row="10" Grid.Column="0" Grid.ColumnSpan="2"
                       Text="This is a 2D density plot — zooming shows more samples of the same statistical structure, not new boundary detail like the Mandelbrot set. Raise Samples (or zoom-compensation) if a zoomed view looks sparse."
                       TextWrapping="Wrap" FontSize="11" Opacity="0.7" Margin="0,4,0,0" />
        </Grid>

        <!-- Dual Buddhabrot (#1124) — extra rows under the shared sampler rows -->
        <Grid IsVisible="{Binding IsDualBuddhabrot}"
              ColumnDefinitions="160,*"
              RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="c-seed real:" VerticalAlignment="Center" Margin="0,8,0,2" />
            <NumericUpDown Grid.Row="0" Grid.Column="1"
                           Minimum="-2" Maximum="2" Increment="0.02" FormatString="F3"
                           Value="{Binding DualBuddhaCSeedX, Mode=TwoWay}" Margin="0,8,0,2"
                           ToolTip.Tip="Seed of the second (c) orbit. Each sample s runs the classic z-orbit from 0 AND a c-orbit from this seed. Sweeping it re-textures the c channels while the Z channel (classic Buddhabrot) stays put. 0 = degenerate (c-orbit = z-orbit)." />
            <TextBlock Grid.Row="1" Grid.Column="0" Text="c-seed imag:" VerticalAlignment="Center" />
            <NumericUpDown Grid.Row="1" Grid.Column="1"
                           Minimum="-2" Maximum="2" Increment="0.02" FormatString="F3"
                           Value="{Binding DualBuddhaCSeedY, Mode=TwoWay}" Margin="0,2"
                           ToolTip.Tip="Imaginary part of the c-seed. Non-zero breaks the up/down symmetry of the c channels (HD mirror sampling is switched off for them)." />
            <TextBlock Grid.Row="2" Grid.Column="0" Text="Min escape iter:" VerticalAlignment="Center" />
            <NumericUpDown Grid.Row="2" Grid.Column="1"
                           Minimum="0" Maximum="10000" Increment="1" FormatString="F0"
                           Value="{Binding DualBuddhaMinIter, Mode=TwoWay}" Margin="0,2"
                           ToolTip.Tip="Orbits that escape in fewer steps are not drawn. Removes the flat wash from fast escapers. 0 = classic Buddhabrot behaviour." />
            <TextBlock Grid.Row="3" Grid.Column="0" Text="Composite:" VerticalAlignment="Center" />
            <ComboBox Grid.Row="3" Grid.Column="1"
                      ItemsSource="{Binding DualBuddhaComposites}"
                      SelectedItem="{Binding DualBuddhaComposite, Mode=TwoWay}" Margin="0,2"
                      ToolTip.Tip="Channels = each outcome in its own colour, normalised separately (the c-escaped / z-bounded filaments stay visible). Theme = the weighted total through the active colour theme." />
            <TextBlock Grid.Row="4" Grid.Column="0" Text="Z colour (classic):" VerticalAlignment="Center"
                       IsVisible="{Binding IsDualBuddhaChannels}" />
            <TextBox Grid.Row="4" Grid.Column="1" Margin="0,2"
                     Text="{Binding DualBuddhaColorZHex, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                     IsVisible="{Binding IsDualBuddhaChannels}"
                     ToolTip.Tip="AARRGGBB hex. Z channel = z-orbits that escape — the classic Buddhabrot." />
            <TextBlock Grid.Row="5" Grid.Column="0" Text="CB colour (c esc, z bnd):" VerticalAlignment="Center"
                       IsVisible="{Binding IsDualBuddhaChannels}" />
            <TextBox Grid.Row="5" Grid.Column="1" Margin="0,2"
                     Text="{Binding DualBuddhaColorCBHex, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                     IsVisible="{Binding IsDualBuddhaChannels}"
                     ToolTip.Tip="AARRGGBB hex. CB channel = c-orbits that escape while the z-orbit stays bounded (s inside the Mandelbrot set) — the structure the classic Buddhabrot cannot show." />
            <TextBlock Grid.Row="6" Grid.Column="0" Text="CE colour (both esc):" VerticalAlignment="Center"
                       IsVisible="{Binding IsDualBuddhaChannels}" />
            <TextBox Grid.Row="6" Grid.Column="1" Margin="0,2"
                     Text="{Binding DualBuddhaColorCEHex, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                     IsVisible="{Binding IsDualBuddhaChannels}"
                     ToolTip.Tip="AARRGGBB hex. CE channel = c-orbits where both orbits escape." />
            <TextBlock Grid.Row="7" Grid.Column="0" Text="Z gain:" VerticalAlignment="Center" />
            <NumericUpDown Grid.Row="7" Grid.Column="1"
                           Minimum="0" Maximum="4" Increment="0.1" FormatString="F2"
                           Value="{Binding DualBuddhaGainZ, Mode=TwoWay}" Margin="0,2"
                           ToolTip.Tip="Channel weight. 0 hides the channel. Re-composites without re-sampling." />
            <TextBlock Grid.Row="8" Grid.Column="0" Text="CB gain:" VerticalAlignment="Center" />
            <NumericUpDown Grid.Row="8" Grid.Column="1"
                           Minimum="0" Maximum="4" Increment="0.1" FormatString="F2"
                           Value="{Binding DualBuddhaGainCB, Mode=TwoWay}" Margin="0,2" />
            <TextBlock Grid.Row="9" Grid.Column="0" Text="CE gain:" VerticalAlignment="Center" />
            <NumericUpDown Grid.Row="9" Grid.Column="1"
                           Minimum="0" Maximum="4" Increment="0.1" FormatString="F2"
                           Value="{Binding DualBuddhaGainCE, Mode=TwoWay}" Margin="0,2" />
            <TextBlock Grid.Row="10" Grid.Column="0" Grid.ColumnSpan="2"
                       Text="Iter high is the orbit cap. Iter low / mid only matter for the outcome Nebulabrot below (they split one outcome into three bands)."
                       TextWrapping="Wrap" FontSize="11" Opacity="0.7" Margin="0,4,0,0" />
            <TextBlock Grid.Row="11" Grid.Column="0" Text="c deposit:" VerticalAlignment="Center" />
            <ComboBox Grid.Row="11" Grid.Column="1"
                      ItemsSource="{Binding DualBuddhaDeposits}"
                      SelectedItem="{Binding DualBuddhaDeposit, Mode=TwoWay}" Margin="0,2"
                      ToolTip.Tip="What the c channels draw. Orbits = the c-orbit's path. Midpoint = the point half-way between the two orbits each step. PairChord = a random point on the line joining them each step (string art). EscapeLocation = only where each orbit leaves the radius-2 disc — zoom out to see it." />
            <TextBlock Grid.Row="12" Grid.Column="0" Text="Outcome Nebulabrot:" VerticalAlignment="Center" />
            <ComboBox Grid.Row="12" Grid.Column="1"
                      ItemsSource="{Binding DualBuddhaNebulas}"
                      SelectedItem="{Binding DualBuddhaNebula, Mode=TwoWay}" Margin="0,2"
                      ToolTip.Tip="Off = the three outcome channels. Z / CB / CE = draw only that outcome, split by how many steps the orbit took to escape into three bands (below Iter low, below Iter mid, the rest), shown in the three channel colours." />
            <CheckBox Grid.Row="13" Grid.Column="0" Grid.ColumnSpan="2"
                      Content="Anti (bounded orbits)"
                      IsChecked="{Binding DualBuddhaAnti, Mode=TwoWay}" Margin="0,2"
                      ToolTip.Tip="Draw the orbits that never escape instead: channel 1 = the z-orbit where only the c-orbit escapes, channel 2 = the c-orbit where both stay bounded, channel 3 = the z-orbit there. Slow (bounded orbits run to Iter high). Overrides the deposit and Nebulabrot choices." />
        </Grid>

        <!-- Plasma -->
        <Grid IsVisible="{Binding IsPlasma}"
              ColumnDefinitions="160,*"
              RowDefinitions="Auto,Auto">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Roughness:" VerticalAlignment="Center" />
            <NumericUpDown Grid.Row="0" Grid.Column="1"
                           Minimum="0.0" Maximum="1.0" Increment="0.05" FormatString="F2"
                           Value="{Binding PlasmaRoughness, Mode=TwoWay}" Margin="0,2"
                           ToolTip.Tip="Per-subdivision displacement decay. 0 = smooth gradient, 1 = full amplitude (jagged)." />
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Seed:" VerticalAlignment="Center" />
            <NumericUpDown Grid.Row="1" Grid.Column="1"
                           Minimum="-2147483648" Maximum="2147483647" Increment="1" FormatString="F0"
                           Value="{Binding PlasmaSeed, Mode=TwoWay}" Margin="0,2"
                           ToolTip.Tip="PRNG seed — same seed + roughness + size = identical field." />
        </Grid>

        <!-- Acid Warp (#247) -->
        <Grid IsVisible="{Binding IsAcidWarp}"
              ColumnDefinitions="160,*"
              RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Pattern:" VerticalAlignment="Center" />
            <NumericUpDown Grid.Row="0" Grid.Column="1"
                           Minimum="0" Maximum="{Binding AcidWarpPatternMax}" Increment="1" FormatString="F0"
                           Value="{Binding AcidWarpPattern, Mode=TwoWay}" Margin="0,2"
                           ToolTip.Tip="Pattern selector: rings, spokes, spirals, interference, plaid, XOR moire, rose, value-noise." />
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Frequency:" VerticalAlignment="Center" />
            <NumericUpDown Grid.Row="1" Grid.Column="1"
                           Minimum="0.1" Maximum="8.0" Increment="0.1" FormatString="F2"
                           Value="{Binding AcidWarpFrequency, Mode=TwoWay}" Margin="0,2"
                           ToolTip.Tip="Ring / wave / spoke density." />
            <TextBlock Grid.Row="2" Grid.Column="0" Text="Center X:" VerticalAlignment="Center" />
            <NumericUpDown Grid.Row="2" Grid.Column="1"
                           Minimum="-2.0" Maximum="2.0" Increment="0.05" FormatString="F2"
                           Value="{Binding AcidWarpCenterX, Mode=TwoWay}" Margin="0,2"
                           ToolTip.Tip="Pattern focus X in normalised units (0 = screen centre)." />
            <TextBlock Grid.Row="3" Grid.Column="0" Text="Center Y:" VerticalAlignment="Center" />
            <NumericUpDown Grid.Row="3" Grid.Column="1"
                           Minimum="-2.0" Maximum="2.0" Increment="0.05" FormatString="F2"
                           Value="{Binding AcidWarpCenterY, Mode=TwoWay}" Margin="0,2"
                           ToolTip.Tip="Pattern focus Y in normalised units (0 = screen centre)." />
            <TextBlock Grid.Row="4" Grid.Column="0" Text="Seed:" VerticalAlignment="Center" />
            <NumericUpDown Grid.Row="4" Grid.Column="1"
                           Minimum="-2147483648" Maximum="2147483647" Increment="1" FormatString="F0"
                           Value="{Binding AcidWarpSeed, Mode=TwoWay}" Margin="0,2"
                           ToolTip.Tip="PRNG seed for the stochastic value-noise pattern." />
            <TextBlock Grid.Row="5" Grid.Column="0" Text="Warp:" VerticalAlignment="Center" />
            <NumericUpDown Grid.Row="5" Grid.Column="1"
                           Minimum="0" Maximum="2" Increment="0.05" FormatString="F2"
                           Value="{Binding AcidWarpWarpStrength, Mode=TwoWay}" Margin="0,2"
                           ToolTip.Tip="#253 — domain warp: fold straight rings/waves into organic swirls. 0 = off." />
            <TextBlock Grid.Row="6" Grid.Column="0" Text="Morph:" VerticalAlignment="Center" />
            <CheckBox Grid.Row="6" Grid.Column="1"
                      IsChecked="{Binding AcidWarpMorph, Mode=TwoWay}" Margin="0,2"
                      Content="Blend adjacent patterns (animate Flow)"
                      ToolTip.Tip="Continuous morph: blends the base and next pattern in field space so animating Flow melts smoothly between patterns instead of hard-cutting. Off = discrete Pattern pick (byte-identical)." />
            <TextBlock Grid.Row="7" Grid.Column="0" Text="Flow:" VerticalAlignment="Center" />
            <NumericUpDown Grid.Row="7" Grid.Column="1"
                           IsEnabled="{Binding AcidWarpMorph}"
                           Minimum="0" Maximum="{Binding AcidWarpFlowMax}" Increment="0.1" FormatString="F2"
                           Value="{Binding AcidWarpFlow, Mode=TwoWay}" Margin="0,2"
                           ToolTip.Tip="Continuous pattern position — integer part picks the base pattern, fraction blends toward the next. Animate 0 → pattern-count for an endless morph. Needs Morph on." />
        </Grid>

        <!-- Flame -->
        <Grid IsVisible="{Binding IsFlame}"
              ColumnDefinitions="160,*"
              RowDefinitions="Auto,Auto,Auto,Auto">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Preset:" VerticalAlignment="Center" />
            <ComboBox Grid.Row="0" Grid.Column="1"
                      ItemsSource="{Binding FlamePresets}"
                      SelectedItem="{Binding FlamePresetName, Mode=TwoWay}"
                      Margin="0,2"
                      ToolTip.Tip="Built-in Apophysis-style flame map table." />
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Iterations:" VerticalAlignment="Center" />
            <NumericUpDown Grid.Row="1" Grid.Column="1"
                           Minimum="100000" Maximum="100000000" Increment="500000" FormatString="F0"
                           Value="{Binding FlameIterations, Mode=TwoWay}" Margin="0,2"
                           ToolTip.Tip="Chaos-game sample count. Density quality scales with √N." />
            <TextBlock Grid.Row="2" Grid.Column="0" Text="Gamma:" VerticalAlignment="Center" />
            <NumericUpDown Grid.Row="2" Grid.Column="1"
                           Minimum="0.5" Maximum="5.0" Increment="0.1" FormatString="F2"
                           Value="{Binding FlameGamma, Mode=TwoWay}" Margin="0,2"
                           ToolTip.Tip="Tone-map gamma. 2.2 = Apophysis default. Lower = punchier highlights." />
            <TextBlock Grid.Row="3" Grid.Column="0" Text="Vibrancy:" VerticalAlignment="Center" />
            <NumericUpDown Grid.Row="3" Grid.Column="1"
                           Minimum="0.0" Maximum="1.0" Increment="0.05" FormatString="F2"
                           Value="{Binding FlameVibrancy, Mode=TwoWay}" Margin="0,2"
                           ToolTip.Tip="Highlight saturation 0..1. 0 = linear, 1 = full gamma-on-colour." />
        </Grid>

        <!-- DLA -->
        <Grid IsVisible="{Binding IsDla}"
              ColumnDefinitions="160,*"
              RowDefinitions="Auto,Auto">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Particles:" VerticalAlignment="Center" />
            <NumericUpDown Grid.Row="0" Grid.Column="1"
                           Minimum="100" Maximum="500000" Increment="500" FormatString="F0"
                           Value="{Binding DlaParticles, Mode=TwoWay}" Margin="0,2"
                           ToolTip.Tip="Random-walk particles launched into the aggregate. Higher = denser tree, slower render." />
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Seed:" VerticalAlignment="Center" />
            <NumericUpDown Grid.Row="1" Grid.Column="1"
                           Minimum="-2147483648" Maximum="2147483647" Increment="1" FormatString="F0"
                           Value="{Binding DlaSeed, Mode=TwoWay}" Margin="0,2"
                           ToolTip.Tip="PRNG seed — same seed + particles + canvas size = identical tree." />
        </Grid>

        <!-- Apollonian -->
        <Grid IsVisible="{Binding IsApollonian}"
              ColumnDefinitions="160,*"
              RowDefinitions="Auto,Auto,Auto,Auto">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Depth:" VerticalAlignment="Center" />
            <NumericUpDown Grid.Row="0" Grid.Column="1"
                           Minimum="0" Maximum="40" Increment="1" FormatString="F0"
                           Value="{Binding ApollonianDepth, Mode=TwoWay}" Margin="0,2"
                           ToolTip.Tip="Maximum Vieta-jump recursion depth. Pixel cutoff usually fires first; raise only when zoomed deep." />
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Min px radius:" VerticalAlignment="Center" />
            <NumericUpDown Grid.Row="1" Grid.Column="1"
                           Minimum="0.25" Maximum="16.0" Increment="0.25" FormatString="F2"
                           Value="{Binding ApollonianMinPixelRadius, Mode=TwoWay}" Margin="0,2"
                           ToolTip.Tip="Stop recursing when the next circle would draw smaller than this many device pixels." />
            <TextBlock Grid.Row="2" Grid.Column="0" Text="Colour by depth:" VerticalAlignment="Center" />
            <CheckBox Grid.Row="2" Grid.Column="1"
                      IsChecked="{Binding ApollonianColorByDepth, Mode=TwoWay}" Margin="0,2"
                      ToolTip.Tip="On = palette indexed by recursion depth (banded). Off = log(radius) gradient (smooth)." />
            <TextBlock Grid.Row="3" Grid.Column="0" Text="3D relief:" VerticalAlignment="Center" />
            <NumericUpDown Grid.Row="3" Grid.Column="1"
                           Minimum="0.0" Maximum="4.0" Increment="0.1" FormatString="F1"
                           Value="{Binding ApollonianRelief, Mode=TwoWay}" Margin="0,2"
                           ToolTip.Tip="Dome curvature for 3D (normal-mapped) themes: each circle is lit as a sphere. 0 = flat discs; 1 = full hemisphere. Ignored by flat 2D themes." />
        </Grid>

        <!-- Random Tiling (Bourke) -->
        <Grid IsVisible="{Binding IsRandomTile}"
              ColumnDefinitions="160,*"
              RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
            <TextBlock Grid.Row="7" Grid.Column="0" Text="Shape:" VerticalAlignment="Center" />
            <ComboBox Grid.Row="7" Grid.Column="1"
                      ItemsSource="{Binding RandomTileShapes}"
                      SelectedItem="{Binding RandomTileShape, Mode=TwoWay}"
                      Margin="0,2"
                      ToolTip.Tip="Tile shape. Square / Triangle are inscribed in the placement radius with a random rotation; all shapes carry the same domed relief." />
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Shapes:" VerticalAlignment="Center" />
            <NumericUpDown Grid.Row="0" Grid.Column="1"
                           Minimum="1" Maximum="200000" Increment="500" FormatString="F0"
                           Value="{Binding RandomTileCount, Mode=TwoWay}" Margin="0,2"
                           ToolTip.Tip="Maximum shapes to place. Placement also stops when the power-law radius drops below the min-px floor." />
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Size exponent (α):" VerticalAlignment="Center" />
            <NumericUpDown Grid.Row="1" Grid.Column="1"
                           Minimum="0.2" Maximum="6.0" Increment="0.1" FormatString="F2"
                           Value="{Binding RandomTileSizeExponent, Mode=TwoWay}" Margin="0,2"
                           ToolTip.Tip="Size falloff. Larger = a few big shapes plus a heavy tail of tiny ones; smaller = more uniform sizes." />
            <TextBlock Grid.Row="2" Grid.Column="0" Text="Seed:" VerticalAlignment="Center" />
            <NumericUpDown Grid.Row="2" Grid.Column="1"
                           Minimum="-2147483648" Maximum="2147483647" Increment="1" FormatString="F0"
                           Value="{Binding RandomTileSeed, Mode=TwoWay}" Margin="0,2"
                           ToolTip.Tip="PRNG seed — same seed + settings + canvas size = identical tiling." />
            <TextBlock Grid.Row="3" Grid.Column="0" Text="Gap:" VerticalAlignment="Center" />
            <NumericUpDown Grid.Row="3" Grid.Column="1"
                           Minimum="0.0" Maximum="2.0" Increment="0.05" FormatString="F2"
                           Value="{Binding RandomTileGap, Mode=TwoWay}" Margin="0,2"
                           ToolTip.Tip="Margin between shapes as a fraction of the candidate radius. 0 = shapes may kiss; higher = looser packing." />
            <TextBlock Grid.Row="4" Grid.Column="0" Text="Min px radius:" VerticalAlignment="Center" />
            <NumericUpDown Grid.Row="4" Grid.Column="1"
                           Minimum="0.25" Maximum="16.0" Increment="0.25" FormatString="F2"
                           Value="{Binding RandomTileMinPixelRadius, Mode=TwoWay}" Margin="0,2"
                           ToolTip.Tip="Stop placing when the next radius would draw smaller than this many device pixels." />
            <TextBlock Grid.Row="5" Grid.Column="0" Text="Colour by index:" VerticalAlignment="Center" />
            <CheckBox Grid.Row="5" Grid.Column="1"
                      IsChecked="{Binding RandomTileColorByIndex, Mode=TwoWay}" Margin="0,2"
                      ToolTip.Tip="On = palette swept across placement order (big → small). Off = log(radius) gradient." />
            <TextBlock Grid.Row="6" Grid.Column="0" Text="3D relief:" VerticalAlignment="Center" />
            <NumericUpDown Grid.Row="6" Grid.Column="1"
                           Minimum="0.0" Maximum="4.0" Increment="0.1" FormatString="F1"
                           Value="{Binding RandomTileRelief, Mode=TwoWay}" Margin="0,2"
                           ToolTip.Tip="Dome curvature for 3D (normal-mapped) themes: each shape is lit as a sphere. 0 = flat discs; 1 = full hemisphere. Ignored by flat 2D themes." />
        </Grid>

        <!-- Indra's Pearls (2D Möbius-group limit set, #893) -->
        <StackPanel IsVisible="{Binding IsIndrasPearls}" Spacing="4">
            <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Preset:" VerticalAlignment="Center" />
                <ComboBox Grid.Row="0" Grid.Column="1"
                          ItemsSource="{Binding IndrasPresets}"
                          SelectedItem="{Binding SelectedIndrasPreset, Mode=TwoWay}"
                          Margin="0,2"
                          ToolTip.Tip="Canned group. Selecting one fills the family + parameters below (the apple, a Cantor set, a double-cusp group, …). MSW plates." />
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Family:" VerticalAlignment="Center" />
                <ComboBox Grid.Row="1" Grid.Column="1"
                          ItemsSource="{Binding IndrasFamilies}"
                          SelectedItem="{Binding IndrasFamily, Mode=TwoWay}"
                          Margin="0,2"
                          ToolTip.Tip="Two-generator family: Maskit slice (single μ), Grandma's recipe (traces ta, tb), or Riley slice (single c)." />
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Word depth:" VerticalAlignment="Center" />
                <NumericUpDown Grid.Row="2" Grid.Column="1"
                               Minimum="2" Maximum="16" Increment="1" FormatString="F0"
                               Value="{Binding IndrasMaxWordDepth, Mode=TwoWay}" Margin="0,2"
                               ToolTip.Tip="Reduced-word enumeration depth. Higher = finer limit set; word count grows ~3× per level." />
                <TextBlock Grid.Row="3" Grid.Column="0" Text="Render mode:" VerticalAlignment="Center" />
                <ComboBox Grid.Row="3" Grid.Column="1"
                          ItemsSource="{Binding IndrasRenderModes}"
                          SelectedItem="{Binding IndrasRenderMode, Mode=TwoWay}"
                          Margin="0,2"
                          ToolTip.Tip="PointCloud = BFS density plot. CurveTrace = crisp limit curve (S3)." />
                <TextBlock Grid.Row="4" Grid.Column="0" Text="Colour by:" VerticalAlignment="Center" />
                <ComboBox Grid.Row="4" Grid.Column="1"
                          ItemsSource="{Binding IndrasColorSources}"
                          SelectedItem="{Binding IndrasColorSource, Mode=TwoWay}"
                          Margin="0,2"
                          ToolTip.Tip="What drives the palette: Density (hit count), WordLength (enumeration depth), LastGenerator (a/A/b/B bands) or Parity (generator vs inverse)." />
            </Grid>

            <!-- Maskit μ -->
            <Grid IsVisible="{Binding IsIndrasMaskit}" ColumnDefinitions="160,*" RowDefinitions="Auto,Auto">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Maskit μ (real):" VerticalAlignment="Center" />
                <NumericUpDown Grid.Row="0" Grid.Column="1"
                               Minimum="-8" Maximum="8" Increment="0.05" FormatString="F3"
                               Value="{Binding IndrasMaskitMuRe, Mode=TwoWay}" Margin="0,2"
                               ToolTip.Tip="Real part of the Maskit parameter μ. a: z ↦ μ + 1/z." />
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Maskit μ (imag):" VerticalAlignment="Center" />
                <NumericUpDown Grid.Row="1" Grid.Column="1"
                               Minimum="-8" Maximum="8" Increment="0.05" FormatString="F3"
                               Value="{Binding IndrasMaskitMuIm, Mode=TwoWay}" Margin="0,2"
                               ToolTip.Tip="Imag part of μ. μ = 2i is the classic 'apple' (a parabolic)." />
            </Grid>

            <!-- Grandma traces -->
            <Grid IsVisible="{Binding IsIndrasGrandma}" ColumnDefinitions="160,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="tr(a) real:" VerticalAlignment="Center" />
                <NumericUpDown Grid.Row="0" Grid.Column="1"
                               Minimum="-4" Maximum="4" Increment="0.01" FormatString="F3"
                               Value="{Binding IndrasGrandmaTaRe, Mode=TwoWay}" Margin="0,2"
                               ToolTip.Tip="Real part of trace ta. tb is set separately; tab derives from the Markov identity." />
                <TextBlock Grid.Row="1" Grid.Column="0" Text="tr(a) imag:" VerticalAlignment="Center" />
                <NumericUpDown Grid.Row="1" Grid.Column="1"
                               Minimum="-4" Maximum="4" Increment="0.01" FormatString="F3"
                               Value="{Binding IndrasGrandmaTaIm, Mode=TwoWay}" Margin="0,2" />
                <TextBlock Grid.Row="2" Grid.Column="0" Text="tr(b) real:" VerticalAlignment="Center" />
                <NumericUpDown Grid.Row="2" Grid.Column="1"
                               Minimum="-4" Maximum="4" Increment="0.01" FormatString="F3"
                               Value="{Binding IndrasGrandmaTbRe, Mode=TwoWay}" Margin="0,2" />
                <TextBlock Grid.Row="3" Grid.Column="0" Text="tr(b) imag:" VerticalAlignment="Center" />
                <NumericUpDown Grid.Row="3" Grid.Column="1"
                               Minimum="-4" Maximum="4" Increment="0.01" FormatString="F3"
                               Value="{Binding IndrasGrandmaTbIm, Mode=TwoWay}" Margin="0,2" />
                <TextBlock Grid.Row="4" Grid.Column="0" Text="Second tab root:" VerticalAlignment="Center" />
                <CheckBox Grid.Row="4" Grid.Column="1"
                          IsChecked="{Binding IndrasGrandmaSecondSolution, Mode=TwoWay}" Margin="0,2"
                          ToolTip.Tip="Pick the other root of the Markov quadratic for tab — a different (often mirror) group." />
            </Grid>

            <!-- Riley c -->
            <Grid IsVisible="{Binding IsIndrasRiley}" ColumnDefinitions="160,*" RowDefinitions="Auto,Auto">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Riley c (real):" VerticalAlignment="Center" />
                <NumericUpDown Grid.Row="0" Grid.Column="1"
                               Minimum="-4" Maximum="4" Increment="0.01" FormatString="F3"
                               Value="{Binding IndrasRileyCRe, Mode=TwoWay}" Margin="0,2"
                               ToolTip.Tip="Real part of the Riley parameter c. a: z ↦ z/(cz+1) (parabolic)." />
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Riley c (imag):" VerticalAlignment="Center" />
                <NumericUpDown Grid.Row="1" Grid.Column="1"
                               Minimum="-4" Maximum="4" Increment="0.01" FormatString="F3"
                               Value="{Binding IndrasRileyCIm, Mode=TwoWay}" Margin="0,2" />
            </Grid>
        </StackPanel>

        <!-- Julibrot Pair, was Dual-Orbit Escape (#864 / #866; renamed #1155) -->
        <Grid IsVisible="{Binding IsDualOrbitEscape}"
              ColumnDefinitions="160,*"
              RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Map:" VerticalAlignment="Center" />
            <ComboBox Grid.Row="0" Grid.Column="1"
                      ItemsSource="{Binding DualOrbitMaps}"
                      SelectedItem="{Binding DualOrbitMap, Mode=TwoWay}"
                      Margin="0,2"
                      ToolTip.Tip="Shared orbit map. ComplexPlane = 2D u²+s. Quaternion = q²+S (4D escape geometry, non-degenerate by construction; uses c-seed Z + s_z)." />
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Field:" VerticalAlignment="Center" />
            <ComboBox Grid.Row="1" Grid.Column="1"
                      ItemsSource="{Binding DualOrbitFields}"
                      SelectedItem="{Binding DualOrbitField, Mode=TwoWay}"
                      IsEnabled="{Binding IsDualOrbitFieldMode}"
                      Margin="0,2"
                      ToolTip.Tip="Derived scalar. Intrinsic (same at any bailout): GreenRatio = log2 of the two orbits' escape-potential ratio; ExternalAngleDelta = difference of their external angles (ComplexPlane only). Bailout-dependent (artistic): EscapeSeparation |E_c−E_z|, MidpointResidual |M−s|, DualOrbitAngle. ΔN = n_c − n_z. Pair fields (read every step of both orbits): SecantLyapunov = mean ln|z+c| (defined everywhere, inside M_c too); DivergenceTime = steps until the pair separates by the divergence ratio; ClosestApproach / ClosestApproachIndex = how close the orbits get, and when; PairWinding = turns of the separation vector; MidpointPerturbation = how far the pair is from moving as one orbit; ItineraryAgreement = steps both orbits stay on the same side of the real axis. PairWinding and ItineraryAgreement are ComplexPlane only. Interior fields (live inside the set, where the orbits settle on a cycle): PhaseLag = how many steps ahead the c-orbit runs on the shared cycle (try the CxCy slice); PhaseLagFraction = the same, spread evenly across the palette; CyclePeriod = the cycle length. ComplexPlane only. Per-orbit colourings (ComplexPlane only, live inside the set too): TrapZ / TrapC / TrapDelta = closest approach of each orbit to a trap shape; StripeZ / StripeC / StripeInterference = stripe averages and their product; TiaZ / TiaC = triangle-inequality averages; OrbitThemeZ / OrbitThemeC = pick an orbit-trap / stripe / curvature theme and it colours from that one orbit. Distance (ComplexPlane only): DistanceZ / DistanceC = distance to each orbit's boundary; DualOutline = outlines of both boundaries in two colours; BinaryXor = the two orbits' binary decompositions combined; FinalAngleDelta = angle between the raw escape points." />
            <TextBlock Grid.Row="2" Grid.Column="0" Text="c-seed real:" VerticalAlignment="Center" />
            <NumericUpDown Grid.Row="2" Grid.Column="1"
                           Minimum="-2" Maximum="2" Increment="0.02" FormatString="F3"
                           Value="{Binding DualOrbitCSeedX, Mode=TwoWay}" Margin="0,2"
                           IsEnabled="{Binding DualOrbitCXEditable}"
                           ToolTip.Tip="Fixed, independent c-orbit seed (real). s selects the set; c textures it. Keep decoupled from s — c = s is degenerate. Disabled when c.x is an image axis." />
            <TextBlock Grid.Row="3" Grid.Column="0" Text="c-seed imag:" VerticalAlignment="Center" />
            <NumericUpDown Grid.Row="3" Grid.Column="1"
                           Minimum="-2" Maximum="2" Increment="0.02" FormatString="F3"
                           Value="{Binding DualOrbitCSeedY, Mode=TwoWay}" Margin="0,2"
                           IsEnabled="{Binding DualOrbitCYEditable}"
                           ToolTip.Tip="Fixed c-orbit seed (imaginary). Disabled when c.y is an image axis." />
            <TextBlock Grid.Row="4" Grid.Column="0" Text="c-seed k (quat):" VerticalAlignment="Center"
                       IsVisible="{Binding IsDualOrbitQuat}" />
            <NumericUpDown Grid.Row="4" Grid.Column="1"
                           Minimum="-2" Maximum="2" Increment="0.02" FormatString="F3"
                           Value="{Binding DualOrbitCSeedZ, Mode=TwoWay}" Margin="0,2"
                           IsVisible="{Binding IsDualOrbitQuat}"
                           IsEnabled="{Binding !DualOrbitCEqualsS}"
                           ToolTip.Tip="Quaternion c-seed 3rd imaginary component — puts the c-orbit in a different plane from the seed-0 orbit (the richness source)." />
            <TextBlock Grid.Row="5" Grid.Column="0" Text="s_z dial (quat):" VerticalAlignment="Center"
                       IsVisible="{Binding IsDualOrbitQuat}" />
            <NumericUpDown Grid.Row="5" Grid.Column="1"
                           Minimum="-2" Maximum="2" Increment="0.02" FormatString="F3"
                           Value="{Binding DualOrbitSZ, Mode=TwoWay}" Margin="0,2"
                           IsVisible="{Binding IsDualOrbitQuat}"
                           ToolTip.Tip="Quaternion s_z of S=(0,s_x,s_y,s_z) — the decoupling / phase dial. 0 keeps S in the s_x/s_y plane." />
            <TextBlock Grid.Row="6" Grid.Column="0" Text="Mandelbrot control:" VerticalAlignment="Center" />
            <CheckBox Grid.Row="6" Grid.Column="1"
                      IsChecked="{Binding DualOrbitCEqualsS, Mode=TwoWay}" Margin="0,2"
                      ToolTip.Tip="Seed the c-orbit from s (c = s). Degenerate — the dual fields collapse to a plain Mandelbrot exterior. For comparison only." />
            <TextBlock Grid.Row="7" Grid.Column="0" Text="Bailout radius:" VerticalAlignment="Center" />
            <NumericUpDown Grid.Row="7" Grid.Column="1"
                           Minimum="2" Maximum="1000000" Increment="16" FormatString="F0"
                           Value="{Binding DualOrbitBailout, Mode=TwoWay}" Margin="0,2"
                           ToolTip.Tip="Escape radius both orbits iterate to (default 128). EscapeSeparation / MidpointResidual / DualOrbitAngle change with it; GreenRatio and ExternalAngleDelta do not." />
            <TextBlock Grid.Row="8" Grid.Column="0" Text="Ratio span (octaves):" VerticalAlignment="Center" />
            <NumericUpDown Grid.Row="8" Grid.Column="1"
                           Minimum="0.25" Maximum="64" Increment="0.5" FormatString="F2"
                           Value="{Binding DualOrbitRatioSpan, Mode=TwoWay}" Margin="0,2"
                           ToolTip.Tip="GreenRatio half-range: ±span octaves map to the palette ends, 0 (equal escape potential) to mid-palette." />
            <TextBlock Grid.Row="9" Grid.Column="0" Text="Slice (image X, Y):" VerticalAlignment="Center" />
            <ComboBox Grid.Row="9" Grid.Column="1"
                      ItemsSource="{Binding DualOrbitSliceAxesValues}"
                      SelectedItem="{Binding DualOrbitSliceAxes, Mode=TwoWay}"
                      Margin="0,2"
                      ToolTip.Tip="Which two of (c.x, c.y, s.x, s.y) the image spans. SxSy = parameter plane (default). CxCy = dynamical / Julia plane (s fixed). CxSx = cross-section of the 3D volume: the original s.x sweep stacked over c.x. Pair with EscapeTimeC where the critical orbit stays bounded." />
            <TextBlock Grid.Row="10" Grid.Column="0" Text="Fixed s.x (sweep):" VerticalAlignment="Center" />
            <NumericUpDown Grid.Row="10" Grid.Column="1"
                           Minimum="-4" Maximum="4" Increment="0.01" FormatString="F3"
                           Value="{Binding DualOrbitSX, Mode=TwoWay}" Margin="0,2"
                           IsEnabled="{Binding DualOrbitSXEditable}"
                           ToolTip.Tip="s.x when it is not an image axis — the original sweep coordinate. Animate it to replay the sweep." />
            <TextBlock Grid.Row="11" Grid.Column="0" Text="Fixed s.y:" VerticalAlignment="Center" />
            <NumericUpDown Grid.Row="11" Grid.Column="1"
                           Minimum="-4" Maximum="4" Increment="0.01" FormatString="F3"
                           Value="{Binding DualOrbitSY, Mode=TwoWay}" Margin="0,2"
                           IsEnabled="{Binding DualOrbitSYEditable}"
                           ToolTip.Tip="s.y when it is not an image axis." />

            <!-- Per-orbit layer colouring (#979 / #980) -->
            <TextBlock Grid.Row="12" Grid.Column="0" Text="Colour mode:" VerticalAlignment="Center" Margin="0,8,0,2" />
            <ComboBox Grid.Row="12" Grid.Column="1"
                      ItemsSource="{Binding DualOrbitColorModes}"
                      SelectedItem="{Binding DualOrbitColorMode, Mode=TwoWay}"
                      Margin="0,8,0,2"
                      ToolTip.Tip="Field: one derived scalar through the main theme. PerOrbitLayers: the z-orbit (seed 0) and the c-orbit each coloured by their own theme (interior colour, alpha and surround included), then blended — so the two 'discs' can be styled and faded independently." />
            <TextBlock Grid.Row="13" Grid.Column="0" Text="z-orbit theme:" VerticalAlignment="Center"
                       IsVisible="{Binding IsDualOrbitLayers}" />
            <ComboBox Grid.Row="13" Grid.Column="1"
                      ItemsSource="{Binding LayerThemeNames}"
                      SelectedItem="{Binding DualOrbitThemeZ, Mode=TwoWay}"
                      IsVisible="{Binding IsDualOrbitLayers}" Margin="0,2"
                      ToolTip.Tip="Theme for the z-orbit layer (seed 0 — the Mandelbrot set and its bands). Lists themes compatible with this fractal; '(main theme)' follows the toolbar theme." />
            <TextBlock Grid.Row="14" Grid.Column="0" Text="c-orbit theme:" VerticalAlignment="Center"
                       IsVisible="{Binding IsDualOrbitLayers}" />
            <ComboBox Grid.Row="14" Grid.Column="1"
                      ItemsSource="{Binding LayerThemeNames}"
                      SelectedItem="{Binding DualOrbitThemeC, Mode=TwoWay}"
                      IsVisible="{Binding IsDualOrbitLayers}" Margin="0,2"
                      ToolTip.Tip="Theme for the c-orbit layer (the c-seed's own set and bands, centred on −c²)." />
            <TextBlock Grid.Row="15" Grid.Column="0" Text="Layer blend:" VerticalAlignment="Center"
                       IsVisible="{Binding IsDualOrbitLayers}" />
            <ComboBox Grid.Row="15" Grid.Column="1"
                      ItemsSource="{Binding DualOrbitLayerBlends}"
                      SelectedItem="{Binding DualOrbitLayerBlend, Mode=TwoWay}"
                      IsVisible="{Binding IsDualOrbitLayers}" Margin="0,2"
                      ToolTip.Tip="COverZ / ZOverC: one layer over the other. Screen: lightens where they overlap. Multiply: darkens. Mix: cross-fade weighted by the two opacities." />
            <TextBlock Grid.Row="16" Grid.Column="0" Text="z-orbit opacity:" VerticalAlignment="Center"
                       IsVisible="{Binding IsDualOrbitLayers}" />
            <NumericUpDown Grid.Row="16" Grid.Column="1"
                           Minimum="0" Maximum="1" Increment="0.05" FormatString="F2"
                           Value="{Binding DualOrbitOpacityZ, Mode=TwoWay}"
                           IsVisible="{Binding IsDualOrbitLayers}" Margin="0,2"
                           ToolTip.Tip="Opacity of the z-orbit layer (multiplies the theme's own alpha). Animatable." />
            <TextBlock Grid.Row="17" Grid.Column="0" Text="c-orbit opacity:" VerticalAlignment="Center"
                       IsVisible="{Binding IsDualOrbitLayers}" />
            <NumericUpDown Grid.Row="17" Grid.Column="1"
                           Minimum="0" Maximum="1" Increment="0.05" FormatString="F2"
                           Value="{Binding DualOrbitOpacityC, Mode=TwoWay}"
                           IsVisible="{Binding IsDualOrbitLayers}" Margin="0,2"
                           ToolTip.Tip="Opacity of the c-orbit layer. Animate it to cross-fade the two discs." />
            <TextBlock Grid.Row="18" Grid.Column="0" Grid.ColumnSpan="2"
                       Text="{Binding DualOrbitThemeWarning}"
                       IsVisible="{Binding HasDualOrbitThemeWarning}"
                       Foreground="#FFCC00" TextWrapping="Wrap" Margin="0,4" />
            <TextBlock Grid.Row="19" Grid.Column="0" Text="Lyapunov span:" VerticalAlignment="Center"
                       IsVisible="{Binding IsDualOrbitLyapunovField}" />
            <NumericUpDown Grid.Row="19" Grid.Column="1"
                           Minimum="0.05" Maximum="20" Increment="0.25" FormatString="F2"
                           Value="{Binding DualOrbitLyapunovSpan, Mode=TwoWay}" Margin="0,2"
                           IsVisible="{Binding IsDualOrbitLyapunovField}"
                           ToolTip.Tip="SecantLyapunov half-range (nats per step): ±span maps to the palette ends, 0 to mid-palette. Negative = the orbits converge together, positive = they separate." />
            <TextBlock Grid.Row="20" Grid.Column="0" Text="Divergence ratio:" VerticalAlignment="Center"
                       IsVisible="{Binding IsDualOrbitDivergenceField}" />
            <NumericUpDown Grid.Row="20" Grid.Column="1"
                           Minimum="1.01" Maximum="1000000" Increment="0.5" FormatString="F2"
                           Value="{Binding DualOrbitDivergenceRatio, Mode=TwoWay}" Margin="0,2"
                           IsVisible="{Binding IsDualOrbitDivergenceField}"
                           ToolTip.Tip="DivergenceTime threshold: the time for the two orbits' separation to grow to this many times its starting value (|c|). Pixels where it never does use the interior colour." />
            <TextBlock Grid.Row="21" Grid.Column="0" Text="Contour density:" VerticalAlignment="Center"
                       IsVisible="{Binding IsDualOrbitDomain}" />
            <NumericUpDown Grid.Row="21" Grid.Column="1"
                           Minimum="0" Maximum="64" Increment="0.5" FormatString="F1"
                           Value="{Binding DualOrbitContourDensity, Mode=TwoWay}" Margin="0,2"
                           IsVisible="{Binding IsDualOrbitDomain}"
                           ToolTip.Tip="Böttcher domain colouring: contour bands per unit of escape-potential difference between the two orbits. 0 = no bands. Recolours without re-iterating." />
            <TextBlock Grid.Row="22" Grid.Column="0" Text="Hue palette:" VerticalAlignment="Center"
                       IsVisible="{Binding IsDualOrbitDomain}" />
            <ComboBox Grid.Row="22" Grid.Column="1"
                      ItemsSource="{Binding DualOrbitDomainPalettes}"
                      SelectedItem="{Binding DualOrbitDomainPalette, Mode=TwoWay}" Margin="0,2"
                      IsVisible="{Binding IsDualOrbitDomain}"
                      ToolTip.Tip="Hue = the difference of the two orbits' external angles. BlueAmberCycle = built-in cycle on lightness and blue↔yellow only (colour-blind safe). Theme = the active colour theme (pick a cyclic one)." />
            <CheckBox Grid.Row="23" Grid.Column="0" Grid.ColumnSpan="2"
                      Content="Angular grid lines"
                      IsChecked="{Binding DualOrbitDomainGrid, Mode=TwoWay}" Margin="0,2"
                      IsVisible="{Binding IsDualOrbitDomain}"
                      ToolTip.Tip="Also draw lines at multiples of 1/density of the angle difference (a polar grid on the Böttcher ratio)." />
            <CheckBox Grid.Row="25" Grid.Column="0" Grid.ColumnSpan="2"
                      Content="Dim outside the Böttcher domain"
                      IsChecked="{Binding DualOrbitDomainMarkCuts, Mode=TwoWay}" Margin="0,2"
                      IsVisible="{Binding IsDualOrbitDomain}"
                      ToolTip.Tip="The ratio is only truly defined where the c-orbit's escape potential is above the critical point's level. Below it the angle has branch cuts (straight-looking seams). On = dim those pixels; off = show the raw values." />
            <TextBlock Grid.Row="26" Grid.Column="0" Text="Class colours:" VerticalAlignment="Center"
                       IsVisible="{Binding IsDualOrbitCategoricalField}" />
            <ComboBox Grid.Row="26" Grid.Column="1"
                      ItemsSource="{Binding DualOrbitLagColorModes}"
                      SelectedItem="{Binding DualOrbitLagColors, Mode=TwoWay}" Margin="0,2"
                      IsVisible="{Binding IsDualOrbitCategoricalField}"
                      ToolTip.Tip="Categorical = one fixed colour-blind-safe colour per lag / period class, whatever the theme. Theme = the active theme (a cycling theme can give several classes the same colour)." />
            <TextBlock Grid.Row="27" Grid.Column="0" Text="Trap shape:" VerticalAlignment="Center"
                       IsVisible="{Binding IsDualOrbitTrapField}" />
            <ComboBox Grid.Row="27" Grid.Column="1"
                      ItemsSource="{Binding DualOrbitTrapShapes}"
                      SelectedItem="{Binding DualOrbitTrapShape, Mode=TwoWay}" Margin="0,2"
                      IsVisible="{Binding IsDualOrbitTrapField}"
                      ToolTip.Tip="The shape each orbit's closest approach is measured to — the same shapes as the orbit-trap themes." />
            <TextBlock Grid.Row="28" Grid.Column="0" Text="Trap scale:" VerticalAlignment="Center"
                       IsVisible="{Binding IsDualOrbitTrapField}" />
            <NumericUpDown Grid.Row="28" Grid.Column="1"
                           Minimum="0.0001" Maximum="10" Increment="0.05" FormatString="F3"
                           Value="{Binding DualOrbitTrapScale, Mode=TwoWay}" Margin="0,2"
                           IsVisible="{Binding IsDualOrbitTrapField}"
                           ToolTip.Tip="Distance at which the palette is half-way: a trap distance d maps to d / (d + scale)." />
            <TextBlock Grid.Row="29" Grid.Column="0" Text="Stripe density:" VerticalAlignment="Center"
                       IsVisible="{Binding IsDualOrbitStripeField}" />
            <NumericUpDown Grid.Row="29" Grid.Column="1"
                           Minimum="0.5" Maximum="64" Increment="0.5" FormatString="F1"
                           Value="{Binding DualOrbitStripeDensity, Mode=TwoWay}" Margin="0,2"
                           IsVisible="{Binding IsDualOrbitStripeField}"
                           ToolTip.Tip="Number of stripes per turn of the orbit's angle (stripe average colouring)." />
            <TextBlock Grid.Row="30" Grid.Column="0" Text="Distance scale (px):" VerticalAlignment="Center"
                       IsVisible="{Binding IsDualOrbitDistanceField}" />
            <NumericUpDown Grid.Row="30" Grid.Column="1"
                           Minimum="0.01" Maximum="1000" Increment="1" FormatString="F2"
                           Value="{Binding DualOrbitDEScale, Mode=TwoWay}" Margin="0,2"
                           IsVisible="{Binding IsDualOrbitDistanceField}"
                           ToolTip.Tip="Distance to the orbit's boundary, in pixels, at which the palette is half-way: d maps to d / (d + scale)." />
            <TextBlock Grid.Row="31" Grid.Column="0" Text="Outline width (px):" VerticalAlignment="Center"
                       IsVisible="{Binding IsDualOrbitOutline}" />
            <NumericUpDown Grid.Row="31" Grid.Column="1"
                           Minimum="0.1" Maximum="50" Increment="0.25" FormatString="F2"
                           Value="{Binding DualOrbitOutlineWidth, Mode=TwoWay}" Margin="0,2"
                           IsVisible="{Binding IsDualOrbitOutline}"
                           ToolTip.Tip="Ink line width at each boundary. Recolours without re-iterating." />
            <TextBlock Grid.Row="32" Grid.Column="0" Text="M outline (z):" VerticalAlignment="Center"
                       IsVisible="{Binding IsDualOrbitOutline}" />
            <TextBox Grid.Row="32" Grid.Column="1" Margin="0,2"
                     Text="{Binding DualOrbitOutlineColorZHex, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                     IsVisible="{Binding IsDualOrbitOutline}"
                     ToolTip.Tip="AARRGGBB hex — line on the z-orbit's boundary (the Mandelbrot set on the parameter plane)." />
            <TextBlock Grid.Row="33" Grid.Column="0" Text="M_c outline (c):" VerticalAlignment="Center"
                       IsVisible="{Binding IsDualOrbitOutline}" />
            <TextBox Grid.Row="33" Grid.Column="1" Margin="0,2"
                     Text="{Binding DualOrbitOutlineColorCHex, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                     IsVisible="{Binding IsDualOrbitOutline}"
                     ToolTip.Tip="AARRGGBB hex — line on the c-orbit's boundary (the region where the c-orbit stays bounded)." />
            <TextBlock Grid.Row="34" Grid.Column="0" Text="2D palette:" VerticalAlignment="Center"
                       IsVisible="{Binding IsDualOrbitPalette2DMode}" />
            <ComboBox Grid.Row="34" Grid.Column="1"
                      ItemsSource="{Binding DualOrbitPalettes2D}"
                      SelectedItem="{Binding DualOrbitPalette2D, Mode=TwoWay}" Margin="0,2"
                      IsVisible="{Binding IsDualOrbitPalette2DMode}"
                      ToolTip.Tip="BlueAmberSquare = dark → blue along the z-orbit's escape count, dark → amber along the c-orbit's, white where both are high (colour-blind safe). ThemeByLightness = the active theme's colour from the z count, brightness from the c count." />
            <TextBlock Grid.Row="35" Grid.Column="0" Text="Count scale:" VerticalAlignment="Center"
                       IsVisible="{Binding IsDualOrbitBivariateScaled}" />
            <NumericUpDown Grid.Row="35" Grid.Column="1"
                           Minimum="0.01" Maximum="10000" Increment="1" FormatString="F2"
                           Value="{Binding DualOrbitBivariateScale, Mode=TwoWay}" Margin="0,2"
                           IsVisible="{Binding IsDualOrbitBivariateScaled}"
                           ToolTip.Tip="Escape count at which a channel is half-way: n maps to n / (n + scale). (JointEqualised uses ranks instead.)" />
            <TextBlock Grid.Row="36" Grid.Column="0" Text="Phase κ:" VerticalAlignment="Center"
                       IsVisible="{Binding IsDualOrbitPhaseMod}" />
            <NumericUpDown Grid.Row="36" Grid.Column="1"
                           Minimum="-100" Maximum="100" Increment="0.05" FormatString="F2"
                           Value="{Binding DualOrbitPhaseK, Mode=TwoWay}" Margin="0,2"
                           IsVisible="{Binding IsDualOrbitPhaseMod}"
                           ToolTip.Tip="PhaseModulated: colour = theme at (z escape count + κ × c escape count). Animatable — sweeping κ slides the c-orbit's pattern through the z palette." />
            <TextBlock Grid.Row="37" Grid.Column="0" Text="Trap frame:" VerticalAlignment="Center"
                       IsVisible="{Binding IsDualOrbitTrapField}" />
            <ComboBox Grid.Row="37" Grid.Column="1"
                      ItemsSource="{Binding DualOrbitTrapFrames}"
                      SelectedItem="{Binding DualOrbitTrapFrame, Mode=TwoWay}" Margin="0,2"
                      IsVisible="{Binding IsDualOrbitTrapField}"
                      ToolTip.Tip="Fixed = the trap sits still at the origin. CoMoving = the trap rides the other orbit: TrapC measures the c-orbit against a trap centred on the z-orbit's current point (and TrapZ the z-orbit against one riding the c-orbit), so the trap motifs follow the dynamics." />
            <CheckBox Grid.Row="38" Grid.Column="0" Grid.ColumnSpan="2"
                      Content="Turn trap with the orbit"
                      IsChecked="{Binding DualOrbitTrapRotate, Mode=TwoWay}" Margin="0,2"
                      IsVisible="{Binding IsDualOrbitCoMovingTrap}"
                      ToolTip.Tip="Co-moving trap: rotate the trap shape by the angle of the orbit point it rides. Off = the trap keeps its orientation and only moves." />
            <CheckBox Grid.Row="39" Grid.Column="0" Grid.ColumnSpan="2"
                      Content="Scale trap with the orbit"
                      IsChecked="{Binding DualOrbitTrapScaleByOrbit, Mode=TwoWay}" Margin="0,2"
                      IsVisible="{Binding IsDualOrbitCoMovingTrap}"
                      ToolTip.Tip="Co-moving trap: grow the trap with the distance of the orbit point it rides from the origin (distances become relative)." />
            <TextBlock Grid.Row="40" Grid.Column="0" Text="Trap angle (°):" VerticalAlignment="Center"
                       IsVisible="{Binding IsDualOrbitTrapField}" />
            <NumericUpDown Grid.Row="40" Grid.Column="1"
                           Minimum="-3600" Maximum="3600" Increment="5" FormatString="F1"
                           Value="{Binding DualOrbitTrapAngle, Mode=TwoWay}" Margin="0,2"
                           IsVisible="{Binding IsDualOrbitTrapField}"
                           ToolTip.Tip="Turns the trap shape by this many degrees, in either frame. Animatable — spin the trap." />
            <CheckBox Grid.Row="41" Grid.Column="0" Grid.ColumnSpan="2"
                      Content="Relief height from its own field"
                      IsChecked="{Binding DualOrbitSplitHeight, Mode=TwoWay}" Margin="0,8,0,2"
                      ToolTip.Tip="Off = Relief (and SSAO) height follows the coloured value. On = the height comes from the field chosen below while the colour stays as set above — e.g. hills from the secant Lyapunov exponent, painted by the external-angle difference or the per-orbit layers." />
            <TextBlock Grid.Row="42" Grid.Column="0" Text="Height field:" VerticalAlignment="Center"
                       IsVisible="{Binding DualOrbitSplitHeight}" />
            <ComboBox Grid.Row="42" Grid.Column="1"
                      ItemsSource="{Binding DualOrbitFields}"
                      SelectedItem="{Binding DualOrbitHeightField, Mode=TwoWay}" Margin="0,2"
                      IsVisible="{Binding DualOrbitSplitHeight}"
                      ToolTip.Tip="The field the Relief height is built from (its own settings — trap shape, spans, scales — are shared with the colour field). Changing it does not re-run the colour orbits." />
            <TextBlock Grid.Row="43" Grid.Column="0" Text="Interference κ:" VerticalAlignment="Center"
                       IsVisible="{Binding IsDualOrbitInterferenceField}" />
            <NumericUpDown Grid.Row="43" Grid.Column="1"
                           Minimum="-1000" Maximum="1000" Increment="1" FormatString="F2"
                           Value="{Binding DualOrbitInterferenceK, Mode=TwoWay}" Margin="0,2"
                           IsVisible="{Binding IsDualOrbitInterferenceField}"
                           ToolTip.Tip="Path interference: how fast the phase turns with escape potential — more fringes as κ grows. Animatable (the fringes shimmer); recolours without re-iterating." />
            <TextBlock Grid.Row="44" Grid.Column="0" Text="Angle damping γ:" VerticalAlignment="Center"
                       IsVisible="{Binding IsDualOrbitInterferenceField}" />
            <NumericUpDown Grid.Row="44" Grid.Column="1"
                           Minimum="0" Maximum="100" Increment="0.1" FormatString="F2"
                           Value="{Binding DualOrbitInterferenceGamma, Mode=TwoWay}" Margin="0,2"
                           IsVisible="{Binding IsDualOrbitInterferenceField}"
                           ToolTip.Tip="How strongly a difference in the two orbits' external angles washes the fringes out. 0 = full fringes everywhere (default); 1 = the complex phase as defined — fringes strongest where the angles agree, and the angle's branch cuts show as straight seams." />
            <TextBlock Grid.Row="45" Grid.Column="0" Text="Which-path η:" VerticalAlignment="Center"
                       IsVisible="{Binding IsDualOrbitInterferenceIntensity}" />
            <NumericUpDown Grid.Row="45" Grid.Column="1"
                           Minimum="0" Maximum="1" Increment="0.05" FormatString="F2"
                           Value="{Binding DualOrbitWhichPath, Mode=TwoWay}" Margin="0,2"
                           IsVisible="{Binding IsDualOrbitInterferenceIntensity}"
                           ToolTip.Tip="Which-path measurement, as in the double-slit experiment: how much we &quot;watch&quot; which orbit each path took. 0 = no watching, full fringes (default); 1 = fully watched, the fringes vanish. Animate it 0 → 1 to see the pattern collapse. Recolours without re-iterating." />
            <TextBlock Grid.Row="46" Grid.Column="0" Text="Angular momentum ℓ:" VerticalAlignment="Center"
                       IsVisible="{Binding IsDualOrbitInterferenceField}" />
            <NumericUpDown Grid.Row="46" Grid.Column="1"
                           Minimum="-64" Maximum="64" Increment="1" FormatString="F0"
                           Value="{Binding DualOrbitAngularMomentum, Mode=TwoWay}" Margin="0,2"
                           IsVisible="{Binding IsDualOrbitInterferenceField}"
                           ToolTip.Tip="Gives each path a twist from its external angle, like light carrying orbital angular momentum. On the phase field the rings turn into spirals with ℓ arms; the sign sets the handedness. 0 = off (default). Close to the set, below the critical level, the angle has branch cuts that show as seams when ℓ is not 0. Recolours without re-iterating." />
            <TextBlock Grid.Row="47" Grid.Column="0" Text="Winding direction:" VerticalAlignment="Center"
                       IsVisible="{Binding IsDualOrbitInterferenceField}" />
            <ComboBox Grid.Row="47" Grid.Column="1"
                      ItemsSource="{Binding DualOrbitWindingModes}"
                      SelectedItem="{Binding DualOrbitWindingMode, Mode=TwoWay}" Margin="0,2"
                      IsVisible="{Binding IsDualOrbitInterferenceField}"
                      ToolTip.Tip="Same = both paths twist the same way (spiral arms on the phase field). Opposite = the c-path twists the other way: the intensity fringes become radial rays, while the phase field's twists cancel." />
            <TextBlock Grid.Row="48" Grid.Column="0" Text="Ensemble seeds (N):" VerticalAlignment="Center"
                       IsVisible="{Binding IsDualOrbitEnsembleField}" />
            <NumericUpDown Grid.Row="48" Grid.Column="1"
                           Minimum="1" Maximum="4096" Increment="8" FormatString="F0"
                           Value="{Binding DualOrbitEnsembleN, Mode=TwoWay}" Margin="0,2"
                           IsVisible="{Binding IsDualOrbitEnsembleField}"
                           ToolTip.Tip="How many c-orbit seeds are spread over a small disc round c for every pixel. Render time grows with N — keep it low while exploring, raise it for export." />
            <TextBlock Grid.Row="49" Grid.Column="0" Text="Seed disc radius:" VerticalAlignment="Center"
                       IsVisible="{Binding IsDualOrbitEnsembleField}" />
            <NumericUpDown Grid.Row="49" Grid.Column="1"
                           Minimum="0.000000001" Maximum="4" Increment="0.005" FormatString="G4"
                           Value="{Binding DualOrbitEnsembleRadius, Mode=TwoWay}" Margin="0,2"
                           IsVisible="{Binding IsDualOrbitEnsembleField}"
                           ToolTip.Tip="Radius of the seed disc round c, in c units (not pixels). Shrink it when you zoom in, or the boundary band gets wide." />
            <TextBlock Grid.Row="50" Grid.Column="0" Text="Angle sectors:" VerticalAlignment="Center"
                       IsVisible="{Binding IsDualOrbitEnsembleField}" />
            <NumericUpDown Grid.Row="50" Grid.Column="1"
                           Minimum="0" Maximum="64" Increment="1" FormatString="F0"
                           Value="{Binding DualOrbitEnsembleSectors, Mode=TwoWay}" Margin="0,2"
                           IsVisible="{Binding IsDualOrbitEnsembleField}"
                           ToolTip.Tip="Outcome classes. 0 = bounded or escaped. K = bounded, or escaped through one of K equal external-angle sectors (more classes; ray boundaries appear)." />
            <TextBlock Grid.Row="51" Grid.Column="0" Text="Uncertainty levels:" VerticalAlignment="Center"
                       IsVisible="{Binding IsDualOrbitUncertaintyField}" />
            <NumericUpDown Grid.Row="51" Grid.Column="1"
                           Minimum="2" Maximum="12" Increment="1" FormatString="F0"
                           Value="{Binding DualOrbitUncertaintyLevels, Mode=TwoWay}" Margin="0,2"
                           IsVisible="{Binding IsDualOrbitUncertaintyField}"
                           ToolTip.Tip="How many pair distances (each half the last) the exponent is fitted over. Each level costs another N orbits per pixel." />
            <TextBlock Grid.Row="52" Grid.Column="0" Text="FTLE span:" VerticalAlignment="Center"
                       IsVisible="{Binding IsDualOrbitFtleField}" />
            <NumericUpDown Grid.Row="52" Grid.Column="1"
                           Minimum="0.01" Maximum="100" Increment="0.1" FormatString="F2"
                           Value="{Binding DualOrbitFtleSpan, Mode=TwoWay}" Margin="0,2"
                           IsVisible="{Binding IsDualOrbitFtleField}"
                           ToolTip.Tip="Stretching rate (per step) that maps to the palette ends: ±span, with 0 at mid-palette. Ridges mark where nearby pairs separate fastest." />
            <TextBlock Grid.Row="53" Grid.Column="0" Text="Anisotropy scale:" VerticalAlignment="Center"
                       IsVisible="{Binding IsDualOrbitAnisotropyField}" />
            <NumericUpDown Grid.Row="53" Grid.Column="1"
                           Minimum="0.01" Maximum="10000" Increment="1" FormatString="F2"
                           Value="{Binding DualOrbitAnisotropyScale, Mode=TwoWay}" Margin="0,2"
                           IsVisible="{Binding IsDualOrbitAnisotropyField}"
                           ToolTip.Tip="Log stretch ratio at which the palette is half-way: A maps to A / (A + scale)." />
            <TextBlock Grid.Row="54" Grid.Column="0" Text="Flow texture (LIC):" VerticalAlignment="Center" Margin="0,8,0,2" />
            <ComboBox Grid.Row="54" Grid.Column="1"
                      ItemsSource="{Binding DualOrbitLicSources}"
                      SelectedItem="{Binding DualOrbitLicSource, Mode=TwoWay}" Margin="0,8,0,2"
                      ToolTip.Tip="Overlay a streaky flow texture that follows a direction field. SeparationDirection = the direction from the z-orbit to the c-orbit at the end. FieldGradient = up the coloured value's slope. FieldContour = along its level lines. Works in every colour mode." />
            <TextBlock Grid.Row="55" Grid.Column="0" Text="Streak length (px):" VerticalAlignment="Center"
                       IsVisible="{Binding IsDualOrbitLicOn}" />
            <NumericUpDown Grid.Row="55" Grid.Column="1"
                           Minimum="1" Maximum="256" Increment="2" FormatString="F0"
                           Value="{Binding DualOrbitLicLength, Mode=TwoWay}" Margin="0,2"
                           IsVisible="{Binding IsDualOrbitLicOn}"
                           ToolTip.Tip="How far each streak runs either way. Recolours without re-iterating." />
            <TextBlock Grid.Row="56" Grid.Column="0" Text="Texture strength:" VerticalAlignment="Center"
                       IsVisible="{Binding IsDualOrbitLicOn}" />
            <NumericUpDown Grid.Row="56" Grid.Column="1"
                           Minimum="0" Maximum="1" Increment="0.05" FormatString="F2"
                           Value="{Binding DualOrbitLicStrength, Mode=TwoWay}" Margin="0,2"
                           IsVisible="{Binding IsDualOrbitLicOn}"
                           ToolTip.Tip="0 = no texture, 1 = full light/dark streaks over the colour. Recolours without re-iterating." />
            <CheckBox Grid.Row="57" Grid.Column="0" Grid.ColumnSpan="2"
                      Content="Smooth across escape bands"
                      IsChecked="{Binding DualOrbitLyapunovSmooth, Mode=TwoWay}" Margin="0,2"
                      IsVisible="{Binding IsDualOrbitSmoothableField}"
                      ToolTip.Tip="The value is an average (or total) over the steps before the first escape, so it jumps wherever that step count changes — visible as thin terrace lines, especially as Relief height. On = blend across each jump using the fractional escape count, so the field is continuous." />
            <TextBlock Grid.Row="24" Grid.Column="0" Grid.ColumnSpan="2"
                       Text="Böttcher domain colouring: inside the Mandelbrot set (critical orbit bounded) it shows the c-orbit's own angle and potential. ComplexPlane map only."
                       IsVisible="{Binding IsDualOrbitDomain}"
                       TextWrapping="Wrap" FontSize="11" Opacity="0.7" Margin="0,4,0,0" />
        </Grid>

        <!-- Chaotic Billiard (#627); the scene rows are shared with Billiard Rays (#1506) -->
        <Grid IsVisible="{Binding IsBilliardScene}"
              ColumnDefinitions="160,*"
              RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Geometry:" VerticalAlignment="Center" />
            <ComboBox Grid.Row="0" Grid.Column="1"
                      ItemsSource="{Binding BilliardGeometries}"
                      SelectedItem="{Binding BilliardGeometry, Mode=TwoWay}"
                      Margin="0,2"
                      ToolTip.Tip="Obstacle arrangement. ThreeDisk = classic scatterer; Ring = disks evenly on a circle; NDisk = seeded random field; Custom = your own layout, edited by dragging disks in Ray Paths; Polygon = disks on a triangle, square, hexagon ... (Sides): one per corner, the rest spread along the edges, Fill adds the inside; SquareLattice / HexLattice = a patch of a square / triangular grid (Lorentz gas), Separation apart." />
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Disk count:" VerticalAlignment="Center" />
            <!-- #1538: Sides (and #1539 Fill) sit beside the count for the Polygon geometry,
                 #1539 Rotation for the lattices. -->
            <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto">
                <NumericUpDown Grid.Column="0"
                               Minimum="1" Maximum="256" Increment="1" FormatString="F0"
                               Value="{Binding BilliardDiskCount, Mode=TwoWay}" Margin="0,2"
                               ToolTip.Tip="Disk count for NDisk / Ring / Polygon / the lattices (up to 256; more disks trace slower). ThreeDisk ignores this (always 3). NDisk spreads its random field wider when the disks would not fit, so every disk is placed. Polygon puts one disk on each corner and spreads the rest along the edges. A lattice takes the sites nearest the centre, so it grows ring by ring." />
                <TextBlock Grid.Column="1" Text="Sides:" VerticalAlignment="Center" Margin="8,0,4,0"
                           IsVisible="{Binding IsBilliardPolygon}" />
                <NumericUpDown Grid.Column="2" Width="90" IsVisible="{Binding IsBilliardPolygon}"
                               Minimum="3" Maximum="12" Increment="1" FormatString="F0"
                               Value="{Binding BilliardPolygonSides, Mode=TwoWay}" Margin="0,2"
                               ToolTip.Tip="Polygon sides: 3 triangle, 4 square, 5 pentagon, 6 hexagon, 8 octagon (3-12). Separation is the corner radius." />
                <CheckBox Grid.Column="3" Content="Fill" Margin="8,0,0,0" IsVisible="{Binding IsBilliardPolygon}"
                          IsChecked="{Binding BilliardPolygonFill, Mode=TwoWay}"
                          ToolTip.Tip="Also fill the inside with disks on a grid at the edge spacing (square grid for 4 and 8 sides, triangular otherwise). The disk count still sets the perimeter; the fill adds to it, up to 256 disks in all." />
                <TextBlock Grid.Column="4" Text="Rotation:" VerticalAlignment="Center" Margin="8,0,4,0"
                           IsVisible="{Binding IsBilliardLattice}" />
                <NumericUpDown Grid.Column="5" Width="100" IsVisible="{Binding IsBilliardLattice}"
                               Minimum="-180" Maximum="180" Increment="5" FormatString="0.##########"
                               Value="{Binding BilliardLatticeRotation, Mode=TwoWay}" Margin="0,2"
                               ToolTip.Tip="Lattice rotation, degrees anticlockwise (-180 to 180)." />
            </Grid>
            <TextBlock Grid.Row="2" Grid.Column="0" Text="Disk radius:" VerticalAlignment="Center" />
            <NumericUpDown Grid.Row="2" Grid.Column="1"
                           Minimum="0.05" Maximum="1.5" Increment="0.05" FormatString="F2"
                           Value="{Binding BilliardDiskRadius, Mode=TwoWay}" Margin="0,2"
                           ToolTip.Tip="Mirror-disk radius in world units. Larger disks narrow the escape gaps toward deeper chaos." />
            <TextBlock Grid.Row="3" Grid.Column="0" Text="Separation:" VerticalAlignment="Center" />
            <NumericUpDown Grid.Row="3" Grid.Column="1"
                           Minimum="0.1" Maximum="3.0" Increment="0.05" FormatString="F2"
                           Value="{Binding BilliardSeparation, Mode=TwoWay}" Margin="0,2"
                           ToolTip.Tip="Centre-to-centre spacing (radius of the circle the disk centres sit on; the corner radius for Polygon; the grid spacing for the lattices). Wider = simpler basins; tighter = deeper chaos." />
            <TextBlock Grid.Row="4" Grid.Column="0" Text="Max bounces:" VerticalAlignment="Center" />
            <NumericUpDown Grid.Row="4" Grid.Column="1"
                           Minimum="1" Maximum="4096" Increment="16" FormatString="F0"
                           Value="{Binding BilliardMaxBounces, Mode=TwoWay}" Margin="0,2"
                           ToolTip.Tip="Reflection cap before a trajectory is declared trapped. Higher resolves the trapped (Cantor) set deeper at linear cost." />
            <TextBlock Grid.Row="5" Grid.Column="0" Text="Gate count:" VerticalAlignment="Center" IsVisible="{Binding IsBilliardScene}" />
            <NumericUpDown Grid.Row="5" Grid.Column="1" IsVisible="{Binding IsBilliardScene}"
                           Minimum="2" Maximum="64" Increment="1" FormatString="F0"
                           Value="{Binding BilliardGateCount, Mode=TwoWay}" Margin="0,2"
                           ToolTip.Tip="Sector gate mode only: number of compass sectors the exit direction is bucketed into. ExitGap mode uses one gate per gap between ring disks." />
            <TextBlock Grid.Row="6" Grid.Column="0" Text="Seed:" VerticalAlignment="Center" />
            <NumericUpDown Grid.Row="6" Grid.Column="1"
                           Minimum="-2147483648" Maximum="2147483647" Increment="1" FormatString="F0"
                           Value="{Binding BilliardSeed, Mode=TwoWay}" Margin="0,2"
                           ToolTip.Tip="PRNG seed for the NDisk random arrangement. Same seed + settings = identical field." />
            <TextBlock Grid.Row="7" Grid.Column="0" Text="Launch:" VerticalAlignment="Center" IsVisible="{Binding IsChaoticBilliard}" />
            <ComboBox Grid.Row="7" Grid.Column="1" IsVisible="{Binding IsChaoticBilliard}"
                      ItemsSource="{Binding BilliardLaunchModes}"
                      SelectedItem="{Binding BilliardLaunchMode, Mode=TwoWay}"
                      Margin="0,2"
                      ToolTip.Tip="FarField: rays come in from outside (x = impact offset, y = incoming angle). PhaseSpace: rays leave the surface of disk 0 (x = position around the disk, y = sine of the outgoing angle) — the chaotic set fills the view." />
            <TextBlock Grid.Row="8" Grid.Column="0" Text="Gate mode:" VerticalAlignment="Center" IsVisible="{Binding IsBilliardScene}" />
            <ComboBox Grid.Row="8" Grid.Column="1" IsVisible="{Binding IsBilliardScene}"
                      ItemsSource="{Binding BilliardGateModes}"
                      SelectedItem="{Binding BilliardGateMode, Mode=TwoWay}"
                      Margin="0,2"
                      ToolTip.Tip="ExitGap: colour by which gap between ring disks the ray leaves through (the Wada exit basins; ThreeDisk / Ring). Sector: equal compass sectors (Gate count)." />
            <CheckBox Grid.Row="9" Grid.Column="1" Content="Mute direct misses" IsVisible="{Binding IsChaoticBilliard}"
                      IsChecked="{Binding BilliardMuteMisses, Mode=TwoWay}" Margin="0,2"
                      ToolTip.Tip="Draw rays that never hit a mirror as a dark background, so the scattered rays carry the picture." />
            <Button Grid.Row="10" Grid.Column="1" Content="Ray paths..."
                    Command="{Binding ShowBilliardRayInsetCommand}" Margin="0,4,0,2"
                    ToolTip.Tip="Open the ray-path inset: hover the render to see that pixel's ray in real space; Ctrl+click to pin rays and compare neighbours across a basin boundary. Live only, never part of an export." />
            <!-- #1503: Ring / ThreeDisk neighbours touching closes the exit gaps. -->
            <TextBlock Grid.Row="11" Grid.Column="0" Grid.ColumnSpan="2"
                       Text="{Binding BilliardLayoutWarning}"
                       IsVisible="{Binding HasBilliardLayoutWarning}"
                       Foreground="#FFCC00" TextWrapping="Wrap" Margin="0,4,0,2" />
            <!-- #1504: Custom layouts are edited in the ray-path inset. -->
            <TextBlock Grid.Row="12" Grid.Column="0" Grid.ColumnSpan="2"
                       IsVisible="{Binding IsBilliardCustom}" TextWrapping="Wrap" Margin="0,4,0,2"
                       Text="Custom layout: open Ray paths and drag disks to move them, wheel to resize, double-click to add, right-click to remove. Disk count, separation and seed don't apply; disk radius sets the size of added disks. Pick another geometry to go back (the custom layout is kept)." />
        </Grid>

        <!-- Slit cascade (#1569, double-slit epic #1565): the recursive aperture and its diffraction -->
        <Grid IsVisible="{Binding IsSlitCascade}" ColumnDefinitions="160,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Children per slit:" VerticalAlignment="Center" />
            <NumericUpDown Grid.Row="0" Grid.Column="1"
                           Minimum="2" Maximum="16" Increment="1" FormatString="F0"
                           Value="{Binding SlitCascadeChildren, Mode=TwoWay}" Margin="0,2"
                           ToolTip.Tip="How many smaller slits replace each slit at every level. Use 3 or more: with a symmetric pair both children get the same share of light and the cascade is a plain Cantor set." />
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Layout:" VerticalAlignment="Center" />
            <ComboBox Grid.Row="1" Grid.Column="1"
                      ItemsSource="{Binding SlitCascadeLayouts}"
                      SelectedItem="{Binding SlitCascadeLayout, Mode=TwoWay}" Margin="0,2"
                      ToolTip.Tip="Line = the children sit in a row (a 1D grating, so the pattern is stripes). Ring = they sit round a circle (a 2D aperture)." />
            <TextBlock Grid.Row="2" Grid.Column="0" Text="Scale ratio r:" VerticalAlignment="Center" />
            <NumericUpDown Grid.Row="2" Grid.Column="1"
                           Minimum="0.01" Maximum="0.5" Increment="0.01" FormatString="F3"
                           Value="{Binding SlitCascadeRatio, Mode=TwoWay}" Margin="0,2"
                           ToolTip.Tip="Size of a child slit relative to its parent. Zooming the pattern out by 1/r shows the next level's structure." />
            <TextBlock Grid.Row="3" Grid.Column="0" Text="Depth (levels):" VerticalAlignment="Center" />
            <NumericUpDown Grid.Row="3" Grid.Column="1"
                           Minimum="1" Maximum="12" Increment="1" FormatString="F0"
                           Value="{Binding SlitCascadeDepth, Mode=TwoWay}" Margin="0,2"
                           ToolTip.Tip="How many times the slits are replaced. Render time grows with depth × children." />
            <TextBlock Grid.Row="4" Grid.Column="0" Text="Slit separation d:" VerticalAlignment="Center" />
            <NumericUpDown Grid.Row="4" Grid.Column="1"
                           Minimum="0" Maximum="100" Increment="0.05" FormatString="F3"
                           Value="{Binding SlitCascadeSeparation, Mode=TwoWay}" Margin="0,2"
                           ToolTip.Tip="Separation of the two slits whose fringe pattern decides how much light each child gets. Larger d = more fringes across the children." />
            <TextBlock Grid.Row="5" Grid.Column="0" Text="Slit width w:" VerticalAlignment="Center" />
            <NumericUpDown Grid.Row="5" Grid.Column="1"
                           Minimum="0" Maximum="100" Increment="0.05" FormatString="F3"
                           Value="{Binding SlitCascadeWidth, Mode=TwoWay}" Margin="0,2"
                           ToolTip.Tip="Width of those two slits: it sets the envelope that dims the outer fringes. 0 = no envelope." />
            <TextBlock Grid.Row="6" Grid.Column="0" Text="Wavelength λ:" VerticalAlignment="Center" />
            <NumericUpDown Grid.Row="6" Grid.Column="1"
                           Minimum="0.001" Maximum="100" Increment="0.05" FormatString="F3"
                           Value="{Binding SlitCascadeWavelength, Mode=TwoWay}" Margin="0,2"
                           ToolTip.Tip="Wavelength of the light (the screen distance is folded in). Changing it slides the fringes, so children move on and off dark fringes; a child on a dark fringe drops out. Animatable." />
            <TextBlock Grid.Row="7" Grid.Column="0" Text="Show:" VerticalAlignment="Center" />
            <ComboBox Grid.Row="7" Grid.Column="1"
                      ItemsSource="{Binding SlitCascadeViews}"
                      SelectedItem="{Binding SlitCascadeView, Mode=TwoWay}" Margin="0,2"
                      ToolTip.Tip="Intensity = the far-field diffraction pattern on a log scale. Phase = its phase. Aperture = the slits themselves, brighter where more light gets through." />
            <TextBlock Grid.Row="8" Grid.Column="0" Text="Dynamic range (decades):" VerticalAlignment="Center" />
            <NumericUpDown Grid.Row="8" Grid.Column="1"
                           Minimum="0.5" Maximum="30" Increment="0.5" FormatString="F1"
                           Value="{Binding SlitCascadeDynamicRange, Mode=TwoWay}" Margin="0,2"
                           ToolTip.Tip="How many powers of ten of brightness the colours span. Raise it to see the faint outer orders." />
        </Grid>

        <!-- Math Plane (#1548): the scene as text. S2 (#1549) adds the object editor. -->
        <StackPanel IsVisible="{Binding IsMathPlane}" Spacing="4">
            <TextBlock Text="Scene" FontWeight="Bold" />
            <TextBox Text="{Binding MathPlaneSceneText, Mode=TwoWay}"
                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90" MaxHeight="260"
                     FontFamily="Consolas, Menlo, monospace"
                     ToolTip.Tip="One statement per line or separated by ';'. point NAME x y | vector NAME x y [from x0 y0] | segment NAME x1 y1 x2 y2 | polyline NAME x1 y1 x2 y2 ... Options: #RRGGBB, hidden, nolabel. Settings: axes on|off, grid on|off, ticks on|off, labels auto|offset|fixed:N|sci:N." />
            <TextBlock Text="{Binding MathPlaneSceneError}"
                       IsVisible="{Binding MathPlaneSceneError, Converter={x:Static ObjectConverters.IsNotNull}}"
                       Foreground="#FFCC00" TextWrapping="Wrap" />
            <TextBlock TextWrapping="Wrap" Foreground="#9B9B9B"
                       Text="Example: vector v 2 1 #E69F00; point A -1 2; segment s 0 0 1 1; polyline p 0 0 1 1 2 0" />
            <TextBlock TextWrapping="Wrap" Foreground="#9B9B9B"
                       Text="Control Center → Math Plane has the object editor; on the render, drag points and vector tips (Shift snaps), double-click to add a point, Delete removes the selected one." />
        </StackPanel>

        <!-- Billiard Rays (#1506): the sweep that emits the rays -->
        <Grid IsVisible="{Binding IsBilliardRays}"
              ColumnDefinitions="160,*"
              RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Sweep:" VerticalAlignment="Center" />
            <ComboBox Grid.Row="0" Grid.Column="1"
                      ItemsSource="{Binding BilliardRaySweeps}"
                      SelectedItem="{Binding BilliardRaysSweep, Mode=TwoWay}"
                      Margin="0,2"
                      ToolTip.Tip="How rays enter the disk array. BSweep: parallel beams, impact offset swept across the play circle. AngleSweep: an emitter going round the play circle, aiming inward. PointSource: a fan from one point. RandomFarField: random beams. PhaseSpace: random rays leaving disk 0." />
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Rays:" VerticalAlignment="Center" />
            <NumericUpDown Grid.Row="1" Grid.Column="1"
                           Minimum="1" Maximum="2000000" Increment="1000" FormatString="F0"
                           Value="{Binding BilliardRaysCount, Mode=TwoWay}" Margin="0,2"
                           ToolTip.Tip="Total rays emitted. Cost grows with rays x bounces x the length drawn." />
            <TextBlock Grid.Row="2" Grid.Column="0" Text="Beams:" VerticalAlignment="Center" IsVisible="{Binding IsRaysBSweep}" />
            <NumericUpDown Grid.Row="2" Grid.Column="1" IsVisible="{Binding IsRaysBSweep}"
                           Minimum="1" Maximum="360" Increment="1" FormatString="F0"
                           Value="{Binding BilliardRaysAngleCount, Mode=TwoWay}" Margin="0,2"
                           ToolTip.Tip="Number of beam directions, evenly spaced round the circle from the beam angle. 1 = a single parallel beam; the rays are shared between the beams." />
            <TextBlock Grid.Row="3" Grid.Column="0" Text="Angle (deg):" VerticalAlignment="Center" IsVisible="{Binding RaysUsesAngle}" />
            <NumericUpDown Grid.Row="3" Grid.Column="1" IsVisible="{Binding RaysUsesAngle}"
                           Minimum="-360" Maximum="360" Increment="5" FormatString="0.##########"
                           Value="{Binding BilliardRaysAngle, Mode=TwoWay}" Margin="0,2"
                           ToolTip.Tip="BSweep: direction the first beam travels (0 = left to right). AngleSweep: where the emitter starts round the circle. PointSource: the fan's centre direction. Up to 10 decimals are shown and kept (type them in); the tracer works in doubles, so digits past about 15 significant figures change nothing." />
            <TextBlock Grid.Row="4" Grid.Column="0" Text="Spread (deg):" VerticalAlignment="Center" IsVisible="{Binding RaysUsesSpread}" />
            <NumericUpDown Grid.Row="4" Grid.Column="1" IsVisible="{Binding RaysUsesSpread}"
                           Minimum="0" Maximum="360" Increment="5" FormatString="0.##########"
                           Value="{Binding BilliardRaysSpread, Mode=TwoWay}" Margin="0,2"
                           ToolTip.Tip="AngleSweep: rays aim within half this either side of the centre. PointSource: the fan's full width (360 = every direction)." />
            <TextBlock Grid.Row="5" Grid.Column="0" Text="Source X:" VerticalAlignment="Center" IsVisible="{Binding IsRaysPointSource}" />
            <NumericUpDown Grid.Row="5" Grid.Column="1" IsVisible="{Binding IsRaysPointSource}"
                           Minimum="-20" Maximum="20" Increment="0.1" FormatString="0.##########"
                           Value="{Binding BilliardRaysSourceX, Mode=TwoWay}" Margin="0,2"
                           ToolTip.Tip="Fan origin, world units. A point inside a disk emits nothing." />
            <TextBlock Grid.Row="6" Grid.Column="0" Text="Source Y:" VerticalAlignment="Center" IsVisible="{Binding IsRaysPointSource}" />
            <NumericUpDown Grid.Row="6" Grid.Column="1" IsVisible="{Binding IsRaysPointSource}"
                           Minimum="-20" Maximum="20" Increment="0.1" FormatString="0.##########"
                           Value="{Binding BilliardRaysSourceY, Mode=TwoWay}" Margin="0,2"
                           ToolTip.Tip="Fan origin y, world units. Up to 10 decimals are shown and kept; the tracer works in doubles, so digits past about 15 significant figures change nothing." />
            <TextBlock Grid.Row="7" Grid.Column="0" Text="Ray seed:" VerticalAlignment="Center" IsVisible="{Binding RaysUsesSeed}" />
            <NumericUpDown Grid.Row="7" Grid.Column="1" IsVisible="{Binding RaysUsesSeed}"
                           Minimum="-2147483648" Maximum="2147483647" Increment="1" FormatString="F0"
                           Value="{Binding BilliardRaysSeed, Mode=TwoWay}" Margin="0,2"
                           ToolTip.Tip="Seed for the random sweeps and the AngleSweep aim offsets. Same seed = same rays." />
            <TextBlock Grid.Row="8" Grid.Column="0" Text="Min bounces:" VerticalAlignment="Center" />
            <NumericUpDown Grid.Row="8" Grid.Column="1"
                           Minimum="0" Maximum="4096" Increment="1" FormatString="F0"
                           Value="{Binding BilliardRaysMinBounces, Mode=TwoWay}" Margin="0,2"
                           ToolTip.Tip="Rays with fewer reflections are not drawn. 2 (default) drops straight misses and rays that glance off one disk and leave; 0 draws everything." />
            <CheckBox Grid.Row="9" Grid.Column="1" Content="Show disks"
                      IsChecked="{Binding BilliardRaysShowDisks, Mode=TwoWay}" Margin="0,2"
                      ToolTip.Tip="Draw the mirror disks over the ray density." />
            <!-- #1507: hue source; brightness is always the log density. -->
            <TextBlock Grid.Row="10" Grid.Column="0" Text="Colour by:" VerticalAlignment="Center" />
            <ComboBox Grid.Row="10" Grid.Column="1"
                      ItemsSource="{Binding BilliardRayColorSources}"
                      SelectedItem="{Binding BilliardRaysColorSource, Mode=TwoWay}"
                      Margin="0,2"
                      ToolTip.Tip="What sets the colour; brightness is always how much ray path crosses the pixel. Density: theme gradient over density. Gate: the exit-gate colours of the rays crossing it, mixed by length (trapped rays grey; uses Gate mode / Gate count). Bounces, PathLength, EntryAngle, ExitAngle, GateDistance (gates between entry and exit), SelfIntersects (share of rays crossing their own path): the average of that value through the theme gradient. Dark grey = no value (e.g. no exit for trapped rays)." />
            <!-- #1508: crossings between rays. -->
            <TextBlock Grid.Row="11" Grid.Column="0" Text="Draw:" VerticalAlignment="Center" />
            <ComboBox Grid.Row="11" Grid.Column="1"
                      ItemsSource="{Binding BilliardRayModes}"
                      SelectedItem="{Binding BilliardRaysMode, Mode=TwoWay}"
                      Margin="0,2"
                      ToolTip.Tip="Paths: the rays themselves. Crossings: only the points where a ray crosses one drawn shortly before it. Both: crossings over the paths. Divergence: where each ray parts from its sweep neighbour (the ray launched next to it) - the exit-basin boundary in real space; DivergenceOverPaths draws it over the paths. Escaped: rays that leave through a gate without crossing any ray in the crossing window are drawn, the crossings of the rest are marked; the status bar shows how many rays escaped, crossed or were trapped. Crossings and divergence also become the relief height." />
            <TextBlock Grid.Row="12" Grid.Column="0" Text="Crossing window:" VerticalAlignment="Center" IsVisible="{Binding RaysShowsCrossings}" />
            <NumericUpDown Grid.Row="12" Grid.Column="1" IsVisible="{Binding RaysShowsCrossings}"
                           Minimum="0" Maximum="50000" Increment="10" FormatString="F0"
                           Value="{Binding BilliardRaysCrossingWindow, Mode=TwoWay}" Margin="0,2"
                           ToolTip.Tip="Each ray is checked against this many rays drawn just before it in sweep order (0 = none). Larger finds more crossings and costs more; this is the one setting where emission order matters." />
            <TextBlock Grid.Row="13" Grid.Column="0" Text="Crossing colour:" VerticalAlignment="Center" IsVisible="{Binding RaysShowsCrossings}" />
            <ComboBox Grid.Row="13" Grid.Column="1" IsVisible="{Binding RaysShowsCrossings}"
                      ItemsSource="{Binding BilliardCrossingValues}"
                      SelectedItem="{Binding BilliardRaysCrossingValue, Mode=TwoWay}"
                      Margin="0,2"
                      ToolTip.Tip="Count: how many crossings. DeltaN: current minus previous ray's bounce count at the crossing (mid-gradient = equal). Angle: how steeply they cross. PreviousFromEntry / PreviousToExit / CurrentFromEntry / CurrentToExit: path length along that ray from where it entered to the crossing, or on to where it left." />
            <CheckBox Grid.Row="14" Grid.Column="1" Content="Include self-crossings" IsVisible="{Binding RaysShowsCrossings}"
                      IsChecked="{Binding BilliardRaysSelfCrossings, Mode=TwoWay}" Margin="0,2"
                      ToolTip.Tip="Also draw where a ray crosses its own path (always counted separately)." />
            <!-- #1509: neighbour divergence. -->
            <TextBlock Grid.Row="15" Grid.Column="0" Text="Divergence colour:" VerticalAlignment="Center" IsVisible="{Binding RaysShowsDivergence}" />
            <ComboBox Grid.Row="15" Grid.Column="1" IsVisible="{Binding RaysShowsDivergence}"
                      ItemsSource="{Binding BilliardDivergenceValues}"
                      SelectedItem="{Binding BilliardRaysDivergenceValue, Mode=TwoWay}"
                      Margin="0,2"
                      ToolTip.Tip="Marks sit on the last mirror two neighbouring rays both hit before they part. BounceDifference: how different their bounce counts end up. GateChange: whether they leave through different gates. Separation: how far apart their next hits are. CommonBounces: how many mirrors they shared. Random sweeps have no neighbours, so they draw no marks." />
            <!-- #1510: escaped rays. -->
            <TextBlock Grid.Row="16" Grid.Column="0" Text="Escaped colour:" VerticalAlignment="Center" IsVisible="{Binding RaysShowsEscaped}" />
            <ComboBox Grid.Row="16" Grid.Column="1" IsVisible="{Binding RaysShowsEscaped}"
                      ItemsSource="{Binding BilliardEscapedColours}"
                      SelectedItem="{Binding BilliardRaysEscapedColour, Mode=TwoWay}"
                      Margin="0,2"
                      ToolTip.Tip="How the escaped rays (no crossing with an earlier ray in the window) are drawn: by the gates between entry and exit, path length or bounces; plain grey; or Hidden to show only the crossings. A ray's class is worked out over the whole play circle, not just the view." />
            <!-- #1511: sweep progress (animatable). -->
            <TextBlock Grid.Row="17" Grid.Column="0" Text="Sweep progress:" VerticalAlignment="Center" />
            <NumericUpDown Grid.Row="17" Grid.Column="1"
                           Minimum="0" Maximum="1" Increment="0.05" FormatString="F2"
                           Value="{Binding BilliardRaysProgress, Mode=TwoWay}" Margin="0,2"
                           ToolTip.Tip="Fraction of the sweep emitted, in order (1 = all rays). Animate it from 0 to 1 to watch the rays arrive." />
            <TextBlock Grid.Row="18" Grid.Column="0" Grid.ColumnSpan="2" TextWrapping="Wrap" Margin="0,4,0,2"
                       Text="Each pixel shows how much ray path crosses it (log scale). Emission order does not change the paths, since rays do not interact; it does decide which rays count as previous for crossings." />
        </Grid>

        <!-- Precision Field (#628) -->
        <Grid IsVisible="{Binding IsPrecisionField}"
              ColumnDefinitions="160,*"
              RowDefinitions="Auto,Auto,Auto,Auto">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Low tier:" VerticalAlignment="Center" />
            <ComboBox Grid.Row="0" Grid.Column="1"
                      ItemsSource="{Binding PrecisionTiers}"
                      SelectedItem="{Binding PrecisionLowTier, Mode=TwoWay}"
                      Margin="0,2"
                      ToolTip.Tip="Lower arithmetic tier. Float (32-bit) loses precision first — its disagreement with the reference is the fragility map. Float/Double/DoubleDouble/QuadDouble." />
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Reference tier:" VerticalAlignment="Center" />
            <ComboBox Grid.Row="1" Grid.Column="1"
                      ItemsSource="{Binding PrecisionTiers}"
                      SelectedItem="{Binding PrecisionHighTier, Mode=TwoWay}"
                      Margin="0,2"
                      ToolTip.Tip="Upper (reference) tier. Use DoubleDouble / QuadDouble to probe deep-zoom fragility that Double itself cannot resolve." />
            <TextBlock Grid.Row="2" Grid.Column="0" Text="Diff metric:" VerticalAlignment="Center" />
            <ComboBox Grid.Row="2" Grid.Column="1"
                      ItemsSource="{Binding PrecisionDiffMetrics}"
                      SelectedItem="{Binding PrecisionDiffMetric, Mode=TwoWay}"
                      Margin="0,2"
                      ToolTip.Tip="How the two tiers' outcomes combine: L2 over (Δ iteration, Δ angle), or either channel alone." />
            <TextBlock Grid.Row="3" Grid.Column="1"
                       Text="Interior/agreeing pixels go dark; boundary filaments where the low tier breaks light up. Zoom in until the low tier fails."
                       TextWrapping="Wrap" FontSize="11" Opacity="0.7" Margin="0,4" />
        </Grid>

    </StackPanel>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FracturingFog.UI.Avalonia.ViewModels"
        x:Class="FracturingFog.UI.Avalonia.Views.ControlCenterSections.AdvancedSectionView"
        x:DataType="vm:ControlCenterViewModel"
        Foreground="#DCDCDC">
    <!-- ═══ Advanced ═══ (extracted from ControlCenterView for detach/pop-out) -->
    <StackPanel Spacing="0">
        <Border Classes="group">
            <StackPanel Spacing="6">
                <TextBlock Classes="section" Text="Remote Rendering" />
                <UniformGrid Columns="2">
                    <Button Classes="action neutral" Content="Server…" Command="{Binding Menu.ServerCommand}" HorizontalAlignment="Stretch" Margin="0,0,4,0" ToolTip.Tip="Local render server: status, metrics, start/restart/kill" />
                    <Button Classes="action neutral" Content="Client…" Command="{Binding Menu.ClientCommand}" HorizontalAlignment="Stretch" ToolTip.Tip="Connect to a remote FracturingFog server" />
                </UniformGrid>
            </StackPanel>
        </Border>

        <Border Classes="group">
            <StackPanel Spacing="6">
                <TextBlock Classes="section" Text="GPU / Performance" />
                <CheckBox Content="GPU compute"
                          IsChecked="{Binding Menu.UseGpuCompute, Mode=TwoWay}"
                          ToolTip.Tip="Ctrl+G — run the shallow Mandelbrot pass on the GPU, using whichever compute backend this session attached (D3D11 on Windows, or Vulkan/SPIR-V under --renderer vulkan). Clears itself if no device can engage. Deep-zoom stays on the CPU." />
                <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                    <CheckBox Grid.Column="0" Content="Dynamic preview resolution"
                              IsChecked="{Binding Menu.DynamicPreviewResolution, Mode=TwoWay}"
                              ToolTip.Tip="While you drag or zoom, size the first preview from how long recent frames took: as fine as the frame-time target allows, from 1/8 resolution up to full (no preview at all when a full frame already fits). The final frame is always full resolution and unchanged. Off: the fixed 1/4, 1/2, full ladder." />
                    <NumericUpDown Grid.Column="2"
                                   Value="{Binding Menu.InteractiveTargetMs, Mode=TwoWay}"
                                   Minimum="4" Maximum="500" Increment="1"
                                   FormatString="0"
                                   Width="110"
                                   IsEnabled="{Binding Menu.DynamicPreviewResolution}"
                                   ToolTip.Tip="Frame-time target for interactive previews, in milliseconds (33 = about 30 frames a second, 16 = about 60)" />
                    <TextBlock Grid.Column="3" Classes="fxLabel" Text="ms" VerticalAlignment="Center" Margin="4,0,0,0" />
                </Grid>
                <CheckBox Content="Temporal 3D lighting"
                          IsChecked="{Binding Menu.TemporalLighting3D, Mode=TwoWay}"
                          ToolTip.Tip="3D views (CPU raymarch): while you move the camera, each pixel recomputes its ambient occlusion and soft shadows only every 4th frame and otherwise reuses them from where its surface point was in the previous frame, so moving frames render faster but their AO / shadows are approximate. When the view settles, one more frame is rendered in full — exactly as with this off. Batch and export are unaffected." />
                <CheckBox Content="Distance-field cache for 3D camera moves"
                          IsChecked="{Binding Menu.DistanceFieldCache3D, Mode=TwoWay}"
                          ToolTip.Tip="KIFS, User Bulb, Mandelbulb and Mandelbox (CPU raymarch): the fractal's distance field is baked once in the background into a sparse voxel volume, and while you only move the camera the frames march that instead of the formula, so they render much faster. Moving frames are a preview: detail finer than a voxel is smoothed. When the view settles, one more frame is rendered with the true formula — exactly as with this off. Changing the fractal re-bakes. Batch and export are unaffected." />
            </StackPanel>
        </Border>

        <Border Classes="group">
            <StackPanel Spacing="6">
                <TextBlock Classes="section" Text="System" />
                <Button Classes="action slideshow" Content="App Settings…"     Command="{Binding Menu.AppSettingsCommand}"     HorizontalAlignment="Stretch" ToolTip.Tip="Application settings" />
                <Button Classes="action video"     Content="FFmpeg…"           Command="{Binding Menu.FfmpegSetupCommand}"     HorizontalAlignment="Stretch" ToolTip.Tip="Install, update, or skip the FFmpeg video encoder" />
                <Button Classes="action video"     Content="Denoiser (Intel OIDN)…" Command="{Binding Menu.OidnSetupCommand}" HorizontalAlignment="Stretch" ToolTip.Tip="Install Intel Open Image Denoise, the learned denoiser behind Lighting &amp; FX → Denoise (Intel OIDN)" />
                <Button Classes="action neutral"   Content="AppData Location…" Command="{Binding Menu.AppDataLocationCommand}" HorizontalAlignment="Stretch" ToolTip.Tip="Choose where FracturingFog stores its data" />
                <Button Classes="action help"      Content="Help…"             Command="{Binding Menu.HelpCommand}"            HorizontalAlignment="Stretch" ToolTip.Tip="Open help" />
                <Button Classes="action danger"    Content="Close Program"     Command="{Binding Menu.CloseProgramCommand}"    HorizontalAlignment="Stretch" Margin="0,8,0,0" ToolTip.Tip="Exit Fracturing Fog" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FracturingFog.UI.Avalonia.ViewModels"
        x:Class="FracturingFog.UI.Avalonia.Views.ControlCenterSections.ColorLightSectionView"
        x:DataType="vm:ControlCenterViewModel"
        Foreground="#DCDCDC">
    <!-- ═══ Color & Light ═══ (extracted from ControlCenterView for detach/pop-out) -->
    <StackPanel Spacing="0">
        <Border Classes="group">
            <StackPanel Spacing="6">
                <TextBlock Classes="section" Text="Color Themes" />
                <ComboBox ItemsSource="{Binding Menu.ThemeNames}" SelectedItem="{Binding Menu.SelectedTheme}" HorizontalAlignment="Stretch" Margin="0,4,0,0" />
                <UniformGrid Columns="4">
                    <Button Classes="action neutral" Content="Exp…"   Command="{Binding Menu.ExportThemeCommand}"  ToolTip.Tip="Export current theme to JSON" Margin="0,0,4,0" />
                    <Button Classes="action neutral" Content="Imp…"   Command="{Binding Menu.ImportThemeCommand}"  ToolTip.Tip="Import themes from JSON" Margin="0,0,4,0" />
                    <Button Classes="action danger"  Content="Delete" Command="{Binding Menu.DeleteThemeCommand}"  ToolTip.Tip="Delete selected user theme" Margin="0,0,4,0" />
                    <Button Classes="action neutral" Content="Reload" Command="{Binding Menu.ReloadThemesCommand}" ToolTip.Tip="Reload themes from disk" />
                </UniformGrid>
                <Button Classes="action help" Content="Edit Theme…" Command="{Binding Menu.EditThemeCommand}" HorizontalAlignment="Stretch" Margin="0,4,0,0" ToolTip.Tip="Open the Color Theme Editor" />
                <Button Classes="action neutral" Content="Save Lighting → Theme" Command="{Binding Menu.SaveLightingToThemeCommand}" HorizontalAlignment="Stretch" Margin="0,4,0,0" ToolTip.Tip="Snapshot the active Lighting &amp; FX block as the selected user theme's bundled preset" />
            </StackPanel>
        </Border>

        <Border Classes="group">
            <StackPanel Spacing="6">
                <TextBlock Classes="section" Text="Lighting &amp; FX" />
                <Button Classes="action help" Content="Volumetric Lighting &amp; FX…" Command="{Binding Shell.ShowLightingFxCommand}" HorizontalAlignment="Stretch"
                        ToolTip.Tip="Opens the standalone Lighting &amp; FX panel (lights, ambient occlusion, fog, tonemap, HDRI/IBL) — no longer buried inside Fractal Params. Stays open across fractal-type changes." />
            </StackPanel>
        </Border>

        <Border Classes="group">
            <StackPanel Spacing="4">
                <TextBlock Classes="section" Text="Post-FX" />
                <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" Margin="0,4,0,0">
                    <TextBlock Grid.Row="0" Grid.Column="0" Classes="fxLabel" Text="{Binding Menu.BrightnessLabel}" Margin="0,0,6,4" />
                    <Slider    Grid.Row="0" Grid.Column="1" Value="{Binding Menu.Brightness}" Minimum="-100" Maximum="100" TickFrequency="25" Margin="0,0,6,4" ToolTip.Tip="Brightness (-100..100)" />
                    <CheckBox  Grid.Row="0" Grid.Column="2" IsChecked="{Binding Menu.BrightnessLocked}" ToolTip.Tip="Lock brightness" Margin="0,0,0,4" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Classes="fxLabel" Text="{Binding Menu.ContrastLabel}" Margin="0,0,6,4" />
                    <Slider    Grid.Row="1" Grid.Column="1" Value="{Binding Menu.Contrast}" Minimum="-100" Maximum="100" TickFrequency="25" Margin="0,0,6,4" ToolTip.Tip="Contrast (-100..100)" />
                    <CheckBox  Grid.Row="1" Grid.Column="2" IsChecked="{Binding Menu.ContrastLocked}" ToolTip.Tip="Lock contrast" Margin="0,0,0,4" />
                    <TextBlock Grid.Row="2" Grid.Column="0" Classes="fxLabel" Text="{Binding Menu.AdaptiveLabel}" Margin="0,0,6,0" IsEnabled="{Binding Menu.AdaptiveEnabled}" />
                    <Slider    Grid.Row="2" Grid.Column="1" Value="{Binding Menu.Adaptive}" Minimum="0" Maximum="100" TickFrequency="25" Margin="0,0,6,0" IsEnabled="{Binding Menu.AdaptiveEnabled}" ToolTip.Tip="Adaptive contrast (0=off, 100=full)" />
                    <CheckBox  Grid.Row="2" Grid.Column="2" IsChecked="{Binding Menu.AdaptiveLocked}" IsEnabled="{Binding Menu.AdaptiveEnabled}" ToolTip.Tip="Lock adaptive" />
                    <TextBlock Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Classes="fxLabel" Text="Lock Lighting &amp; FX" Margin="0,4,6,0" />
                    <CheckBox  Grid.Row="3" Grid.Column="2" IsChecked="{Binding Menu.LightingLocked}" ToolTip.Tip="Lock lighting — ignore theme presets" Margin="0,4,0,0" />
                </Grid>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>

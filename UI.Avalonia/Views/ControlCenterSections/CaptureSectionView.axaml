<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FracturingFog.UI.Avalonia.ViewModels"
        x:Class="FracturingFog.UI.Avalonia.Views.ControlCenterSections.CaptureSectionView"
        x:DataType="vm:ControlCenterViewModel"
        Foreground="#DCDCDC">
    <!-- ═══ Capture ═══ (extracted from ControlCenterView for detach/pop-out) -->
    <StackPanel Spacing="0">
        <Border Classes="group">
            <StackPanel Spacing="6">
                <TextBlock Classes="section" Text="Stills &amp; Video" />
                <UniformGrid Columns="3">
                    <Button Classes="action neutral"   Content="Image"  Command="{Binding Menu.ScreenshotCommand}" ToolTip.Tip="High-resolution screenshot" Margin="0,0,4,0" />
                    <Button Classes="action neutral"   Content="{Binding Menu.PosterButtonText}" Command="{Binding Menu.PosterCommand}"     ToolTip.Tip="Print-ready poster image (click again while rendering to cancel)" Margin="0,0,4,0" />
                    <Button Classes="action video"     Content="{Binding Menu.VideoButtonText}" Command="{Binding Menu.VideoCommand}" ToolTip.Tip="Animated zoom" />
                </UniformGrid>
                <UniformGrid Columns="2" Margin="0,4,0,0">
                    <Button Classes="action neutral"   Content="Text Art…" Command="{Binding Shell.AsciiArtCommand}" ToolTip.Tip="Save the current frame as ASCII / text art (HTML, SVG, ANSI, plain text or braille — chosen by file extension)" Margin="0,0,4,0" />
                    <Button Classes="action neutral"   Content="Record ASCII…" Command="{Binding Shell.RecordAsciiCommand}" ToolTip.Tip="Record the current view's ASCII FX animation to a shareable file (asciinema .cast, animated SVG, ANSI frame sequence, or MP4 video). Uses the active preset / FX panel." />
                </UniformGrid>
                <UniformGrid Columns="2" Margin="0,4,0,0">
                    <Button Classes="action slideshow" Content="{Binding Menu.SlideshowButtonText}" Command="{Binding Menu.SlideshowCommand}" ToolTip.Tip="Start/stop slideshow" Margin="0,0,4,0" />
                    <Button Classes="action slideshow" Content="Slideshow Settings…" Command="{Binding Menu.SlideshowSettingsCommand}" ToolTip.Tip="Configure slideshow timing + audio-reactive options" />
                </UniformGrid>
                <UniformGrid Columns="2" Margin="0,4,0,0">
                    <Button Classes="action slideshow" Content="Audio Settings…" Command="{Binding Menu.AudioSettingsCommand}" ToolTip.Tip="Audio-reactive settings: source, sensitivity, band weights, live meter" Margin="0,0,4,0" />
                </UniformGrid>
                <UniformGrid Columns="2" Margin="0,4,0,0">
                    <Button Classes="action slideshow" Content="Lock Region" Command="{Binding Shell.ToggleSlideshowLockRegionCommand}" IsEnabled="{Binding Shell.IsSlideshowRunning}" Margin="0,0,4,0" ToolTip.Tip="Pin the running slideshow to the current region (only while a slideshow is running)" />
                    <Button Classes="action slideshow" Content="More Colors" Command="{Binding Shell.ToggleSlideshowFocusCommand}"      IsEnabled="{Binding Shell.IsSlideshowRunning}" ToolTip.Tip="Toggle 3 vs 8 themes per region while the slideshow runs" />
                </UniformGrid>
            </StackPanel>
        </Border>

        <Border Classes="group">
            <StackPanel Spacing="6">
                <TextBlock Classes="section" Text="CLI Command" />
                <TextBlock Text="Generate a copy/paste --batch command that reproduces the current 2D view."
                           Foreground="#9A9A9A" FontSize="11" TextWrapping="Wrap" />
                <UniformGrid Columns="2">
                    <StackPanel Margin="0,0,4,0">
                        <TextBlock Text="Width" Foreground="#9A9A9A" FontSize="11" />
                        <NumericUpDown Value="{Binding CommandWidth, Mode=TwoWay}" Minimum="1" Maximum="61440" Increment="16" FormatString="0" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Height" Foreground="#9A9A9A" FontSize="11" />
                        <NumericUpDown Value="{Binding CommandHeight, Mode=TwoWay}" Minimum="1" Maximum="34560" Increment="16" FormatString="0" />
                    </StackPanel>
                </UniformGrid>
                <UniformGrid Columns="2">
                    <Button Classes="action neutral" Content="Generate" Command="{Binding GenerateCommandCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,0,4,0" ToolTip.Tip="Build the --batch command from the current fractal, coordinates, theme, quality, size and post-FX" />
                    <Button Classes="action neutral" Content="Copy" Command="{Binding CopyCommandCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" ToolTip.Tip="Copy the generated command to the clipboard (generates it first if empty)" />
                </UniformGrid>
                <TextBox Text="{Binding GeneratedCommand, Mode=OneWay}" IsReadOnly="True"
                         AcceptsReturn="True" TextWrapping="Wrap"
                         FontFamily="Consolas,Menlo,monospace" FontSize="11"
                         MinHeight="72" MaxHeight="160"
                         PlaceholderText="Click Generate to build the command…"
                         VerticalContentAlignment="Top"
                         ToolTip.Tip="Read-only. Replace &lt;OUTPUT.png&gt; with your target file path before running." />
                <TextBlock Text="Replace &lt;OUTPUT.png&gt; with a real path. Lighting, relief, acid and other fx are not represented yet."
                           Foreground="#9A9A9A" FontSize="10" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Border Classes="group">
            <StackPanel Spacing="6">
                <TextBlock Classes="section" Text="Watermark" />
                <CheckBox Content="Show watermark" IsChecked="{Binding Menu.ShowWatermark, Mode=TwoWay}" ToolTip.Tip="Master toggle for the on-screen watermark overlay" />
                <CheckBox Content="Use custom watermark" IsChecked="{Binding Menu.UseCustomWatermark, Mode=TwoWay}" ToolTip.Tip="Replace the default region/theme watermark with your saved custom one" />
                <ComboBox ItemsSource="{Binding Menu.WatermarkNames}" SelectedItem="{Binding Menu.SelectedWatermark}" IsEnabled="{Binding Menu.UseCustomWatermark}" HorizontalAlignment="Stretch" />
                <CheckBox Content="Override region watermark" IsChecked="{Binding Menu.OverrideRegionWatermark, Mode=TwoWay}" ToolTip.Tip="Force the active custom watermark even when the region carries its own" />
                <Button Classes="action help" Content="Edit Watermark…" Command="{Binding Menu.EditWatermarkCommand}" HorizontalAlignment="Stretch" Margin="0,4,0,0" ToolTip.Tip="Open the Watermark Editor" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>

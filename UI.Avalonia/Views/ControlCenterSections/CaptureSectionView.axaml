<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FracturingFog.UI.Avalonia.ViewModels"
        x:Class="FracturingFog.UI.Avalonia.Views.ControlCenterSections.CaptureSectionView"
        x:DataType="vm:ControlCenterViewModel"
        Foreground="#DCDCDC">
    <UserControl.Styles>
        <Style Selector="TextBlock.qrstatus">
            <Setter Property="Foreground" Value="#B4B4B4" />
        </Style>
        <Style Selector="TextBlock.qrstatus.warn">
            <Setter Property="Foreground" Value="#FFCC00" />
        </Style>
    </UserControl.Styles>
    <!-- ═══ Capture ═══ (extracted from ControlCenterView for detach/pop-out) -->
    <StackPanel Spacing="0">
        <Border Classes="group">
            <StackPanel Spacing="6">
                <TextBlock Classes="section" Text="Stills &amp; Video" />
                <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
                    <Button Grid.Column="0" Classes="action neutral"   Content="Image"  Command="{Binding Menu.ScreenshotCommand}" ToolTip.Tip="High-resolution screenshot" Margin="0,0,4,0" />
                    <Button Grid.Column="2" Classes="action neutral"   Content="{Binding Menu.PosterButtonText}" Command="{Binding Menu.PosterCommand}"     ToolTip.Tip="Print-ready poster image (click again while rendering to cancel)" Margin="0,0,4,0" />
                    <Button Grid.Column="3" Classes="action video"     Content="{Binding Menu.VideoButtonText}" Command="{Binding Menu.VideoCommand}" ToolTip.Tip="Animated zoom" Margin="0,0,4,0"/>
                    <Button Grid.Column="4" Classes="action neutral"   Content="Text Art…" Command="{Binding Shell.AsciiArtCommand}" ToolTip.Tip="Save the current frame as ASCII / text art (HTML, SVG, ANSI, plain text or braille — chosen by file extension)" Margin="0,0,4,0" />
                    <Button Grid.Column="5" Classes="action neutral"   Content="Record ASCII…" Command="{Binding Shell.RecordAsciiCommand}" ToolTip.Tip="Record the current view's ASCII FX animation to a shareable file (asciinema .cast, animated SVG, ANSI frame sequence, or MP4 video). Uses the active preset / FX panel." />
                </Grid>
                <!-- #610 — Wallpaper aspect handling. The Poster dialog carries its own
                     Maintain radio; the Wallpaper button has no size dialog, so its mode
                     is chosen here. -->
                <Grid ColumnDefinitions="Auto,Auto,*" Margin="0,2,0,0">
                    <Button Grid.Column="0" Classes="action neutral" Content="Wallpaper"   Command="{Binding Menu.WallpaperCommand}"  ToolTip.Tip="Render a wallpaper-sized image at the virtual-screen union of every monitor" Margin="0,0,4,0" />
                    <TextBlock Grid.Column="1" Text="Fit" Foreground="#9A9A9A" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <ComboBox Grid.Column="2" HorizontalAlignment="Left"
                              Width="175"
                              ItemsSource="{Binding Menu.WallpaperMaintainModes}"
                              SelectedItem="{Binding Menu.WallpaperMaintainMode, Mode=TwoWay}"
                              ToolTip.Tip="How a wallpaper render (virtual-screen union, usually a different aspect than the window) is framed. View = keep the whole on-screen view, revealing more fractal on the wide axis (default). Aspect = current on-screen span on the long axis, cropping the short axis. Letterbox = keep the on-screen view exactly and pad the surround with the out-of-bounds colour." />
                </Grid>
                
            </StackPanel>
        </Border>

        <!-- #1305 Fractal QR code: export the current view as a square image that
             is also a scannable QR code. The saved file is decoded afterwards
             (full size, small, blurred, JPEG); a failure is reported in yellow
             (#FFCC00, never red - the user is red/green colour-blind). The same
             settings feed Command > Seed from live view (the qr batch flags). -->
        <Border Classes="group">
            <StackPanel Spacing="6">
                <TextBlock Classes="section" Text="QR Code" />
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6" Width="420" HorizontalAlignment="Left">
                    <TextBlock Grid.Column="0" Text="Text" Foreground="#9A9A9A" FontSize="11" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Text="{Binding QrCode.Payload, Mode=TwoWay}"
                             Watermark="https://…"
                             ToolTip.Tip="What the code carries when scanned - usually a URL. Shorter text makes a smaller code with bigger modules, so more of the fractal survives." />
                </Grid>
                <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="4" ColumnSpacing="6" Width="420" HorizontalAlignment="Left">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Style" Foreground="#9A9A9A" FontSize="11" VerticalAlignment="Center" />
                    <ComboBox Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch"
                              ItemsSource="{Binding QrCode.StyleChoices}"
                              SelectedIndex="{Binding QrCode.StyleIndex, Mode=TwoWay}"
                              ToolTip.Tip="Steer: every module recoloured into a dark or light band, hue kept. Dots: only a square at each module's centre is forced, the fractal shows around it. Halftone: each module split 3x3, the centre cell carries the code and the outer cells are the fractal's own halftone. Bevel (3D): dark modules become raised blocks with sloped edges and cast shadows, lit by the theme's 3D lights." />
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Error fix" Foreground="#9A9A9A" FontSize="11" VerticalAlignment="Center" />
                    <ComboBox Grid.Row="0" Grid.Column="3" HorizontalAlignment="Stretch"
                              ItemsSource="{Binding QrCode.ErrorCorrectionChoices}"
                              SelectedIndex="{Binding QrCode.ErrorCorrectionIndex, Mode=TwoWay}"
                              ToolTip.Tip="Reed-Solomon error correction: the share of the code that may be damaged and still scan. Higher leaves more room for the fractal but makes the code larger." />
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Size" Foreground="#9A9A9A" FontSize="11" VerticalAlignment="Center" />
                    <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding QrCode.Size}" Minimum="64" Maximum="8192" Increment="100"
                                   FormatString="0" ToolTip.Tip="Side of the square image, in pixels. The code is centred with its 4-module quiet zone." />
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="Module px" Foreground="#9A9A9A" FontSize="11" VerticalAlignment="Center" />
                    <NumericUpDown Grid.Row="1" Grid.Column="3" Value="{Binding QrCode.ModulePixels}" Minimum="0" Maximum="256" Increment="1"
                                   FormatString="0" ToolTip.Tip="Pixels per module. 0 = auto: the largest that fits the image." />
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Dot" Foreground="#9A9A9A" FontSize="11" VerticalAlignment="Center" />
                    <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding QrCode.DotFraction}" Minimum="0.2" Maximum="0.6" Increment="0.05"
                                   FormatString="0.00" ToolTip.Tip="Size of the forced centre square as a fraction of the module (Dots style; the strict core in Steer)." />
                    <CheckBox Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2" Content="Invert (light on dark)"
                              IsChecked="{Binding QrCode.Invert, Mode=TwoWay}"
                              ToolTip.Tip="Light modules on a dark field. Many readers accept it, but not all." />
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Version" Foreground="#9A9A9A" FontSize="11" VerticalAlignment="Center" />
                    <NumericUpDown Grid.Row="3" Grid.Column="1" Value="{Binding QrCode.MinVersion}" Minimum="1" Maximum="40" Increment="1"
                                   FormatString="0" ToolTip.Tip="Smallest QR version (1-40). Above what the text needs it makes a bigger code with smaller modules, and leaves more free bits for Shape to the image." />
                    <CheckBox Grid.Row="3" Grid.Column="2" Grid.ColumnSpan="2" Content="Shape to the image"
                              IsChecked="{Binding QrCode.Shape, Mode=TwoWay}"
                              ToolTip.Tip="QArt: choose the data bits a reader never reads so the code's own pattern follows the fractal's light and dark areas, then composite as usual. Lower error fix and a higher version shape more of the code." />
                </Grid>
                <!-- #1409 Bevel style controls (shown only for Bevel). -->
                <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="4" ColumnSpacing="6" Width="420" HorizontalAlignment="Left"
                      IsVisible="{Binding QrCode.IsBevel}">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Height" Foreground="#9A9A9A" FontSize="11" VerticalAlignment="Center" />
                    <NumericUpDown Grid.Row="0" Grid.Column="1" Value="{Binding QrCode.BevelHeight}" Minimum="0.05" Maximum="2" Increment="0.05"
                                   FormatString="0.00" ToolTip.Tip="Block height as a fraction of the module. Taller blocks cast longer shadows and their edges shade harder." />
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Bevel" Foreground="#9A9A9A" FontSize="11" VerticalAlignment="Center" />
                    <NumericUpDown Grid.Row="0" Grid.Column="3" Value="{Binding QrCode.BevelWidth}" Minimum="0.05" Maximum="0.45" Increment="0.05"
                                   FormatString="0.00" ToolTip.Tip="Width of the sloped edge as a fraction of the module." />
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Shine" Foreground="#9A9A9A" FontSize="11" VerticalAlignment="Center" />
                    <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding QrCode.BevelSpecular}" Minimum="0" Maximum="1" Increment="0.1"
                                   FormatString="0.00" ToolTip.Tip="Specular highlight on the lit edges." />
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="Shadow" Foreground="#9A9A9A" FontSize="11" VerticalAlignment="Center" />
                    <NumericUpDown Grid.Row="1" Grid.Column="3" Value="{Binding QrCode.BevelShadow}" Minimum="0" Maximum="1" Increment="0.1"
                                   FormatString="0.00" ToolTip.Tip="How dark the shadow the blocks cast on the floor is." />
                    <CheckBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="4" Content="Light from the 3D theme"
                              IsChecked="{Binding QrCode.BevelLightFromTheme, Mode=TwoWay}"
                              ToolTip.Tip="Use the active 3D theme's key, fill and rim lights. A theme without 3D lights gets a light from the upper left. Untick to set the direction yourself." />
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Azimuth" Foreground="#9A9A9A" FontSize="11" VerticalAlignment="Center"
                               IsVisible="{Binding QrCode.BevelLightExplicit}" />
                    <NumericUpDown Grid.Row="3" Grid.Column="1" Value="{Binding QrCode.BevelAzimuth}" Minimum="0" Maximum="359" Increment="15"
                                   FormatString="0" IsVisible="{Binding QrCode.BevelLightExplicit}"
                                   ToolTip.Tip="Light direction in degrees, counter-clockwise from the right: 0 right, 90 top, 135 upper left, 180 left." />
                    <TextBlock Grid.Row="3" Grid.Column="2" Text="Elevation" Foreground="#9A9A9A" FontSize="11" VerticalAlignment="Center"
                               IsVisible="{Binding QrCode.BevelLightExplicit}" />
                    <NumericUpDown Grid.Row="3" Grid.Column="3" Value="{Binding QrCode.BevelElevation}" Minimum="1" Maximum="89" Increment="5"
                                   FormatString="0" IsVisible="{Binding QrCode.BevelLightExplicit}"
                                   ToolTip.Tip="Light height above the image in degrees. Low light casts long shadows." />
                </Grid>
                <!-- #1410 Extrude in Relief 3D. -->
                <CheckBox Content="Extrude in Relief 3D"
                          IsChecked="{Binding QrCode.Relief, Mode=TwoWay}"
                          ToolTip.Tip="Build the code into the Relief 3D scene as raised blocks, so camera tilt, cast shadows, ambient occlusion and the lights act on the code itself. Used when the view is in Relief 3D raymarch mode; otherwise the flat style is exported. The camera is raised to at least the minimum elevation below, and zoomed out if the code would leave the frame." />
                <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto,Auto" RowSpacing="4" ColumnSpacing="6" Width="420" HorizontalAlignment="Left"
                      IsVisible="{Binding QrCode.Relief}">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Blocks" Foreground="#9A9A9A" FontSize="11" VerticalAlignment="Center" />
                    <NumericUpDown Grid.Row="0" Grid.Column="1" Value="{Binding QrCode.ReliefHeight}" Minimum="0.05" Maximum="3" Increment="0.1"
                                   FormatString="0.00" ToolTip.Tip="Block height in modules." />
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Terrain" Foreground="#9A9A9A" FontSize="11" VerticalAlignment="Center" />
                    <NumericUpDown Grid.Row="0" Grid.Column="3" Value="{Binding QrCode.ReliefTerrain}" Minimum="0" Maximum="1" Increment="0.05"
                                   FormatString="0.00" ToolTip.Tip="How much of the fractal's own relief is kept under the code: 0 = a flat plinth, 1 = the full terrain. Tall terrain casts shadows across modules and can hide them." />
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Min elev." Foreground="#9A9A9A" FontSize="11" VerticalAlignment="Center" />
                    <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding QrCode.ReliefMinElevation}" Minimum="5" Maximum="89" Increment="5"
                                   FormatString="0" ToolTip.Tip="Lowest camera elevation in degrees while the code is extruded; a lower Relief 3D camera is raised to it. Codes stopped scanning below about 50 degrees in testing." />
                </Grid>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Classes="action neutral" Content="Find View"
                            Command="{Binding QrCode.FindViewCommand}"
                            ToolTip.Tip="Search around the current view (position and zoom) and over the 8 mask patterns for the framing whose own light and dark areas already agree best with the code, then go there. The fractal is altered less; gains are modest because QR data looks random. Backspace returns." />
                    <Button Classes="action neutral" Content="Export QR Image…"
                            Command="{Binding QrCode.ExportCommand}"
                            ToolTip.Tip="Render the current view as a square image with the QR code composited in, save it, then decode the saved file to confirm it scans." />
                    <TextBlock Text="{Binding QrCode.MaskText}" Foreground="#9A9A9A" FontSize="11" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding QrCode.Message}" IsVisible="{Binding QrCode.HasMessage}"
                               Classes="qrstatus" Classes.warn="{Binding QrCode.MessageIsWarning}"
                               FontSize="11" TextWrapping="Wrap" MaxWidth="300" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- #946 Quick Record: instant capture of the render window (F9 /
             toolbar ● Rec) + its persisted defaults. The Video dialog's
             "Record this run" and the post-stop Save Recording prompt share
             these settings (the prompt remembers the last choices here). -->
        <Border Classes="group">
            <StackPanel Spacing="6">
                <TextBlock Classes="section" Text="Quick Record" />
                <Grid ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="6">
                    <Button Grid.Column="0" Classes="action video" MinWidth="96"
                            Content="{Binding Shell.LiveRecordingLabel}"
                            Command="{Binding Shell.ToggleLiveRecordingCommand}"
                            IsVisible="{Binding Shell.IsLiveRecordingAvailable}"
                            ToolTip.Tip="Start / stop recording exactly what the render window shows (F9). Themes, animation, lighting/FX and the watermark are captured as displayed." />
                    <TextBlock Grid.Column="1" Text="Capture" Foreground="#9A9A9A" FontSize="11" VerticalAlignment="Center" Margin="6,0,0,0" />
                    <ComboBox Grid.Column="2" Width="100"
                              ItemsSource="{Binding QuickRecordFpsChoices}"
                              SelectedItem="{Binding QuickRecordCaptureFps, Mode=TwoWay}"
                              ToolTip.Tip="How often the render window is sampled while recording (frames per second). Unchanged frames cost nothing; higher rates capture fast motion more smoothly." />
                </Grid>
                <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto,Auto" RowSpacing="4" ColumnSpacing="6" Width="420" HorizontalAlignment="Left">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Format" Foreground="#9A9A9A" FontSize="11" VerticalAlignment="Center" />
                    <ComboBox Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch"
                              ItemsSource="{Binding QuickRecordFormatChoices}"
                              SelectedIndex="{Binding QuickRecordFormatIndex, Mode=TwoWay}"
                              ToolTip.Tip="Default output format. (ffmpeg) formats need ffmpeg installed (FFmpeg Setup)." />
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Quality" Foreground="#9A9A9A" FontSize="11" VerticalAlignment="Center" />
                    <ComboBox Grid.Row="0" Grid.Column="3" HorizontalAlignment="Stretch"
                              ItemsSource="{Binding QuickRecordQualityChoices}"
                              SelectedIndex="{Binding QuickRecordQualityIndex, Mode=TwoWay}"
                              IsEnabled="{Binding IsQuickRecordQualityApplicable}"
                              ToolTip.Tip="Default encode quality (ignored by lossless MKV and PNG sequence)." />
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Output" Foreground="#9A9A9A" FontSize="11" VerticalAlignment="Center" />
                    <ComboBox Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch"
                              ItemsSource="{Binding QuickRecordFpsChoices}"
                              SelectedItem="{Binding QuickRecordOutputFps, Mode=TwoWay}"
                              ToolTip.Tip="Default frame rate of the saved video (resampled from the capture timeline)." />
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="Size %" Foreground="#9A9A9A" FontSize="11" VerticalAlignment="Center" />
                    <ComboBox Grid.Row="1" Grid.Column="3" HorizontalAlignment="Stretch"
                              ItemsSource="{Binding QuickRecordScaleChoices}"
                              SelectedItem="{Binding QuickRecordScale, Mode=TwoWay}"
                              ToolTip.Tip="Default output size as a percentage of the render window." />
                </Grid>
                <CheckBox Content="Ask how to save when recording stops"
                          IsChecked="{Binding QuickRecordAskOnStop, Mode=TwoWay}"
                          ToolTip.Tip="On: the Save Recording prompt opens on stop (pre-filled with these defaults; your choices are remembered). Off: save straight to the folder below with these defaults — no prompts." />
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4" Width="420" HorizontalAlignment="Left">
                    <TextBlock Grid.Column="0" Text="{Binding QuickRecordFolderDisplay}"
                               Foreground="#9A9A9A" FontSize="11" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{Binding QuickRecordFolderDisplay}" />
                    <Button Grid.Column="1" Classes="action neutral" Content="Folder…"
                            Command="{Binding BrowseQuickRecordFolderCommand}"
                            ToolTip.Tip="Folder used when 'Ask how to save' is off" />
                    <Button Grid.Column="2" Classes="action neutral" Content="Default"
                            Command="{Binding ClearQuickRecordFolderCommand}"
                            ToolTip.Tip="Reset to the default folder (Videos\FracturingFog)" />
                </Grid>
            </StackPanel>
        </Border>

        <Border Classes="group">
            <StackPanel Spacing="6">
                <TextBlock Classes="section" Text="Slideshow" />
                <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,Auto,Auto" RowSpacing="4" ColumnSpacing="4">                    
                    <Button Grid.Column="0" Grid.Row="0" Classes="action slideshow" Content="Slideshow Settings…" 
                            Command="{Binding Menu.SlideshowSettingsCommand}" ToolTip.Tip="Configure slideshow timing + audio-reactive options" 
                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                    <Button Grid.Column="1" Grid.Row="0" Classes="action slideshow" Content="Audio Settings…" 
                            Command="{Binding Menu.AudioSettingsCommand}" ToolTip.Tip="Fractured Waves Reactive Audio settings: source, sensitivity, band weights, live meter" 
                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                    <Button Grid.Column="0" Grid.Row="1"  Classes="action slideshow" Content="{Binding Menu.SlideshowButtonText}" 
                            Command="{Binding Menu.SlideshowCommand}" ToolTip.Tip="Start/stop slideshow" 
                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                    <Button Grid.Column="1" Grid.Row="1" Classes="action slideshow" Content="Travel to location…" 
                            Command="{Binding Menu.TravelCommand}" ToolTip.Tip="Plan a coordinate-ordered slideshow course from a start region to an end region" 
                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                    <Button Grid.Column="0" Grid.Row="2" Classes="action slideshow" Content="Lock Region" 
                            Command="{Binding Shell.ToggleSlideshowLockRegionCommand}" IsEnabled="{Binding Shell.IsSlideshowRunning}" ToolTip.Tip="Pin the running slideshow to the current region (only while a slideshow is running)"
                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                    <Button Grid.Column="1" Grid.Row="2" Classes="action slideshow" Content="More Colors" 
                            Command="{Binding Shell.ToggleSlideshowFocusCommand}" IsEnabled="{Binding Shell.IsSlideshowRunning}" ToolTip.Tip="Toggle 3 vs 8 themes per region while the slideshow runs"
                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                </Grid>
            </StackPanel>
        </Border>

        <Border Classes="group">
            <StackPanel Spacing="6">
                <TextBlock Classes="section" Text="Watermark" />
                <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="6">
                    <CheckBox Grid.Column="0" Content="Show watermark" IsChecked="{Binding Menu.ShowWatermark, Mode=TwoWay}" ToolTip.Tip="Master toggle for the on-screen watermark overlay" />
                    <CheckBox Grid.Column="1" Content="Override region watermark" IsChecked="{Binding Menu.OverrideRegionWatermark, Mode=TwoWay}" ToolTip.Tip="Force the active custom watermark even when the region carries its own" />
                </Grid>
                <CheckBox Content="Use custom watermark" IsChecked="{Binding Menu.UseCustomWatermark, Mode=TwoWay}" ToolTip.Tip="Replace the default region/theme watermark with your saved custom one" />
                <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="6">
                    <ComboBox Grid.Column="0" ItemsSource="{Binding Menu.WatermarkNames}" SelectedItem="{Binding Menu.SelectedWatermark}" 
                          IsEnabled="{Binding Menu.UseCustomWatermark}" HorizontalAlignment="Left" Width="350" />
                    <Button Grid.Column="1" Classes="action help" Content="Edit…" Command="{Binding Menu.EditWatermarkCommand}" 
                            HorizontalAlignment="Left" ToolTip.Tip="Open the Watermark Editor" />                </Grid>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>

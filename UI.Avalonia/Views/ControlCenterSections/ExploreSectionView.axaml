<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FracturingFog.UI.Avalonia.ViewModels"
        x:Class="FracturingFog.UI.Avalonia.Views.ControlCenterSections.ExploreSectionView"
        x:DataType="vm:ControlCenterViewModel"
        Foreground="#DCDCDC">
    <!-- ═══ Explore ═══ (extracted from ControlCenterView for detach/pop-out) -->
    <StackPanel Spacing="0">
        <Border Classes="group">
            <StackPanel Spacing="6" MaxWidth="425" HorizontalAlignment="Left">
                <TextBlock Classes="section" Text="Region Navigation" />
                <!-- Fractal type selector — mirrors the toolbar Type combo
                     (Main.FractalEntries / SelectedFractalEntry). Needed so a
                     recalled workspace whose tool window is fractal-type-specific
                     can have its type set from the Control Center (#433 follow-up). -->
                <TextBlock Classes="label" Text="Type" HorizontalAlignment="Left" Margin="0,4,0,0"/>
                <!--<StackPanel Orientation="Horizontal" Spacing="6">
                       
                </StackPanel>-->
                <Grid ColumnDefinitions="*,Auto" 
                        Margin="0,0,8,0" ColumnSpacing="6">
                    <ComboBox Grid.Column="0" x:Name="TypeCombo"
                          ItemsSource="{Binding Shell.Main.FractalEntries}"
                          SelectedItem="{Binding Shell.Main.SelectedFractalEntry}"
                          MinWidth="215" MaxWidth="305" HorizontalAlignment="Stretch" Margin="0,4,0,6">
                        <ComboBox.ItemTemplate>
                            <DataTemplate DataType="vm:FractalTypeEntry">
                                <TextBlock Text="{Binding Label}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Grid.Column="1" Classes="action help" Content="Params…" 
                        Command="{Binding Shell.ShowFractalParamsCommand}" 
                        Width="83" HorizontalAlignment="Stretch" 
                        ToolTip.Tip="Open the per-fractal parameter editor"/> 
                </Grid>

                <!-- Right-click ("Edit region…" + filter-by-fractal-type) is wired
                     in code-behind to match the toolbar Region combo (issue #51). -->
                <TextBlock Classes="label" Text="Region" HorizontalAlignment="Left" />
                <ComboBox x:Name="RegionCombo"
                          ItemsSource="{Binding Menu.RegionNames}"
                          SelectedItem="{Binding Menu.SelectedRegion}"
                          MinWidth="305" MaxWidth="395" HorizontalAlignment="Stretch" Margin="0,4,0,0" />
                <Grid ColumnDefinitions="Auto,Auto,Auto,Auto">
                    <Button Grid.Column="0" Classes="action neutral" Content="Save"   Command="{Binding Menu.SaveViewCommand}"      ToolTip.Tip="Save current view as a region" Margin="0,0,4,0" />
                    <Button Grid.Column="1" Classes="action danger"  Content="Delete" Command="{Binding Menu.DeleteRegionCommand}"  ToolTip.Tip="Delete selected region" Margin="0,0,4,0" />
                    <Button Grid.Column="2" Classes="action neutral" Content="Export…"   Command="{Binding Menu.ExportRegionsCommand}" ToolTip.Tip="Export regions to JSON" Margin="0,0,4,0" />
                    <Button Grid.Column="3" Classes="action neutral" Content="Import…"   Command="{Binding Menu.ImportRegionsCommand}" ToolTip.Tip="Import regions from JSON" />
                </Grid>

                <CheckBox Content="Pipe notation (FF-native limbs)" IsChecked="{Binding Menu.UsePipeNotation}" Margin="80,8,0,0"
                          ToolTip.Tip="Off (default): show/copy CX/CY as a single decimal value. On: show/copy pipe-delimited limbs (Hi|Lo|…) for lossless deep-zoom precision. Paste accepts either." />
                <Grid ColumnDefinitions="80,*" RowDefinitions="Auto,*,Auto,Auto,Auto" >
                    <TextBlock Classes="label" Grid.Row="0" Grid.Column="0" Text="CX:" Margin="0,0,8,4" />
                    <TextBox   Classes="coord" Grid.Row="0" Grid.Column="1" Text="{Binding Menu.CX, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4"
                               MinWidth="225" MaxWidth="315" HorizontalAlignment="Stretch"/>
                    <TextBlock Classes="label" Grid.Row="1" Grid.Column="0" Text="CY:" Margin="0,0,8,4" />
                    <TextBox   Classes="coord" Grid.Row="1" Grid.Column="1" Text="{Binding Menu.CY, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4"
                               MinWidth="225" MaxWidth="315" HorizontalAlignment="Stretch" />
                    <TextBlock Classes="label" Grid.Row="2" Grid.Column="0" Text="Quality:" Margin="0,0,8,4" />
                    <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding Menu.QualityNames}" SelectedItem="{Binding Menu.SelectedQuality}"
                               MinWidth="225" MaxWidth="315" HorizontalAlignment="Stretch" Margin="0,0,0,4" />
                    <TextBlock Classes="label" Grid.Row="3" Grid.Column="0" Text="Zoom:" Margin="0,0,8,4" />
                    <TextBox   Classes="coord" Grid.Row="3" Grid.Column="1" Text="{Binding Menu.Zoom, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4"
                               MinWidth="225" MaxWidth="315" HorizontalAlignment="Stretch" />
                    <TextBlock Classes="label" Grid.Row="4" Grid.Column="0" Text="Iterations:" Margin="0,0,8,0" />
                    <TextBox   Classes="coord" Grid.Row="4" Grid.Column="1" Text="{Binding Menu.Iter, UpdateSourceTrigger=PropertyChanged}"
                               MinWidth="225" MaxWidth="315" HorizontalAlignment="Stretch" />
                </Grid>

                    <CheckBox Content="Lock Iterations" IsChecked="{Binding Menu.IterLocked}" Margin="80,0,0,0"
                              Foreground="#C8C878" FontWeight="Bold" ToolTip.Tip="Lock iteration count — pan/zoom won't recalc" />
                
                <Grid ColumnDefinitions="Auto,Auto,Auto" Margin="80,6,0,0">
                    <Button Grid.Column="0" Classes="action go" Content="Go"     Command="{Binding Menu.GoCommand}"         Margin="0,0,4,0" />
                    <Button Grid.Column="1" Classes="action go" Content="Flip Y" Command="{Binding Menu.FlipCommand}"       Margin="0,0,4,0" />
                    <Button Grid.Column="2" Classes="action go" Content="Copy"   Command="{Binding Menu.CopyCoordsCommand}" ToolTip.Tip="Copy CX/CY/Zoom/Iter to clipboard" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- Interesting-location finder (epic #1184). S1 #1185: period
             detection; S2 #1186: zoom to a minibrot in view; S3 #1187: snap a
             click to a Misiurewicz point; S4 #1188: go to an external angle;
             S5 #1189: Julia morph (z² + c); S7 #1191: minibrot / spiral / morph for Multibrot, Burning Ship, Tricorn, User Equation; S6 #1190: auto-explore (any 2D family). -->
        <Border Classes="group">
            <StackPanel Spacing="6" MaxWidth="425" HorizontalAlignment="Left">
                <TextBlock Classes="section" Text="Find" />
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Button Classes="action go" Content="Zoom to minibrot"
                            Command="{Binding ZoomToMinibrotCommand}"
                            ToolTip.Tip="Find a minibrot whose centre is inside the current view and zoom to frame it like the home view. Mandelbrot, Multibrot, Burning Ship, Tricorn and User Equation. Backspace returns to where you were." />
                    <Button Classes="action go" Content="Snap to spiral"
                            Command="{Binding SnapToSpiralCommand}"
                            ToolTip.Tip="Then click a spiral centre or branch point in the render: the view recentres exactly on it (a Misiurewicz point). Mandelbrot, Multibrot, Burning Ship, Tricorn and User Equation. Backspace returns." />
                    <Button Classes="action go" Content="Julia morph"
                            Command="{Binding JuliaMorphCommand}"
                            ToolTip.Tip="Then click points in the pattern: each click steps halfway (in zoom) toward a minibrot near that point, where its embedded Julia set doubles the pattern. Keep clicking to stack layers; Cancel to stop." />
                    <Button Classes="action neutral" Content="Detect period"
                            Command="{Binding DetectPeriodCommand}"
                            ToolTip.Tip="Report the lowest period candidate in the current view (a lower bound from a fast ball scan; Mandelbrot z² + c only)." />
                    <Button Classes="action neutral" Content="Cancel"
                            Command="{Binding CancelFinderCommand}"
                            IsVisible="{Binding CanCancelFinder}" />
                </StackPanel>
                <TextBlock Text="{Binding FinderStatus}" Foreground="#9A9A9A" FontSize="11" TextWrapping="Wrap" />
                <!-- #1237: the external angles of the point just found. -->
                <SelectableTextBlock Text="{Binding LocationAngleInfo}" IsVisible="{Binding HasLocationAngles}"
                                     Foreground="#B4B4B4" FontSize="11" TextWrapping="Wrap"
                                     ToolTip.Tip="External angles of the minibrot / spiral point just found, verified by landing them again. Paste an angle or the angled address into Angle to come back here." />
                <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding HasLocationAngle}">
                    <Button Classes="action neutral" Content="Copy angle"
                            Command="{Binding CopyLocationAngleCommand}"
                            ToolTip.Tip="Copy the external angle of the point just found. Paste it into Angle and press Go to come back here." />
                    <Button Classes="action neutral" Content="Copy address"
                            Command="{Binding CopyLocationAddressCommand}" IsVisible="{Binding HasLocationAddress}"
                            ToolTip.Tip="Copy the angled internal address (e.g. 1_3/4 → 4_1/2 → … → 53). It names exactly this minibrot; paste it into Angle and press Go." />
                </StackPanel>
                <!-- S3b #1235: after Snap to spiral — the seamless loop and J_c. -->
                <StackPanel Spacing="4" IsVisible="{Binding HasLoop}">
                    <TextBlock Text="{Binding LoopInfo}" Foreground="#9A9A9A" FontSize="11" TextWrapping="Wrap" />
                    <Button Classes="action go" Content="Loop video" HorizontalAlignment="Left"
                            Command="{Binding LoopVideoCommand}"
                            ToolTip.Tip="Load a seamless self-similar loop video of this point into the Command section: each loop zooms by the multiplier and turns by its angle, so the last frame leads straight back into the first. Set --out and Run." />
                </StackPanel>
                <StackPanel Spacing="2" IsVisible="{Binding HasJuliaPreview}">
                    <TextBlock Classes="label" Text="Julia set at this point" HorizontalAlignment="Left" />
                    <Image Source="{Binding JuliaPreview}" Width="240" Height="135" HorizontalAlignment="Left" Stretch="Uniform"
                           ToolTip.Tip="J_c at the snapped point: near c the Mandelbrot set looks like this Julia set near c (Tan Lei)." />
                </StackPanel>
                <!-- S5 #1189: Julia-morph path. -->
                <StackPanel Spacing="4" IsVisible="{Binding HasMorphSteps}">
                    <TextBlock Classes="label" Text="Morph path" HorizontalAlignment="Left" />
                    <TextBlock Text="{Binding MorphPathText}" Foreground="#9A9A9A" FontSize="11" TextWrapping="Wrap" />
                    <Button Classes="action neutral" Content="Undo step" HorizontalAlignment="Left"
                            Command="{Binding UndoMorphStepCommand}"
                            ToolTip.Tip="Go back one morph layer." />
                </StackPanel>
                <!-- S4 #1188: external angle → location (binary .pre(per) or p/q). -->
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6" Margin="0,6,0,0">
                    <TextBlock Grid.Column="0" Classes="label" Text="Angle:" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Classes="coord" Text="{Binding AngleText, UpdateSourceTrigger=PropertyChanged}"
                             MinWidth="180" Watermark=".(001)  1/7  or  1 → 2 → 4"
                             ToolTip.Tip="External angle θ: binary with the repeating part in brackets (.(011), .01(10)) or a fraction p/q. Its bits are the left/right turns of the ray's path into the set. Or an internal address such as 1 → 2 → 4 (angled: 1_1/3 → 3). On Multibrot z^d + c the digits are base d (z³: .(01) = 1/8); fractions work in any base." />
                    <Button Grid.Column="2" Classes="action go" Content="Go to angle"
                            Command="{Binding GoToAngleCommand}"
                            ToolTip.Tip="Trace the parameter ray at this angle into the set and jump to where it lands: a minibrot (periodic angle) or a Misiurewicz point (preperiodic angle). Backspace returns." />
                </Grid>
                <TextBlock Text="{Binding AngleInfo}" Foreground="#9A9A9A" FontSize="11" TextWrapping="Wrap" />
                <!-- #1242: User Equation critical points; one becomes the z0 seed. -->
                <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,6,0,0" IsVisible="{Binding IsUserEquation}">
                    <Button Classes="action neutral" Content="Critical points"
                            Command="{Binding FindCriticalPointsCommand}"
                            ToolTip.Tip="List the critical points of the equation (where f'(z) = 0). Each has its own Mandelbrot-like set in the parameter plane; the render shows the set of its start point z0." />
                    <ComboBox ItemsSource="{Binding CriticalPointItems}" SelectedIndex="{Binding CriticalPointIndex}"
                              IsVisible="{Binding HasCriticalPoints}" MinWidth="170"
                              ToolTip.Tip="The critical points, nearest the origin first; (xm) marks a multiple one. One that moves with c is shown at the view centre and cannot be set as a constant seed." />
                    <Button Classes="action go" Content="Use as z0"
                            Command="{Binding UseCriticalPointCommand}" IsVisible="{Binding HasCriticalPoints}"
                            ToolTip.Tip="Set the User Equation's z0 seed to this critical point and re-render. The minibrot finders then find nuclei of its set." />
                </StackPanel>
                <TextBlock Text="{Binding CriticalPointInfo}" Foreground="#9A9A9A" FontSize="11" TextWrapping="Wrap"
                           IsVisible="{Binding IsUserEquation}" />
                <!-- S6 #1190: heuristic auto-explore (every 2D family). -->
                <TextBlock Classes="label" Text="Auto-explore" HorizontalAlignment="Left" Margin="0,6,0,0" />
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Button Classes="action go" Content="Surprise me"
                            Command="{Binding SurpriseMeCommand}"
                            ToolTip.Tip="Search from this family's home view, with a fresh random seed, for a detail-rich view and go there. Works on every 2D type. Backspace returns." />
                    <Button Classes="action go" Content="Descend"
                            Command="{Binding DescendCommand}"
                            ToolTip.Tip="Search downward from the current view for the most detail-rich view and go there. Backspace returns." />
                    <TextBlock Classes="label" Text="Depth" VerticalAlignment="Center" Margin="6,0,0,0" />
                    <NumericUpDown Value="{Binding ExploreDepth}" Minimum="1" Maximum="16" Increment="1"
                                   FormatString="0" Width="96"
                                   ToolTip.Tip="Levels to descend; each level zooms in 4x." />
                    <TextBlock Classes="label" Text="Beam" VerticalAlignment="Center" />
                    <NumericUpDown Value="{Binding ExploreBeam}" Minimum="1" Maximum="8" Increment="1"
                                   FormatString="0" Width="96"
                                   ToolTip.Tip="Views kept per level. Wider searches more but takes longer." />
                </StackPanel>
                <!-- #1240: interest-score heatmap + live weights. -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <CheckBox Content="Heatmap" IsChecked="{Binding ShowHeatmap}" Foreground="#B4B4B4"
                              ToolTip.Tip="Overlay the interest score of each part of the view (the score Auto-explore descends on): blue = dull, yellow = detail-rich. Diagnostic only — never exported." />
                    <ComboBox ItemsSource="{Binding HeatmapTerms}" SelectedIndex="{Binding HeatmapTermIndex}"
                              IsVisible="{Binding ShowHeatmap}" MinWidth="120"
                              ToolTip.Tip="Show the total score or one of its terms (boundary density, band entropy, fractal-dimension fit, penalty keep)." />
                </StackPanel>
                <Grid ColumnDefinitions="Auto,*,48" RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8" IsVisible="{Binding ShowHeatmap}">
                    <TextBlock Grid.Row="0" Grid.Column="0" Classes="fxLabel" Text="Boundary" VerticalAlignment="Center" Width="104" />
                    <Slider    Grid.Row="0" Grid.Column="1" Value="{Binding WeightBoundary}" Minimum="0" Maximum="1" Margin="0,2,6,2"
                               ToolTip.Tip="How much edge / filament density counts." />
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding WeightBoundaryText}" VerticalAlignment="Center" Foreground="#9A9A9A" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Classes="fxLabel" Text="Entropy" VerticalAlignment="Center" Width="104" />
                    <Slider    Grid.Row="1" Grid.Column="1" Value="{Binding WeightEntropy}" Minimum="0" Maximum="1" Margin="0,2,6,2"
                               ToolTip.Tip="How much colour-band variety counts." />
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding WeightEntropyText}" VerticalAlignment="Center" Foreground="#9A9A9A" />
                    <TextBlock Grid.Row="2" Grid.Column="0" Classes="fxLabel" Text="Dimension" VerticalAlignment="Center" Width="104" />
                    <Slider    Grid.Row="2" Grid.Column="1" Value="{Binding WeightDimension}" Minimum="0" Maximum="1" Margin="0,2,6,2"
                               ToolTip.Tip="How much a fractal-looking edge (dimension near the preferred value) counts." />
                    <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding WeightDimensionText}" VerticalAlignment="Center" Foreground="#9A9A9A" />
                    <TextBlock Grid.Row="3" Grid.Column="0" Classes="fxLabel" Text="Preferred dim." VerticalAlignment="Center" Width="104" />
                    <Slider    Grid.Row="3" Grid.Column="1" Value="{Binding DimensionCentre}" Minimum="1" Maximum="2" Margin="0,2,6,2"
                               ToolTip.Tip="Box-count dimension that scores best: 1 = smooth curves, 2 = space-filling noise (default 1.7)." />
                    <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding DimensionCentreText}" VerticalAlignment="Center" Foreground="#9A9A9A" />
                    <Button    Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Classes="action neutral" Content="Reset weights"
                               Command="{Binding ResetWeightsCommand}" HorizontalAlignment="Left" Margin="0,4,0,0"
                               ToolTip.Tip="Back to the default interest weights." />
                </Grid>
                <TextBlock Text="{Binding HeatmapStatus}" IsVisible="{Binding ShowHeatmap}" Foreground="#9A9A9A" FontSize="11" TextWrapping="Wrap" />
                <ItemsControl ItemsSource="{Binding ExploreCandidates}" IsVisible="{Binding HasExploreCandidates}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:ExploreCandidateItem">
                            <Button Classes="action neutral" Content="{Binding Label}" Command="{Binding Go}"
                                    ToolTip.Tip="{Binding Tip}" HorizontalAlignment="Left" Margin="0,2,0,0" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!--<Border Classes="group">
            <StackPanel Spacing="6">
                <TextBlock Classes="section" Text="Parameters" />
                <Button Classes="action help" Content="Fractal Params…" 
                        Command="{Binding Shell.ShowFractalParamsCommand}" 
                        Width="135" HorizontalAlignment="Left" 
                        ToolTip.Tip="Open the per-fractal parameter editor" />
            </StackPanel>
        </Border>-->

        <!-- Deep-zoom diagnostics — power mode only -->
        <Border Classes="group" IsVisible="{Binding IsPowerMode}">
            <StackPanel Spacing="6">
                <TextBlock Classes="section" Text="Deep-Zoom Diagnostics" />
                <StackPanel Orientation="Horizontal" Spacing="14">
                    <CheckBox Content="Bypass BLA+SA" IsChecked="{Binding Menu.BypassAcceleration}"       Foreground="#FFCC00" FontWeight="Bold" ToolTip.Tip="Ctrl+Shift+A" />
                    <CheckBox Content="Bypass SA"     IsChecked="{Binding Menu.BypassSeriesApproximation}" Foreground="#FFCC00" FontWeight="Bold" ToolTip.Tip="Ctrl+Shift+S" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="14">
                    <CheckBox Content="Bypass DD-BLA"   IsChecked="{Binding Menu.BypassDdBla}"    Foreground="#FFCC00" FontWeight="Bold" ToolTip.Tip="Ctrl+Shift+D" />
                    <CheckBox Content="Bypass Rebasing" IsChecked="{Binding Menu.BypassRebasing}" Foreground="#FFCC00" FontWeight="Bold" ToolTip.Tip="SM-2: rebasing default ON; check to A/B against legacy per-pixel QD/OD" />
                </StackPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FracturingFog.UI.Avalonia.ViewModels"
        x:Class="FracturingFog.UI.Avalonia.Views.ControlCenterSections.ViewSectionView"
        x:DataType="vm:ControlCenterViewModel"
        Foreground="#DCDCDC">
    <!-- ═══ View ═══ (extracted from ControlCenterView for detach/pop-out) -->
    <StackPanel Spacing="0">
        <Border Classes="group">
            <StackPanel Spacing="6">
                <TextBlock Classes="section" Text="View" />
                <UniformGrid Columns="5" Margin="0,4,0,0">
                    <Button Classes="action neutral" Content="Reset"  Command="{Binding Menu.ResetCommand}"      ToolTip.Tip="Reset view to default center and zoom" Margin="0,0,4,4" />
                    <Button Classes="action neutral" Content="{Binding Menu.SpanButtonText}" Command="{Binding Menu.SpanCommand}" ToolTip.Tip="Span across all monitors" Margin="0,0,4,4" />
                    <Button Classes="action neutral" Content="Wall"   Command="{Binding Menu.WallpaperCommand}"  ToolTip.Tip="Render a wallpaper-sized image at the virtual-screen union of every monitor" Margin="0,0,4,4" />
                    <Button Classes="action neutral" Content="Image"  Command="{Binding Menu.ScreenshotCommand}" ToolTip.Tip="High-resolution screenshot" Margin="0,0,4,4" />
                    <Button Classes="action neutral" Content="{Binding Menu.PosterButtonText}" Command="{Binding Menu.PosterCommand}"     ToolTip.Tip="Print-ready poster image (click again while rendering to cancel)" Margin="0,0,0,4" />
                </UniformGrid>
                <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,4,0,0">
                    <CheckBox Content="Status" IsChecked="{Binding Menu.ShowStatusBar}" Foreground="#9B9B9B" FontWeight="Bold" />
                    <CheckBox Content="Grid"   IsChecked="{Binding Menu.ShowGrid}"      Foreground="#9B9B9B" FontWeight="Bold" ToolTip.Tip="Overlay complex-plane grid" />
                    <TextBlock Text="Size" VerticalAlignment="Center" Foreground="#9B9B9B" FontWeight="Bold" />
                    <ComboBox ItemsSource="{Binding Menu.ResolutionNames}"
                              SelectedItem="{Binding Menu.SelectedResolution}"
                              Width="160" ToolTip.Tip="Set window dimensions" />
                </StackPanel>
                <!-- Big Buttons (kid mode): opens the standalone three-button kid
                     dialog and auto-closes the Control Center. -->
                <Button Content="Big Buttons (Kids)"
                        Command="{Binding Shell.ShowBigButtonsCommand}"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        FontWeight="Bold" Padding="0,8" Margin="0,8,0,0"
                        Background="#8E44AD" Foreground="White"
                        ToolTip.Tip="Open the big three-button dialog for kids (Color / Place / Show) — closes the Control Center" />
            </StackPanel>
        </Border>

        <Border Classes="group">
            <StackPanel Spacing="6">
                <TextBlock Classes="section" Text="Display" />
                <UniformGrid Columns="2">
                    <Button Classes="action neutral" Content="Mini Map"    Command="{Binding Shell.ToggleMiniMapCommand}"   Margin="0,0,4,4" ToolTip.Tip="Toggle the mini map overlay window" />
                    <Button Classes="action neutral" Content="Mini Depth"  Command="{Binding Shell.ToggleMiniDepthCommand}" Margin="0,0,0,4" ToolTip.Tip="Toggle the mini depth histogram window" />
                    <Button Classes="action neutral" Content="Mini Mode"   Command="{Binding Shell.ToggleMiniModeCommand}"  Margin="0,0,4,4" ToolTip.Tip="Shrink to a compact drag-handle window" />
                    <Button Classes="action neutral" Content="Toy Mode"    Command="{Binding Shell.ToggleToyModeCommand}"   Margin="0,0,0,4" ToolTip.Tip="Hide toolbar + status for a clean canvas" />
                    <Button Classes="action neutral" Content="Post-FX HUD" Command="{Binding Shell.TogglePostFxHudCommand}" ToolTip.Tip="Toggle the on-canvas brightness/contrast/adaptive overlay, tethered to the render window (shortcut: X)" />
                    <Button Classes="action neutral" Content="Status Panel" Command="{Binding Shell.ToggleStatusPanelCommand}" ToolTip.Tip="Toggle a floating, drag-to-move copy of the status bar" />
                    <Button Classes="action neutral" Content="Toolbar Panel" Command="{Binding Shell.ToggleToolbarPanelCommand}" ToolTip.Tip="Toggle a floating, drag-to-move/resize copy of the toolbar" />
                </UniformGrid>
                <CheckBox Content="Keep render window on top"
                          IsChecked="{Binding Shell.IsRenderTopmost, Mode=TwoWay}"
                          Foreground="#9B9B9B" FontWeight="Bold" Margin="0,4,0,0"
                          ToolTip.Tip="Keep the render window above other (non-FF) apps and windows. FF dialogs can still overlay it when needed." />
            </StackPanel>
        </Border>

        <Border Classes="group">
            <StackPanel Spacing="6">
                <TextBlock Classes="section" Text="Workspaces" />
                <TextBlock Text="Save the window arrangement (render window mode/size/monitor + open tool windows) as a recallable preset."
                           TextWrapping="Wrap" Foreground="#9B9B9B" FontSize="11" />
                <ComboBox ItemsSource="{Binding Workspaces}"
                          SelectedItem="{Binding SelectedWorkspace}"
                          HorizontalAlignment="Stretch"
                          ToolTip.Tip="Saved window layouts" />
                <UniformGrid Columns="5" Margin="0,4,0,0">
                    <Button Classes="action neutral" Content="Save"   Command="{Binding SaveWorkspaceCommand}"   ToolTip.Tip="Save the current window arrangement as a preset (prompts for a name)" Margin="0,0,4,0" />
                    <Button Classes="action neutral" Content="Recall" Command="{Binding ApplyWorkspaceCommand}"  ToolTip.Tip="Restore the selected layout" Margin="0,0,4,0" />
                    <Button Classes="action neutral" Content="Delete" Command="{Binding DeleteWorkspaceCommand}" ToolTip.Tip="Delete the selected layout" Margin="0,0,4,0" />
                    <Button Classes="action neutral" Content="Import" Command="{Binding ImportWorkspaceCommand}" ToolTip.Tip="Import a layout from a file" Margin="0,0,4,0" />
                    <Button Classes="action neutral" Content="Export" Command="{Binding ExportWorkspaceCommand}" ToolTip.Tip="Export the selected layout to a file" />
                </UniformGrid>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>

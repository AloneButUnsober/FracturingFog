<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FracturingFog.UI.Avalonia.ViewModels"
        x:Class="FracturingFog.UI.Avalonia.Views.ControlCenterSections.ViewSectionView"
        x:DataType="vm:ControlCenterViewModel"
        Foreground="#DCDCDC">
    <!-- ═══ View ═══ (extracted from ControlCenterView for detach/pop-out) -->
    <StackPanel Spacing="0">
        <Border Classes="group">
            <StackPanel Spacing="6">
                <TextBlock Classes="section" Text="View" />
                <Grid ColumnDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="6">
                    <Button Grid.Column="0" Classes="action neutral" Content="Reset"  Command="{Binding Menu.ResetCommand}"      ToolTip.Tip="Reset view to default center and zoom" Margin="0,0,4,4" />
                    <Button Grid.Column="1" Classes="action neutral" Content="{Binding Menu.SpanButtonText}" Command="{Binding Menu.SpanCommand}" ToolTip.Tip="Span across all monitors" Margin="0,0,4,4" />
                    <Button Grid.Column="2" Classes="action neutral" Content="Mini Mode"   Command="{Binding Shell.ToggleMiniModeCommand}"  Margin="0,0,4,4" ToolTip.Tip="Shrink to a compact drag-handle window" />
                    <Button Grid.Column="3" Classes="action neutral" Content="Toy Mode"    Command="{Binding Shell.ToggleToyModeCommand}"   Margin="0,0,0,4" ToolTip.Tip="Hide toolbar + status for a clean canvas" />
                </Grid>
                <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,4,0,0">
                    <CheckBox Content="Status" IsChecked="{Binding Menu.ShowStatusBar}" Foreground="#9B9B9B" FontWeight="Bold" />
                    <CheckBox Content="Grid"   IsChecked="{Binding Menu.ShowGrid}"      Foreground="#9B9B9B" FontWeight="Bold" ToolTip.Tip="Overlay complex-plane grid" />
                    <TextBlock Text="Size" VerticalAlignment="Center" Foreground="#9B9B9B" FontWeight="Bold" />
                    <ComboBox ItemsSource="{Binding Menu.ResolutionNames}"
                              SelectedItem="{Binding Menu.SelectedResolution}"
                              Width="160" ToolTip.Tip="Set window dimensions" />
                </StackPanel>
                <!-- #1559 — grid axis label precision. -->
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2,0,0">
                    <TextBlock Text="Grid labels" VerticalAlignment="Center" Foreground="#9B9B9B" FontWeight="Bold" />
                    <ComboBox ItemsSource="{Binding Menu.GridLabelModes}"
                              SelectedItem="{Binding Menu.GridLabelMode}" Width="120"
                              ToolTip.Tip="Auto: decimals follow the grid spacing; long labels switch to scientific, then to offsets from a full-precision anchor (deep zoom). Fixed: set decimals. Scientific: set significant figures. Offset: always anchor + offsets." />
                    <NumericUpDown Value="{Binding Menu.GridLabelDigits}" Minimum="0" Maximum="30" Increment="1"
                                   FormatString="0" Width="110"
                                   IsEnabled="{Binding Menu.GridLabelDigitsEnabled}"
                                   ToolTip.Tip="Decimals (Fixed) or significant figures (Scientific)" />
                </StackPanel>
                <!-- #1554 — math overlay: axes + the orbit of one point (Mandelbrot: c; Julia: z0). -->
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2,0,0">
                    <CheckBox Content="Math overlay" IsChecked="{Binding Shell.Main.MathOverlay}" Foreground="#9B9B9B" FontWeight="Bold"
                              ToolTip.Tip="Draw the axes and the orbit of a point under z^2 + c over 2D views (Mandelbrot: the point is c; Julia: the point is z0), with the escape circle |z| = 2" />
                    <CheckBox Content="Follow pointer" IsChecked="{Binding Shell.Main.MathOverlayFollow}" IsEnabled="{Binding Shell.Main.MathOverlay}"
                              ToolTip.Tip="The orbit follows the pixel under the pointer (live only). Off: it stays on the pinned point." />
                    <TextBlock Text="steps" VerticalAlignment="Center" Foreground="#9B9B9B" />
                    <NumericUpDown Value="{Binding Shell.Main.MathOverlaySteps}" Minimum="1" Maximum="10000" Increment="10" FormatString="0" Width="110"
                                   IsEnabled="{Binding Shell.Main.MathOverlay}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2,0,0" IsVisible="{Binding Shell.Main.MathOverlay}">
                    <Button Classes="action neutral" Content="Pin last point" Command="{Binding Shell.Main.PinMathOverlayCommand}"
                            ToolTip.Tip="Pin the last point the pointer was over; exports, the Command builder and --math-overlay draw the pinned orbit" />
                    <TextBox Text="{Binding Shell.Main.MathOverlayPinText}" Width="200" FontFamily="Consolas, Menlo, monospace"
                             ToolTip.Tip="The pinned point as re im (empty: none)" />
                    <TextBlock Text="{Binding Shell.Main.MathOverlayPinError}" Foreground="#FFCC00" VerticalAlignment="Center"
                               IsVisible="{Binding Shell.Main.MathOverlayPinError, Converter={x:Static ObjectConverters.IsNotNull}}" />
                </StackPanel>
                     <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto">
                         <!-- Global UI scale (#809 / S4 #813): shrink / percent / enlarge /
                         reset. Scales all dialogs + windows (not the render window).
                         Shortcuts: Ctrl+-, Ctrl+=, Ctrl+0. -->
                    <TextBlock Grid.Column="0" Text="Scale (UI &amp; Text)" VerticalAlignment="Center" Foreground="#9B9B9B" FontWeight="Bold"
                               Width="115" HorizontalAlignment="Left"/>
                    <Button Grid.Column="1" Content="A−" Padding="8,2" 
                            Command="{Binding UiScaleDownCommand}"
                            ToolTip.Tip="Make the UI (all dialogs/windows) smaller — Ctrl+-"
                            HorizontalAlignment="Left"/>
                    <TextBlock Grid.Column="2" Text="{Binding UiScalePercent}" Width="44" TextAlignment="Center"
                               VerticalAlignment="Center" Foreground="#DCDCDC" FontWeight="Bold" />
                    <Button Grid.Column="3" Content="A+" Padding="8,2" VerticalAlignment="Center"
                            Command="{Binding UiScaleUpCommand}"
                            ToolTip.Tip="Make the UI (all dialogs/windows) larger — Ctrl+=" />
                    <Button Grid.Column="4" Content="100%" Padding="6,2" VerticalAlignment="Center"
                            Command="{Binding UiScaleResetCommand}"
                            ToolTip.Tip="Reset UI size to 100% — Ctrl+0" />
                     </Grid>
            </StackPanel>
        </Border>

        <Border Classes="group">
            <StackPanel Spacing="6">
                <TextBlock Classes="section" Text="Display" />
                <Grid ColumnDefinitions="Auto,Auto" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="6" RowSpacing="4">
                    <Button Grid.Row="0" Grid.Column="0" Classes="action neutral" Content="Mini Map"    Command="{Binding Shell.ToggleMiniMapCommand}" ToolTip.Tip="Toggle the mini map overlay window"
                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                    <Button Grid.Row="0" Grid.Column="1" Classes="action neutral" Content="Mini Depth"  Command="{Binding Shell.ToggleMiniDepthCommand}" ToolTip.Tip="Toggle the mini depth histogram window"
                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                    <Button Grid.Row="1" Grid.Column="0" Classes="action neutral" Content="Post-FX HUD" Command="{Binding Shell.TogglePostFxHudCommand}" ToolTip.Tip="Toggle the on-canvas brightness/contrast/adaptive overlay, tethered to the render window (shortcut: X)"
                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch" VerticalContentAlignment="Center" />
                    <!-- Big Buttons (kid mode): opens the standalone three-button kid
                     dialog and auto-closes the Control Center. -->
                    <Button Content="Big Buttons (Kids)"
                            Grid.Row="1" Grid.Column="1"
                        Command="{Binding Shell.ShowBigButtonsCommand}"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Classes="action neutral" 
                        ToolTip.Tip="Open the big three-button dialog for kids (Color / Place / Show) — closes the Control Center" />
                     
                    <Button Grid.Row="2" Grid.Column="0" Classes="action neutral" Content="Status Panel" Command="{Binding Shell.ToggleStatusPanelCommand}" ToolTip.Tip="Toggle a floating, drag-to-move copy of the status bar"
                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                    <Button Grid.Row="2" Grid.Column="1" Classes="action neutral" Content="Toolbar Panel" Command="{Binding Shell.ToggleToolbarPanelCommand}" ToolTip.Tip="Toggle a floating, drag-to-move/resize copy of the toolbar"
                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                    <Button Grid.Row="3" Grid.Column="0" Classes="action neutral" Content="Ray Paths" Command="{Binding Shell.ToggleBilliardRayInsetCommand}" ToolTip.Tip="Chaotic Billiard: toggle the ray-path inset (hover the render to trace that pixel's ray; Ctrl+click pins it)"
                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch" VerticalContentAlignment="Center" />
                </Grid>
                <CheckBox Content="Keep render window on top"
                          IsChecked="{Binding Shell.IsRenderTopmost, Mode=TwoWay}"
                          Foreground="#9B9B9B" FontWeight="Bold" Margin="0,4,0,0"
                          ToolTip.Tip="Keep the render window above other (non-FF) apps and windows. FF dialogs can still overlay it when needed." />
            </StackPanel>
        </Border>

        <Border Classes="group">
            <StackPanel Spacing="6">
                <TextBlock Classes="section" Text="Workspaces" />
                <TextBlock Text="Save the window arrangement (render window mode/size/monitor + open tool windows) as a recallable preset."
                           TextWrapping="Wrap" Foreground="#9B9B9B" FontSize="11" 
                           Width="250"
                           HorizontalAlignment="Left"/>
                <ComboBox ItemsSource="{Binding Workspaces}"
                          SelectedItem="{Binding SelectedWorkspace}"
                          HorizontalAlignment="Left"
                          ToolTip.Tip="Saved window layouts" 
                          Width="350"/>
                <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto">
                    <Button Grid.Column="0" Classes="action neutral" Content="Save"   Command="{Binding SaveWorkspaceCommand}"   ToolTip.Tip="Save the current window arrangement as a preset (prompts for a name)" Margin="0,0,4,0" />
                    <Button Grid.Column="1" Classes="action neutral" Content="Recall" Command="{Binding ApplyWorkspaceCommand}"  ToolTip.Tip="Restore the selected layout" Margin="0,0,4,0" />
                    <Button Grid.Column="2" Classes="action neutral" Content="Delete" Command="{Binding DeleteWorkspaceCommand}" ToolTip.Tip="Delete the selected layout" Margin="0,0,4,0" />
                    <Button Grid.Column="3" Classes="action neutral" Content="Import" Command="{Binding ImportWorkspaceCommand}" ToolTip.Tip="Import a layout from a file" Margin="0,0,4,0" />
                    <Button Grid.Column="4" Classes="action neutral" Content="Export" Command="{Binding ExportWorkspaceCommand}" ToolTip.Tip="Export the selected layout to a file" />
                </Grid>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>

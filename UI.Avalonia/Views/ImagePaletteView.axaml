<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FracturingFog.UI.Avalonia.ViewModels"
        xmlns:c="using:FracturingFog.UI.Avalonia.Controls"
        x:Class="FracturingFog.UI.Avalonia.Views.ImagePaletteView"
        x:DataType="vm:ImagePaletteViewModel"
        Title="Palette from Image"
        Width="860"
        Height="780"
        MinWidth="640"
        MinHeight="540"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#161616"
        Foreground="#DCDCDC">

    <Window.Styles>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#285028" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style Selector="Button.secondary">
            <Setter Property="Background" Value="#3C3264" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style Selector="Button.danger">
            <Setter Property="Background" Value="#463232" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="14,6" />
        </Style>
        <Style Selector="Button.apply">
            <Setter Property="Background" Value="#28643C" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style Selector="TextBlock.section">
            <Setter Property="Foreground" Value="#C8C864" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="Foreground" Value="#B4B4B4" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.error">
            <Setter Property="Foreground" Value="#C86464" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style Selector="Border.resultRow">
            <Setter Property="Background" Value="#232323" />
        </Style>
        <Style Selector="Border.resultRow.selected">
            <Setter Property="Background" Value="#283C28" />
        </Style>
    </Window.Styles>

    <Grid Margin="12" RowDefinitions="Auto,Auto,*,Auto">

        <!-- Title -->
        <TextBlock Grid.Row="0"
                   Classes="section"
                   FontSize="14"
                   Text="Palette from Image"
                   Margin="0,0,0,10" />

        <!-- Drop zone + Options -->
        <Grid Grid.Row="1" ColumnDefinitions="300,12,*" Margin="0,0,0,10">

            <!-- Drop zone -->
            <Border Grid.Column="0"
                    Background="#1E1E1E"
                    BorderBrush="#505050"
                    BorderThickness="1"
                    Height="280">
                <Grid RowDefinitions="*,Auto">
                    <Grid Grid.Row="0" Margin="4">
                        <Image Source="{Binding PreviewImage}"
                               Stretch="Uniform" />
                        <TextBlock Text="Drop image here&#x0A;or click Browse…"
                                   TextAlignment="Center"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   Foreground="#8C8C8C"
                                   FontStyle="Italic"
                                   IsVisible="{Binding ShowDropHint}" />
                    </Grid>
                    <Grid Grid.Row="1" Margin="4,2,4,4" ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0"
                                   Text="{Binding FileLabel}"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"
                                   Foreground="#A0A0A0"
                                   FontSize="11" />
                        <Button Grid.Column="1"
                                Content="Browse…"
                                Command="{Binding BrowseCommand}"
                                Background="#2D4164"
                                Foreground="White"
                                Padding="10,2" />
                    </Grid>
                </Grid>
            </Border>

            <!-- Options grid -->
            <Grid Grid.Column="2"
                  RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                  ColumnDefinitions="140,*">
                <TextBlock Grid.Row="0" Grid.Column="0" Classes="label" Text="Method:" Margin="0,2" />
                <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,2"
                          ItemsSource="{Binding MethodNames}"
                          SelectedIndex="{Binding MethodIndex}" />

                <TextBlock Grid.Row="1" Grid.Column="0" Classes="label" Text="Color count:" Margin="0,2" />
                <NumericUpDown Grid.Row="1" Grid.Column="1" Margin="0,2"
                               Minimum="4" Maximum="32" Increment="1"
                               Value="{Binding ColorCount}"
                               FormatString="0" />

                <TextBlock Grid.Row="2" Grid.Column="0" Classes="label" Text="Color space:" Margin="0,2" />
                <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,2"
                          SelectedIndex="{Binding SpaceIndex}">
                    <ComboBoxItem Content="RGB" />
                    <ComboBoxItem Content="Lab (perceptual)" />
                    <ComboBoxItem Content="HSL" />
                </ComboBox>

                <TextBlock Grid.Row="3" Grid.Column="0" Classes="label" Text="Downsample max:" Margin="0,2" />
                <NumericUpDown Grid.Row="3" Grid.Column="1" Margin="0,2"
                               Minimum="64" Maximum="1024" Increment="64"
                               Value="{Binding DownsampleMax}"
                               FormatString="0" />

                <TextBlock Grid.Row="4" Grid.Column="0" Classes="label" Text="Sort:" Margin="0,2" />
                <ComboBox Grid.Row="4" Grid.Column="1" Margin="0,2"
                          SelectedIndex="{Binding SortIndex}">
                    <ComboBoxItem Content="Nearest-Neighbor Chain" />
                    <ComboBoxItem Content="Hue" />
                    <ComboBoxItem Content="Luminance" />
                    <ComboBoxItem Content="Cluster Size" />
                </ComboBox>

                <TextBlock Grid.Row="5" Grid.Column="0" Classes="label" Text="Dedup ΔE:" Margin="0,2" />
                <NumericUpDown Grid.Row="5" Grid.Column="1" Margin="0,2"
                               Minimum="0" Maximum="30" Increment="0.5"
                               Value="{Binding DedupDeltaE}"
                               FormatString="0.0" />

                <CheckBox Grid.Row="6" Grid.ColumnSpan="2"
                          Content="Weight stop positions by cluster size"
                          IsChecked="{Binding WeightedPositions}"
                          Margin="0,4,0,0" />

                <CheckBox Grid.Row="7" Grid.ColumnSpan="2"
                          Content="Exclude near-black pixels"
                          IsChecked="{Binding ExcludeNearBlack}"
                          Margin="0,2,0,0" />

                <CheckBox Grid.Row="8" Grid.ColumnSpan="2"
                          Content="Exclude near-white pixels"
                          IsChecked="{Binding ExcludeNearWhite}"
                          Margin="0,2,0,0" />

                <StackPanel Grid.Row="9" Grid.ColumnSpan="2"
                            Orientation="Horizontal"
                            Spacing="10"
                            Margin="0,12,0,0">
                    <Button Classes="primary"
                            Content="Extract"
                            Command="{Binding ExtractCommand}" />
                    <Button Classes="secondary"
                            Content="Compare All"
                            Command="{Binding CompareAllCommand}" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Results panel -->
        <Border Grid.Row="2"
                Background="#1C1C1C"
                BorderBrush="#505050"
                BorderThickness="1">
            <Grid>
                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Results}" Margin="8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:PaletteResultViewModel">
                                <Border Classes="resultRow"
                                        Classes.selected="{Binding IsSelected}"
                                        BorderBrush="#3C3C3C"
                                        BorderThickness="1"
                                        Margin="0,0,0,6"
                                        Padding="6">
                                    <Grid RowDefinitions="Auto,Auto,Auto">
                                        <!-- Header: title or radio -->
                                        <Grid Grid.Row="0" ColumnDefinitions="Auto,*">
                                            <RadioButton Grid.Column="0"
                                                         GroupName="PaletteResults"
                                                         Content="{Binding Name}"
                                                         IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                         IsVisible="{Binding ExclusiveSelect}"
                                                         Foreground="White"
                                                         FontWeight="Bold" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding SubtitleText}"
                                                       Foreground="#DCDCA0"
                                                       FontWeight="Bold"
                                                       VerticalAlignment="Center"
                                                       IsVisible="{Binding ShowTitleLabel}" />
                                        </Grid>

                                        <!-- Swatches -->
                                        <c:SwatchStripControl Grid.Row="1" Margin="0,6,0,0" />

                                        <!-- Gradient -->
                                        <c:GradientStripControl Grid.Row="2" Margin="0,6,0,0" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <TextBlock Text="{Binding StatusMessage}"
                           Classes="error"
                           Margin="12"
                           VerticalAlignment="Top"
                           IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </Grid>
        </Border>

        <!-- Bottom row: Apply / Cancel -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8"
                    Margin="0,10,0,0">
            <Button Classes="apply"
                    Content="Apply"
                    IsEnabled="{Binding CanApply}"
                    Command="{Binding ApplyCommand}" />
            <Button Classes="danger"
                    Content="Cancel"
                    Command="{Binding CancelCommand}" />
        </StackPanel>
    </Grid>
</Window>

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FracturingFog.UI.Avalonia.ViewModels"
        x:Class="FracturingFog.UI.Avalonia.Views.AssetManagerView"
        x:DataType="vm:AssetManagerViewModel"
        Title="Asset Manager"
        Width="820"
        Height="540"
        MinWidth="640"
        MinHeight="380"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#161616"
        Foreground="#DCDCDC">

    <Window.Styles>
        <Style Selector="TextBlock.label">
            <Setter Property="Foreground" Value="#B4B4B4" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style Selector="TextBlock.value">
            <Setter Property="Foreground" Value="#DCDCDC" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="Border.pane">
            <Setter Property="BorderBrush" Value="#3A3A3A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="3" />
        </Style>
        <Style Selector="Button.action">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="4,0,0,0" />
        </Style>
        <Style Selector="Button.close"> <Setter Property="Background" Value="#3A3A3A" /> </Style>
        <Style Selector="Button.neutral"> <Setter Property="Background" Value="#283C64" /> </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto" Margin="10">

        <!-- Header -->
        <TextBlock Grid.Row="0"
                   Text="{Binding HeaderText}"
                   Foreground="#C8C864"
                   FontSize="14"
                   FontWeight="Bold"
                   Margin="0,0,0,8" />

        <!-- Three panes -->
        <Grid Grid.Row="1" ColumnDefinitions="180,*,240" ColumnSpacing="8">

            <!-- Left: type tree -->
            <Border Grid.Column="0" Classes="pane">
                <ListBox ItemsSource="{Binding Types}"
                         SelectedItem="{Binding SelectedType}"
                         Background="Transparent"
                         BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:AssetTypeNode">
                            <TextBlock Text="{Binding DisplayName}" Padding="2" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- Middle: filtered list -->
            <Grid Grid.Column="1" RowDefinitions="Auto,*" RowSpacing="6">
                <TextBox Grid.Row="0"
                         Text="{Binding FilterText}"
                         Watermark="Filter by name…"
                         Background="#1E1E1E" />
                <Border Grid.Row="1" Classes="pane">
                    <Grid>
                        <ListBox ItemsSource="{Binding Assets}"
                                 SelectedItem="{Binding SelectedAsset}"
                                 Background="Transparent"
                                 BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:AssetRowViewModel">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="{Binding Name}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Text="{Binding SizeText}"
                                                   Foreground="#808080" Margin="8,0,0,0" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Text="No saved assets of this type."
                                   Foreground="#808080"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   IsVisible="{Binding IsEmpty}" />
                    </Grid>
                </Border>
            </Grid>

            <!-- Right: detail -->
            <Border Grid.Column="2" Classes="pane" Padding="10">
                <StackPanel Spacing="8" IsVisible="{Binding HasSelection}">
                    <TextBlock Text="Detail" Foreground="#C8C864" FontWeight="Bold" />
                    <StackPanel Spacing="2">
                        <TextBlock Classes="label" Text="Name" />
                        <TextBlock Classes="value" Text="{Binding SelectedAsset.Name}" />
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <TextBlock Classes="label" Text="Type" />
                        <TextBlock Classes="value" Text="{Binding SelectedAsset.KindLabel}" />
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <TextBlock Classes="label" Text="Size" />
                        <TextBlock Classes="value" Text="{Binding SelectedAsset.SizeText}" />
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <TextBlock Classes="label" Text="Created" />
                        <TextBlock Classes="value" Text="{Binding SelectedAsset.CreatedText}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Footer -->
        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Classes="action neutral" Content="Refresh" Command="{Binding RefreshCommand}" />
            <Button Classes="action close" Content="Close" Command="{Binding CloseCommand}" />
        </StackPanel>
    </Grid>
</Window>

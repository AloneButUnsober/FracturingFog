<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FracturingFog.UI.Avalonia.ViewModels"
        x:Class="FracturingFog.UI.Avalonia.Views.RegionEditorView"
        x:DataType="vm:RegionEditorViewModel"
        Foreground="#DCDCDC">

    <!-- Chrome (title/560x520/#161616 bg/CenterOwner) lives on the
         PanelHostWindow built in MainWindow.SyncRegionEditor. -->

    <UserControl.Styles>
        <Style Selector="TextBlock.section">
            <Setter Property="Foreground" Value="#C8C864" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="Foreground" Value="#B4B4B4" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.group">
            <Setter Property="BorderBrush" Value="#3A3A3A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style Selector="Button.action">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="0,0,4,0" />
        </Style>
        <Style Selector="Button.save">  <Setter Property="Background" Value="#283C64" /> </Style>
        <Style Selector="Button.close"> <Setter Property="Background" Value="#3A3A3A" /> </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*,Auto" Margin="10">

        <!-- Header -->
        <TextBlock Grid.Row="0"
                   Text="{Binding HeaderText}"
                   Foreground="#C8C864"
                   FontSize="14"
                   FontWeight="Bold"
                   VerticalAlignment="Center"
                   Margin="0,0,0,8" />

        <!-- Content -->
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Orientation="Vertical">

                <!-- Stored geometry (read-only) -->
                <Border Classes="group">
                    <StackPanel Spacing="6">
                        <TextBlock Classes="section" Text="Stored geometry (read-only)" />
                        <TextBlock Text="{Binding GeometrySummary}"
                                   Foreground="#DCDCDC"
                                   TextWrapping="Wrap" />
                        <TextBlock Foreground="#888888" FontSize="11"
                                   TextWrapping="Wrap"
                                   Text="Geometry is preserved as saved. Use Capture current view to re-frame it from the live view on save." />
                        <Button Content="Capture current view"
                                Command="{Binding CaptureCurrentViewCommand}"
                                IsVisible="{Binding CanCaptureView}"
                                HorizontalAlignment="Left"
                                Background="#2A3A2A" Foreground="#DCDCDC"
                                Padding="8,3" Margin="0,2,0,0" />
                        <TextBlock Foreground="#8CC88C" FontSize="11"
                                   TextWrapping="Wrap"
                                   IsVisible="{Binding GeometryWillRecapture}"
                                   Text="{Binding CaptureSummary}" />
                    </StackPanel>
                </Border>

                <!-- Identity -->
                <Border Classes="group">
                    <StackPanel Spacing="6">
                        <TextBlock Classes="section" Text="Identity" />
                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" Margin="0,4,0,0">
                            <TextBlock Classes="label" Grid.Row="0" Grid.Column="0" Text="Name:" Margin="0,0,8,4" />
                            <TextBox   Grid.Row="0" Grid.Column="1" Text="{Binding Name}" Margin="0,0,0,4" />

                            <TextBlock Classes="label" Grid.Row="1" Grid.Column="0" Text="Description:" Margin="0,0,8,0" />
                            <TextBox   Grid.Row="1" Grid.Column="1" Text="{Binding Description}" />
                        </Grid>
                        <TextBlock Foreground="#C8C878" FontSize="11"
                                   IsVisible="{Binding IsBuiltIn}"
                                   TextWrapping="Wrap"
                                   Text="This is a built-in region. Saving creates a new user-region copy; the built-in is left untouched." />
                    </StackPanel>
                </Border>

                <!-- Attached assets -->
                <Border Classes="group">
                    <StackPanel Spacing="6">
                        <TextBlock Classes="section" Text="Attached assets" />
                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto" Margin="0,4,0,0">
                            <TextBlock Classes="label" Grid.Row="0" Grid.Column="0" Text="Animation:" Margin="0,0,8,4" />
                            <ComboBox  Grid.Row="0" Grid.Column="1"
                                       ItemsSource="{Binding AnimationNames}"
                                       SelectedItem="{Binding SelectedAnimation}"
                                       HorizontalAlignment="Stretch"
                                       Margin="0,0,0,4" />
                        </Grid>

                        <TextBlock Classes="label" Text="Curated themes:" />
                        <TextBlock Foreground="#888888" FontSize="11" TextWrapping="Wrap"
                                   Text="Check the themes this region prefers. None checked = no preference (falls back to the compat-filtered pool)." />
                        <TextBox Text="{Binding CuratedFilter}"
                                 PlaceholderText="filter themes…"
                                 Margin="0,0,0,4" />
                        <Border BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="3" MaxHeight="150">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding CuratedThemes}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="vm:CuratedThemeOption">
                                            <CheckBox Content="{Binding Name}"
                                                      IsChecked="{Binding IsSelected}"
                                                      IsVisible="{Binding IsVisible}"
                                                      Foreground="#DCDCDC"
                                                      Padding="4,0" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                        <CheckBox Content="Use curated color theme(s) only"
                                  IsChecked="{Binding UseCuratedThemesOnly}"
                                  Foreground="#DCDCDC"
                                  ToolTip.Tip="When on, recalling this region applies its first checked curated theme as the active color theme (the saved look comes back on jump). Off = recall leaves whatever theme is active untouched." />
                        <CheckBox Content="Cycle (palette rotation)"
                                  IsChecked="{Binding CycleEnabled}"
                                  IsVisible="{Binding ShowCycleToggle}"
                                  Foreground="#DCDCDC"
                                  ToolTip.Tip="Region-scoped palette cycling, like the toolbar Cycle button. On recall this wins over the toolbar toggle — turn it off for Acid Fog looks that read better without the flowing LUT rotation (e.g. a Flow-morph animation)." />
                        <CheckBox Content="Keep lighting override"
                                  IsChecked="{Binding KeepLightingOverride}"
                                  IsVisible="{Binding HasLightingOverride}"
                                  Foreground="#DCDCDC" />
                        <CheckBox Content="Keep embedded watermark"
                                  IsChecked="{Binding KeepEmbeddedWatermark}"
                                  IsVisible="{Binding HasEmbeddedWatermark}"
                                  Foreground="#DCDCDC" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Classes="action save"  Content="Save"  Command="{Binding SaveCommand}"  Width="100" />
            <Button Classes="action close" Content="Close" Command="{Binding CloseCommand}" Width="100" />
        </StackPanel>

    </Grid>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:FracturingFog.UI.Avalonia.ViewModels"
        mc:Ignorable="d"
        x:Class="FracturingFog.UI.Avalonia.Views.JobListView"
        x:DataType="vm:JobListViewModel">

    <UserControl.Styles>
        <Style Selector="TextBlock.section">
            <Setter Property="Foreground" Value="#DDD" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,8,0,4" />
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="Foreground" Value="#9B9B9B" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.value">
            <Setter Property="Foreground" Value="#EEE" />
            <Setter Property="FontFamily" Value="Consolas,Menlo,monospace" />
        </Style>
        <Style Selector="Border.group">
            <Setter Property="Padding" Value="10" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Background" Value="#1B1B1B" />
            <Setter Property="BorderBrush" Value="#2E2E2E" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#2E6BC8" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="12,5" />
        </Style>
        <Style Selector="Border.gridRow">
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="BorderBrush" Value="#262626" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
        <Style Selector="Border.gridHeader">
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Background" Value="#242424" />
            <Setter Property="BorderBrush" Value="#3A3A3A" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
        <Style Selector="Border.gridHeader TextBlock">
            <Setter Property="Foreground" Value="#CCC" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style Selector="Border.gridRow TextBlock">
            <Setter Property="Foreground" Value="#222" />
            <Setter Property="FontFamily" Value="Consolas,Menlo,monospace" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*,Auto" Margin="12">

        <!-- Header / filter / refresh -->
        <Border Grid.Row="0" Classes="group">
            <StackPanel Spacing="4">
                <TextBlock Classes="section" Text="Filters" />
                <Grid ColumnDefinitions="120,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto">
                    <TextBlock Grid.Row="0" Grid.Column="0" Classes="label" Text="State" />
                    <ComboBox  Grid.Row="0" Grid.Column="1"
                               ItemsSource="{x:Static vm:JobListViewModel.StateFilterOptions}"
                               SelectedItem="{Binding SelectedStateFilter, Mode=TwoWay}"
                               HorizontalAlignment="Stretch" />
                    <Button    Grid.Row="0" Grid.Column="2" Classes="primary" Content="Refresh"
                               Command="{Binding RefreshCommand}" Margin="8,0,0,0" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Classes="label" Text="Include terminal" Margin="0,4,0,0" />
                    <CheckBox  Grid.Row="1" Grid.Column="1" IsChecked="{Binding IncludeTerminal, Mode=TwoWay}"
                               Foreground="#EEE" Margin="0,4,0,0"
                               ToolTip.Tip="When off, only queued/planning/rendering/merging jobs show" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Classes="label" Text="Limit" Margin="0,4,0,0" />
                    <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding Limit}"
                                   Minimum="1" Maximum="500" Margin="0,4,0,0" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Classes="label" Text="Status" Margin="0,4,0,0" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Classes="value" Text="{Binding Status}"
                               TextWrapping="Wrap" Margin="0,4,0,0" />
                </Grid>
                <TextBlock Classes="value" Text="{Binding LastError}"
                           Foreground="#FFCC00" TextWrapping="Wrap" Margin="0,4,0,0"
                           IsVisible="{Binding LastError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>
        </Border>

        <!-- Jobs grid -->
        <Border Grid.Row="1" Classes="group">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Top" Classes="section" Text="Jobs" />

                <Border DockPanel.Dock="Top" Classes="gridHeader">
                    <Grid ColumnDefinitions="220,80,90,160,70,150,90,80,*">
                        <TextBlock Grid.Column="0" Text="Job ID" />
                        <TextBlock Grid.Column="1" Text="Mode" />
                        <TextBlock Grid.Column="2" Text="State" />
                        <TextBlock Grid.Column="3" Text="Tiles" />
                        <TextBlock Grid.Column="4" Text="Done %" />
                        <TextBlock Grid.Column="5" Text="Created" />
                        <TextBlock Grid.Column="6" Text="Artifact" />
                        <TextBlock Grid.Column="7" Text="Detail" />
                        <TextBlock Grid.Column="8" Text="Fail reason" />
                    </Grid>
                </Border>

                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Jobs}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:JobListRowVm">
                                <Border Classes="gridRow" Background="{Binding RowBackgroundHex}">
                                    <Grid ColumnDefinitions="220,80,90,160,70,150,90,80,*">
                                        <TextBlock Grid.Column="0" Text="{Binding JobId}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Text="{Binding Mode}" />
                                        <TextBlock Grid.Column="2" Text="{Binding JobState}" FontWeight="Bold" />
                                        <TextBlock Grid.Column="3" Text="{Binding TilesProgress}" />
                                        <TextBlock Grid.Column="4" Text="{Binding ProgressPercent}" />
                                        <TextBlock Grid.Column="5" Text="{Binding CreatedLocal}" />
                                        <TextBlock Grid.Column="6" Text="{Binding ArtifactSizeText}" />
                                        <Button    Grid.Column="7" Content="Open"
                                                   Padding="6,2"
                                                   Background="#2E6BC8" Foreground="White"
                                                   Command="{Binding $parent[ItemsControl].((vm:JobListViewModel)DataContext).OpenJobDetailCommand}"
                                                   CommandParameter="{Binding}" />
                                        <TextBlock Grid.Column="8" Text="{Binding FailReason}" TextWrapping="Wrap" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Footer -->
        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Spacing="6">
            <Button Classes="primary" Content="Close" Command="{Binding CloseCommand}" />
        </StackPanel>
    </Grid>
</UserControl>

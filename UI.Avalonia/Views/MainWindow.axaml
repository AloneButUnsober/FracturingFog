<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ctrl="using:FracturingFog.UI.Avalonia.Controls"
        mc:Ignorable="d"
        x:Class="FracturingFog.UI.Avalonia.Views.MainWindow"
        Title="Fracturing Fog (Avalonia preview)"
        Width="1280" Height="800"
        MinWidth="640" MinHeight="400"
        Background="Black">

    <!--
      Phase 2.0 shell. The GpuSurfaceControl is the central render target;
      everything else (floating menu, minimap, footer) will dock around it
      via Grid * sizing as each WinForms dialog is ported.

      No hardcoded pixel coordinates anywhere in this tree — Avalonia DIPs
      scale automatically across DPI and resolution.
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="8,4"
                Background="#161616"
                BorderBrush="#333" BorderThickness="0,0,0,1">
            <TextBlock Text="Fracturing Fog — Avalonia shell (Phase 2 bootstrap)"
                       Foreground="#C8C864"
                       FontWeight="Bold" />
        </Border>

        <ctrl:GpuSurfaceControl x:Name="GpuSurface" Grid.Row="1" />

        <Border Grid.Row="2"
                Padding="8,4"
                Background="#161616"
                BorderBrush="#333" BorderThickness="0,1,0,0">
            <TextBlock x:Name="StatusText"
                       Text="Surface not yet attached."
                       Foreground="#999" />
        </Border>
    </Grid>

</Window>

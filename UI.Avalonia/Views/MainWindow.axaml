<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ctrl="using:FracturingFog.UI.Avalonia.Controls"
        xmlns:vm="using:FracturingFog.UI.Avalonia.ViewModels"
        mc:Ignorable="d"
        x:Class="FracturingFog.UI.Avalonia.Views.MainWindow"
        x:DataType="vm:ShellViewModel"
        Title="{Binding WindowTitle}"
        Width="1280" Height="800"
        MinWidth="640" MinHeight="400"
        Background="Black">

    <!--
      Phase 2.3 F.2 shell layout. Binds to ShellViewModel:
        • Top toolbar  → Main.FractalTypes / QualityPresets +
                         FloatingMenu.RegionNames / ThemeNames
        • Center       → GpuSurfaceControl (NativeControlHost child HWND)
                         with an "InputSponge" Border above it. Native
                         HWND children do not forward pointer events
                         to Avalonia, so the sponge is the actual input
                         target the AvaloniaInputAdapter listens on.
        • Bottom strip → Main.StatusText
        • Child windows (FloatingMenu / ColorThemeEditor / FloatingHelp)
          are shown / hidden by the code-behind tracking the Shell's
          IsXxxVisible flags.
    -->

    <Window.Styles>
        <Style Selector="Button.toolbar">
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Background" Value="#222" />
            <Setter Property="Foreground" Value="#EEE" />
            <Setter Property="BorderBrush" Value="#444" />
        </Style>
        <Style Selector="ComboBox.toolbar">
            <Setter Property="Background" Value="#1E1E1E" />
            <Setter Property="Foreground" Value="#EEE" />
            <Setter Property="MinHeight" Value="26" />
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="Foreground" Value="#9B9B9B" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
    </Window.Styles>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Toolbar ─────────────────────────────────────────────────────── -->
        <Border Grid.Row="0"
                Padding="6,4"
                Background="#161616"
                BorderBrush="#333" BorderThickness="0,0,0,1"
                IsVisible="{Binding IsToolbarVisible}">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" Spacing="6" DockPanel.Dock="Left">
                    <Button Classes="toolbar" Content="Reset"
                            Command="{Binding Main.ResetViewCommand}" />
                    <Button Classes="toolbar" Content="Menu"
                            Command="{Binding ShowFloatingMenuCommand}" />
                    <ToggleButton Classes="toolbar" Content="Terminal"
                                  IsChecked="{Binding IsTerminalMode, Mode=TwoWay}"
                                  ToolTip.Tip="Terminal Mode — show the fractal as live ASCII / text art" />
                    <ToggleButton Classes="toolbar" Content="Split"
                                  IsChecked="{Binding IsSideBySideMode, Mode=TwoWay}"
                                  ToolTip.Tip="Side-by-side — full render on the left, live ASCII on the right" />
                    <ToggleButton Classes="toolbar" Content="Ramp: FX"
                                  IsVisible="{Binding IsAsciiVisible}"
                                  IsChecked="{Binding AsciiRampFromColor, Mode=TwoWay}"
                                  ToolTip.Tip="Drive the ASCII glyph ramp from the post-FX image (adaptive / brightness / contrast) instead of the raw iteration field" />
                    <ToggleButton Classes="toolbar" Content="Hue"
                                  IsVisible="{Binding IsAsciiVisible}"
                                  IsChecked="{Binding AsciiFxHue, Mode=TwoWay}"
                                  ToolTip.Tip="ASCII FX — cycle the palette hue over time" />
                    <ToggleButton Classes="toolbar" Content="CRT"
                                  IsVisible="{Binding IsAsciiVisible}"
                                  IsChecked="{Binding AsciiFxCrt, Mode=TwoWay}"
                                  ToolTip.Tip="ASCII FX — CRT scanlines" />
                    <ToggleButton Classes="toolbar" Content="Breathe"
                                  IsVisible="{Binding IsAsciiVisible}"
                                  IsChecked="{Binding AsciiFxBreathe, Mode=TwoWay}"
                                  ToolTip.Tip="ASCII FX — pulse the glyph density over time" />
                    <ComboBox x:Name="AsciiFxPresetCombo"
                              Classes="toolbar"
                              MinWidth="140"
                              IsVisible="{Binding IsAsciiVisible}"
                              ItemsSource="{Binding AsciiFxPresetNames}"
                              SelectedItem="{Binding SelectedAsciiFxPreset, Mode=TwoWay}"
                              ToolTip.Tip="ASCII FX preset — a one-click curated look (Matrix, CRT, Fire, …)" />
                    <ComboBox x:Name="AsciiWatermarkStyleCombo"
                              Classes="toolbar"
                              MinWidth="110"
                              IsVisible="{Binding IsAsciiVisible}"
                              ItemsSource="{Binding AsciiWatermarkStyles}"
                              SelectedItem="{Binding SelectedAsciiWatermarkStyle, Mode=TwoWay}"
                              ToolTip.Tip="ASCII watermark style — how the region/theme watermark is drawn as text art (Block, Plain label, Boxed banner). Shows in Terminal Mode when Watermark is on; always on ASCII exports." />
                    <Button Classes="toolbar" Content="FX…"
                            IsVisible="{Binding IsAsciiVisible}"
                            Command="{Binding ShowAsciiFxPanelCommand}"
                            ToolTip.Tip="Open the full ASCII FX panel for per-effect control" />
                    <ToggleButton Classes="toolbar" Content="● REC"
                                  IsVisible="{Binding IsAsciiVisible}"
                                  IsChecked="{Binding IsAsciiRecording, Mode=TwoWay}"
                                  ToolTip.Tip="Record the live ASCII animation to a file (zoom video / scene / slideshow / interactive). Toggle off to choose .cast / .svg / .ans / .mp4." />
                    <!--<ToggleButton Classes="toolbar" Content="Grid"
                                  IsChecked="{Binding Main.ShowGrid, Mode=TwoWay}"
                                  ToolTip.Tip="Show Cartesian grid overlay" />
                    <ToggleButton Classes="toolbar" Content="Watermark"
                                  IsChecked="{Binding Main.ShowWatermark, Mode=TwoWay}"
                                  ToolTip.Tip="Show region/theme + program watermark" />-->
                    <Button Classes="toolbar" Content="?"
                            Command="{Binding ShowHelpCommand}" 
                            ToolTip.Tip="Help menu..."/>
                    <TextBlock Text="Type" Classes="label" />
                    <ComboBox x:Name="ToolbarTypeCombo"
                              Classes="toolbar"
                              MinWidth="150"
                              ItemsSource="{Binding Main.FractalEntries}"
                              SelectedItem="{Binding Main.SelectedFractalEntry}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate DataType="vm:FractalTypeEntry">
                                <TextBlock Text="{Binding Label}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Classes="toolbar" Content="Params"
                            Command="{Binding ShowFractalParamsCommand}"
                            ToolTip.Tip="Edit parameters for the current fractal type" />
                    <TextBlock Text="Quality" Classes="label" Margin="8,0,0,0" />
                    <ComboBox Classes="toolbar"
                              MinWidth="130"
                              ItemsSource="{Binding Main.QualityPresets}"
                              SelectedItem="{Binding Main.SelectedQuality}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Text="Region" Classes="label" Margin="8,0,0,0" />
                    <ComboBox x:Name="ToolbarRegionCombo"
                              Classes="toolbar"
                              MinWidth="180"
                              ItemsSource="{Binding FloatingMenu.RegionNames}"
                              SelectedItem="{Binding FloatingMenu.SelectedRegion}">
                        <!-- Right-click menu ("Edit region…" + filter-by-fractal-type)
                             is built in code-behind (AttachShell → ComboSortMenu) so
                             the Edit entry and the RegionSortMode filters share one
                             flyout. A static ComboBox.ContextMenu here would shadow it. -->
                    </ComboBox>
                    <Button Classes="toolbar" Content="Edit"
                            ToolTip.Tip="Edit the selected region's metadata (name, animation, curated themes)."
                            Command="{Binding ShowRegionEditorCommand}" />
                    <TextBlock Text="Theme" Classes="label" Margin="8,0,0,0" />
                    <ComboBox x:Name="ToolbarThemeCombo"
                              Classes="toolbar"
                              MinWidth="180"
                              ItemsSource="{Binding FloatingMenu.ThemeNames}"
                              SelectedItem="{Binding FloatingMenu.SelectedTheme}" />
                    <Button Classes="toolbar" Content="Edit"
                            Command="{Binding ShowColorThemeEditorCommand}" />
                </StackPanel>
                <!--<StackPanel Orientation="Horizontal" Spacing="6" DockPanel.Dock="Right">
                    
                </StackPanel>-->
            </DockPanel>
        </Border>

        <!-- Render surface + input sponge ─────────────────────────────────
             Grid + watermark are CPU-composited into the BGRA buffer by
             FractalRenderHost before swap-chain upload (the GpuSurfaceControl
             is a NativeControlHost wrapping a Win32 HWND, and on Windows the
             OS composites that HWND on top of all Avalonia content
             regardless of XAML Z-order — so an Avalonia.Media overlay above
             this Grid would not be visible). -->
        <!-- Two columns so Side-by-side Mode (#228) can place the GPU surface in
             column 0 and the ASCII view in column 1. In Normal / Terminal mode
             the active surface spans both columns. Visibility + Grid.Column /
             ColumnSpan are driven from code-behind (ApplyAsciiLayout) so the
             three-state Normal / Terminal / SideBySide logic lives in one place.
             The native GPU HWND only ever covers its own column, so in split
             mode it never overlaps (occludes) the Avalonia ASCII view. -->
        <Grid Grid.Row="1" x:Name="RenderGrid" ColumnDefinitions="*,*">
            <ctrl:GpuSurfaceControl x:Name="GpuSurface"
                                    Grid.Column="0" Grid.ColumnSpan="2" />
            <ctrl:AsciiView x:Name="AsciiSurface"
                            Grid.Column="0" Grid.ColumnSpan="2"
                            IsVisible="False" />
            <!-- Transparent input sponge above the native HWND child. Pointer
                 + key events from this Border feed AvaloniaInputAdapter,
                 which translates them into the IFractalInputController. Spans
                 both columns so a click on either panel drives the shared view. -->
            <Border x:Name="InputSponge"
                    Grid.Column="0" Grid.ColumnSpan="2"
                    Background="Transparent"
                    IsHitTestVisible="True"
                    Focusable="True" />
            <!-- MiniMap is hoisted into a separate top-level Avalonia Window
                 by MainWindow code-behind (the GPU swap-chain HWND would
                 occlude any in-window overlay on Windows). -->
        </Grid>

        <!-- Slideshow VCR transport ───────────────────────────────────────
             Lives in its own layout band (not over the render grid) so the
             native swap-chain HWND can't occlude it. Visible only while the
             Avalonia slideshow cycler is running. -->
        <Border Grid.Row="2" IsVisible="{Binding IsSlideshowVcrVisible}">
            <ctrl:SlideshowVcrControl DataContext="{Binding SlideshowVcr}" />
        </Border>

        <!-- Status bar ─────────────────────────────────────────────────── -->
        <Border x:Name="StatusBar"
                Grid.Row="3"
                Padding="8,4"
                Background="#161616"
                BorderBrush="#333" BorderThickness="0,1,0,0"
                IsVisible="{Binding IsStatusBarVisible}">
            <DockPanel LastChildFill="True">
                <!-- Server up/down indicator on the right edge of the status bar -->
                <TextBlock DockPanel.Dock="Right"
                           Text="{Binding LocalServerIndicator}"
                           Foreground="{Binding LocalServerBrush}"
                           FontFamily="Consolas,Menlo,monospace"
                           Margin="12,0,0,0"
                           ToolTip.Tip="Local FracturingFog render server status — open Floating Menu → Server… for controls" />
                <TextBlock Text="{Binding Main.StatusText}"
                           Foreground="#C0C0C0"
                           FontFamily="Consolas,Menlo,monospace" />
            </DockPanel>
        </Border>
    </Grid>

</Window>

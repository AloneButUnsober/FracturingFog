<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FracturingFog.UI.Avalonia.ViewModels"
        xmlns:ff="using:FracturingFog"
        xmlns:anim="using:FracturingFog.Abstractions.Animation"
        x:Class="FracturingFog.UI.Avalonia.Views.AnimationEditorView"
        x:DataType="vm:AnimationEditorViewModel"
        Title="Animation Editor"
        Width="780"
        Height="700"
        MinWidth="640"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#161616"
        Foreground="#DCDCDC">

    <Window.Styles>
        <Style Selector="TextBlock.section">
            <Setter Property="Foreground" Value="#C8C864" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="Foreground" Value="#B4B4B4" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.group">
            <Setter Property="BorderBrush" Value="#3A3A3A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style Selector="Border.trackrow">
            <Setter Property="BorderBrush" Value="#2A2A2A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style Selector="Button.action">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="0,0,4,0" />
        </Style>
        <Style Selector="Button.new">     <Setter Property="Background" Value="#37374B" /> </Style>
        <Style Selector="Button.revert">  <Setter Property="Background" Value="#503C1E" /> </Style>
        <Style Selector="Button.save">    <Setter Property="Background" Value="#283C64" /> </Style>
        <Style Selector="Button.danger">  <Setter Property="Background" Value="#502323" /> </Style>
        <Style Selector="Button.preview"> <Setter Property="Background" Value="#1E5034" /> </Style>
        <Style Selector="Button.stop">    <Setter Property="Background" Value="#5A4A1E" /> </Style>
        <Style Selector="Button.close">   <Setter Property="Background" Value="#3A3A3A" /> </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="10">

        <!-- Title row -->
        <TextBlock Grid.Row="0"
                   Text="{Binding TitleText}"
                   Foreground="#C8C864"
                   FontSize="14"
                   FontWeight="Bold"
                   VerticalAlignment="Center" />

        <!-- Action row -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,8" Spacing="0">
            <CheckBox Content="Live preview"
                      IsChecked="{Binding LivePreview}"
                      Foreground="#C8C878"
                      FontWeight="Bold"
                      VerticalAlignment="Center"
                      Margin="0,0,12,0" />
            <Button Classes="action new"     Content="New"     Command="{Binding NewBlankCommand}" />
            <Button Classes="action revert"  Content="Revert"  Command="{Binding RevertCommand}" />
            <Button Classes="action preview" Content="Preview" Command="{Binding PreviewCommand}" />
            <Button Classes="action stop"    Content="Stop"    Command="{Binding StopPreviewCommand}" />
            <Button Classes="action save"    Content="Save"    Command="{Binding SaveCommand}" />
            <Button Classes="action danger"  Content="Delete"  Command="{Binding DeleteCommand}" />
        </StackPanel>

        <!-- Content -->
        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Orientation="Vertical">

                <!-- Saved animation -->
                <Border Classes="group">
                    <StackPanel Spacing="6">
                        <TextBlock Classes="section" Text="Saved animation" />
                        <Grid ColumnDefinitions="Auto,*" Margin="0,4,0,0">
                            <TextBlock Classes="label" Grid.Column="0" Text="Load:" Margin="0,0,8,0" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding AnimationNames}"
                                      SelectedItem="{Binding SelectedAnimation}"
                                      HorizontalAlignment="Stretch" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Identity + targeting -->
                <Border Classes="group">
                    <StackPanel Spacing="6">
                        <TextBlock Classes="section" Text="Identity" />
                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" Margin="0,4,0,0">
                            <TextBlock Classes="label" Grid.Row="0" Grid.Column="0" Text="Name:" Margin="0,0,8,4" />
                            <TextBox   Grid.Row="0" Grid.Column="1" Text="{Binding Name}" Margin="0,0,0,4" />

                            <TextBlock Classes="label" Grid.Row="1" Grid.Column="0" Text="Description:" Margin="0,0,8,4" />
                            <TextBox   Grid.Row="1" Grid.Column="1" Text="{Binding Description}" Margin="0,0,0,4" />

                            <TextBlock Classes="label" Grid.Row="2" Grid.Column="0" Text="Category:" Margin="0,0,8,4" />
                            <TextBox   Grid.Row="2" Grid.Column="1" Text="{Binding Category}" Margin="0,0,0,4" />

                            <TextBlock Classes="label" Grid.Row="3" Grid.Column="0" Text="Tags:" Margin="0,0,8,4" />
                            <TextBox   Grid.Row="3" Grid.Column="1" Text="{Binding Tags}" Margin="0,0,0,4"
                                       PlaceholderText="comma-separated" />

                            <TextBlock Classes="label" Grid.Row="4" Grid.Column="0" Text="Duration (s):" Margin="0,0,8,4" />
                            <NumericUpDown Grid.Row="4" Grid.Column="1"
                                           Value="{Binding Duration}"
                                           Minimum="0" Maximum="3600"
                                           Increment="1"
                                           FormatString="0.###"
                                           Margin="0,0,0,4" />

                            <TextBlock Classes="label" Grid.Row="5" Grid.Column="0" Text="Target type:" Margin="0,0,8,0" />
                            <ComboBox  Grid.Row="5" Grid.Column="1"
                                       ItemsSource="{Binding AvailableFractalTypes}"
                                       SelectedItem="{Binding SelectedFractalType}"
                                       HorizontalAlignment="Stretch" />
                        </Grid>
                        <TextBlock Foreground="#888888" FontSize="11"
                                   Text="Changing target type rebuilds the tracks list from the per-type animatable-params registry." />
                    </StackPanel>
                </Border>

                <!-- Tracks -->
                <Border Classes="group">
                    <StackPanel Spacing="6">
                        <TextBlock Classes="section" Text="Tracks" />
                        <ItemsControl ItemsSource="{Binding Tracks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:AnimationTrackRowViewModel">
                                    <Border Classes="trackrow">
                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto"
                                              RowDefinitions="Auto,Auto">

                                            <CheckBox Grid.Row="0" Grid.Column="0"
                                                      IsChecked="{Binding Enabled}"
                                                      Content=""
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,4,0" />
                                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Vertical" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding ParamName}"
                                                           Foreground="#DCDCDC"
                                                           FontWeight="Bold" />
                                                <TextBlock FontSize="10" Foreground="#888888">
                                                    <Run Text="{Binding KindLabel}" />
                                                    <Run Text=" · cost " />
                                                    <Run Text="{Binding CostLabel}" />
                                                </TextBlock>
                                            </StackPanel>

                                            <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Vertical" Margin="0,0,8,0">
                                                <TextBlock Classes="label" Text="Mode" FontSize="10" />
                                                <ComboBox ItemsSource="{Binding AvailableModes}"
                                                          SelectedItem="{Binding Mode}"
                                                          MinWidth="100" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="0" Grid.Column="3" Orientation="Vertical" Margin="0,0,8,0">
                                                <TextBlock Classes="label" Text="Min" FontSize="10" />
                                                <NumericUpDown Value="{Binding Min}"
                                                               Increment="0.1" FormatString="0.###"
                                                               MinWidth="90" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="0" Grid.Column="4" Orientation="Vertical" Margin="0,0,8,0">
                                                <TextBlock Classes="label" Text="Max" FontSize="10" />
                                                <NumericUpDown Value="{Binding Max}"
                                                               Increment="0.1" FormatString="0.###"
                                                               MinWidth="90" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="0" Grid.Column="5" Orientation="Vertical" Margin="0,0,8,0">
                                                <TextBlock Classes="label" Text="Hz" FontSize="10" />
                                                <NumericUpDown Value="{Binding FrequencyHz}"
                                                               Minimum="0" Maximum="20"
                                                               Increment="0.05" FormatString="0.###"
                                                               MinWidth="80" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="0" Grid.Column="6" Orientation="Vertical">
                                                <TextBlock Classes="label" Text="Phase (rad)" FontSize="10" />
                                                <NumericUpDown Value="{Binding PhaseOffsetRadians}"
                                                               Increment="0.1" FormatString="0.###"
                                                               MinWidth="80" />
                                            </StackPanel>

                                            <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="6"
                                                       FontSize="11" Foreground="#888888"
                                                       Text="{Binding Notes}"
                                                       IsVisible="{Binding HasNotes}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,4,0,0" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer close -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Classes="action close" Content="Close" Command="{Binding CloseCommand}" Width="100" />
        </StackPanel>

    </Grid>
</Window>

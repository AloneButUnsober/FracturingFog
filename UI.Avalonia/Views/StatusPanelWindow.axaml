<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FracturingFog.UI.Avalonia.ViewModels"
        xmlns:views="using:FracturingFog.UI.Avalonia.Views"
        x:Class="FracturingFog.UI.Avalonia.Views.StatusPanelWindow"
        x:DataType="vm:ShellViewModel"
        Title="Status"
        Width="420" Height="38"
        MinWidth="240" MinHeight="34"
        WindowDecorations="None"
        WindowStartupLocation="Manual"
        CanResize="True"
        ShowInTaskbar="False"
        Topmost="False"
        Background="#0D0D0D">
    <!-- Floating standalone status bar (#499). Chromeless. Click-drag the strip
         moves it (the Cancel button, when shown, handles its own click so it
         never starts a drag). Borderless OS edge-resize isn't reliable, so the
         bottom-right grip drives an explicit resize (code-behind). -->
    <Grid>
        <Border x:Name="DragRoot"
                Margin="6"
                Background="#161616"
                BorderBrush="#333" BorderThickness="1"
                Padding="8,4" Cursor="SizeAll">
            <views:StatusBarView />
        </Border>
        <Border x:Name="ResizeGrip"
                Width="16" Height="16"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Background="#2A2A2A"
                Cursor="BottomRightCorner"
                ToolTip.Tip="Drag to resize">
            <Path Data="M 11,15 L 15,11 M 7,15 L 15,7 M 3,15 L 15,3"
                  Stroke="#909090" StrokeThickness="1" />
        </Border>
    </Grid>
</Window>

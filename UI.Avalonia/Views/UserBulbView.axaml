<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FracturingFog.UI.Avalonia.ViewModels"
             xmlns:m="using:FracturingFog.Models"
             x:Class="FracturingFog.UI.Avalonia.Views.UserBulbView"
             x:DataType="vm:UserBulbViewModel"
             Foreground="White">

    <UserControl.Styles>
        <Style Selector="TextBlock.header">
            <Setter Property="Foreground" Value="#C8C8FF" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,8,0,4" />
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="Foreground" Value="#DCDCDC" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
        <Style Selector="Button.tool">
            <Setter Property="Background" Value="#464646" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="10,3" />
        </Style>
        <Style Selector="TextBox.code">
            <Setter Property="FontFamily" Value="Consolas, monospace" />
            <Setter Property="Background" Value="#1C1C1C" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="TextBlock.error">
            <Setter Property="Foreground" Value="#FFCC00" />
            <Setter Property="FontFamily" Value="Consolas, monospace" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style Selector="TextBlock.ok">
            <Setter Property="Foreground" Value="#64FF64" />
            <Setter Property="FontFamily" Value="Consolas, monospace" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style Selector="GridSplitter.splitter">
            <Setter Property="Background" Value="#C8C864"/>
        </Style>
    </UserControl.Styles>

    <Grid Margin="10" ColumnDefinitions="620,12,*" RowDefinitions="*">

        <!-- ── LEFT COLUMN ──────────────────────────────────────────── -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" >
            <StackPanel Spacing="6">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="{Binding HintText}" Foreground="#B4B4B4" TextWrapping="Wrap" />
                    <Button Grid.Column="1"
                            Content="?"
                            Command="{Binding OpenHelpCommand}"
                            ToolTip.Tip="Help for the User Bulb 3D editor"
                            Margin="8,0,0,0"
                            Width="28" Height="28"
                            VerticalAlignment="Top" />
                </Grid>

                <!-- Saved row -->
                <Grid ColumnDefinitions="50,*,Auto,Auto" Margin="0,4,0,0">
                    <TextBlock Grid.Column="0" Classes="label" Text="Saved:" />
                    <ComboBox  Grid.Column="1"
                               ItemsSource="{Binding SavedNames}"
                               SelectedItem="{Binding SelectedSavedName, Mode=TwoWay}"
                               HorizontalAlignment="Stretch"
                               MinWidth="380" />
                    <Button    Grid.Column="2" Classes="tool" Content="Save…"
                               Command="{Binding SaveCommand}" Margin="6,0,4,0" />
                    <Button    Grid.Column="3" Classes="tool" Content="Delete"
                               Command="{Binding DeleteCommand}" />
                </Grid>
                <Grid ColumnDefinitions="50,*,Auto,Auto">
                    <CheckBox  Grid.Column="1" Content="Promote to fractal list"
                               IsChecked="{Binding Promote, Mode=TwoWay}"
                               IsEnabled="{Binding PromoteEnabled}" />
                    <Button    Grid.Column="2" Classes="tool" Content="Import…"
                               Command="{Binding ImportCommand}" Margin="6,0,4,0" />
                    <Button    Grid.Column="3" Classes="tool" Content="Export…"
                               Command="{Binding ExportCommand}" />
                </Grid>

                <!-- Source editor -->
                <Border BorderBrush="#5A5A5A" BorderThickness="1" Background="#1C1C1C">
                    <TextBox x:Name="SourceEditor"
                             Classes="code"
                             AcceptsReturn="True"
                             AcceptsTab="True"
                             Text="{Binding Source, Mode=TwoWay}"
                             MinHeight="110"/>
                </Border>
                <TextBlock Classes="error"
                           Text="{Binding StatusMessage}"
                           IsVisible="{Binding StatusIsError}" />
                <TextBlock Classes="ok"
                           Text="{Binding StatusMessage}"
                           IsVisible="{Binding !StatusIsError}" />

                <!-- Camera -->
                <TextBlock Classes="header" Text="Camera" />
                <Grid ColumnDefinitions="75,Auto,75,Auto,75,Auto"
                      RowDefinitions="Auto,Auto" Margin="0,0,0,4"
                      RowSpacing="4">
                    <TextBlock Grid.Row="0" Grid.Column="0" Classes="label" Text="Distance:" />
                    <NumericUpDown Grid.Row="0" Grid.Column="1" Minimum="0.1" Maximum="500" Increment="0.1" FormatString="0.00"
                                   Value="{Binding CamDistance}" MinWidth="120"/>
                    <TextBlock Grid.Row="0" Grid.Column="2" Classes="label" Text="Theta°:" Margin="10,0,4,0" />
                    <NumericUpDown Grid.Row="0" Grid.Column="3" Minimum="-360" Maximum="360" Increment="5" FormatString="0.0"
                                   Value="{Binding CamThetaDeg}" MinWidth="120" />
                    <TextBlock Grid.Row="0" Grid.Column="4" Classes="label" Text="Phi°:" Margin="10,0,4,0" />
                    <NumericUpDown Grid.Row="0" Grid.Column="5" Minimum="1" Maximum="179" Increment="5" FormatString="0.0"
                                   Value="{Binding CamPhiDeg}" MinWidth="120" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Classes="label" Text="Light θ°:" />
                    <NumericUpDown Grid.Row="1" Grid.Column="1" Minimum="-360" Maximum="360" Increment="5" FormatString="0.0"
                                   Value="{Binding LightThetaDeg}" MinWidth="120" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Classes="label" Text="Light φ°:" Margin="10,0,4,0" />
                    <NumericUpDown Grid.Row="1" Grid.Column="3" Minimum="1" Maximum="179" Increment="5" FormatString="0.0"
                                   Value="{Binding LightPhiDeg}" MinWidth="120" />
                    <Button        Grid.Row="1" Grid.Column="4" Grid.ColumnSpan="2" Classes="tool" Content="Reset cam"
                                   Command="{Binding ResetCameraCommand}"
                                   HorizontalAlignment="Right" Margin="10,0,0,0" />
                </Grid>

                <!-- Render -->
                <Grid ColumnDefinitions="Auto" RowDefinitions="Auto,Auto,Auto">
                    <Grid Grid.Row="0" Grid.Column="0" ColumnDefinitions="75,75,Auto,Auto" 
                          RowDefinitions="Auto,Auto" Margin="0,0,0,4">
                        <TextBlock Grid.Column="0" Grid.Row="0" Classes="header" Text="Render" 
                                   Margin="0,4,0,0"/>    
                        <TextBlock Grid.Column="1" Grid.Row="0" Text="DE detect:" 
                               FontSize="12" Foreground="#64F070" Margin="0,4,0,0"/>

                        <Grid Grid.Column="2" Grid.Row="0" Grid.ColumnSpan="2"
                              Margin="0,5,0,0"
                          ToolTip.Tip="Closed-form DE pattern detected on the current source. When 'Analytic engaged', the raymarch runs a single trajectory with the Hubbard-Douady recurrence instead of four-trajectory numerical Jacobian — typically 3-4x faster.">
                        <TextBlock Text="{Binding AnalyticBadgeText}"
                                   IsVisible="{Binding AnalyticBadgeOk}"
                                   Foreground="#64FF64"
                                   FontFamily="Consolas, monospace"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding AnalyticBadgeText}"
                                   IsVisible="{Binding !AnalyticBadgeOk}"
                                   Foreground="#888888"
                                   FontFamily="Consolas, monospace"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"/>
                        </Grid>
                    </Grid>
                    <Grid Grid.Row="1" Grid.Column="0" ColumnDefinitions="75,Auto,75,Auto,75,Auto"
                          RowDefinitions="Auto,Auto,Auto" RowSpacing="4">
                        <TextBlock Grid.Column="0" Classes="label" Text="Algebra:" Margin="10,0,4,0"/>
                        <ComboBox Grid.Column="1" SelectedIndex="{Binding AxisModeIndex}"
                                 ToolTip.Tip="Vec3 = 3D mandelbulb-style. Quat = 4D quaternion fractal (slice W picks the hyperplane). Sandbox compiler in Quat mode: use qmul, qpow, qconj, qinv, qvec(x,y,z,w), .w member access, plus quaternion-algebra transcendentals qexp/qlog/qsqrt/qsin/qcos/qtan/qsinh/qcosh/qtanh/qasin/qacos/qatan (and reciprocals qcsc/qsec/qcot)."
                                  MinWidth="120">
                        <ComboBoxItem Content="Vec3 (3D)" />
                        <ComboBoxItem Content="Quat (4D)" />
                    </ComboBox>
                        <!-- #27 Phase 3 — the raw-C# Roslyn bulb compiler was
                             removed; the safe Sandbox DSL is the only path, so
                             the Compiler selector is retired. -->
                    <TextBlock Grid.Row="1" Grid.Column="0" Classes="label" Text="DE mode:" Margin="10,0,4,0"/>
                    <ComboBox Grid.Row="1" Grid.Column="1" SelectedIndex="{Binding DEModeIndex}" MinWidth="120">
                        <ComboBoxItem Content="Auto" />
                        <ComboBoxItem Content="Analytic" />
                        <ComboBoxItem Content="Numerical" />
                    </ComboBox>
                    <TextBlock Grid.Row="1" Grid.Column="2" Classes="label" Text="Backend:" Margin="8,0,4,0" />
                    <ComboBox    Grid.Row="1" Grid.Column="3" SelectedIndex="{Binding BackendIndex}" MinWidth="120"
                                 Grid.ColumnSpan="2">
                        <ComboBoxItem Content="CPU" />
                        <ComboBoxItem Content="GPU (experimental)" />
                    </ComboBox>
                                          
                        </Grid>
                    <Border Grid.Row="2" Grid.Column="0" BorderBrush="#5A5A5A" BorderThickness="1"
                            Margin="0,4,0,0" Padding="0,2,0,2">
                            <Grid ColumnDefinitions="75,Auto,75,Auto,Auto,Auto,Auto" RowDefinitions="Auto,Auto,Auto" 
                                  RowSpacing="4">
                                <TextBlock Grid.Row="0" Grid.Column="0" Classes="label" Text="Iterations:" />
                    <NumericUpDown Grid.Row="0" Grid.Column="1" Minimum="2" Maximum="64" Increment="1" FormatString="0"
                                   Value="{Binding Iterations}" MinWidth="120" />
                    <TextBlock Grid.Row="0" Grid.Column="2" Classes="label" Text="Bailout:" Margin="10,0,6,0" />
                    <NumericUpDown Grid.Row="0" Grid.Column="3" Minimum="1" Maximum="100" Increment="0.5" FormatString="0.0"
                                   Value="{Binding Bailout}" MinWidth="120" />
                    <TextBlock Grid.Row="0" Grid.Column="4" Classes="label" Text="Max steps:" Margin="10,0,6,0" />
                    <NumericUpDown Grid.Row="0" Grid.Column="5" Minimum="16" Maximum="512" Increment="8" FormatString="0"
                                   Value="{Binding MaxSteps}" MinWidth="120" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Classes="label" Text="K-scale:" Margin="10,0,6,0" />
                                <NumericUpDown Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="20" Increment="0.5" FormatString="0.0"
                                   ToolTip.Tip="Per-iteration linear scale for the scalar KIFS/Mandelbox distance estimator. 0 = off (use DE Mode). Set to the map's scale factor (e.g. 3 for the Kaleidoscopic-IFS preset) to render fold+rotation IFS whose folds have discontinuities the numerical Jacobian can't handle. CPU-only; overrides DE Mode when > 0."
                                   Value="{Binding KifsScale}" MinWidth="120" />
                                <TextBlock Grid.Row="1" Grid.Column="2" Classes="label" Text="Slice W:" Margin="10,0,6,0" />
                                <NumericUpDown Grid.Row="1" Grid.Column="3" Minimum="-10" Maximum="10" Increment="0.05" FormatString="0.000"
                                   IsEnabled="{Binding QuatEnabled}"
                                   Value="{Binding QuatSliceW}" MinWidth="120" 
                                   ToolTip.Tip="Set the KIFS scale value"/>
                                <TextBlock Grid.Row="1" Grid.Column="4" Classes="label" Text="Cull r:" Margin="10,0,6,0" />
                                <NumericUpDown Grid.Row="1" Grid.Column="5" Minimum="0.1" Maximum="50" Increment="0.25" FormatString="0.00"
                                   Value="{Binding CullRadius}" MinWidth="120" />  

                                <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="7" ColumnDefinitions="75,Auto,75,Auto">
                                    <TextBlock Grid.Column="0" Classes="label" Text="Epsilon:" />
                                    <NumericUpDown Grid.Column="1" Minimum="0.00001" Maximum="0.1" Increment="0.0005" FormatString="0.00000" 
                                                   Value="{Binding Epsilon}" MinWidth="120" />
                                    <TextBlock Grid.Column="2" Classes="label" Text="Jac h:" Margin="10,0,6,0" />
                                    <NumericUpDown Grid.Column="3" Minimum="0.0000001" Maximum="0.01" Increment="0.00005" FormatString="0.0000000" 
                                                   Value="{Binding JacobianH}" MinWidth="120" />    
                                </Grid>
                            </Grid>
                        </Border>
                </Grid>

                <!-- Params -->
                <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                    <TextBlock Grid.Column="0" Classes="header" Text="Params" Margin="0,0,0,0" />
                    <Button    Grid.Column="1" Classes="tool" Content="+ Add"
                               Command="{Binding AddParamCommand}" />
                </Grid>
                <Border BorderBrush="#5A5A5A" BorderThickness="1" Background="#232323">
                    <ItemsControl ItemsSource="{Binding Params}" MaxHeight="180">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="m:UserBulbParam">
                                <Grid ColumnDefinitions="80,*,*,*,Auto" Margin="2">
                                    <TextBox       Grid.Column="0" Text="{Binding Name, Mode=TwoWay}" />
                                    <NumericUpDown Grid.Column="1" Value="{Binding Value, Mode=TwoWay}" FormatString="0.0000" />
                                    <NumericUpDown Grid.Column="2" Value="{Binding Min,   Mode=TwoWay}" FormatString="0.000" />
                                    <NumericUpDown Grid.Column="3" Value="{Binding Max,   Mode=TwoWay}" FormatString="0.000" />
                                    <Button        Grid.Column="4" Content="X" Background="#5A3232" Foreground="White"
                                                   Command="{Binding $parent[ItemsControl].((vm:UserBulbViewModel)DataContext).RemoveParamCommand}"
                                                   CommandParameter="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <!-- Animation -->
                <TextBlock Classes="header" Text="Animation (t)" />
                <Grid ColumnDefinitions="Auto" RowDefinitions="Auto,Auto" RowSpacing="4">
                <Grid Grid.Row="0" ColumnDefinitions="Auto">
                    <Button        Grid.Column="0" Classes="tool" Content="{Binding PlayPauseLabel}"
                                   Command="{Binding TogglePlayCommand}" />
                    </Grid>
                    <Grid Grid.Row="1" ColumnDefinitions="75,Auto,75,Auto,75,*">
                    <TextBlock     Grid.Column="0" Classes="label" Text="Speed:" Margin="10,0,4,0" />
                    <NumericUpDown Grid.Column="1" Minimum="-10" Maximum="10" Increment="0.1" FormatString="0.00"
                                   Value="{Binding AnimSpeed}" MinWidth="120"/>
                    <TextBlock     Grid.Column="2" Classes="label" Text="Loop s:" Margin="10,0,4,0"
                                   ToolTip.Tip="Loop length in seconds. 0 = no loop." />
                    <NumericUpDown Grid.Column="3" Minimum="0" Maximum="600" Increment="0.5" FormatString="0.00"
                                   Value="{Binding AnimLoopSeconds}" MinWidth="120"/>
                    <TextBlock     Grid.Column="4" Classes="label" Text="t:" Margin="10,0,4,0" />
                    <NumericUpDown Grid.Column="5" Minimum="-1000000" Maximum="1000000" Increment="0.1" FormatString="0.000"
                                   Value="{Binding AnimTime}" MinWidth="140" />
                        </Grid>
                </Grid>

                <!-- Julia -->
                <TextBlock Classes="header" Text="Julia mode" />
                <CheckBox  Content="Enable (fix c)"
                           IsChecked="{Binding JuliaMode}"
                           Margin="0,0,0,2" />
                <Grid ColumnDefinitions="*" RowDefinitions="Auto,Auto" RowSpacing="4">
                <Grid Grid.Row="0" ColumnDefinitions="75,Auto,75,Auto,75,Auto,75,Auto" >
                    <TextBlock     Grid.Column="0" Classes="label" Text="c.X:" Margin="10,0,4,0" />
                    <NumericUpDown Grid.Column="1" Minimum="-10" Maximum="10" Increment="0.01" FormatString="0.000"
                                   Value="{Binding JuliaCX}" MinWidth="120" />
                    <TextBlock     Grid.Column="2" Classes="label" Text="c.Y:" Margin="10,0,4,0" />
                    <NumericUpDown Grid.Column="3" Minimum="-10" Maximum="10" Increment="0.01" FormatString="0.000"
                                   Value="{Binding JuliaCY}" MinWidth="120" />
                    <TextBlock     Grid.Column="4" Classes="label" Text="c.Z:" Margin="10,0,4,0" />
                    <NumericUpDown Grid.Column="5" Minimum="-10" Maximum="10" Increment="0.01" FormatString="0.000"
                                   Value="{Binding JuliaCZ}" MinWidth="120" />
                </Grid>
                    <Grid Grid.Row="1" ColumnDefinitions="75,Auto">
                        
                    <TextBlock     Grid.Column="0" Classes="label" Text="c.W:" Margin="0,0,4,0" />
                    <NumericUpDown Grid.Column="1" Minimum="-10" Maximum="10" Increment="0.01" FormatString="0.000"
                                   IsEnabled="{Binding QuatEnabled}"
                                   Value="{Binding JuliaCW}" MinWidth="120" />
                    </Grid>
                </Grid>
            </StackPanel>
        </ScrollViewer>
        <GridSplitter Grid.Column="1"
                      ResizeDirection="Columns"
                      Classes="splitter"
                      HorizontalAlignment="Center"
                      Margin="4,0,4,0"
                      Width="4"/>
        <!-- ── RIGHT COLUMN ─────────────────────────────────────────── -->
             <Grid Grid.Column="2" 
                   Margin="12,0,0,0"
                   ColumnDefinitions="*" 
                   RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,*">
                    <!-- Color driver -->
                <TextBlock Grid.Row="0" Classes="header" Text="Color driver" />
                <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto" RowDefinitions="Auto,Auto" RowSpacing="4">
                    <Grid Grid.Row="0" ColumnDefinitions="50,Auto,50,Auto">
                        <TextBlock Grid.Column="0" Classes="label" Text="Type:" Margin="4,0,4,0" Grid.Row="0" />
                        <ComboBox Grid.Column="1" SelectedIndex="{Binding ColorDriverIndex}" Grid.Row="0" MinWidth="125">
                            <ComboBoxItem Content="StepDepth" />
                            <ComboBoxItem Content="OrbitTrap" />
                            <ComboBoxItem Content="EscapeAngle" />
                            <ComboBoxItem Content="FinalMagnitude" />
                            <ComboBoxItem Content="IterComponent" />
                            <ComboBoxItem Content="Normal" />
                        </ComboBox>
                        <TextBlock Grid.Column="2" Classes="label" Text="axis:" Margin="4,0,4,0" Grid.Row="0" />
                        <ComboBox Grid.Column="3" SelectedIndex="{Binding IterAxis}" MinWidth="60" Grid.Row="0">
                            <ComboBoxItem Content="X" />
                            <ComboBoxItem Content="Y" />
                            <ComboBoxItem Content="Z" />
                        </ComboBox>
                    </Grid>

                    <Grid Grid.Row="1" ColumnDefinitions="50,Auto,50,Auto,50,Auto" Grid.Column="0">
                        <TextBlock Grid.Column="0" Classes="label" Text="tx:" Margin="10,0,4,0"/>
                        <NumericUpDown Grid.Column="1" Minimum="-10" Maximum="10" Increment="0.01"
                                       FormatString="0.000" Value="{Binding TrapX}" MinWidth="120"/>
                        <TextBlock     Grid.Column="2" Classes="label" Text="ty:" Margin="10,0,4,0"/>
                        <NumericUpDown Grid.Column="3" Minimum="-10" Maximum="10" Increment="0.01"
                                       FormatString="0.000" Value="{Binding TrapY}" MinWidth="120" />
                        <TextBlock     Grid.Column="4" Classes="label" Text="tz:" Margin="10,0,4,0" />
                        <NumericUpDown Grid.Column="5" Minimum="-10" Maximum="10" Increment="0.01"
                                       FormatString="0.000" Value="{Binding TrapZ}" MinWidth="120" />
                    </Grid>
                </Grid>

                <!-- Lighting -->
                <TextBlock Grid.Row="2" Classes="header" Text="Lighting (L1/L2/L3 intensity, AO, fog)" />
                <Grid Grid.Row="3" ColumnDefinitions="50,Auto,50,Auto,50,Auto" RowDefinitions="Auto,Auto" RowSpacing="4">
                    <TextBlock     Grid.Column="0" Classes="label" Text="L1:" Grid.Row="0"/>
                    <NumericUpDown Grid.Column="1" Minimum="-10" Maximum="10" Increment="0.05"
                                   FormatString="0.000" Value="{Binding Light1}" Grid.Row="0" MinWidth="120"/>
                    <TextBlock     Grid.Column="2" Classes="label" Text="L2:" Margin="10,0,4,0" Grid.Row="0" />
                    <NumericUpDown Grid.Column="3" Minimum="-10" Maximum="10" Increment="0.05"
                                   FormatString="0.000" Value="{Binding Light2}"  Grid.Row="0" MinWidth="120"/>
                    <TextBlock     Grid.Column="4" Classes="label" Text="L3:" Margin="10,0,4,0" Grid.Row="0" />
                    <NumericUpDown Grid.Column="5" Minimum="-10" Maximum="10" Increment="0.05"
                                   FormatString="0.000" Value="{Binding Light3}"  Grid.Row="0" MinWidth="120"/>
                    <TextBlock     Grid.Column="0" Classes="label" Text="AO:" Margin="10,0,4,0" Grid.Row="1" />
                    <NumericUpDown Grid.Column="1" Minimum="0" Maximum="16" Increment="1"
                                   FormatString="0" Value="{Binding AOSamples}" Grid.Row="1" MinWidth="120"/>
                    <TextBlock     Grid.Column="2" Classes="label" Text="Fog:" Margin="10,0,4,0" Grid.Row="1"/>
                    <NumericUpDown Grid.Column="3" Minimum="0" Maximum="5" Increment="0.05"
                                   FormatString="0.000" Value="{Binding FogDensity}" Grid.Row="1" MinWidth="120"/>
                </Grid>

                <!-- View -->
                <TextBlock Grid.Row="4" Classes="header" Text="View (FOV / clip / SS)" />
                <Grid Grid.Row="5" ColumnDefinitions="50,Auto,Auto,Auto,80">
                    <TextBlock     Grid.Column="0" Classes="label" Text="FOV°:" />
                    <NumericUpDown Grid.Column="1" Minimum="5" Maximum="170" Increment="1"
                                   FormatString="0.0" Value="{Binding FovDegrees}" MinWidth="120"/>
                    <CheckBox      Grid.Column="2" Content="Clip+Y" Margin="14,0,0,0" IsChecked="{Binding ClipPlane}" />
                    <TextBlock     Grid.Column="3" Classes="label" Text="SS:" Margin="14,0,4,0" />
                    <ComboBox      Grid.Column="4" SelectedIndex="{Binding SSIndex}">
                        <ComboBoxItem Content="1x" />
                        <ComboBoxItem Content="2x" />
                        <ComboBoxItem Content="4x" />
                    </ComboBox>
                </Grid>

                <!-- Chain -->
                <Grid Grid.Row="6" ColumnDefinitions="Auto" Margin="0,8,0,0" RowDefinitions="Auto,Auto" RowSpacing="4">
                    <TextBlock Grid.Column="0" Classes="header" Text="Chain (when non-empty, overrides single source)"
                               Margin="0,0,0,0" Grid.Row="0"/>
                    <!-- Export -->
                    <Grid ColumnDefinitions="110,Auto,Auto,Auto,Auto" Grid.Row="1" Grid.Column="0">
                        <Button    Grid.Column="1" Grid.Row="1" Classes="tool" Content="+ Step"
                                   Command="{Binding AddChainCommand}" Margin="6,0,0,0" />
                        <Button    Grid.Column="2" Grid.Row="1" Classes="tool" Content="+ Primitive ▾" Margin="6,0,0,0"
                                   ToolTip.Tip="Append a fold/power primitive to the chain">
                            <Button.Flyout>
                                <MenuFlyout ItemsSource="{Binding ChainPrimitives}">
                                    <MenuFlyout.ItemTemplate>
                                        <DataTemplate DataType="m:UserBulbChainPrimitive">
                                            <MenuItem Header="{Binding DisplayName}"
                                                      Command="{Binding $parent[Window].((vm:UserBulbViewModel)DataContext).InsertPrimitiveCommand}"
                                                      CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </MenuFlyout.ItemTemplate>
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                        <Button Grid.Column="3" Grid.Row="1"  Classes="tool" Content="Hybrid ▾" Margin="6,0,0,0"
                                ToolTip.Tip="Replace chain with a worked-example hybrid">
                            <Button.Flyout>
                                <MenuFlyout>
                                    <MenuItem Header="Mandelbox + Mandelbulb"
                                              Command="{Binding LoadHybridCommand}"
                                              CommandParameter="mbox+bulb" />
                                    <MenuItem Header="Menger + Mandelbulb"
                                              Command="{Binding LoadHybridCommand}"
                                              CommandParameter="menger+bulb" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                        <StackPanel Grid.Column="4" Grid.Row="1" Orientation="Horizontal" Margin="6,0,0,0"
                                    VerticalAlignment="Center" Spacing="6">
                            <Button Classes="tool"
                                    Content="Export mesh (OBJ)…"
                                    Command="{Binding ExportMeshCommand}"
                                    HorizontalAlignment="Left" />
                            <TextBlock Text="Grid" VerticalAlignment="Center"
                                       ToolTip.Tip="Marching-cubes resolution per axis. Higher = finer mesh (cost ~N³). 96 = native-exporter parity." />
                            <NumericUpDown Width="86" Minimum="16" Maximum="512" Increment="16" FormatString="F0"
                                           Value="{Binding ExportGridN, Mode=TwoWay}" />
                            <TextBlock Text="Range" VerticalAlignment="Center"
                                       ToolTip.Tip="Object-space half-extent of the sampled cube. Must enclose the fractal; too small clips it." />
                            <NumericUpDown Width="86" Minimum="0.25" Maximum="64" Increment="0.25" FormatString="F2"
                                           Value="{Binding ExportRange, Mode=TwoWay}" />
                            <Button Classes="tool" Content="Auto"
                                    Command="{Binding AutoRangeCommand}"
                                    ToolTip.Tip="Probe the fractal's extent (using the export Iterations + JacobianH) and set Range to just enclose it — avoids clipping and wasted resolution." />
                            <TextBlock Text="Iso" VerticalAlignment="Center"
                                       ToolTip.Tip="Surface level. As a cell fraction (abs off) 0.5 sits a half-cell OUTSIDE the true surface, so filaments inflate into fat tubes and gaps fuse into a ball; lower toward 0.1–0.25 to hug the surface and keep filament detail, raise to bridge gaps if the mesh shatters. With abs on it is an object-space distance (grid-independent)." />
                            <NumericUpDown Width="86" Minimum="0.005" Maximum="2" Increment="0.01" FormatString="F3"
                                           Value="{Binding ExportIsoScale, Mode=TwoWay}" />
                            <CheckBox Content="abs" VerticalAlignment="Center"
                                      IsChecked="{Binding ExportIsoAbsolute, Mode=TwoWay}"
                                      ToolTip.Tip="Treat Iso as an absolute object-space distance (grid-independent surface level) instead of a fraction of the cell size. Change the Grid without re-tuning Iso." />
                            <TextBlock Text="SS" VerticalAlignment="Center"
                                       ToolTip.Tip="Supersampling: box-average an s×s×s DE stencil per grid corner (1 = off). Antialiases thin sub-cell filaments into continuous surface instead of broken tubes/dots. Cost ~s³× — keep it 2–3 on fine grids." />
                            <NumericUpDown Width="66" Minimum="1" Maximum="4" Increment="1" FormatString="F0"
                                           Value="{Binding ExportSuperSamples, Mode=TwoWay}" />
                            <TextBlock Text="Crease°" VerticalAlignment="Center"
                                       ToolTip.Tip="Crease angle. Faces differing by more than this keep a hard edge (Mandelbox facets stay crisp) while curved bulb arms still smooth. 180 = smooth everything (default); ~30 preserves facets." />
                            <NumericUpDown Width="76" Minimum="5" Maximum="180" Increment="5" FormatString="F0"
                                           Value="{Binding ExportCreaseDegrees, Mode=TwoWay}" />
                            <TextBlock Text="(uses Iterations + JacobianH above)" VerticalAlignment="Center"
                                       Opacity="0.7" FontStyle="Italic"
                                       ToolTip.Tip="Mesh DE quality reuses the panel's Iterations + JacobianH. For crisp export geometry raise Iterations (native quaternion types use 11–14; the render default 8 is blobby) and/or lower JacobianH toward 1e-5." />
                        </StackPanel>
                    </Grid>
                </Grid>
            <Border Grid.Row="7" BorderBrush="#5A5A5A" BorderThickness="1" Background="#232323" >
                <ScrollViewer VerticalScrollBarVisibility="Auto"> 
                    <ItemsControl ItemsSource="{Binding Chain}" >
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="m:UserBulbChainStep">
                                    <Grid ColumnDefinitions="70,*,Auto" Margin="2">
                                        <TextBox Grid.Column="0" Text="{Binding OutputName, Mode=TwoWay}" />
                                        <TextBox Grid.Column="1" Classes="code"
                                                 Text="{Binding Source, Mode=TwoWay}" Margin="4,0,4,0" />
                                        <Button  Grid.Column="2" Content="X" Background="#5A3232" Foreground="White"
                                                 Command="{Binding $parent[ItemsControl].((vm:UserBulbViewModel)DataContext).RemoveChainCommand}"
                                                 CommandParameter="{Binding}" />
                                    </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer> 
            </Border>
        </Grid>
    </Grid>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FracturingFog.UI.Avalonia.ViewModels"
        x:Class="FracturingFog.UI.Avalonia.Views.ControlCenterView"
        x:DataType="vm:ControlCenterViewModel"
        Foreground="#DCDCDC">

    <!-- Phase S1 shell. SplitView nav-rail (6 groups) + sectioned content, all
         bound through Menu (FloatingMenuViewModel) / Shell (ShellViewModel).
         Chrome lives on the PanelHostWindow host. -->

    <UserControl.Styles>
        <Style Selector="ListBox.navRail">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="ListBox.navRail ListBoxItem">
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#B4B4B4" />
        </Style>
        <Style Selector="ListBox.navRail ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="#282828" />
        </Style>
        <Style Selector="ListBox.navRail ListBoxItem:selected">
            <Setter Property="Foreground" Value="#C8C864" />
        </Style>
        <Style Selector="TextBlock.navGlyph">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Width" Value="22" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Styles>

    <SplitView IsPaneOpen="True" DisplayMode="Inline" OpenPaneLength="180"
               PaneBackground="#161616">

        <!-- ── Nav rail ────────────────────────────────────────────────── -->
        <SplitView.Pane>
            <DockPanel LastChildFill="True">

                <TextBlock DockPanel.Dock="Top"
                           Text="Control Center"
                           Foreground="#C8C864" FontWeight="Bold" FontSize="14"
                           Margin="14,12,14,10" />

                <!-- Beginner / Power toggle (the guiding hand) -->
                <Border DockPanel.Dock="Bottom" Margin="10,8,10,12">
                    <StackPanel Spacing="4">
                        <Button Classes="action neutral"
                                Content="{Binding ModeButtonLabel}"
                                Command="{Binding ToggleModeCommand}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                ToolTip.Tip="Beginner mode hides advanced groups + diagnostics; Power mode shows everything." />
                        <TextBlock Text="{Binding ModeHint}"
                                   Foreground="#7E7E7E" FontSize="10"
                                   TextWrapping="Wrap" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

                <ListBox Classes="navRail"
                         ItemsSource="{Binding Nav}"
                         SelectedValueBinding="{Binding Section}"
                         SelectedValue="{Binding SelectedSection, Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:ControlCenterNavItem">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Classes="navGlyph" Text="{Binding Glyph}" />
                                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </SplitView.Pane>

        <!-- ── Content ─────────────────────────────────────────────────── -->
        <ScrollViewer Padding="14,12" VerticalScrollBarVisibility="Auto">
            <Panel>

                <!-- ═══ View ═══ -->
                <StackPanel Spacing="0" IsVisible="{Binding IsViewSection}">
                    <Border Classes="group">
                        <StackPanel Spacing="6">
                            <TextBlock Classes="section" Text="View" />
                            <UniformGrid Columns="5" Margin="0,4,0,0">
                                <Button Classes="action neutral" Content="Reset"  Command="{Binding Menu.ResetCommand}"      ToolTip.Tip="Reset view to default center and zoom" Margin="0,0,4,4" />
                                <Button Classes="action neutral" Content="{Binding Menu.SpanButtonText}" Command="{Binding Menu.SpanCommand}" ToolTip.Tip="Span across all monitors" Margin="0,0,4,4" />
                                <Button Classes="action neutral" Content="Wall"   Command="{Binding Menu.WallpaperCommand}"  ToolTip.Tip="Render a wallpaper-sized image at the virtual-screen union of every monitor" Margin="0,0,4,4" />
                                <Button Classes="action neutral" Content="Image"  Command="{Binding Menu.ScreenshotCommand}" ToolTip.Tip="High-resolution screenshot" Margin="0,0,4,4" />
                                <Button Classes="action neutral" Content="Poster" Command="{Binding Menu.PosterCommand}"     ToolTip.Tip="Print-ready poster image" Margin="0,0,0,4" />
                            </UniformGrid>
                            <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,4,0,0">
                                <CheckBox Content="Status" IsChecked="{Binding Menu.ShowStatusBar}" Foreground="#9B9B9B" FontWeight="Bold" />
                                <CheckBox Content="Grid"   IsChecked="{Binding Menu.ShowGrid}"      Foreground="#9B9B9B" FontWeight="Bold" ToolTip.Tip="Overlay complex-plane grid" />
                                <ComboBox ItemsSource="{Binding Menu.ResolutionNames}"
                                          SelectedItem="{Binding Menu.SelectedResolution}"
                                          Width="160" ToolTip.Tip="Set window dimensions" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Classes="group">
                        <StackPanel Spacing="6">
                            <TextBlock Classes="section" Text="Display" />
                            <UniformGrid Columns="2">
                                <Button Classes="action neutral" Content="Mini Map"   Command="{Binding Shell.ToggleMiniMapCommand}"   Margin="0,0,4,4" ToolTip.Tip="Toggle the mini map overlay window" />
                                <Button Classes="action neutral" Content="Mini Depth" Command="{Binding Shell.ToggleMiniDepthCommand}" Margin="0,0,0,4" ToolTip.Tip="Toggle the mini depth histogram window" />
                                <Button Classes="action neutral" Content="Mini Mode"  Command="{Binding Shell.ToggleMiniModeCommand}"  Margin="0,0,4,0" ToolTip.Tip="Shrink to a compact drag-handle window" />
                                <Button Classes="action neutral" Content="Toy Mode"   Command="{Binding Shell.ToggleToyModeCommand}"   ToolTip.Tip="Hide toolbar + status for a clean canvas" />
                            </UniformGrid>
                            <CheckBox Content="Keep render window on top"
                                      IsChecked="{Binding Shell.IsRenderTopmost, Mode=TwoWay}"
                                      Foreground="#9B9B9B" FontWeight="Bold" Margin="0,4,0,0"
                                      ToolTip.Tip="Always-on-top for the render window" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ═══ Explore ═══ -->
                <StackPanel Spacing="0" IsVisible="{Binding IsExploreSection}">
                    <Border Classes="group">
                        <StackPanel Spacing="6">
                            <TextBlock Classes="section" Text="Region Navigation" />
                            <ComboBox ItemsSource="{Binding Menu.RegionNames}"
                                      SelectedItem="{Binding Menu.SelectedRegion}"
                                      HorizontalAlignment="Stretch" Margin="0,4,0,0" />
                            <UniformGrid Columns="4">
                                <Button Classes="action neutral" Content="Save"   Command="{Binding Menu.SaveViewCommand}"      ToolTip.Tip="Save current view as a region" Margin="0,0,4,0" />
                                <Button Classes="action danger"  Content="Delete" Command="{Binding Menu.DeleteRegionCommand}"  ToolTip.Tip="Delete selected region" Margin="0,0,4,0" />
                                <Button Classes="action neutral" Content="Exp…"   Command="{Binding Menu.ExportRegionsCommand}" ToolTip.Tip="Export regions to JSON" Margin="0,0,4,0" />
                                <Button Classes="action neutral" Content="Imp…"   Command="{Binding Menu.ImportRegionsCommand}" ToolTip.Tip="Import regions from JSON" />
                            </UniformGrid>

                            <Grid ColumnDefinitions="80,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" Margin="0,8,0,0">
                                <TextBlock Classes="label" Grid.Row="0" Grid.Column="0" Text="CX:" Margin="0,0,8,4" />
                                <TextBox   Classes="coord" Grid.Row="0" Grid.Column="1" Text="{Binding Menu.CX, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4" />
                                <TextBlock Classes="label" Grid.Row="1" Grid.Column="0" Text="CY:" Margin="0,0,8,4" />
                                <TextBox   Classes="coord" Grid.Row="1" Grid.Column="1" Text="{Binding Menu.CY, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4" />
                                <TextBlock Classes="label" Grid.Row="2" Grid.Column="0" Text="Quality:" Margin="0,0,8,4" />
                                <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding Menu.QualityNames}" SelectedItem="{Binding Menu.SelectedQuality}" HorizontalAlignment="Stretch" Margin="0,0,0,4" />
                                <TextBlock Classes="label" Grid.Row="3" Grid.Column="0" Text="Zoom:" Margin="0,0,8,4" />
                                <TextBox   Classes="coord" Grid.Row="3" Grid.Column="1" Text="{Binding Menu.Zoom, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4" />
                                <TextBlock Classes="label" Grid.Row="4" Grid.Column="0" Text="Iterations:" Margin="0,0,8,0" />
                                <TextBox   Classes="coord" Grid.Row="4" Grid.Column="1" Text="{Binding Menu.Iter, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                            <CheckBox Content="Lock Iterations" IsChecked="{Binding Menu.IterLocked}" Foreground="#C8C878" FontWeight="Bold" Margin="80,4,0,0" ToolTip.Tip="Lock iteration count — pan/zoom won't recalc" />
                            <UniformGrid Columns="3" Margin="80,6,0,0">
                                <Button Classes="action go" Content="Go"     Command="{Binding Menu.GoCommand}"         Margin="0,0,4,0" />
                                <Button Classes="action go" Content="Flip Y" Command="{Binding Menu.FlipCommand}"       Margin="0,0,4,0" />
                                <Button Classes="action go" Content="Copy"   Command="{Binding Menu.CopyCoordsCommand}" ToolTip.Tip="Copy CX/CY/Zoom/Iter to clipboard" />
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <Border Classes="group">
                        <StackPanel Spacing="6">
                            <TextBlock Classes="section" Text="Parameters" />
                            <Button Classes="action help" Content="Fractal Params…" Command="{Binding Shell.ShowFractalParamsCommand}" HorizontalAlignment="Stretch" ToolTip.Tip="Open the per-fractal parameter editor" />
                        </StackPanel>
                    </Border>

                    <!-- Deep-zoom diagnostics — power mode only -->
                    <Border Classes="group" IsVisible="{Binding IsPowerMode}">
                        <StackPanel Spacing="6">
                            <TextBlock Classes="section" Text="Deep-Zoom Diagnostics" />
                            <StackPanel Orientation="Horizontal" Spacing="14">
                                <CheckBox Content="Bypass BLA+SA" IsChecked="{Binding Menu.BypassAcceleration}"       Foreground="#FFCC00" FontWeight="Bold" ToolTip.Tip="Ctrl+Shift+A" />
                                <CheckBox Content="Bypass SA"     IsChecked="{Binding Menu.BypassSeriesApproximation}" Foreground="#FFCC00" FontWeight="Bold" ToolTip.Tip="Ctrl+Shift+S" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="14">
                                <CheckBox Content="Bypass DD-BLA"   IsChecked="{Binding Menu.BypassDdBla}"    Foreground="#FFCC00" FontWeight="Bold" ToolTip.Tip="Ctrl+Shift+D" />
                                <CheckBox Content="Bypass Rebasing" IsChecked="{Binding Menu.BypassRebasing}" Foreground="#FFCC00" FontWeight="Bold" ToolTip.Tip="SM-2: rebasing default ON; check to A/B against legacy per-pixel QD/OD" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ═══ Color & Light ═══ -->
                <StackPanel Spacing="0" IsVisible="{Binding IsColorLightSection}">
                    <Border Classes="group">
                        <StackPanel Spacing="6">
                            <TextBlock Classes="section" Text="Color Themes" />
                            <ComboBox ItemsSource="{Binding Menu.ThemeNames}" SelectedItem="{Binding Menu.SelectedTheme}" HorizontalAlignment="Stretch" Margin="0,4,0,0" />
                            <UniformGrid Columns="4">
                                <Button Classes="action neutral" Content="Exp…"   Command="{Binding Menu.ExportThemeCommand}"  ToolTip.Tip="Export current theme to JSON" Margin="0,0,4,0" />
                                <Button Classes="action neutral" Content="Imp…"   Command="{Binding Menu.ImportThemeCommand}"  ToolTip.Tip="Import themes from JSON" Margin="0,0,4,0" />
                                <Button Classes="action danger"  Content="Delete" Command="{Binding Menu.DeleteThemeCommand}"  ToolTip.Tip="Delete selected user theme" Margin="0,0,4,0" />
                                <Button Classes="action neutral" Content="Reload" Command="{Binding Menu.ReloadThemesCommand}" ToolTip.Tip="Reload themes from disk" />
                            </UniformGrid>
                            <Button Classes="action help" Content="Edit Theme…" Command="{Binding Menu.EditThemeCommand}" HorizontalAlignment="Stretch" Margin="0,4,0,0" ToolTip.Tip="Open the Color Theme Editor" />
                            <Button Classes="action neutral" Content="Save Lighting → Theme" Command="{Binding Menu.SaveLightingToThemeCommand}" HorizontalAlignment="Stretch" Margin="0,4,0,0" ToolTip.Tip="Snapshot the active Lighting &amp; FX block as the selected user theme's bundled preset" />
                        </StackPanel>
                    </Border>

                    <Border Classes="group">
                        <StackPanel Spacing="6">
                            <TextBlock Classes="section" Text="Lighting &amp; FX" />
                            <Button Classes="action help" Content="Volumetric Lighting &amp; FX…" Command="{Binding Shell.ShowFractalParamsCommand}" HorizontalAlignment="Stretch"
                                    ToolTip.Tip="Opens Fractal Params, which hosts the Lighting &amp; FX panel (lights, ambient occlusion, fog, tonemap, HDRI/IBL). Standalone surfacing lands in S2." />
                        </StackPanel>
                    </Border>

                    <Border Classes="group">
                        <StackPanel Spacing="4">
                            <TextBlock Classes="section" Text="Post-FX" />
                            <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" Margin="0,4,0,0">
                                <TextBlock Grid.Row="0" Grid.Column="0" Classes="fxLabel" Text="{Binding Menu.BrightnessLabel}" Margin="0,0,6,4" />
                                <Slider    Grid.Row="0" Grid.Column="1" Value="{Binding Menu.Brightness}" Minimum="-100" Maximum="100" TickFrequency="25" Margin="0,0,6,4" ToolTip.Tip="Brightness (-100..100)" />
                                <CheckBox  Grid.Row="0" Grid.Column="2" IsChecked="{Binding Menu.BrightnessLocked}" ToolTip.Tip="Lock brightness" Margin="0,0,0,4" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Classes="fxLabel" Text="{Binding Menu.ContrastLabel}" Margin="0,0,6,4" />
                                <Slider    Grid.Row="1" Grid.Column="1" Value="{Binding Menu.Contrast}" Minimum="-100" Maximum="100" TickFrequency="25" Margin="0,0,6,4" ToolTip.Tip="Contrast (-100..100)" />
                                <CheckBox  Grid.Row="1" Grid.Column="2" IsChecked="{Binding Menu.ContrastLocked}" ToolTip.Tip="Lock contrast" Margin="0,0,0,4" />
                                <TextBlock Grid.Row="2" Grid.Column="0" Classes="fxLabel" Text="{Binding Menu.AdaptiveLabel}" Margin="0,0,6,0" IsEnabled="{Binding Menu.AdaptiveEnabled}" />
                                <Slider    Grid.Row="2" Grid.Column="1" Value="{Binding Menu.Adaptive}" Minimum="0" Maximum="100" TickFrequency="25" Margin="0,0,6,0" IsEnabled="{Binding Menu.AdaptiveEnabled}" ToolTip.Tip="Adaptive contrast (0=off, 100=full)" />
                                <CheckBox  Grid.Row="2" Grid.Column="2" IsChecked="{Binding Menu.AdaptiveLocked}" IsEnabled="{Binding Menu.AdaptiveEnabled}" ToolTip.Tip="Lock adaptive" />
                                <TextBlock Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Classes="fxLabel" Text="Lock Lighting &amp; FX" Margin="0,4,6,0" />
                                <CheckBox  Grid.Row="3" Grid.Column="2" IsChecked="{Binding Menu.LightingLocked}" ToolTip.Tip="Lock lighting — ignore theme presets" Margin="0,4,0,0" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ═══ Capture ═══ -->
                <StackPanel Spacing="0" IsVisible="{Binding IsCaptureSection}">
                    <Border Classes="group">
                        <StackPanel Spacing="6">
                            <TextBlock Classes="section" Text="Stills &amp; Video" />
                            <UniformGrid Columns="3">
                                <Button Classes="action neutral"   Content="Image"  Command="{Binding Menu.ScreenshotCommand}" ToolTip.Tip="High-resolution screenshot" Margin="0,0,4,0" />
                                <Button Classes="action neutral"   Content="Poster" Command="{Binding Menu.PosterCommand}"     ToolTip.Tip="Print-ready poster image" Margin="0,0,4,0" />
                                <Button Classes="action video"     Content="{Binding Menu.VideoButtonText}" Command="{Binding Menu.VideoCommand}" ToolTip.Tip="Animated zoom" />
                            </UniformGrid>
                            <UniformGrid Columns="2" Margin="0,4,0,0">
                                <Button Classes="action slideshow" Content="{Binding Menu.SlideshowButtonText}" Command="{Binding Menu.SlideshowCommand}" ToolTip.Tip="Start/stop slideshow" Margin="0,0,4,0" />
                                <Button Classes="action slideshow" Content="Slideshow Settings…" Command="{Binding Menu.SlideshowSettingsCommand}" ToolTip.Tip="Configure slideshow timing + audio-reactive options" />
                            </UniformGrid>
                            <UniformGrid Columns="2" Margin="0,4,0,0">
                                <Button Classes="action slideshow" Content="Lock Region" Command="{Binding Shell.ToggleSlideshowLockRegionCommand}" IsEnabled="{Binding Shell.IsSlideshowRunning}" Margin="0,0,4,0" ToolTip.Tip="Pin the running slideshow to the current region (only while a slideshow is running)" />
                                <Button Classes="action slideshow" Content="More Colors" Command="{Binding Shell.ToggleSlideshowFocusCommand}"      IsEnabled="{Binding Shell.IsSlideshowRunning}" ToolTip.Tip="Toggle 3 vs 8 themes per region while the slideshow runs" />
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <Border Classes="group">
                        <StackPanel Spacing="6">
                            <TextBlock Classes="section" Text="Watermark" />
                            <CheckBox Content="Show watermark" IsChecked="{Binding Menu.ShowWatermark, Mode=TwoWay}" ToolTip.Tip="Master toggle for the on-screen watermark overlay" />
                            <CheckBox Content="Use custom watermark" IsChecked="{Binding Menu.UseCustomWatermark, Mode=TwoWay}" ToolTip.Tip="Replace the default region/theme watermark with your saved custom one" />
                            <ComboBox ItemsSource="{Binding Menu.WatermarkNames}" SelectedItem="{Binding Menu.SelectedWatermark}" IsEnabled="{Binding Menu.UseCustomWatermark}" HorizontalAlignment="Stretch" />
                            <CheckBox Content="Override region watermark" IsChecked="{Binding Menu.OverrideRegionWatermark, Mode=TwoWay}" ToolTip.Tip="Force the active custom watermark even when the region carries its own" />
                            <Button Classes="action help" Content="Edit Watermark…" Command="{Binding Menu.EditWatermarkCommand}" HorizontalAlignment="Stretch" Margin="0,4,0,0" ToolTip.Tip="Open the Watermark Editor" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ═══ Assets ═══ -->
                <StackPanel Spacing="0" IsVisible="{Binding IsAssetsSection}">
                    <Border Classes="group">
                        <StackPanel Spacing="6">
                            <TextBlock Classes="section" Text="Libraries &amp; Editors" />
                            <Button Classes="action help" Content="Asset Manager…"   Command="{Binding Shell.ShowAssetManagerCommand}"   HorizontalAlignment="Stretch" ToolTip.Tip="Browse every saved asset type" />
                            <Button Classes="action help" Content="Region Editor…"   Command="{Binding Shell.ShowRegionEditorCommand}"   HorizontalAlignment="Stretch" ToolTip.Tip="Edit the selected region's metadata" />
                            <Button Classes="action help" Content="Edit Scene…"      Command="{Binding Menu.EditSceneCommand}"           HorizontalAlignment="Stretch" ToolTip.Tip="Open the Scene Editor" />
                            <Button Classes="action help" Content="Edit Animation…"  Command="{Binding Menu.EditAnimationCommand}"       HorizontalAlignment="Stretch" ToolTip.Tip="Open the Animation Editor" />
                            <Button Classes="action help" Content="ColorGen Editor…" Command="{Binding Shell.ShowColorGenEditorCommand}" HorizontalAlignment="Stretch" ToolTip.Tip="Open the ColorGen palette editor" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ═══ Advanced ═══ (power mode only — nav item hidden in beginner) -->
                <StackPanel Spacing="0" IsVisible="{Binding IsAdvancedSection}">
                    <Border Classes="group">
                        <StackPanel Spacing="6">
                            <TextBlock Classes="section" Text="Remote Rendering" />
                            <UniformGrid Columns="2">
                                <Button Classes="action neutral" Content="Server…" Command="{Binding Menu.ServerCommand}" HorizontalAlignment="Stretch" Margin="0,0,4,0" ToolTip.Tip="Local render server: status, metrics, start/restart/kill" />
                                <Button Classes="action neutral" Content="Client…" Command="{Binding Menu.ClientCommand}" HorizontalAlignment="Stretch" ToolTip.Tip="Connect to a remote FracturingFog server" />
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <Border Classes="group">
                        <StackPanel Spacing="6">
                            <TextBlock Classes="section" Text="System" />
                            <Button Classes="action slideshow" Content="App Settings…"     Command="{Binding Menu.AppSettingsCommand}"     HorizontalAlignment="Stretch" ToolTip.Tip="Application settings" />
                            <Button Classes="action video"     Content="FFmpeg…"           Command="{Binding Menu.FfmpegSetupCommand}"     HorizontalAlignment="Stretch" ToolTip.Tip="Install, update, or skip the FFmpeg video encoder" />
                            <Button Classes="action neutral"   Content="AppData Location…" Command="{Binding Menu.AppDataLocationCommand}" HorizontalAlignment="Stretch" ToolTip.Tip="Choose where FracturingFog stores its data" />
                            <Button Classes="action help"      Content="Help…"             Command="{Binding Menu.HelpCommand}"            HorizontalAlignment="Stretch" ToolTip.Tip="Open help" />
                            <Button Classes="action danger"    Content="Close Program"     Command="{Binding Menu.CloseProgramCommand}"    HorizontalAlignment="Stretch" Margin="0,8,0,0" ToolTip.Tip="Exit Fracturing Fog" />
                        </StackPanel>
                    </Border>
                </StackPanel>

            </Panel>
        </ScrollViewer>
    </SplitView>
</UserControl>

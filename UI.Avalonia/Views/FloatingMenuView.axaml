<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FracturingFog.UI.Avalonia.ViewModels"
        x:Class="FracturingFog.UI.Avalonia.Views.FloatingMenuView"
        x:DataType="vm:FloatingMenuViewModel"
        Title="Main Menu"
        Width="380"
        Height="780"
        MinWidth="320"
        MinHeight="520"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Background="#161616"
        Foreground="#DCDCDC">

    <Window.Styles>
        <Style Selector="TextBlock.section">
            <Setter Property="Foreground" Value="#C8C864" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="Foreground" Value="#9B9B9B" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
        <Style Selector="TextBlock.fxLabel">
            <Setter Property="Foreground" Value="#B4B4B4" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Width" Value="84" />
        </Style>
        <Style Selector="Border.group">
            <Setter Property="BorderBrush" Value="#3A3A3A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style Selector="Button.action">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="0,0,4,0" />
        </Style>
        <Style Selector="Button.neutral">  <Setter Property="Background" Value="#2D2D32" /> </Style>
        <Style Selector="Button.go">       <Setter Property="Background" Value="#285028" /> </Style>
        <Style Selector="Button.danger">   <Setter Property="Background" Value="#502323" /> </Style>
        <Style Selector="Button.slideshow"><Setter Property="Background" Value="#283728" /> </Style>
        <Style Selector="Button.video">    <Setter Property="Background" Value="#372846" /> </Style>
        <Style Selector="Button.help">     <Setter Property="Background" Value="#283C64" /> </Style>
        <Style Selector="TextBox.coord">
            <Setter Property="Background" Value="#282828" />
            <Setter Property="Foreground" Value="#DCDCDC" />
            <Setter Property="FontFamily" Value="Consolas, monospace" />
            <Setter Property="TextAlignment" Value="Right" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*">

        <!-- Title bar — window chrome already provides the close button. -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="10,8,10,4">
            <TextBlock Grid.Column="0"
                       Text="Main Menu"
                       Foreground="#C8C864"
                       FontSize="14"
                       FontWeight="Bold"
                       VerticalAlignment="Center" />
            <Button Grid.Column="1"
                    Classes="action help"
                    Content="?"
                    Command="{Binding HelpCommand}"
                    Width="30"
                    ToolTip.Tip="Open help menu" />
        </Grid>

        <!-- Main body -->
        <ScrollViewer Grid.Row="1" Padding="10,4,10,10" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="0">

                <!-- Top action row 1: Reset / Span / Image / Poster -->
                <Border Classes="group">
                    <StackPanel Spacing="6">
                        <TextBlock Classes="section" Text="View" />
                        <UniformGrid Columns="4" Margin="0,4,0,0">
                            <Button Classes="action neutral" Content="Reset"  Command="{Binding ResetCommand}"      ToolTip.Tip="Reset view to default center and zoom" Margin="0,0,4,4" />
                            <Button Classes="action neutral" Content="{Binding SpanButtonText}" Command="{Binding SpanCommand}" ToolTip.Tip="Span across all monitors" Margin="0,0,4,4" />
                            <Button Classes="action neutral" Content="Image"  Command="{Binding ScreenshotCommand}" ToolTip.Tip="High-resolution screenshot" Margin="0,0,4,4" />
                            <Button Classes="action neutral" Content="Poster" Command="{Binding PosterCommand}"     ToolTip.Tip="Print-ready poster image" Margin="0,0,0,4" />
                        </UniformGrid>
                        <UniformGrid Columns="3">
                            <Button Classes="action slideshow" Content="Slideshow"     Command="{Binding SlideshowCommand}"     ToolTip.Tip="Start/stop slideshow" Margin="0,0,4,0" />
                            <Button Classes="action video"     Content="{Binding VideoButtonText}" Command="{Binding VideoCommand}" ToolTip.Tip="Animated zoom" Margin="0,0,4,0" />
                            <Button Classes="action danger"    Content="Close Program" Command="{Binding CloseProgramCommand}"  ToolTip.Tip="Exit Fracturing Fog" />
                        </UniformGrid>
                        <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,4,0,0">
                            <CheckBox Content="Status" IsChecked="{Binding ShowStatusBar}" Foreground="#9B9B9B" FontWeight="Bold" />
                            <CheckBox Content="Grid"   IsChecked="{Binding ShowGrid}"      Foreground="#9B9B9B" FontWeight="Bold"
                                      ToolTip.Tip="Overlay complex-plane grid" />
                            <ComboBox ItemsSource="{Binding ResolutionNames}"
                                      SelectedItem="{Binding SelectedResolution}"
                                      Width="160"
                                      ToolTip.Tip="Set window dimensions" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Region Navigation -->
                <Border Classes="group">
                    <StackPanel Spacing="6">
                        <TextBlock Classes="section" Text="Region Navigation" />
                        <ComboBox x:Name="RegionCombo"
                                  ItemsSource="{Binding RegionNames}"
                                  SelectedItem="{Binding SelectedRegion}"
                                  HorizontalAlignment="Stretch"
                                  Margin="0,4,0,0" />
                        <UniformGrid Columns="4">
                            <Button Classes="action neutral" Content="Save"   Command="{Binding SaveViewCommand}"      ToolTip.Tip="Save current view as a region" Margin="0,0,4,0" />
                            <Button Classes="action danger"  Content="Delete" Command="{Binding DeleteRegionCommand}"  ToolTip.Tip="Delete selected region" Margin="0,0,4,0" />
                            <Button Classes="action neutral" Content="Exp…"   Command="{Binding ExportRegionsCommand}" ToolTip.Tip="Export regions to JSON" Margin="0,0,4,0" />
                            <Button Classes="action neutral" Content="Imp…"   Command="{Binding ImportRegionsCommand}" ToolTip.Tip="Import regions from JSON" />
                        </UniformGrid>

                        <Grid ColumnDefinitions="80,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" Margin="0,8,0,0">
                            <TextBlock Classes="label" Grid.Row="0" Grid.Column="0" Text="CX:" Margin="0,0,8,4" />
                            <TextBox   Name="CoordCX"   Classes="coord" Grid.Row="0" Grid.Column="1" Text="{Binding CX, UpdateSourceTrigger=PropertyChanged}"   Margin="0,0,0,4" />

                            <TextBlock Classes="label" Grid.Row="1" Grid.Column="0" Text="CY:" Margin="0,0,8,4" />
                            <TextBox   Name="CoordCY"   Classes="coord" Grid.Row="1" Grid.Column="1" Text="{Binding CY, UpdateSourceTrigger=PropertyChanged}"   Margin="0,0,0,4" />

                            <TextBlock Classes="label" Grid.Row="2" Grid.Column="0" Text="Quality:" Margin="0,0,8,4" />
                            <ComboBox Grid.Row="2" Grid.Column="1"
                                      ItemsSource="{Binding QualityNames}"
                                      SelectedItem="{Binding SelectedQuality}"
                                      HorizontalAlignment="Stretch"
                                      Margin="0,0,0,4" />

                            <TextBlock Classes="label" Grid.Row="3" Grid.Column="0" Text="Zoom:" Margin="0,0,8,4" />
                            <TextBox   Name="CoordZoom" Classes="coord" Grid.Row="3" Grid.Column="1" Text="{Binding Zoom, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4" />

                            <TextBlock Classes="label" Grid.Row="4" Grid.Column="0" Text="Iterations:" Margin="0,0,8,0" />
                            <TextBox   Name="CoordIter" Classes="coord" Grid.Row="4" Grid.Column="1" Text="{Binding Iter, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>

                        <CheckBox Content="Lock Iterations"
                                  IsChecked="{Binding IterLocked}"
                                  Foreground="#C8C878"
                                  FontWeight="Bold"
                                  Margin="80,4,0,0"
                                  ToolTip.Tip="Lock iteration count — pan/zoom won't recalc" />

                        <UniformGrid Columns="3" Margin="80,6,0,0">
                            <Button Classes="action go" Content="Go"     Command="{Binding GoCommand}"         Margin="0,0,4,0" />
                            <Button Classes="action go" Content="Flip Y" Command="{Binding FlipCommand}"       Margin="0,0,4,0" />
                            <Button Classes="action go" Content="Copy"   Command="{Binding CopyCoordsCommand}" ToolTip.Tip="Copy CX/CY/Zoom/Iter to clipboard" />
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- Color Themes -->
                <Border Classes="group">
                    <StackPanel Spacing="6">
                        <TextBlock Classes="section" Text="Color Themes" />
                        <ComboBox x:Name="ThemeCombo"
                                  ItemsSource="{Binding ThemeNames}"
                                  SelectedItem="{Binding SelectedTheme}"
                                  HorizontalAlignment="Stretch"
                                  Margin="0,4,0,0" />
                        <UniformGrid Columns="4">
                            <Button Classes="action neutral" Content="Exp…"    Command="{Binding ExportThemeCommand}"  ToolTip.Tip="Export current theme to JSON" Margin="0,0,4,0" />
                            <Button Classes="action neutral" Content="Imp…"    Command="{Binding ImportThemeCommand}"  ToolTip.Tip="Import themes from JSON" Margin="0,0,4,0" />
                            <Button Classes="action danger"  Content="Delete"  Command="{Binding DeleteThemeCommand}"  ToolTip.Tip="Delete selected user theme" Margin="0,0,4,0" />
                            <Button Classes="action neutral" Content="Reload"  Command="{Binding ReloadThemesCommand}" ToolTip.Tip="Reload themes from disk" />
                        </UniformGrid>
                        <Button Classes="action help"
                                Content="Edit Theme…"
                                Command="{Binding EditThemeCommand}"
                                HorizontalAlignment="Stretch"
                                Margin="0,4,0,0"
                                ToolTip.Tip="Open the Color Theme Editor" />
                    </StackPanel>
                </Border>

                <!-- Post-FX -->
                <Border Classes="group">
                    <StackPanel Spacing="4">
                        <TextBlock Classes="section" Text="Post-FX" />
                        <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto" Margin="0,4,0,0">
                            <TextBlock Grid.Row="0" Grid.Column="0" Classes="fxLabel" Text="{Binding BrightnessLabel}" Margin="0,0,6,4" />
                            <Slider    Grid.Row="0" Grid.Column="1" Value="{Binding Brightness}" Minimum="-100" Maximum="100" TickFrequency="25" Margin="0,0,6,4"
                                       ToolTip.Tip="Brightness (-100 to +100, default 0)" />
                            <CheckBox  Grid.Row="0" Grid.Column="2" IsChecked="{Binding BrightnessLocked}" ToolTip.Tip="Lock brightness — ignore theme defaults" Margin="0,0,0,4" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Classes="fxLabel" Text="{Binding ContrastLabel}" Margin="0,0,6,4" />
                            <Slider    Grid.Row="1" Grid.Column="1" Value="{Binding Contrast}" Minimum="-100" Maximum="100" TickFrequency="25" Margin="0,0,6,4"
                                       ToolTip.Tip="Contrast (-100 to +100, default 0)" />
                            <CheckBox  Grid.Row="1" Grid.Column="2" IsChecked="{Binding ContrastLocked}" ToolTip.Tip="Lock contrast — ignore theme defaults" Margin="0,0,0,4" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Classes="fxLabel" Text="{Binding AdaptiveLabel}" Margin="0,0,6,0" IsEnabled="{Binding AdaptiveEnabled}" />
                            <Slider    Grid.Row="2" Grid.Column="1" Value="{Binding Adaptive}" Minimum="0" Maximum="100" TickFrequency="25" Margin="0,0,6,0"
                                       IsEnabled="{Binding AdaptiveEnabled}"
                                       ToolTip.Tip="Adaptive contrast (histogram equalization, 0 = off, 100 = full)" />
                            <CheckBox  Grid.Row="2" Grid.Column="2" IsChecked="{Binding AdaptiveLocked}" IsEnabled="{Binding AdaptiveEnabled}" ToolTip.Tip="Lock adaptive — ignore theme defaults" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,6,0,0">
                            <Button Grid.Column="0"
                                    Classes="action neutral"
                                    Content="{Binding AdaptiveSweepButtonLabel}"
                                    Command="{Binding ToggleAdaptiveSweepCommand}"
                                    IsEnabled="{Binding AdaptiveEnabled}"
                                    HorizontalAlignment="Stretch"
                                    Margin="0,0,6,0"
                                    ToolTip.Tip="Sweep Adaptive 0 → 100 over the given duration with a sine ease" />
                            <NumericUpDown Grid.Column="1"
                                           Value="{Binding AdaptiveSweepDurationSeconds}"
                                           Minimum="0.25"
                                           Maximum="600"
                                           Increment="0.5"
                                           FormatString="0.##"
                                           Width="86"
                                           IsEnabled="{Binding AdaptiveEnabled}"
                                           ToolTip.Tip="Sweep duration in seconds (default 5)" />
                            <TextBlock Grid.Column="2"
                                       Classes="fxLabel"
                                       Text="s"
                                       VerticalAlignment="Center"
                                       Margin="4,0,0,0" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Watermark -->
                <Border Classes="group">
                    <StackPanel Spacing="6">
                        <TextBlock Classes="section" Text="Watermark" />
                        <CheckBox Content="Use custom watermark"
                                  IsChecked="{Binding UseCustomWatermark, Mode=TwoWay}"
                                  ToolTip.Tip="Replace the default region/theme watermark with your saved custom one" />
                        <ComboBox ItemsSource="{Binding WatermarkNames}"
                                  SelectedItem="{Binding SelectedWatermark}"
                                  IsEnabled="{Binding UseCustomWatermark}"
                                  HorizontalAlignment="Stretch" />
                        <CheckBox Content="Override region watermark"
                                  IsChecked="{Binding OverrideRegionWatermark, Mode=TwoWay}"
                                  ToolTip.Tip="Force the active custom watermark even when the region carries its own embedded watermark" />
                        <Button Classes="action help"
                                Content="Edit Watermark…"
                                Command="{Binding EditWatermarkCommand}"
                                HorizontalAlignment="Stretch"
                                Margin="0,4,0,0"
                                ToolTip.Tip="Open the Watermark Editor" />
                    </StackPanel>
                </Border>

                <!-- Slideshow Settings shortcut -->
                <Button Classes="action slideshow"
                        Content="Slideshow Settings…"
                        Command="{Binding SlideshowSettingsCommand}"
                        HorizontalAlignment="Stretch"
                        Margin="0,0,0,8"
                        ToolTip.Tip="Configure slideshow timing + audio-reactive options" />

                <!-- FFmpeg install / update launcher -->
                <Button Classes="action video"
                        Content="FFmpeg…"
                        Command="{Binding FfmpegSetupCommand}"
                        HorizontalAlignment="Stretch"
                        Margin="0,0,0,8"
                        ToolTip.Tip="Install, update, or skip the FFmpeg video encoder" />

                <!-- Server / Client (Phase 3 remote rendering) -->
                <UniformGrid Columns="2" Margin="0,0,0,8">
                    <Button Classes="action neutral"
                            Content="Server…"
                            Command="{Binding ServerCommand}"
                            HorizontalAlignment="Stretch"
                            Margin="0,0,4,0"
                            ToolTip.Tip="Local FracturingFog render server: status, metrics, start/restart/kill" />
                    <Button Classes="action neutral"
                            Content="Client…"
                            Command="{Binding ClientCommand}"
                            HorizontalAlignment="Stretch"
                            ToolTip.Tip="Connect to a remote FracturingFog server and render there" />
                </UniformGrid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>

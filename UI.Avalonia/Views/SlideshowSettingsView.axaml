<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FracturingFog.UI.Avalonia.ViewModels"
        x:Class="FracturingFog.UI.Avalonia.Views.SlideshowSettingsView"
        x:DataType="vm:SlideshowSettingsViewModel">

    <!--
      Window chrome (title/size/background) lives on the PanelHostWindow that
      hosts this UserControl (see AvaloniaDialogs.ShowSlideshowSettingsAsync).
      DIP-only layout. Auto rows expand to fit fonts at any DPI; no Left/Top/
      Width arithmetic anywhere in the file. The width is the only fixed
      dimension and even that uses MinWidth so a larger system font (e.g. a
      4K display at 200% scaling with a 12pt UI font) cannot crop labels.
    -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="780">
    <Grid Margin="14" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
          ColumnDefinitions="*,Auto">

        <!-- Row 0: Saved-config name combo + Type droplist (library mode only) -->
        <Grid Grid.Row="0" Grid.ColumnSpan="2"
              IsVisible="{Binding IsLibraryMode}"
              ColumnDefinitions="Auto,*,Auto,Auto"
              Margin="0,0,0,8">
            <TextBlock Grid.Column="0" Text="Name:" VerticalAlignment="Center" Margin="0,0,6,0" />
            <!-- Editable name: free-text input + dropdown of saved names.
                 Combo is read-only (no IsEditable on Avalonia 11 ComboBox);
                 typed names go through the adjacent TextBox so the
                 user can either type a new name or pick an existing one. -->
            <Grid Grid.Column="1" ColumnDefinitions="*,Auto">
                <TextBox Grid.Column="0"
                         Name="NameCombo"
                         Text="{Binding ActiveName, Mode=TwoWay}"
                         MinWidth="160"
                         Watermark="preset name" />
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding SavedConfigNames}"
                          SelectedItem="{Binding ActiveName, Mode=TwoWay}"
                          MinWidth="40"
                          Margin="4,0,0,0"
                          ToolTip.Tip="Pick an existing preset" />
            </Grid>
            <TextBlock Grid.Column="2" Text="Type:" VerticalAlignment="Center" Margin="10,0,6,0" />
            <ComboBox Grid.Column="3"
                      ItemsSource="{Binding AllSlideshowTypes}"
                      SelectedItem="{Binding Type, Mode=TwoWay}"
                      Width="100" />
        </Grid>

        <!-- Row 1: library buttons -->
        <StackPanel Grid.Row="1" Grid.ColumnSpan="2"
                    IsVisible="{Binding IsLibraryMode}"
                    Orientation="Horizontal"
                    Spacing="6"
                    Margin="0,0,0,10">
            <Button Content="Save"   Command="{Binding SaveCommand}"   Padding="10,4" />
            <Button Content="Delete" Command="{Binding DeleteCommand}" Padding="10,4" />
            <Button Content="Import" Command="{Binding ImportCommand}" Padding="10,4" />
            <Button Content="Export" Command="{Binding ExportCommand}" Padding="10,4" />
            <Button Content="Video Settings…"
                    Command="{Binding EditVideoSettingsCommand}"
                    IsVisible="{Binding IsVideo}"
                    Padding="10,4" />
            <TextBlock Text=" •"
                       Foreground="#E0B040"
                       FontWeight="Bold"
                       IsVisible="{Binding IsDirty}"
                       VerticalAlignment="Center" />
        </StackPanel>

        <!-- Row 2: Audio-Reactive toggle + Audio… button -->
        <DockPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,0,0,10" LastChildFill="False">
            <ToggleButton Content="Audio-Reactive Slideshow"
                          IsChecked="{Binding AudioReactive, Mode=TwoWay}"
                          FontWeight="Bold"
                          Padding="12,6"
                          DockPanel.Dock="Left" />
            <Button Content="Audio…"
                    Command="{Binding ShowAudioDialogCommand}"
                    Padding="10,6"
                    Margin="10,0,0,0"
                    DockPanel.Dock="Left" />
        </DockPanel>

        <!-- Row 3: Extreme regions toggle -->
        <CheckBox Grid.Row="3" Grid.ColumnSpan="2"
                  Content="Use Extreme Regions"
                  IsChecked="{Binding UseExtremeRegions, Mode=TwoWay}"
                  Foreground="#DCA0A0"
                  FontWeight="Bold"
                  Margin="0,0,0,8" />

        <!-- Row 4: Timing group header -->
        <TextBlock Grid.Row="4" Grid.ColumnSpan="2"
                   Text="Timing (used when Audio-Reactive is OFF)"
                   Foreground="#B4DCB4"
                   FontWeight="Bold"
                   Margin="0,4,0,6" />

        <!-- Rows 5..8: timing spinners. IsEnabled bound so audio-reactive
             greys them out exactly as the WinForms dialog did. -->
        <TextBlock Grid.Row="5" Grid.Column="0" VerticalAlignment="Center"
                   Text="Total display time per region (s):"
                   IsEnabled="{Binding TimingEnabled}" />
        <NumericUpDown Grid.Row="5" Grid.Column="1"
                       Minimum="3" Maximum="600" Increment="1"
                       Value="{Binding TotalDisplaySec, Mode=TwoWay}"
                       IsEnabled="{Binding TimingEnabled}"
                       Width="110" Margin="8,2" />

        <TextBlock Grid.Row="6" Grid.Column="0" VerticalAlignment="Center"
                   Text="Color theme fade (ms):"
                   IsEnabled="{Binding TimingEnabled}" />
        <NumericUpDown Grid.Row="6" Grid.Column="1"
                       Minimum="100" Maximum="20000" Increment="100"
                       Value="{Binding ThemeFadeMs, Mode=TwoWay}"
                       IsEnabled="{Binding TimingEnabled}"
                       Width="110" Margin="8,2" />

        <TextBlock Grid.Row="7" Grid.Column="0" VerticalAlignment="Center"
                   Text="Region fade (ms):"
                   IsEnabled="{Binding TimingEnabled}" />
        <NumericUpDown Grid.Row="7" Grid.Column="1"
                       Minimum="100" Maximum="20000" Increment="100"
                       Value="{Binding RegionFadeMs, Mode=TwoWay}"
                       IsEnabled="{Binding TimingEnabled}"
                       Width="110" Margin="8,2" />

        <TextBlock Grid.Row="8" Grid.Column="0" VerticalAlignment="Center"
                   Text="Fade steps:"
                   IsEnabled="{Binding TimingEnabled}" />
        <NumericUpDown Grid.Row="8" Grid.Column="1"
                       Minimum="2" Maximum="200" Increment="1"
                       Value="{Binding FadeSteps, Mode=TwoWay}"
                       IsEnabled="{Binding TimingEnabled}"
                       Width="110" Margin="8,2" />

        <!-- Row 9: reproducibility seed. Not greyed by audio-reactive — it
             governs region/theme ordering, which runs in both modes. -->
        <TextBlock Grid.Row="9" Grid.Column="0" VerticalAlignment="Center"
                   Text="Random seed (0 = random each run):"
                   ToolTip.Tip="Set a fixed non-zero seed to replay the exact same region/theme order every run (demos, recordings). 0 shuffles fresh each run." />
        <NumericUpDown Grid.Row="9" Grid.Column="1"
                       Minimum="0" Maximum="2147483647" Increment="1"
                       Value="{Binding RandomSeed, Mode=TwoWay}"
                       Width="110" Margin="8,2" />

        <!-- Row 10: timing note, visibility bound to AudioReactive -->
        <TextBlock Grid.Row="10" Grid.ColumnSpan="2"
                   Text="(Disabled while Audio-Reactive is on — beats drive timing.)"
                   FontStyle="Italic"
                   Foreground="#969696"
                   Margin="0,6,0,4"
                   IsVisible="{Binding TimingNoteVisible}" />

        <!-- Row 11: per-region watermark toggle -->
        <CheckBox Grid.Row="11" Grid.ColumnSpan="2"
                  Content="Use each region's embedded watermark"
                  IsChecked="{Binding UseRegionWatermark, Mode=TwoWay}"
                  Foreground="#B4DCB4"
                  FontWeight="Bold"
                  Margin="0,4,0,0"
                  ToolTip.Tip="When on, each region that carries an embedded watermark drives its own branding during the slideshow." />

        <!-- Row 11: Record-Slideshow block — capture every fade step to a PNG
             sequence and prompt Convert / Save / Cancel on Stop. -->
        <Border Grid.Row="12" Grid.ColumnSpan="2"
                BorderBrush="#3C3C3C" BorderThickness="0,1,0,1"
                Padding="0,8,0,8" Margin="0,8,0,4">
            <StackPanel Spacing="6">
                <CheckBox Content="Record Slideshow (capture every fade step)"
                          IsChecked="{Binding RecordSlideshow, Mode=TwoWay}"
                          Foreground="#B4DCB4" FontWeight="Bold"
                          ToolTip.Tip="When on, the slideshow writes every cross-fade frame to a PNG sequence in a temp folder. Stop prompts Convert (ffmpeg), Save (keep frames), or Cancel (delete)." />
                <Grid ColumnDefinitions="180,*" IsEnabled="{Binding RecordSlideshow}">
                    <TextBlock Grid.Column="0" Text="Encode preset:" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding AllRecordEncodePresets}"
                              SelectedItem="{Binding RecordEncodePreset, Mode=TwoWay}"
                              MinWidth="200" HorizontalAlignment="Left" />
                </Grid>
                <TextBlock Text="HighQualityH264Mp4 = CRF 18 yuv420p (small, broad-compat). LosslessH264Mp4 = -qp 0 yuv444p. Ffv1Mkv = FFV1 v3 archival."
                           Foreground="#969696" FontStyle="Italic" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- Row 12: Filter expander — regions / themes / fractal types / quality presets -->
        <Expander Grid.Row="13" Grid.ColumnSpan="2"
                  Header="Filters (regions / themes / fractal type / quality)"
                  Margin="0,12,0,0"
                  IsExpanded="False">
            <StackPanel Spacing="6" Margin="0,6,0,0">
                <TextBlock Text="Included Regions  (unchecked all = all eligible)"
                           Foreground="#B4DCB4" FontWeight="Bold" />
                <ListBox ItemsSource="{Binding AvailableRegions}"
                         MaxHeight="140"
                         SelectionMode="Multiple">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding Name}"
                                      IsChecked="{Binding IsChecked, Mode=TwoWay}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Text="Included Color Themes" Foreground="#B4DCB4" FontWeight="Bold" Margin="0,6,0,0" />
                <ListBox ItemsSource="{Binding AvailableThemes}"
                         MaxHeight="140"
                         SelectionMode="Multiple">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding Name}"
                                      IsChecked="{Binding IsChecked, Mode=TwoWay}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Text="Restrict by Fractal Type" Foreground="#B4DCB4" FontWeight="Bold" Margin="0,6,0,0" />
                <ListBox ItemsSource="{Binding AvailableFractalTypes}"
                         MaxHeight="120"
                         SelectionMode="Multiple">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding Name}"
                                      IsChecked="{Binding IsChecked, Mode=TwoWay}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Text="Restrict by Quality" Foreground="#B4DCB4" FontWeight="Bold" Margin="0,6,0,0" />
                <ListBox ItemsSource="{Binding AvailableQualityPresets}"
                         MaxHeight="100"
                         SelectionMode="Multiple">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding Name}"
                                      IsChecked="{Binding IsChecked, Mode=TwoWay}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </Expander>

        <!-- Row 13: Adaptive Sweep configuration -->
        <Expander Grid.Row="14" Grid.ColumnSpan="2"
                  Header="Adaptive Sweep"
                  Margin="0,8,0,0"
                  IsExpanded="False">
            <StackPanel Spacing="6" Margin="0,6,0,0">
                <CheckBox Content="Enable per-leg Adaptive sweep"
                          IsChecked="{Binding AdaptiveSweepEnabled, Mode=TwoWay}"
                          FontWeight="Bold" Foreground="#B4DCB4" />
                <Grid ColumnDefinitions="160,*">
                    <TextBlock Grid.Column="0" Text="Start value (0..100):" VerticalAlignment="Center"
                               IsEnabled="{Binding AdaptiveSweepEnabled}" />
                    <NumericUpDown Grid.Column="1"
                                   Minimum="0" Maximum="100" Increment="1"
                                   Value="{Binding AdaptiveSweepStart, Mode=TwoWay}"
                                   IsEnabled="{Binding AdaptiveSweepEnabled}"
                                   Width="110" HorizontalAlignment="Left" />
                </Grid>
                <Grid ColumnDefinitions="160,*">
                    <TextBlock Grid.Column="0" Text="End value (0..100):" VerticalAlignment="Center"
                               IsEnabled="{Binding AdaptiveSweepEnabled}" />
                    <NumericUpDown Grid.Column="1"
                                   Minimum="0" Maximum="100" Increment="1"
                                   Value="{Binding AdaptiveSweepEnd, Mode=TwoWay}"
                                   IsEnabled="{Binding AdaptiveSweepEnabled}"
                                   Width="110" HorizontalAlignment="Left" />
                </Grid>
                <Grid ColumnDefinitions="160,*">
                    <TextBlock Grid.Column="0" Text="Mode:" VerticalAlignment="Center"
                               IsEnabled="{Binding AdaptiveSweepEnabled}" />
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding AllAdaptiveSweepModes}"
                              SelectedItem="{Binding AdaptiveSweepMode_, Mode=TwoWay}"
                              IsEnabled="{Binding AdaptiveSweepEnabled}"
                              MinWidth="150" HorizontalAlignment="Left" />
                </Grid>
                <CheckBox Content="Loop (restart sweep at leg boundary instead of stopping)"
                          IsChecked="{Binding AdaptiveSweepLoop, Mode=TwoWay}"
                          IsEnabled="{Binding AdaptiveSweepEnabled}" />
                <Grid ColumnDefinitions="160,*,80">
                    <TextBlock Grid.Column="0" Text="Beats per cycle:" VerticalAlignment="Center"
                               IsEnabled="{Binding AdaptiveSweepEnabled}" />
                    <NumericUpDown Grid.Column="1"
                                   Minimum="0.0625" Maximum="32" Increment="0.25"
                                   FormatString="0.##"
                                   Value="{Binding AdaptiveSweepBeatFraction, Mode=TwoWay}"
                                   IsEnabled="{Binding AdaptiveSweepEnabled}"
                                   Width="120" HorizontalAlignment="Left" />
                    <TextBlock Grid.Column="2" Text="{Binding AdaptiveSweepBeatFractionLabel}"
                               VerticalAlignment="Center" Margin="6,0,0,0"
                               Foreground="#969696" FontStyle="Italic" />
                </Grid>
                <TextBlock Text="Beat-driven sweep active only when Audio-Reactive is on. Sweep loops automatically for slideshow duration."
                           Foreground="#969696" FontStyle="Italic" TextWrapping="Wrap"
                           IsEnabled="{Binding AdaptiveSweepEnabled}" />
            </StackPanel>
        </Expander>

        <!-- Row 14: Post-FX snapshot -->
        <Expander Grid.Row="15" Grid.ColumnSpan="2"
                  Header="Post-FX snapshot"
                  Margin="0,8,0,0"
                  IsExpanded="False">
            <StackPanel Spacing="6" Margin="0,6,0,0">
                <DockPanel LastChildFill="False">
                    <CheckBox Content="Apply snapshot on slideshow start"
                              IsChecked="{Binding PostFxEnabled, Mode=TwoWay}"
                              FontWeight="Bold" Foreground="#B4DCB4"
                              DockPanel.Dock="Left" />
                    <Button Content="Capture from current"
                            Command="{Binding CapturePostFxCommand}"
                            DockPanel.Dock="Right"
                            Padding="10,4" />
                </DockPanel>
                <Grid ColumnDefinitions="160,*">
                    <TextBlock Grid.Column="0" Text="Brightness (0..200):" VerticalAlignment="Center"
                               IsEnabled="{Binding PostFxEnabled}" />
                    <NumericUpDown Grid.Column="1"
                                   Minimum="0" Maximum="200" Increment="1"
                                   Value="{Binding PostFxBrightness, Mode=TwoWay}"
                                   IsEnabled="{Binding PostFxEnabled}"
                                   Width="110" HorizontalAlignment="Left" />
                </Grid>
                <Grid ColumnDefinitions="160,*">
                    <TextBlock Grid.Column="0" Text="Contrast (0..200):" VerticalAlignment="Center"
                               IsEnabled="{Binding PostFxEnabled}" />
                    <NumericUpDown Grid.Column="1"
                                   Minimum="0" Maximum="200" Increment="1"
                                   Value="{Binding PostFxContrast, Mode=TwoWay}"
                                   IsEnabled="{Binding PostFxEnabled}"
                                   Width="110" HorizontalAlignment="Left" />
                </Grid>
                <Grid ColumnDefinitions="160,*">
                    <TextBlock Grid.Column="0" Text="Adaptive (0..100):" VerticalAlignment="Center"
                               IsEnabled="{Binding PostFxEnabled}" />
                    <NumericUpDown Grid.Column="1"
                                   Minimum="0" Maximum="100" Increment="1"
                                   Value="{Binding PostFxAdaptive, Mode=TwoWay}"
                                   IsEnabled="{Binding PostFxEnabled}"
                                   Width="110" HorizontalAlignment="Left" />
                </Grid>
                <TextBlock Text="Adaptive Sweep overrides the Adaptive value when enabled."
                           Foreground="#969696" FontStyle="Italic" />
            </StackPanel>
        </Expander>

        <!-- Row 15: Animations panel. Always available; the Animation type
             animates unconditionally, while Image / Video opt in via the
             "Enable animations" toggle (Phase 5). -->
        <Expander Grid.Row="16" Grid.ColumnSpan="2"
                  Header="Animations"
                  Margin="0,8,0,0"
                  IsExpanded="{Binding AnimationsExpanded}">
            <StackPanel Spacing="6" Margin="0,6,0,0">
                <CheckBox Content="Enable animations on this slideshow"
                          IsChecked="{Binding EnableAnimations, Mode=TwoWay}"
                          IsVisible="{Binding ShowEnableAnimationsToggle}"
                          FontWeight="Bold" Foreground="#B4DCB4"
                          ToolTip.Tip="Play region-attached (or random type-compatible) animations during each Image/Video leg. Off = unchanged classic behaviour." />
                <TextBlock Text="Animation type always animates each leg."
                           IsVisible="{Binding IsAnimation}"
                           Foreground="#969696" FontStyle="Italic" />
                <StackPanel Spacing="6" IsEnabled="{Binding AnimationsExpanded}">
                    <CheckBox Content="Randomize animation by fractal type"
                              IsChecked="{Binding RandomizeAnimationsByFractalType, Mode=TwoWay}"
                              FontWeight="Bold" Foreground="#B4DCB4"
                              ToolTip.Tip="When on, ignore each region's attached animation and draw a random library animation whose target fractal types include the region's type." />
                    <TextBlock Text="Included Animations  (unchecked all = all eligible)"
                               Foreground="#B4DCB4" FontWeight="Bold" Margin="0,6,0,0" />
                    <ListBox ItemsSource="{Binding AvailableAnimations}"
                             MaxHeight="160"
                             SelectionMode="Multiple">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Name}"
                                          IsChecked="{Binding IsChecked, Mode=TwoWay}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="Each leg plays the region's attached animation, or a random compatible one when none is attached. Regions with no compatible animation play static. (Video slideshow legs are Mandelbrot-only.)"
                               Foreground="#969696" FontStyle="Italic" TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>
        </Expander>

        <!-- Row 16: Start / OK / Cancel buttons -->
        <StackPanel Grid.Row="17" Grid.ColumnSpan="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8"
                    Margin="0,16,0,0">
            <Button Content="Start Slideshow"
                    Command="{Binding StartCommand}"
                    IsVisible="{Binding IsLibraryMode}"
                    Padding="14,6"
                    Background="#2A4E2A"
                    Foreground="White" />
            <Button Content="?"
                    Click="OnHelpClick"
                    ToolTip.Tip="Open the Slideshow + Audio-Reactive guide"
                    Padding="10,6"
                    Background="#283C50"
                    Foreground="#FFCC00"
                    FontWeight="Bold" />
            <Button Content="OK"
                    Command="{Binding OkCommand}"
                    IsDefault="True"
                    Padding="18,6"
                    Background="#284632"
                    Foreground="White"
                    Click="OnOkClicked" />
            <Button Content="Cancel"
                    Command="{Binding CancelCommand}"
                    IsCancel="True"
                    Padding="14,6"
                    Background="#462828"
                    Foreground="White"
                    Click="OnCancelClicked" />
        </StackPanel>

    </Grid>
    </ScrollViewer>

</UserControl>

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FracturingFog.UI.Avalonia.ViewModels"
        x:Class="FracturingFog.UI.Avalonia.Views.SlideshowSettingsView"
        x:DataType="vm:SlideshowSettingsViewModel"
        Title="Slideshow Settings"
        Width="460"
        SizeToContent="Height"
        MinWidth="380"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#1C1C1C">

    <!--
      DIP-only layout. Auto rows expand to fit fonts at any DPI; no Left/Top/
      Width arithmetic anywhere in the file. The width is the only fixed
      dimension and even that uses MinWidth so a larger system font (e.g. a
      4K display at 200% scaling with a 12pt UI font) cannot crop labels.
    -->
    <Grid Margin="14" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
          ColumnDefinitions="*,Auto">

        <!-- Row 0: Audio-Reactive toggle + Audio… button -->
        <DockPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,10" LastChildFill="False">
            <ToggleButton Content="Audio-Reactive Slideshow"
                          IsChecked="{Binding AudioReactive, Mode=TwoWay}"
                          FontWeight="Bold"
                          Padding="12,6"
                          DockPanel.Dock="Left" />
            <Button Content="Audio…"
                    Command="{Binding ShowAudioDialogCommand}"
                    Padding="10,6"
                    Margin="10,0,0,0"
                    DockPanel.Dock="Left" />
        </DockPanel>

        <!-- Row 1: Extreme regions toggle -->
        <CheckBox Grid.Row="1" Grid.ColumnSpan="2"
                  Content="Use Extreme Regions"
                  IsChecked="{Binding UseExtremeRegions, Mode=TwoWay}"
                  Foreground="#DCA0A0"
                  FontWeight="Bold"
                  Margin="0,0,0,8" />

        <!-- Row 2: Timing group header -->
        <TextBlock Grid.Row="2" Grid.ColumnSpan="2"
                   Text="Timing (used when Audio-Reactive is OFF)"
                   Foreground="#B4DCB4"
                   FontWeight="Bold"
                   Margin="0,4,0,6" />

        <!-- Rows 3..6: timing spinners. IsEnabled bound so audio-reactive
             greys them out exactly as the WinForms dialog did. -->
        <TextBlock Grid.Row="3" Grid.Column="0" VerticalAlignment="Center"
                   Text="Total display time per region (s):"
                   IsEnabled="{Binding TimingEnabled}" />
        <NumericUpDown Grid.Row="3" Grid.Column="1"
                       Minimum="3" Maximum="600" Increment="1"
                       Value="{Binding TotalDisplaySec, Mode=TwoWay}"
                       IsEnabled="{Binding TimingEnabled}"
                       Width="110" Margin="8,2" />

        <TextBlock Grid.Row="4" Grid.Column="0" VerticalAlignment="Center"
                   Text="Color theme fade (ms):"
                   IsEnabled="{Binding TimingEnabled}" />
        <NumericUpDown Grid.Row="4" Grid.Column="1"
                       Minimum="100" Maximum="20000" Increment="100"
                       Value="{Binding ThemeFadeMs, Mode=TwoWay}"
                       IsEnabled="{Binding TimingEnabled}"
                       Width="110" Margin="8,2" />

        <TextBlock Grid.Row="5" Grid.Column="0" VerticalAlignment="Center"
                   Text="Region fade (ms):"
                   IsEnabled="{Binding TimingEnabled}" />
        <NumericUpDown Grid.Row="5" Grid.Column="1"
                       Minimum="100" Maximum="20000" Increment="100"
                       Value="{Binding RegionFadeMs, Mode=TwoWay}"
                       IsEnabled="{Binding TimingEnabled}"
                       Width="110" Margin="8,2" />

        <TextBlock Grid.Row="6" Grid.Column="0" VerticalAlignment="Center"
                   Text="Fade steps:"
                   IsEnabled="{Binding TimingEnabled}" />
        <NumericUpDown Grid.Row="6" Grid.Column="1"
                       Minimum="2" Maximum="200" Increment="1"
                       Value="{Binding FadeSteps, Mode=TwoWay}"
                       IsEnabled="{Binding TimingEnabled}"
                       Width="110" Margin="8,2" />

        <!-- Row 7: timing note, visibility bound to AudioReactive -->
        <TextBlock Grid.Row="7" Grid.ColumnSpan="2"
                   Text="(Disabled while Audio-Reactive is on — beats drive timing.)"
                   FontStyle="Italic"
                   Foreground="#969696"
                   Margin="0,6,0,4"
                   IsVisible="{Binding TimingNoteVisible}" />

        <!-- Row 8: per-region watermark toggle -->
        <CheckBox Grid.Row="8" Grid.ColumnSpan="2"
                  Content="Use each region's embedded watermark"
                  IsChecked="{Binding UseRegionWatermark, Mode=TwoWay}"
                  Foreground="#B4DCB4"
                  FontWeight="Bold"
                  Margin="0,4,0,0"
                  ToolTip.Tip="When on, each region that carries an embedded watermark drives its own branding during the slideshow." />

        <!-- Row 9: OK / Cancel buttons -->
        <StackPanel Grid.Row="9" Grid.ColumnSpan="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8"
                    Margin="0,12,0,0">
            <Button Content="OK"
                    Command="{Binding OkCommand}"
                    IsDefault="True"
                    Padding="18,6"
                    Background="#284632"
                    Foreground="White"
                    Click="OnOkClicked" />
            <Button Content="Cancel"
                    Command="{Binding CancelCommand}"
                    IsCancel="True"
                    Padding="14,6"
                    Background="#462828"
                    Foreground="White"
                    Click="OnCancelClicked" />
        </StackPanel>

    </Grid>

</Window>

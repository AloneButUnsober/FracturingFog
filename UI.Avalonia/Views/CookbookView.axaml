<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FracturingFog.UI.Avalonia.ViewModels"
        x:Class="FracturingFog.UI.Avalonia.Views.CookbookView"
        x:DataType="vm:CookbookViewModel"
        Foreground="#DCDCDC">

    <UserControl.KeyBindings>
        <KeyBinding Gesture="Enter"  Command="{Binding AcceptCommand}" />
        <KeyBinding Gesture="Escape" Command="{Binding CancelCommand}" />
    </UserControl.KeyBindings>

    <Grid Margin="12" RowDefinitions="Auto,*,Auto,Auto">

        <TextBlock Grid.Row="0"
                   Text="Curated CalcGen DSL equations. Pick one to populate the DSL editor and re-centre the view."
                   Foreground="#B4B4B4"
                   TextWrapping="Wrap"
                   Margin="0,0,0,8" />

        <Grid Grid.Row="1" ColumnDefinitions="2*,3*">
            <Border Grid.Column="0"
                    BorderBrush="#3A3A3A"
                    BorderThickness="1"
                    Margin="0,0,6,0">
                <ListBox ItemsSource="{Binding Entries}"
                         SelectedItem="{Binding Selected, Mode=TwoWay}"
                         Background="#161616"
                         Foreground="#DCDCDC">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="vm:CookbookEntry">
                            <TextBlock Text="{Binding Name}"
                                       FontWeight="SemiBold"
                                       Padding="4,2" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <Border Grid.Column="1"
                    BorderBrush="#3A3A3A"
                    BorderThickness="1"
                    Background="#161616"
                    Margin="6,0,0,0"
                    Padding="10">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto,*">
                    <TextBlock Grid.Row="0"
                               Text="{Binding SelectedName}"
                               FontWeight="Bold"
                               FontSize="16"
                               Foreground="#FFFFFF"
                               Margin="0,0,0,6" />

                    <SelectableTextBlock Grid.Row="1"
                                         Text="{Binding SelectedSourceDisplay}"
                                         FontFamily="Consolas, monospace"
                                         FontSize="13"
                                         Foreground="#FFD080"
                                         TextWrapping="Wrap"
                                         Margin="0,0,0,6" />

                    <TextBlock Grid.Row="2"
                               Text="{Binding SelectedCentreDisplay}"
                               FontFamily="Consolas, monospace"
                               FontSize="12"
                               Foreground="#909090"
                               Margin="0,0,0,8" />

                    <Rectangle Grid.Row="3"
                               Fill="#3A3A3A"
                               Margin="0,0,0,8" />

                    <TextBlock Grid.Row="4"
                               Text="{Binding SelectedDescription}"
                               TextWrapping="Wrap"
                               Foreground="#C8C8C8" />
                </Grid>
            </Border>
        </Grid>

        <Rectangle Grid.Row="2"
                   Fill="#3A3A3A"
                   Margin="0,12,0,8" />

        <Grid Grid.Row="3" ColumnDefinitions="*,Auto,Auto">
            <TextBlock Grid.Column="0"
                       Text="Selected equation replaces the DSL editor source and re-centres the view."
                       Foreground="#808080"
                       VerticalAlignment="Center" />
            <Button Grid.Column="1"
                    Content="Use this equation"
                    Command="{Binding AcceptCommand}"
                    IsEnabled="{Binding HasSelection}"
                    FontWeight="Bold"
                    Padding="14,4"
                    Margin="0,0,8,0" />
            <Button Grid.Column="2"
                    Content="Cancel"
                    Command="{Binding CancelCommand}"
                    Padding="14,4" />
        </Grid>

    </Grid>
</UserControl>

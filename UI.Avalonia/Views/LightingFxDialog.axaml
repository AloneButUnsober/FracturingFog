<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FracturingFog.UI.Avalonia.ViewModels"
        x:Class="FracturingFog.UI.Avalonia.Views.LightingFxDialog"
        x:DataType="vm:FractalParamsViewModel"
        Foreground="White">

    <!--
      Bound to the SAME FractalParamsViewModel as FractalParamsView (the params
      view passes its DataContext through when opening this dialog). Bindings
      mirror the legacy Lighting & FX expander block that used to live inline
      in FractalParamsView.axaml. Numeric knobs with bounded ranges render as
      sliders + a right-aligned value readout; unbounded or precision-sensitive
      knobs (paths, hex, low-increment numerics) stay as NumericUpDown / TextBox.

      Speed-driven effects (light orbit, caustics, cloud-noise drift) get a
      Start/Stop toggle next to the speed input. Toggle stashes the live speed
      on Stop and restores it on Start so the user can pause animation without
      losing their preferred rate.
    -->

    <UserControl.Styles>
        <!-- Compact slider for value-readout rows. -->
        <Style Selector="Slider.knob">
            <Setter Property="Margin" Value="0,2,0,2" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="MinHeight" Value="24" />
        </Style>
        <Style Selector="TextBlock.knobValue">
            <Setter Property="Width" Value="52" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="Foreground" Value="#C8C8C8" />
        </Style>
        <!-- #305 — armed "Confirm reset?" state: yellow (#FFCC00, colorblind-safe). -->
        <Style Selector="Button.armed">
            <Setter Property="Foreground" Value="#FFCC00" />
            <Setter Property="BorderBrush" Value="#FFCC00" />
        </Style>
    </UserControl.Styles>

    <Grid Margin="14" RowDefinitions="*,Auto">

        <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="4">

                <TextBlock Text="Lighting &amp; FX"
                           FontWeight="Bold"
                           Foreground="#FFCC00"
                           Margin="0,0,0,4" />

                <!-- Relief 3D context banner. Relief shares stage-1 per-hit shading
                     (lights / shadow / AO / fog / volumetrics / material / reflections)
                     runs Tone Map / Exposure / Bloom / Lens / SSAO / Edge ink (S12.1-4, #652) over
                     its HDR beauty + normal/depth G-buffer; only Stereo / DoF stay
                     3D-fractal only and disabled below. #FFCC00 = colorblind-safe
                     advisory. See Docs/Technical/Lighting-FX-3D-vs-Relief3D.md. -->
                <Border IsVisible="{Binding IsReliefLightingContext}"
                        Background="#33FFCC00" BorderBrush="#FFCC00" BorderThickness="1"
                        CornerRadius="3" Padding="8" Margin="0,0,0,6">
                    <TextBlock TextWrapping="Wrap" Foreground="#FFCC00"
                               Text="Relief 3D: lights, shadows, AO, fog and volumetrics below all apply — and Tone Map, Exposure, Bloom, Lens, SSAO and Edge ink now apply too (over the relief HDR beauty + G-buffer). Still 3D-fractal only, disabled here: Stereo and this dialog's DoF. The FX Tone Map and the View ▸ View Transform stack (Tone Map maps HDR to display; View Transform is a look on top); for Relief depth-of-field, use the Relief 3D dialog's own aperture / focus." />
                </Border>

                <!-- #306 — volumetric preset droplist (artistic starting points) -->
                <Grid ColumnDefinitions="160,*" Margin="0,0,0,4">
                    <TextBlock Grid.Column="0" Text="Volumetric preset:" VerticalAlignment="Center"
                               ToolTip.Tip="Curated fog / god-ray / cloud starting points, applied over the current lighting — then tune the Fog / Volumetric sliders below. '—' = no change. A region save snapshots whatever you land on." />
                    <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                              ItemsSource="{Binding VolumetricPresetNames}"
                              SelectedItem="{Binding SelectedVolumetricPreset, Mode=TwoWay}" />
                </Grid>

                <!-- #580 — user-saved Lighting & FX presets (recall / save / delete / import / export) -->
                <Grid ColumnDefinitions="160,*" Margin="0,0,0,4">
                    <TextBlock Grid.Column="0" Text="My FX preset:" VerticalAlignment="Center"
                               ToolTip.Tip="Your own saved Lighting &amp; FX looks — the full lighting/FX block. Pick one and click Recall to apply it. Save snapshots the current settings under a name. Also listed in the Asset Manager." />
                    <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                              ItemsSource="{Binding UserFxPresets}"
                              SelectedItem="{Binding SelectedUserFxPreset, Mode=TwoWay}" />
                </Grid>
                <StackPanel Orientation="Horizontal" Spacing="4" Margin="160,0,0,6">
                    <Button Content="Recall" Click="OnRecallFxPresetClick"
                            ToolTip.Tip="Apply the selected preset to the current view." />
                    <Button Content="Save…" Click="OnSaveFxPresetClick"
                            ToolTip.Tip="Save the current Lighting &amp; FX settings as a named preset." />
                    <Button Content="Delete" Click="OnDeleteFxPresetClick"
                            ToolTip.Tip="Delete the selected preset." />
                    <Button Content="Import…" Click="OnImportFxPresetClick"
                            ToolTip.Tip="Import preset(s) from a JSON file." />
                    <Button Content="Export…" Click="OnExportFxPresetClick"
                            ToolTip.Tip="Export the selected preset to a JSON file." />
                </StackPanel>

                <!-- Lights -->
                <Expander Header="Lights" IsExpanded="True" HorizontalAlignment="Stretch">
                    <Grid ColumnDefinitions="160,*"
                          RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="L1 θ (azim):" VerticalAlignment="Center" />
                        <NumericUpDown Grid.Row="0" Grid.Column="1"
                                       Minimum="-10" Maximum="10" Increment="0.05" FormatString="F3"
                                       Value="{Binding Light1Theta, Mode=TwoWay}" Margin="0,2" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="L1 φ (elev):" VerticalAlignment="Center" />
                        <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="*,Auto" Margin="0,2">
                            <Slider Classes="knob" Grid.Column="0" Minimum="0.01" Maximum="3.13"
                                    Value="{Binding Light1Phi, Mode=TwoWay}" />
                            <TextBlock Classes="knobValue" Grid.Column="1"
                                       Text="{Binding Light1Phi, StringFormat='F3'}" />
                        </Grid>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="L1 intensity:" VerticalAlignment="Center" />
                        <Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="*,Auto" Margin="0,2">
                            <Slider Classes="knob" Grid.Column="0" Minimum="0" Maximum="4"
                                    Value="{Binding Light1Intensity, Mode=TwoWay}" />
                            <TextBlock Classes="knobValue" Grid.Column="1"
                                       Text="{Binding Light1Intensity, StringFormat='F2'}" />
                        </Grid>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="L2 θ (azim):" VerticalAlignment="Center" />
                        <NumericUpDown Grid.Row="3" Grid.Column="1"
                                       Minimum="-10" Maximum="10" Increment="0.05" FormatString="F3"
                                       Value="{Binding Light2Theta, Mode=TwoWay}" Margin="0,2" />

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="L2 φ (elev):" VerticalAlignment="Center" />
                        <Grid Grid.Row="4" Grid.Column="1" ColumnDefinitions="*,Auto" Margin="0,2">
                            <Slider Classes="knob" Grid.Column="0" Minimum="0.01" Maximum="3.13"
                                    Value="{Binding Light2Phi, Mode=TwoWay}" />
                            <TextBlock Classes="knobValue" Grid.Column="1"
                                       Text="{Binding Light2Phi, StringFormat='F3'}" />
                        </Grid>

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="L2 intensity:" VerticalAlignment="Center"
                                   ToolTip.Tip="0 = light off. Fill light. Default off so legacy single-light look stays unchanged." />
                        <Grid Grid.Row="5" Grid.Column="1" ColumnDefinitions="*,Auto" Margin="0,2">
                            <Slider Classes="knob" Grid.Column="0" Minimum="0" Maximum="4"
                                    Value="{Binding Light2Intensity, Mode=TwoWay}" />
                            <TextBlock Classes="knobValue" Grid.Column="1"
                                       Text="{Binding Light2Intensity, StringFormat='F2'}" />
                        </Grid>

                        <TextBlock Grid.Row="6" Grid.Column="0" Text="L3 θ (azim):" VerticalAlignment="Center" />
                        <NumericUpDown Grid.Row="6" Grid.Column="1"
                                       Minimum="-10" Maximum="10" Increment="0.05" FormatString="F3"
                                       Value="{Binding Light3Theta, Mode=TwoWay}" Margin="0,2" />

                        <TextBlock Grid.Row="7" Grid.Column="0" Text="L3 φ (elev):" VerticalAlignment="Center" />
                        <Grid Grid.Row="7" Grid.Column="1" ColumnDefinitions="*,Auto" Margin="0,2">
                            <Slider Classes="knob" Grid.Column="0" Minimum="0.01" Maximum="3.13"
                                    Value="{Binding Light3Phi, Mode=TwoWay}" />
                            <TextBlock Classes="knobValue" Grid.Column="1"
                                       Text="{Binding Light3Phi, StringFormat='F3'}" />
                        </Grid>

                        <TextBlock Grid.Row="8" Grid.Column="0" Text="L3 intensity:" VerticalAlignment="Center"
                                   ToolTip.Tip="0 = light off. Rim/back light." />
                        <Grid Grid.Row="8" Grid.Column="1" ColumnDefinitions="*,Auto" Margin="0,2">
                            <Slider Classes="knob" Grid.Column="0" Minimum="0" Maximum="4"
                                    Value="{Binding Light3Intensity, Mode=TwoWay}" />
                            <TextBlock Classes="knobValue" Grid.Column="1"
                                       Text="{Binding Light3Intensity, StringFormat='F2'}" />
                        </Grid>

                        <TextBlock Grid.Row="9" Grid.Column="0" Text="Ambient:" VerticalAlignment="Center"
                                   ToolTip.Tip="Flat floor brightness. Legacy 0.15. Higher = brighter shadows / less contrast." />
                        <Grid Grid.Row="9" Grid.Column="1" ColumnDefinitions="*,Auto" Margin="0,2">
                            <Slider Classes="knob" Grid.Column="0" Minimum="0" Maximum="1"
                                    Value="{Binding AmbientStrength, Mode=TwoWay}" />
                            <TextBlock Classes="knobValue" Grid.Column="1"
                                       Text="{Binding AmbientStrength, StringFormat='F3'}" />
                        </Grid>

                        <TextBlock Grid.Row="10" Grid.Column="0" Text="Orbit speed (rad/s):" VerticalAlignment="Center"
                                   ToolTip.Tip="Animates L1 around world Y. 0 = static. Start/Stop pauses without losing the rate." />
                        <Grid Grid.Row="10" Grid.Column="1" ColumnDefinitions="*,Auto" Margin="0,2">
                            <NumericUpDown Grid.Column="0"
                                           Minimum="-10" Maximum="10" Increment="0.05" FormatString="F3"
                                           Value="{Binding LightOrbitSpeed, Mode=TwoWay}" />
                            <Button Grid.Column="1"
                                    Content="{Binding LightOrbitToggleLabel}"
                                    Command="{Binding ToggleLightOrbitCommand}"
                                    MinWidth="62" Margin="6,0,0,0" />
                        </Grid>

                        <TextBlock Grid.Row="11" Grid.Column="0" Text="Caustics speed:" VerticalAlignment="Center"
                                   ToolTip.Tip="Caustic-pattern phase rate. 0 = static. Start/Stop pauses without losing the rate." />
                        <Grid Grid.Row="11" Grid.Column="1" ColumnDefinitions="*,Auto" Margin="0,2">
                            <NumericUpDown Grid.Column="0"
                                           Minimum="-10" Maximum="10" Increment="0.05" FormatString="F3"
                                           Value="{Binding CausticsAnimSpeed, Mode=TwoWay}" />
                            <Button Grid.Column="1"
                                    Content="{Binding CausticsToggleLabel}"
                                    Command="{Binding ToggleCausticsCommand}"
                                    MinWidth="62" Margin="6,0,0,0" />
                        </Grid>
                    </Grid>
                </Expander>

                <!-- Light Types: point / spot (roadmap S8, #404) -->
                <Expander Header="Light Types (Point / Spot)" HorizontalAlignment="Stretch">
                    <StackPanel Spacing="8">
                        <TextBlock TextWrapping="Wrap" FontSize="11" Opacity="0.8"
                                   Text="Directional (default) uses θ/φ as a fixed direction. Point adds a world position + inverse-square range falloff; Spot adds a cone. Relief 3D only." />

                        <!-- Light 1 -->
                        <TextBlock Text="Light 1" FontWeight="Bold" />
                        <Grid ColumnDefinitions="160,*" RowDefinitions="Auto">
                            <TextBlock Grid.Column="0" Text="Type:" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" Margin="0,2"
                                      ItemsSource="{Binding LightTypes}"
                                      SelectedItem="{Binding Light1Type, Mode=TwoWay}" />
                        </Grid>
                        <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,Auto,Auto,Auto"
                              IsVisible="{Binding Light1ShowPositional}">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Position X:" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Row="0" Grid.Column="1" Minimum="-100" Maximum="100" Increment="0.1" FormatString="F2" Margin="0,2"
                                           Value="{Binding Light1PosX, Mode=TwoWay}" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Position Y:" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Row="1" Grid.Column="1" Minimum="-100" Maximum="100" Increment="0.1" FormatString="F2" Margin="0,2"
                                           Value="{Binding Light1PosY, Mode=TwoWay}" />
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Position Z:" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Row="2" Grid.Column="1" Minimum="-100" Maximum="100" Increment="0.1" FormatString="F2" Margin="0,2"
                                           Value="{Binding Light1PosZ, Mode=TwoWay}" />
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Range:" VerticalAlignment="Center"
                                       ToolTip.Tip="Soft cutoff distance in world units. 0 = pure inverse-square (no range window)." />
                            <NumericUpDown Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="100" Increment="0.1" FormatString="F2" Margin="0,2"
                                           Value="{Binding Light1Range, Mode=TwoWay}" />
                        </Grid>
                        <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,Auto"
                              IsVisible="{Binding Light1ShowSpot}">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Cone inner (°):" VerticalAlignment="Center"
                                       ToolTip.Tip="Full intensity inside this half-angle." />
                            <NumericUpDown Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="89" Increment="1" FormatString="F1" Margin="0,2"
                                           Value="{Binding Light1SpotInnerDeg, Mode=TwoWay}" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Cone outer (°):" VerticalAlignment="Center"
                                       ToolTip.Tip="Zero intensity beyond this half-angle. Inner→outer is the soft penumbra." />
                            <NumericUpDown Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="90" Increment="1" FormatString="F1" Margin="0,2"
                                           Value="{Binding Light1SpotOuterDeg, Mode=TwoWay}" />
                        </Grid>
                        <Grid ColumnDefinitions="160,*" RowDefinitions="Auto">
                            <TextBlock Grid.Column="0" Text="Area soft (°):" VerticalAlignment="Center"
                                       ToolTip.Tip="Emitter angular radius. 0 = punctual/sharp shadow; larger softens the shadow penumbra (area light). Needs shadows on; forces the CPU relief trace." />
                            <NumericUpDown Grid.Column="1" Minimum="0" Maximum="90" Increment="0.5" FormatString="F1" Margin="0,2"
                                           Value="{Binding Light1Area, Mode=TwoWay}" />
                        </Grid>

                        <!-- Light 2 -->
                        <TextBlock Text="Light 2" FontWeight="Bold" />
                        <Grid ColumnDefinitions="160,*" RowDefinitions="Auto">
                            <TextBlock Grid.Column="0" Text="Type:" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" Margin="0,2"
                                      ItemsSource="{Binding LightTypes}"
                                      SelectedItem="{Binding Light2Type, Mode=TwoWay}" />
                        </Grid>
                        <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,Auto,Auto,Auto"
                              IsVisible="{Binding Light2ShowPositional}">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Position X:" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Row="0" Grid.Column="1" Minimum="-100" Maximum="100" Increment="0.1" FormatString="F2" Margin="0,2"
                                           Value="{Binding Light2PosX, Mode=TwoWay}" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Position Y:" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Row="1" Grid.Column="1" Minimum="-100" Maximum="100" Increment="0.1" FormatString="F2" Margin="0,2"
                                           Value="{Binding Light2PosY, Mode=TwoWay}" />
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Position Z:" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Row="2" Grid.Column="1" Minimum="-100" Maximum="100" Increment="0.1" FormatString="F2" Margin="0,2"
                                           Value="{Binding Light2PosZ, Mode=TwoWay}" />
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Range:" VerticalAlignment="Center"
                                       ToolTip.Tip="Soft cutoff distance in world units. 0 = pure inverse-square (no range window)." />
                            <NumericUpDown Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="100" Increment="0.1" FormatString="F2" Margin="0,2"
                                           Value="{Binding Light2Range, Mode=TwoWay}" />
                        </Grid>
                        <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,Auto"
                              IsVisible="{Binding Light2ShowSpot}">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Cone inner (°):" VerticalAlignment="Center"
                                       ToolTip.Tip="Full intensity inside this half-angle." />
                            <NumericUpDown Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="89" Increment="1" FormatString="F1" Margin="0,2"
                                           Value="{Binding Light2SpotInnerDeg, Mode=TwoWay}" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Cone outer (°):" VerticalAlignment="Center"
                                       ToolTip.Tip="Zero intensity beyond this half-angle. Inner→outer is the soft penumbra." />
                            <NumericUpDown Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="90" Increment="1" FormatString="F1" Margin="0,2"
                                           Value="{Binding Light2SpotOuterDeg, Mode=TwoWay}" />
                        </Grid>
                        <Grid ColumnDefinitions="160,*" RowDefinitions="Auto">
                            <TextBlock Grid.Column="0" Text="Area soft (°):" VerticalAlignment="Center"
                                       ToolTip.Tip="Emitter angular radius. 0 = punctual/sharp shadow; larger softens the shadow penumbra (area light). Needs shadows on; forces the CPU relief trace." />
                            <NumericUpDown Grid.Column="1" Minimum="0" Maximum="90" Increment="0.5" FormatString="F1" Margin="0,2"
                                           Value="{Binding Light2Area, Mode=TwoWay}" />
                        </Grid>

                        <!-- Light 3 -->
                        <TextBlock Text="Light 3" FontWeight="Bold" />
                        <Grid ColumnDefinitions="160,*" RowDefinitions="Auto">
                            <TextBlock Grid.Column="0" Text="Type:" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" Margin="0,2"
                                      ItemsSource="{Binding LightTypes}"
                                      SelectedItem="{Binding Light3Type, Mode=TwoWay}" />
                        </Grid>
                        <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,Auto,Auto,Auto"
                              IsVisible="{Binding Light3ShowPositional}">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Position X:" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Row="0" Grid.Column="1" Minimum="-100" Maximum="100" Increment="0.1" FormatString="F2" Margin="0,2"
                                           Value="{Binding Light3PosX, Mode=TwoWay}" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Position Y:" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Row="1" Grid.Column="1" Minimum="-100" Maximum="100" Increment="0.1" FormatString="F2" Margin="0,2"
                                           Value="{Binding Light3PosY, Mode=TwoWay}" />
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Position Z:" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Row="2" Grid.Column="1" Minimum="-100" Maximum="100" Increment="0.1" FormatString="F2" Margin="0,2"
                                           Value="{Binding Light3PosZ, Mode=TwoWay}" />
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Range:" VerticalAlignment="Center"
                                       ToolTip.Tip="Soft cutoff distance in world units. 0 = pure inverse-square (no range window)." />
                            <NumericUpDown Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="100" Increment="0.1" FormatString="F2" Margin="0,2"
                                           Value="{Binding Light3Range, Mode=TwoWay}" />
                        </Grid>
                        <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,Auto"
                              IsVisible="{Binding Light3ShowSpot}">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Cone inner (°):" VerticalAlignment="Center"
                                       ToolTip.Tip="Full intensity inside this half-angle." />
                            <NumericUpDown Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="89" Increment="1" FormatString="F1" Margin="0,2"
                                           Value="{Binding Light3SpotInnerDeg, Mode=TwoWay}" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Cone outer (°):" VerticalAlignment="Center"
                                       ToolTip.Tip="Zero intensity beyond this half-angle. Inner→outer is the soft penumbra." />
                            <NumericUpDown Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="90" Increment="1" FormatString="F1" Margin="0,2"
                                           Value="{Binding Light3SpotOuterDeg, Mode=TwoWay}" />
                        </Grid>
                        <Grid ColumnDefinitions="160,*" RowDefinitions="Auto">
                            <TextBlock Grid.Column="0" Text="Area soft (°):" VerticalAlignment="Center"
                                       ToolTip.Tip="Emitter angular radius. 0 = punctual/sharp shadow; larger softens the shadow penumbra (area light). Needs shadows on; forces the CPU relief trace." />
                            <NumericUpDown Grid.Column="1" Minimum="0" Maximum="90" Increment="0.5" FormatString="F1" Margin="0,2"
                                           Value="{Binding Light3Area, Mode=TwoWay}" />
                        </Grid>
                    </StackPanel>
                </Expander>

                <!-- Ambient Occlusion -->
                <Expander Header="Ambient Occlusion" HorizontalAlignment="Stretch">
                    <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="DE-AO samples:" VerticalAlignment="Center"
                                   ToolTip.Tip="DE-cone AO (micro-crease detail). 0 = off. 4–8 typical; each sample = one DE eval." />
                        <Grid Grid.Row="0" Grid.Column="1" ColumnDefinitions="*,Auto" Margin="0,2">
                            <Slider Classes="knob" Grid.Column="0" Minimum="0" Maximum="16"
                                    IsSnapToTickEnabled="True" TickFrequency="1"
                                    Value="{Binding AoSamples, Mode=TwoWay}" />
                            <TextBlock Classes="knobValue" Grid.Column="1"
                                       Text="{Binding AoSamples}" />
                        </Grid>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="DE-AO strength:" VerticalAlignment="Center" />
                        <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="*,Auto" Margin="0,2">
                            <Slider Classes="knob" Grid.Column="0" Minimum="0" Maximum="1"
                                    Value="{Binding AoStrength, Mode=TwoWay}" />
                            <TextBlock Classes="knobValue" Grid.Column="1"
                                       Text="{Binding AoStrength, StringFormat='F2'}" />
                        </Grid>

                        <!-- SSAO is a stage-2 screen-space post pass (needs the depth
                             G-buffer). S12.4 (#652): now runs on Relief 3D too (the
                             relief raymarch emits the same normal+depth AOV). DE-cone
                             AO above is shared and stays enabled everywhere. -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="SSAO samples:" VerticalAlignment="Center"
                                   IsEnabled="{Binding ReliefStage2Applies}"
                                   ToolTip.Tip="Screen-space AO (macro neighbor occlusion). Hemisphere sample count. 0 = off. 8–16 typical." />
                        <Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="*,Auto" Margin="0,2"
                              IsEnabled="{Binding ReliefStage2Applies}">
                            <Slider Classes="knob" Grid.Column="0" Minimum="0" Maximum="64"
                                    IsSnapToTickEnabled="True" TickFrequency="1"
                                    Value="{Binding SsaoSamples, Mode=TwoWay}" />
                            <TextBlock Classes="knobValue" Grid.Column="1"
                                       Text="{Binding SsaoSamples}" />
                        </Grid>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="SSAO radius:" VerticalAlignment="Center"
                                   IsEnabled="{Binding ReliefStage2Applies}"
                                   ToolTip.Tip="Hemisphere radius in world units. Smaller = crevice detail; larger = soft global shadow." />
                        <Grid Grid.Row="3" Grid.Column="1" ColumnDefinitions="*,Auto" Margin="0,2"
                              IsEnabled="{Binding ReliefStage2Applies}">
                            <Slider Classes="knob" Grid.Column="0" Minimum="0.001" Maximum="4"
                                    Value="{Binding SsaoRadius, Mode=TwoWay}" />
                            <TextBlock Classes="knobValue" Grid.Column="1"
                                       Text="{Binding SsaoRadius, StringFormat='F3'}" />
                        </Grid>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="SSAO strength:" VerticalAlignment="Center"
                                   IsEnabled="{Binding ReliefStage2Applies}" />
                        <Grid Grid.Row="4" Grid.Column="1" ColumnDefinitions="*,Auto" Margin="0,2"
                              IsEnabled="{Binding ReliefStage2Applies}">
                            <Slider Classes="knob" Grid.Column="0" Minimum="0" Maximum="1"
                                    Value="{Binding SsaoStrength, Mode=TwoWay}" />
                            <TextBlock Classes="knobValue" Grid.Column="1"
                                       Text="{Binding SsaoStrength, StringFormat='F2'}" />
                        </Grid>
                    </Grid>
                </Expander>

                <!-- Shadow -->
                <Expander Header="Shadow" HorizontalAlignment="Stretch">
                    <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,Auto">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Shadow steps:" VerticalAlignment="Center"
                                   ToolTip.Tip="Soft-shadow DE-march count per light. 0 = no shadows. 24–32 typical." />
                        <Grid Grid.Row="0" Grid.Column="1" ColumnDefinitions="*,Auto" Margin="0,2">
                            <Slider Classes="knob" Grid.Column="0" Minimum="0" Maximum="64"
                                    IsSnapToTickEnabled="True" TickFrequency="1"
                                    Value="{Binding ShadowSteps, Mode=TwoWay}" />
                            <TextBlock Classes="knobValue" Grid.Column="1"
                                       Text="{Binding ShadowSteps}" />
                        </Grid>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Softness k:" VerticalAlignment="Center"
                                   ToolTip.Tip="IQ soft-shadow sharpness. Higher = harder edge. 0 = pure hard shadow." />
                        <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="*,Auto" Margin="0,2">
                            <Slider Classes="knob" Grid.Column="0" Minimum="0" Maximum="64"
                                    Value="{Binding ShadowSoftK, Mode=TwoWay}" />
                            <TextBlock Classes="knobValue" Grid.Column="1"
                                       Text="{Binding ShadowSoftK, StringFormat='F1'}" />
                        </Grid>
                    </Grid>
                </Expander>

                <!-- Fog / Volumetric -->
                <Expander Header="Fog / Volumetric" HorizontalAlignment="Stretch">
                  <StackPanel Spacing="6">
                    <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Fog density:" VerticalAlignment="Center"
                                   ToolTip.Tip="Beer–Lambert exponential. 0 = no fog. Scales by ray distance." />
                        <NumericUpDown Grid.Row="0" Grid.Column="1"
                                       Minimum="0" Maximum="2" Increment="0.005" FormatString="F4"
                                       Value="{Binding FogDensity, Mode=TwoWay}" Margin="0,2" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Height falloff:" VerticalAlignment="Center"
                                   ToolTip.Tip="Density scaled by exp(-coef * y). 0 = uniform; higher = fog hugs ground." />
                        <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="*,Auto" Margin="0,2">
                            <Slider Classes="knob" Grid.Column="0" Minimum="0" Maximum="4"
                                    Value="{Binding FogHeightFalloff, Mode=TwoWay}" />
                            <TextBlock Classes="knobValue" Grid.Column="1"
                                       Text="{Binding FogHeightFalloff, StringFormat='F2'}" />
                        </Grid>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Volume steps:" VerticalAlignment="Center"
                                   ToolTip.Tip="In-scatter raymarch step count (light shafts). 0 = exp fog only. Cost = steps × shadow per sample.&#x0a;NOTE: god-ray SHAFTS also need Shadow steps &gt; 0 (Shadow expander) plus a directional key light with terrain to occlude it. With Shadow steps = 0 the fog is a uniform glow, not shafts." />
                        <StackPanel Grid.Row="2" Grid.Column="1">
                            <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                                <Slider Classes="knob" Grid.Column="0" Minimum="0" Maximum="64"
                                        IsSnapToTickEnabled="True" TickFrequency="1"
                                        Value="{Binding VolumeSteps, Mode=TwoWay}" />
                                <TextBlock Classes="knobValue" Grid.Column="1"
                                           Text="{Binding VolumeSteps}" />
                            </Grid>
                            <!-- #309 — advisory: fog is a flat glow until Shadow steps > 0 casts shafts -->
                            <TextBlock Foreground="#FFCC00" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,2"
                                       IsVisible="{Binding ShowVolumeShaftHint}"
                                       Text="Fog is a uniform glow — raise Shadow steps (Shadow expander) above 0 for god-ray shafts." />
                        </StackPanel>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Volume noise:" VerticalAlignment="Center"
                                   ToolTip.Tip="FBM cloud modulation [0,1]. 0 = uniform medium; 1 = cloud-like." />
                        <Grid Grid.Row="3" Grid.Column="1" ColumnDefinitions="*,Auto" Margin="0,2">
                            <Slider Classes="knob" Grid.Column="0" Minimum="0" Maximum="1"
                                    Value="{Binding VolumeNoiseAmount, Mode=TwoWay}" />
                            <TextBlock Classes="knobValue" Grid.Column="1"
                                       Text="{Binding VolumeNoiseAmount, StringFormat='F2'}" />
                        </Grid>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Noise scale:" VerticalAlignment="Center"
                                   ToolTip.Tip="FBM frequency. Higher = finer cloud detail. Default 1.0." />
                        <NumericUpDown Grid.Row="4" Grid.Column="1"
                                       Minimum="0.01" Maximum="100" Increment="0.1" FormatString="F2"
                                       Value="{Binding VolumeNoiseScale, Mode=TwoWay}" Margin="0,2" />

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Noise speed:" VerticalAlignment="Center"
                                   ToolTip.Tip="Cloud drift along (1, 0.3, 0.7). 0 = static. Start/Stop pauses without losing the rate." />
                        <Grid Grid.Row="5" Grid.Column="1" ColumnDefinitions="*,Auto" Margin="0,2">
                            <NumericUpDown Grid.Column="0"
                                           Minimum="-10" Maximum="10" Increment="0.05" FormatString="F3"
                                           Value="{Binding VolumeNoiseSpeed, Mode=TwoWay}" />
                            <Button Grid.Column="1"
                                    Content="{Binding VolumeNoiseToggleLabel}"
                                    Command="{Binding ToggleVolumeNoiseCommand}"
                                    MinWidth="62" Margin="6,0,0,0" />
                        </Grid>

                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Noise octaves:" VerticalAlignment="Center"
                                   ToolTip.Tip="FBM octaves [1..6]. More = finer cloud detail. Default 3 matches Phase 22." />
                        <Grid Grid.Row="6" Grid.Column="1" ColumnDefinitions="*,Auto" Margin="0,2">
                            <Slider Classes="knob" Grid.Column="0" Minimum="1" Maximum="6"
                                    IsSnapToTickEnabled="True" TickFrequency="1"
                                    Value="{Binding VolumeNoiseOctaves, Mode=TwoWay}" />
                            <TextBlock Classes="knobValue" Grid.Column="1"
                                       Text="{Binding VolumeNoiseOctaves}" />
                        </Grid>

                        <TextBlock Grid.Row="7" Grid.Column="0" Text="Self-shadow:" VerticalAlignment="Center"
                                   ToolTip.Tip="Cloud self-shadow strength [0..4]. 0 = off. Produces god-ray banding inside dense clouds." />
                        <Grid Grid.Row="7" Grid.Column="1" ColumnDefinitions="*,Auto" Margin="0,2">
                            <Slider Classes="knob" Grid.Column="0" Minimum="0" Maximum="4"
                                    Value="{Binding VolumeSelfShadow, Mode=TwoWay}" />
                            <TextBlock Classes="knobValue" Grid.Column="1"
                                       Text="{Binding VolumeSelfShadow, StringFormat='F2'}" />
                        </Grid>

                        <TextBlock Grid.Row="8" Grid.Column="0" Text="Self-shadow steps:" VerticalAlignment="Center"
                                   ToolTip.Tip="FBM samples per volume step along light direction [0..16]. Higher = smoother, costlier." />
                        <Grid Grid.Row="8" Grid.Column="1" ColumnDefinitions="*,Auto" Margin="0,2">
                            <Slider Classes="knob" Grid.Column="0" Minimum="0" Maximum="16"
                                    IsSnapToTickEnabled="True" TickFrequency="1"
                                    Value="{Binding VolumeSelfShadowSteps, Mode=TwoWay}" />
                            <TextBlock Classes="knobValue" Grid.Column="1"
                                       Text="{Binding VolumeSelfShadowSteps}" />
                        </Grid>

                        <TextBlock Grid.Row="9" Grid.Column="0" Text="Anisotropy:" VerticalAlignment="Center"
                                   ToolTip.Tip="Henyey-Greenstein phase [-1..1]. 0 = isotropic (even glow). &gt;0 = forward god-ray halo toward the light; &lt;0 = back-scatter halo away from it." />
                        <Grid Grid.Row="9" Grid.Column="1" ColumnDefinitions="*,Auto" Margin="0,2">
                            <Slider Classes="knob" Grid.Column="0" Minimum="-1" Maximum="1"
                                    Value="{Binding VolumeAnisotropy, Mode=TwoWay}" />
                            <TextBlock Classes="knobValue" Grid.Column="1"
                                       Text="{Binding VolumeAnisotropy, StringFormat='F2'}" />
                        </Grid>

                        <TextBlock Grid.Row="10" Grid.Column="0" Text="Fog color:" VerticalAlignment="Center"
                                   ToolTip.Tip="Medium / scattering-albedo tint in AARRGGBB hex, independent of the light colors. FFFFFFFF = no tint (white). Examples: FFFFCC00 = amber haze, FF66CCFF = teal mist." />
                        <TextBox Grid.Row="10" Grid.Column="1"
                                 Text="{Binding FogColorHex, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                 Margin="0,2" />

                        <TextBlock Grid.Row="11" Grid.Column="0" Text="Palette map:" VerticalAlignment="Center"
                                   ToolTip.Tip="Slice D — cross-fade the fog in-scatter toward the active 3D color theme's gradient, keyed by fog optical depth. 0 = off (physically-based fog); 1 = full theme palette. Stylised / non-PBR; the fog picks up the same palette as the fractal surface." />
                        <Grid Grid.Row="11" Grid.Column="1" ColumnDefinitions="*,Auto" Margin="0,2">
                            <Slider Classes="knob" Grid.Column="0" Minimum="0" Maximum="1"
                                    Value="{Binding VolumePaletteStrength, Mode=TwoWay}" />
                            <TextBlock Classes="knobValue" Grid.Column="1"
                                       Text="{Binding VolumePaletteStrength, StringFormat='F2'}" />
                        </Grid>
                    </Grid>

                    <!-- S6 (#408) — per-light fog contribution. Clearing one drops that
                         light from the fog only; surfaces stay lit. -->
                    <TextBlock Text="Lights that colour the fog:" Margin="0,4,0,0"
                               ToolTip.Tip="Which lights contribute to the fog in-scatter. Unchecking a light removes it from the fog only — it still lights surfaces. Applies to both the per-pixel march and the froxel volume." />
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <CheckBox Content="Light 1" IsChecked="{Binding Light1FogsVolume, Mode=TwoWay}" />
                        <CheckBox Content="Light 2" IsChecked="{Binding Light2FogsVolume, Mode=TwoWay}" />
                        <CheckBox Content="Light 3" IsChecked="{Binding Light3FogsVolume, Mode=TwoWay}" />
                    </StackPanel>
                  </StackPanel>
                </Expander>

                <!-- Material -->
                <Expander Header="Material" HorizontalAlignment="Stretch">
                    <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Roughness:" VerticalAlignment="Center"
                                   ToolTip.Tip="GGX roughness. 0 = mirror, 1 = lambert." />
                        <Grid Grid.Row="0" Grid.Column="1" ColumnDefinitions="*,Auto" Margin="0,2">
                            <Slider Classes="knob" Grid.Column="0" Minimum="0" Maximum="1"
                                    Value="{Binding Roughness, Mode=TwoWay}" />
                            <TextBlock Classes="knobValue" Grid.Column="1"
                                       Text="{Binding Roughness, StringFormat='F2'}" />
                        </Grid>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Metallic:" VerticalAlignment="Center"
                                   ToolTip.Tip="0 = dielectric (white spec), 1 = metal (albedo-tinted, no diffuse)." />
                        <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="*,Auto" Margin="0,2">
                            <Slider Classes="knob" Grid.Column="0" Minimum="0" Maximum="1"
                                    Value="{Binding Metallic, Mode=TwoWay}" />
                            <TextBlock Classes="knobValue" Grid.Column="1"
                                       Text="{Binding Metallic, StringFormat='F2'}" />
                        </Grid>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Specular:" VerticalAlignment="Center" />
                        <Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="*,Auto" Margin="0,2">
                            <Slider Classes="knob" Grid.Column="0" Minimum="0" Maximum="4"
                                    Value="{Binding SpecularStrength, Mode=TwoWay}" />
                            <TextBlock Classes="knobValue" Grid.Column="1"
                                       Text="{Binding SpecularStrength, StringFormat='F2'}" />
                        </Grid>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Sub-surface:" VerticalAlignment="Center"
                                   ToolTip.Tip="Translucency. Back-lit lobe via dot(-L,V) * exp(-distInside * k)." />
                        <Grid Grid.Row="3" Grid.Column="1" ColumnDefinitions="*,Auto" Margin="0,2">
                            <Slider Classes="knob" Grid.Column="0" Minimum="0" Maximum="1"
                                    Value="{Binding SubSurfaceStrength, Mode=TwoWay}" />
                            <TextBlock Classes="knobValue" Grid.Column="1"
                                       Text="{Binding SubSurfaceStrength, StringFormat='F2'}" />
                        </Grid>

                        <!-- Glass / refraction (roadmap S5, #389). -->
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Transmission:" VerticalAlignment="Center"
                                   ToolTip.Tip="Glass transparency. 0 = opaque; 1 = fully see-through (refracts the environment). Forces the CPU relief trace when > 0." />
                        <Grid Grid.Row="4" Grid.Column="1" ColumnDefinitions="*,Auto" Margin="0,2">
                            <Slider Classes="knob" Grid.Column="0" Minimum="0" Maximum="1"
                                    Value="{Binding Transmission, Mode=TwoWay}" />
                            <TextBlock Classes="knobValue" Grid.Column="1"
                                       Text="{Binding Transmission, StringFormat='F2'}" />
                        </Grid>

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="IOR:" VerticalAlignment="Center"
                                   IsEnabled="{Binding GlassEnabled}"
                                   ToolTip.Tip="Index of refraction. 1.5 = glass, 1.33 = water, 2.4 = diamond. Bends the refracted background." />
                        <Grid Grid.Row="5" Grid.Column="1" ColumnDefinitions="*,Auto" Margin="0,2" IsEnabled="{Binding GlassEnabled}">
                            <Slider Classes="knob" Grid.Column="0" Minimum="1" Maximum="3"
                                    Value="{Binding Ior, Mode=TwoWay}" />
                            <TextBlock Classes="knobValue" Grid.Column="1"
                                       Text="{Binding Ior, StringFormat='F2'}" />
                        </Grid>

                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Absorption dist:" VerticalAlignment="Center"
                                   IsEnabled="{Binding GlassEnabled}"
                                   ToolTip.Tip="Beer-Lambert reference distance for the glass tint (Absorption color). Smaller = stronger tint." />
                        <Grid Grid.Row="6" Grid.Column="1" ColumnDefinitions="*,Auto" Margin="0,2" IsEnabled="{Binding GlassEnabled}">
                            <Slider Classes="knob" Grid.Column="0" Minimum="0.01" Maximum="10"
                                    Value="{Binding AbsorptionDistance, Mode=TwoWay}" />
                            <TextBlock Classes="knobValue" Grid.Column="1"
                                       Text="{Binding AbsorptionDistance, StringFormat='F2'}" />
                        </Grid>

                        <TextBlock Grid.Row="7" Grid.Column="0" Text="Absorption color:" VerticalAlignment="Center"
                                   IsEnabled="{Binding GlassEnabled}"
                                   ToolTip.Tip="Glass tint as it thickens (Beer-Lambert). Hex #AARRGGBB (or #RRGGBB). White = clear glass; e.g. #FF66CCFF = pale blue. The transmitted colour is what SURVIVES one absorption distance, so the tint the glass shows is the inverse." />
                        <TextBox Grid.Row="7" Grid.Column="1" Margin="0,2"
                                 IsEnabled="{Binding GlassEnabled}"
                                 Text="{Binding AbsorptionColorHex, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />

                        <TextBlock Grid.Row="8" Grid.Column="0" Text="Internal march:" VerticalAlignment="Center"
                                   IsEnabled="{Binding GlassEnabled}"
                                   ToolTip.Tip="Full two-surface glass: march through the solid to the back surface so the tint (Absorption) builds over the REAL thickness — thick parts go darker / more saturated — and the see-through view is refracted a second time on exit. Off = the cheap single-interface approximation (a fixed one-unit slab). Only used when Transmission > 0; forces the CPU trace." />
                        <CheckBox Grid.Row="8" Grid.Column="1" IsChecked="{Binding RefractInternalMarch, Mode=TwoWay}"
                                  IsEnabled="{Binding GlassEnabled}"
                                  Content="march through the solid (real thickness)" Margin="0,2" />
                    </Grid>
                </Expander>

                <!-- Sky / Environment -->
                <Expander Header="Sky / Environment" HorizontalAlignment="Stretch">
                    <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,Auto,Auto,Auto">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Sky mode:" VerticalAlignment="Center" />
                        <ComboBox  Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch"
                                   ItemsSource="{Binding SkyModes}"
                                   SelectedItem="{Binding SkyMode, Mode=TwoWay}" Margin="0,2" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="HDRI preset / file:" VerticalAlignment="Center"
                                   ToolTip.Tip="Built-in preset name (Studio/Sunset/Overcast/Void) OR absolute path to a .hdr / .pic / .exr file. Browse… picks a file." />
                        <Grid Grid.Row="1" Grid.Column="1" Margin="0,2"
                              ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                            <TextBox Grid.Row="0" Grid.Column="0"
                                     Text="{Binding EnvironmentName, Mode=TwoWay}" />
                            <Button Grid.Row="0" Grid.Column="1" Content="Browse…" Margin="4,0,0,0"
                                    Click="OnBrowseHdriClick"
                                    ToolTip.Tip="Pick a .hdr / .pic / .exr file. Eagerly loads + caches so missing files surface a status message immediately." />
                            <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                       x:Name="HdriStatus" Margin="0,2,0,0" FontSize="11" />
                        </Grid>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="IBL strength:" VerticalAlignment="Center" />
                        <Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="*,Auto" Margin="0,2">
                            <Slider Classes="knob" Grid.Column="0" Minimum="0" Maximum="1"
                                    Value="{Binding IblStrength, Mode=TwoWay}" />
                            <TextBlock Classes="knobValue" Grid.Column="1"
                                       Text="{Binding IblStrength, StringFormat='F2'}" />
                        </Grid>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Show backdrop:" VerticalAlignment="Center"
                                   ToolTip.Tip="On: HDRI / gradient sky renders behind the fractal. Off: ray-miss pixels stay at the colormap's InSetColor — IBL still contributes to surface lighting but the photographic backdrop is hidden." />
                        <CheckBox Grid.Row="3" Grid.Column="1"
                                  IsChecked="{Binding ShowSkyBackdrop, Mode=TwoWay}" Margin="0,2" />
                    </Grid>
                </Expander>

                <!-- Tone Map / Bloom apply on 3D AND Relief 3D (S12.1, #652 — relief runs
                     ScreenSpacePost.ApplyToneMapBloom over its captured HDR beauty). Lens
                     / Lens / SSAO / Edge below now apply on Relief too (S12.1-4, #652). -->
                <Expander Header="Tone Map / Bloom / Lens" HorizontalAlignment="Stretch">
                    <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                          IsEnabled="{Binding ReliefStage2Applies}">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Tone map:" VerticalAlignment="Center" />
                        <ComboBox  Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch"
                                   ItemsSource="{Binding ToneMapOperators}"
                                   SelectedItem="{Binding ToneMap, Mode=TwoWay}" Margin="0,2" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Exposure:" VerticalAlignment="Center" />
                        <NumericUpDown Grid.Row="1" Grid.Column="1"
                                       Minimum="0.0625" Maximum="16" Increment="0.05" FormatString="F2"
                                       Value="{Binding Exposure, Mode=TwoWay}" Margin="0,2" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Bloom threshold:" VerticalAlignment="Center" />
                        <Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="*,Auto" Margin="0,2">
                            <Slider Classes="knob" Grid.Column="0" Minimum="0" Maximum="20"
                                    Value="{Binding BloomThreshold, Mode=TwoWay}" />
                            <TextBlock Classes="knobValue" Grid.Column="1"
                                       Text="{Binding BloomThreshold, StringFormat='F2'}" />
                        </Grid>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Bloom strength:" VerticalAlignment="Center" />
                        <Grid Grid.Row="3" Grid.Column="1" ColumnDefinitions="*,Auto" Margin="0,2">
                            <Slider Classes="knob" Grid.Column="0" Minimum="0" Maximum="1"
                                    Value="{Binding BloomStrength, Mode=TwoWay}" />
                            <TextBlock Classes="knobValue" Grid.Column="1"
                                       Text="{Binding BloomStrength, StringFormat='F2'}" />
                        </Grid>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Chromatic ab.:" VerticalAlignment="Center"
                                   ToolTip.Tip="Radial RGB channel offset (pixels). 0 = off." />
                        <Grid Grid.Row="4" Grid.Column="1" ColumnDefinitions="*,Auto" Margin="0,2">
                            <Slider Classes="knob" Grid.Column="0" Minimum="0" Maximum="16"
                                    Value="{Binding ChromaticAberration, Mode=TwoWay}" IsEnabled="{Binding ReliefStage2Applies}" />
                            <TextBlock Classes="knobValue" Grid.Column="1"
                                       Text="{Binding ChromaticAberration, StringFormat='F2'}" />
                        </Grid>

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Lens distortion:" VerticalAlignment="Center"
                                   ToolTip.Tip="Barrel (positive) / pincushion (negative). 0 = none." />
                        <Grid Grid.Row="5" Grid.Column="1" ColumnDefinitions="*,Auto" Margin="0,2">
                            <Slider Classes="knob" Grid.Column="0" Minimum="-0.5" Maximum="0.5"
                                    Value="{Binding LensDistortion, Mode=TwoWay}" IsEnabled="{Binding ReliefStage2Applies}" />
                            <TextBlock Classes="knobValue" Grid.Column="1"
                                       Text="{Binding LensDistortion, StringFormat='F3'}" />
                        </Grid>

                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Vignette:" VerticalAlignment="Center"
                                   ToolTip.Tip="Corner falloff [0..1]. 0 = uniform. Applied after lens warp." />
                        <Grid Grid.Row="6" Grid.Column="1" ColumnDefinitions="*,Auto" Margin="0,2">
                            <Slider Classes="knob" Grid.Column="0" Minimum="0" Maximum="1"
                                    Value="{Binding Vignette, Mode=TwoWay}" IsEnabled="{Binding ReliefStage2Applies}" />
                            <TextBlock Classes="knobValue" Grid.Column="1"
                                       Text="{Binding Vignette, StringFormat='F2'}" />
                        </Grid>

                        <TextBlock Grid.Row="7" Grid.Column="0" Text="Tangential p1:" VerticalAlignment="Center"
                                   ToolTip.Tip="Brown decentring p1 (X coefficient). Simulates lens shift." />
                        <NumericUpDown Grid.Row="7" Grid.Column="1"
                                       Minimum="-0.1" Maximum="0.1" Increment="0.005" FormatString="F4"
                                       Value="{Binding LensTangentialX, Mode=TwoWay}" Margin="0,2" IsEnabled="{Binding ReliefStage2Applies}" />

                        <TextBlock Grid.Row="8" Grid.Column="0" Text="Tangential p2:" VerticalAlignment="Center"
                                   ToolTip.Tip="Brown decentring p2 (Y coefficient). Simulates lens shift." />
                        <NumericUpDown Grid.Row="8" Grid.Column="1"
                                       Minimum="-0.1" Maximum="0.1" Increment="0.005" FormatString="F4"
                                       Value="{Binding LensTangentialY, Mode=TwoWay}" Margin="0,2" IsEnabled="{Binding ReliefStage2Applies}" />

                        <TextBlock Grid.Row="9" Grid.Column="0" Text="Anamorphic squeeze:" VerticalAlignment="Center"
                                   ToolTip.Tip="Vertical-to-horizontal aspect ratio [0.25..4]. 1 = isotropic. >1 = scope/wide look." />
                        <Grid Grid.Row="9" Grid.Column="1" ColumnDefinitions="*,Auto" Margin="0,2">
                            <Slider Classes="knob" Grid.Column="0" Minimum="0.25" Maximum="4"
                                    Value="{Binding AnamorphicSqueeze, Mode=TwoWay}" IsEnabled="{Binding ReliefStage2Applies}" />
                            <TextBlock Classes="knobValue" Grid.Column="1"
                                       Text="{Binding AnamorphicSqueeze, StringFormat='F2'}" />
                        </Grid>
                    </Grid>
                </Expander>

                <!-- Reflection / Edge / Stereo / DoF -->
                <Expander Header="Reflection / Edge / Stereo / DoF" HorizontalAlignment="Stretch">
                    <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Reflection:" VerticalAlignment="Center"
                                   ToolTip.Tip="N-bounce DE-march along reflect(V,N). 0 = off." />
                        <Grid Grid.Row="0" Grid.Column="1" ColumnDefinitions="*,Auto" Margin="0,2">
                            <Slider Classes="knob" Grid.Column="0" Minimum="0" Maximum="1"
                                    Value="{Binding ReflectionStrength, Mode=TwoWay}" />
                            <TextBlock Classes="knobValue" Grid.Column="1"
                                       Text="{Binding ReflectionStrength, StringFormat='F2'}" />
                        </Grid>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Reflection steps:" VerticalAlignment="Center" />
                        <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="*,Auto" Margin="0,2">
                            <Slider Classes="knob" Grid.Column="0" Minimum="0" Maximum="64"
                                    IsSnapToTickEnabled="True" TickFrequency="1"
                                    Value="{Binding ReflectionSteps, Mode=TwoWay}" />
                            <TextBlock Classes="knobValue" Grid.Column="1"
                                       Text="{Binding ReflectionSteps}" />
                        </Grid>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Bounces:" VerticalAlignment="Center"
                                   ToolTip.Tip="Recursive reflection chain depth (Phase 16b). 1 = single bounce (legacy). Up to 6 for chrome / hall-of-mirrors. Linear cost per bounce." />
                        <Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="*,Auto" Margin="0,2">
                            <Slider Classes="knob" Grid.Column="0" Minimum="1" Maximum="6"
                                    IsSnapToTickEnabled="True" TickFrequency="1"
                                    Value="{Binding MaxBounces, Mode=TwoWay}" />
                            <TextBlock Classes="knobValue" Grid.Column="1"
                                       Text="{Binding MaxBounces}" />
                        </Grid>

                        <!-- Edge ink now runs on Relief 3D too (S12.3, #652, over the relief
                             normal+depth G-buffer). Stereo + DoF stay 3D-fractal only
                             (Relief has its own Relief2DDof* knobs). Reflection above IS shared. -->
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Edge contour:" VerticalAlignment="Center"
                                   IsEnabled="{Binding ReliefStage2Applies}"
                                   ToolTip.Tip="Sobel-on-normal ink overlay. 0 = off." />
                        <Grid Grid.Row="3" Grid.Column="1" ColumnDefinitions="*,Auto" Margin="0,2"
                              IsEnabled="{Binding ReliefStage2Applies}">
                            <Slider Classes="knob" Grid.Column="0" Minimum="0" Maximum="1"
                                    Value="{Binding EdgeStrength, Mode=TwoWay}" />
                            <TextBlock Classes="knobValue" Grid.Column="1"
                                       Text="{Binding EdgeStrength, StringFormat='F2'}" />
                        </Grid>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Edge threshold:" VerticalAlignment="Center"
                                   IsEnabled="{Binding ReliefStage2Applies}"
                                   ToolTip.Tip="Sobel magnitude below which no ink is drawn (0..2.83). Default 0.4." />
                        <Grid Grid.Row="4" Grid.Column="1" ColumnDefinitions="*,Auto" Margin="0,2"
                              IsEnabled="{Binding ReliefStage2Applies}">
                            <Slider Classes="knob" Grid.Column="0" Minimum="0" Maximum="2.83"
                                    Value="{Binding EdgeThreshold, Mode=TwoWay}" />
                            <TextBlock Classes="knobValue" Grid.Column="1"
                                       Text="{Binding EdgeThreshold, StringFormat='F2'}" />
                        </Grid>

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Edge kernel:" VerticalAlignment="Center"
                                   IsEnabled="{Binding ReliefStage2Applies}"
                                   ToolTip.Tip="Sobel = fast, isotropic-ish. FreiChen = 9-tap edge subspace, more uniform on diagonals." />
                        <ComboBox Grid.Row="5" Grid.Column="1" HorizontalAlignment="Stretch"
                                  IsEnabled="{Binding ReliefStage2Applies}"
                                  ItemsSource="{Binding EdgeKernels}"
                                  SelectedItem="{Binding EdgeKernel, Mode=TwoWay}"
                                  Margin="0,2" />

                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Edge color (BGRA hex):" VerticalAlignment="Center"
                                   IsEnabled="{Binding ReliefStage2Applies}"
                                   ToolTip.Tip="Ink color in AARRGGBB hex (FF000000 = opaque black, FFFFCC00 = colorblind-safe yellow)." />
                        <TextBox Grid.Row="6" Grid.Column="1"
                                 IsEnabled="{Binding ReliefStage2Applies}"
                                 Text="{Binding EdgeColorHex, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                 Margin="0,2" />

                        <TextBlock Grid.Row="7" Grid.Column="0" Text="Stereo mode:" VerticalAlignment="Center"
                                   IsEnabled="{Binding Stage2PostFxApplies}"
                                   ToolTip.Tip="Off = mono. Fake = single render + depth-parallax warp (cheap). True = two real per-eye renders (Phase 20b — 2x cost, real parallax on close objects). 3D-fractal only — not wired for Relief 3D." />
                        <ComboBox Grid.Row="7" Grid.Column="1" HorizontalAlignment="Stretch"
                                  IsEnabled="{Binding Stage2PostFxApplies}"
                                  ItemsSource="{Binding StereoModes}"
                                  SelectedItem="{Binding StereoMode, Mode=TwoWay}"
                                  Margin="0,2" />

                        <TextBlock Grid.Row="8" Grid.Column="0" Text="Stereo eye sep:" VerticalAlignment="Center"
                                   IsEnabled="{Binding Stage2PostFxApplies}"
                                   ToolTip.Tip="Side-by-side stereo IPD in world units. 0 = mono. Doubles output width." />
                        <NumericUpDown Grid.Row="8" Grid.Column="1"
                                       IsEnabled="{Binding Stage2PostFxApplies}"
                                       Minimum="0" Maximum="0.25" Increment="0.005" FormatString="F4"
                                       Value="{Binding StereoEyeSeparation, Mode=TwoWay}" Margin="0,2" />

                        <TextBlock Grid.Row="9" Grid.Column="0" Text="Stereo FOV°:" VerticalAlignment="Center"
                                   IsEnabled="{Binding Stage2PostFxApplies}"
                                   ToolTip.Tip="Per-eye horizontal field-of-view in degrees. Default 60°. Used only when eye-sep > 0." />
                        <Grid Grid.Row="9" Grid.Column="1" ColumnDefinitions="*,Auto" Margin="0,2"
                              IsEnabled="{Binding Stage2PostFxApplies}">
                            <Slider Classes="knob" Grid.Column="0" Minimum="20" Maximum="120"
                                    IsSnapToTickEnabled="True" TickFrequency="1"
                                    Value="{Binding StereoFovDegrees, Mode=TwoWay}" />
                            <TextBlock Classes="knobValue" Grid.Column="1"
                                       Text="{Binding StereoFovDegrees, StringFormat='F1'}" />
                        </Grid>

                        <TextBlock Grid.Row="10" Grid.Column="0" Text="Stereo convergence:" VerticalAlignment="Center"
                                   IsEnabled="{Binding Stage2PostFxApplies}"
                                   ToolTip.Tip="Zero-parallax plane via horizontal image translation, as a fraction of eye width. 0 = parallel (whole scene behind the screen). Positive = pull the subject toward the screen plane so nearer detail floats in front. Typical +/-0.05." />
                        <Grid Grid.Row="10" Grid.Column="1" ColumnDefinitions="*,Auto" Margin="0,2"
                              IsEnabled="{Binding Stage2PostFxApplies}">
                            <Slider Classes="knob" Grid.Column="0" Minimum="-0.2" Maximum="0.2"
                                    Value="{Binding StereoConvergence, Mode=TwoWay}" />
                            <TextBlock Classes="knobValue" Grid.Column="1"
                                       Text="{Binding StereoConvergence, StringFormat='F3'}" />
                        </Grid>

                        <TextBlock Grid.Row="11" Grid.Column="0" Text="Max disparity:" VerticalAlignment="Center"
                                   IsEnabled="{Binding Stage2PostFxApplies}"
                                   ToolTip.Tip="Parallax comfort guard — largest on-screen eye-to-eye disparity, as a fraction of width. Caps the Fake-warp shift so near hits stay fusable (no divergence / eye strain). Default 0.03 (1/30 rule). 0 = off." />
                        <Grid Grid.Row="11" Grid.Column="1" ColumnDefinitions="*,Auto" Margin="0,2"
                              IsEnabled="{Binding Stage2PostFxApplies}">
                            <Slider Classes="knob" Grid.Column="0" Minimum="0" Maximum="0.15"
                                    Value="{Binding StereoMaxDisparity, Mode=TwoWay}" />
                            <TextBlock Classes="knobValue" Grid.Column="1"
                                       Text="{Binding StereoMaxDisparity, StringFormat='F3'}" />
                        </Grid>

                        <TextBlock Grid.Row="12" Grid.Column="0" Text="DoF aperture:" VerticalAlignment="Center"
                                   IsEnabled="{Binding Stage2PostFxApplies}"
                                   ToolTip.Tip="Hex bokeh radius (world units). 0 = pinhole. 3D-fractal only — Relief 3D has its own DoF on the Relief 3D dialog (aperture / focus)." />
                        <Grid Grid.Row="12" Grid.Column="1" ColumnDefinitions="*,Auto" Margin="0,2"
                              IsEnabled="{Binding Stage2PostFxApplies}">
                            <Slider Classes="knob" Grid.Column="0" Minimum="0" Maximum="0.5"
                                    Value="{Binding DofAperture, Mode=TwoWay}" />
                            <TextBlock Classes="knobValue" Grid.Column="1"
                                       Text="{Binding DofAperture, StringFormat='F3'}" />
                        </Grid>

                        <TextBlock Grid.Row="13" Grid.Column="0" Text="DoF focus dist:" VerticalAlignment="Center"
                                   IsEnabled="{Binding Stage2PostFxApplies}" />
                        <NumericUpDown Grid.Row="13" Grid.Column="1"
                                       IsEnabled="{Binding Stage2PostFxApplies}"
                                       Minimum="0.1" Maximum="100" Increment="0.1" FormatString="F2"
                                       Value="{Binding DofFocusDistance, Mode=TwoWay}" Margin="0,2" />

                        <TextBlock Grid.Row="14" Grid.Column="0" Text="DoF samples:" VerticalAlignment="Center"
                                   IsEnabled="{Binding Stage2PostFxApplies}" />
                        <Grid Grid.Row="14" Grid.Column="1" ColumnDefinitions="*,Auto" Margin="0,2"
                              IsEnabled="{Binding Stage2PostFxApplies}">
                            <Slider Classes="knob" Grid.Column="0" Minimum="1" Maximum="32"
                                    IsSnapToTickEnabled="True" TickFrequency="1"
                                    Value="{Binding DofSamples, Mode=TwoWay}" />
                            <TextBlock Classes="knobValue" Grid.Column="1"
                                       Text="{Binding DofSamples}" />
                        </Grid>

                        <TextBlock Grid.Row="15" Grid.Column="0" Text="Thin-lens DoF:" VerticalAlignment="Center"
                                   IsEnabled="{Binding Stage2PostFxApplies}"
                                   ToolTip.Tip="Physically-based depth of field for the 3D-fractal raymarch camera: averages 'DoF samples' primary rays across the aperture disc, re-aimed through the focal point, so occluded geometry and silhouettes blur correctly (real bokeh) — instead of the screen-space depth gather. Uses the same aperture / focus / samples above. Off keeps the screen-space blur; aperture 0 is pinhole either way. (SSAO / edge-ink are bypassed while thin-lens is on.)" />
                        <CheckBox Grid.Row="15" Grid.Column="1" IsChecked="{Binding DofThinLens, Mode=TwoWay}"
                                  IsEnabled="{Binding Stage2PostFxApplies}"
                                  Content="physically-based lens (real bokeh)" Margin="0,2" />

                        <TextBlock Grid.Row="16" Grid.Column="0" Text="Stereo layout:" VerticalAlignment="Center"
                                   IsEnabled="{Binding Stage2PostFxApplies}"
                                   ToolTip.Tip="FullSbs = each eye full width (2W x H). HalfSbs = each eye squeezed to W/2 (W x H, anamorphic) — mono dimensions, smaller files; the 3D TV / VR player un-squeezes per eye. Used only when Stereo mode is on." />
                        <ComboBox Grid.Row="16" Grid.Column="1" HorizontalAlignment="Stretch"
                                  IsEnabled="{Binding Stage2PostFxApplies}"
                                  ItemsSource="{Binding StereoLayouts}"
                                  SelectedItem="{Binding StereoLayout, Mode=TwoWay}"
                                  Margin="0,2" />
                    </Grid>
                </Expander>

                <!-- Triplanar Material -->
                <Expander Header="Triplanar Material" HorizontalAlignment="Stretch">
                    <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,Auto,Auto,Auto">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Pattern:" VerticalAlignment="Center"
                                   ToolTip.Tip="World-space projected pattern blended with the calculator's albedo. None = off." />
                        <ComboBox Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch"
                                  ItemsSource="{Binding TriplanarKinds}"
                                  SelectedItem="{Binding TriplanarKind, Mode=TwoWay}"
                                  Margin="0,2" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Scale:" VerticalAlignment="Center"
                                   ToolTip.Tip="Pattern frequency. Higher = finer detail." />
                        <NumericUpDown Grid.Row="1" Grid.Column="1"
                                       Minimum="0.01" Maximum="100" Increment="0.1" FormatString="F2"
                                       Value="{Binding TriplanarScale, Mode=TwoWay}" Margin="0,2" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Strength:" VerticalAlignment="Center"
                                   ToolTip.Tip="Blend weight against base albedo. 0 = bypass, 1 = full pattern." />
                        <Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="*,Auto" Margin="0,2">
                            <Slider Classes="knob" Grid.Column="0" Minimum="0" Maximum="1"
                                    Value="{Binding TriplanarStrength, Mode=TwoWay}" />
                            <TextBlock Classes="knobValue" Grid.Column="1"
                                       Text="{Binding TriplanarStrength, StringFormat='F2'}" />
                        </Grid>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Tint (BGRA hex):" VerticalAlignment="Center"
                                   ToolTip.Tip="AARRGGBB tint hex multiplied with the pattern. FFFFFFFF = no tint. Examples: FFFFCC00 = colorblind-safe yellow." />
                        <TextBox Grid.Row="3" Grid.Column="1"
                                 Text="{Binding TriplanarTintHex, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                 Margin="0,2" />
                    </Grid>
                </Expander>

                <!-- Debug HUD -->
                <Expander Header="Debug HUD" HorizontalAlignment="Stretch">
                    <StackPanel Spacing="4" Margin="6,4,0,4">
                        <!-- #317 — AOV / render-buffer view mode -->
                        <Grid ColumnDefinitions="120,*" Margin="0,0,0,4">
                            <TextBlock Grid.Column="0" Text="View (AOV):" VerticalAlignment="Center"
                                       ToolTip.Tip="Isolate a render buffer instead of the beauty pass: Normals, Depth, StepCount (raymarch cost heat), AmbientOcclusion, Diffuse, Specular, Shadow. Beauty = normal output. CPU raymarchers + Relief 3D (forces the CPU path); sky pixels keep the background." />
                            <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding AovViews}"
                                      SelectedItem="{Binding DebugAov, Mode=TwoWay}" />
                        </Grid>
                        <CheckBox Content="Light-direction compass"
                                  IsChecked="{Binding DebugHudCompass, Mode=TwoWay}"
                                  ToolTip.Tip="Top-right compass showing L1/L2/L3 azimuth + elevation. Pure visual, no text." />
                        <CheckBox Content="Parameter bars"
                                  IsChecked="{Binding DebugHudBars, Mode=TwoWay}"
                                  ToolTip.Tip="Bottom-left bars: Ambient / AO / Fog / Reflection / Caustics." />
                        <CheckBox Content="Scene-time clock"
                                  IsChecked="{Binding DebugHudClock, Mode=TwoWay}"
                                  ToolTip.Tip="Top-left rotating dial that visualises SceneTime advance." />
                        <CheckBox Content="Composition guides"
                                  IsChecked="{Binding DebugHudGuides, Mode=TwoWay}"
                                  ToolTip.Tip="Rule-of-thirds grid + center cross + title-safe frame. Framing aid for stills / posters." />
                        <CheckBox Content="Clipping zebra"
                                  IsChecked="{Binding DebugHudZebra, Mode=TwoWay}"
                                  ToolTip.Tip="Diagonal stripes on blown highlights (yellow) and crushed shadows (blue) — a quick over/under-exposure check for the tone-map / exposure / bloom knobs." />
                        <CheckBox Content="Light gauge + shaft readiness"
                                  IsChecked="{Binding DebugHudLightGauge, Mode=TwoWay}"
                                  ToolTip.Tip="Bottom-right: side-on elevation of each light (overhead=top, horizon=middle). The lamp turns yellow when the key light is raking AND fog + volume steps + shadow steps are on — i.e. god-ray shafts will actually render (not a flat glow)." />
                        <CheckBox Content="Lookdev reference balls"
                                  IsChecked="{Binding DebugHudReferenceBalls, Mode=TwoWay}"
                                  ToolTip.Tip="Left edge: an 18%-grey matte ball and a chrome ball, lit by your current lights + IBL/sky. Read light direction, colour and reflections at a glance (the classic lookdev reference spheres)." />
                        <CheckBox Content="Exposure false-color"
                                  IsChecked="{Binding DebugHudFalseColor, Mode=TwoWay}"
                                  ToolTip.Tip="Full-frame exposure zones: blue = crushed shadows, cyan/grey = midtones (grey band ≈ 18%), yellow = near clip, white = blown. Colorblind-safe (blue↔yellow, no red/green)." />
                        <CheckBox Content="Luma histogram"
                                  IsChecked="{Binding DebugHudHistogram, Mode=TwoWay}"
                                  ToolTip.Tip="Bottom-center luma distribution (log-scaled). Yellow edge bars flag energy piled at pure black / pure white (clipping)." />
                        <CheckBox Content="Numeric telemetry"
                                  IsChecked="{Binding DebugHudTelemetry, Mode=TwoWay}"
                                  ToolTip.Tip="Top-left text panel: resolution, active-light count, fog optical depth, supersample, active AOV view, and frame-time/FPS. Uses a bitmap font baked into the frame, so it survives PNG / video export (unlike the on-screen perf HUD)." />
                    </StackPanel>
                </Expander>

            </StackPanel>
        </ScrollViewer>

        <!-- Defaults + Close -->
        <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" Margin="0,12,0,0">
            <!-- #305 — two-click reset to LightingFxData.CreateDefault(). First
                 click arms (label flips + turns yellow), second click applies. -->
            <Button Grid.Column="0"
                    Content="{Binding LightingResetLabel}"
                    Classes.armed="{Binding LightingResetArmed}"
                    Command="{Binding ResetLightingCommand}"
                    Padding="14,6"
                    Background="#464646"
                    Foreground="White"
                    ToolTip.Tip="Reset every Lighting &amp; FX knob to sane defaults. Click once to arm, again to confirm (destructive of your in-session tuning)." />
            <Button Grid.Column="2"
                    Content="Close"
                    Click="OnCloseClick"
                    IsCancel="True"
                    Padding="18,6"
                    Background="#464646"
                    Foreground="White" />
        </Grid>
    </Grid>
</UserControl>

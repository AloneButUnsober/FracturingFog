<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FracturingFog.UI.Avalonia.ViewModels"
        x:Class="FracturingFog.UI.Avalonia.Views.UserEquationView"
        x:DataType="vm:UserEquationViewModel"
        Title="User Equation"
        Width="640"
        Height="540"
        MinWidth="460"
        MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#282828"
        Foreground="White">

    <!-- Ctrl+. mimics Visual Studio's "Quick Actions" shortcut. Bound at the
         Window so the user does not need focus on the button to apply the
         current suggestion. -->
    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+OemPeriod" Command="{Binding ApplyFixCommand}" />
    </Window.KeyBindings>

    <!--
      Header (saved/save/delete/promote/compile/generate + rotation) sits
      ABOVE a TabControl that splits the two equation editors:
        Tab 0  User Equation  — C#-style source (Roslyn live-compile)
        Tab 1  DSL            — bare CalcGen DSL (validate-on-type, no live render)
      Save/Compile/Generate route by the currently active tab via the VM.
    -->
    <Grid Margin="12" RowDefinitions="Auto,Auto,Auto,*,Auto">

        <!-- Row 0: saved equations row -->
        <Grid Grid.Row="0"
              ColumnDefinitions="Auto,*,Auto,Auto"
              Margin="0,0,0,6">
            <TextBlock Grid.Column="0" Text="Saved:" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding SavedNames}"
                      SelectedItem="{Binding SelectedSavedName, Mode=TwoWay}"
                      HorizontalAlignment="Stretch"
                      MinWidth="160" />
            <Button Grid.Column="2"
                    Content="Save…"
                    Command="{Binding SaveCommand}"
                    Margin="8,0,0,0"
                    Padding="14,4" />
            <Button Grid.Column="3"
                    Content="Delete"
                    Command="{Binding DeleteCommand}"
                    Margin="6,0,0,0"
                    Padding="14,4" />
        </Grid>

        <!-- Row 1: promote toggle + Compile & Load + Compile + Save + Generate via CalcGen + Equation Guide + CalcGen Help -->
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto" Margin="0,0,0,6">
            <CheckBox Grid.Column="0"
                      Content="Promote to fractal list"
                      IsChecked="{Binding Promote, Mode=TwoWay}"
                      IsEnabled="{Binding PromoteEnabled}" />
            <Button Grid.Column="1"
                    Content="Compile &amp; Load"
                    Command="{Binding HotLoadViaCalcGenCommand}"
                    ToolTip.Tip="Generate, Roslyn-compile, and load the active tab's equation as a hot calculator. No rebuild required — replaces the active calc immediately."
                    Margin="0,0,6,0"
                    Padding="14,4" />
            <Button Grid.Column="2"
                    Content="Compile + Save"
                    Command="{Binding HotLoadAndPersistCommand}"
                    ToolTip.Tip="Same as Compile &amp; Load, but also writes the generated source under %LOCALAPPDATA%/FracturingFog/UserCalculators/. The calculator is re-loaded automatically on next launch."
                    Margin="0,0,6,0"
                    Padding="14,4" />
            <Button Grid.Column="3"
                    Content="Generate via CalcGen"
                    Command="{Binding GenerateViaCalcGenCommand}"
                    ToolTip.Tip="Run the active tab's equation through CalculatorGen and write a generated calculator to Calculators/Generated/. Rebuild the app to pick it up."
                    Padding="14,4" />
            <Button Grid.Column="4"
                    Content="Equation Guide"
                    Command="{Binding OpenEquationGuideCommand}"
                    ToolTip.Tip="Open the Fractal Equation Design Guide — how equations work, what to change for which result, extensive worked examples across every CalcGen-supported family."
                    Margin="6,0,0,0"
                    Padding="10,4" />
            <Button Grid.Column="5"
                    Content="CalcGen Help"
                    Command="{Binding OpenCalcGenHelpCommand}"
                    ToolTip.Tip="Open the CalcGen User Guide — grammar, operators, examples, gating rules."
                    Margin="6,0,0,0"
                    Padding="10,4" />
        </Grid>

        <!-- Row 2: rotation row -->
        <Grid Grid.Row="2"
              ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*"
              Margin="0,0,0,8">
            <TextBlock Grid.Column="0" Text="Rotation°:" VerticalAlignment="Center" Margin="0,0,8,0" />
            <NumericUpDown Grid.Column="1"
                           Minimum="-360" Maximum="360" Increment="1" FormatString="F1"
                           Value="{Binding RotationDegrees, Mode=TwoWay}"
                           Width="100" />
            <Button Grid.Column="2" Content="+90°" Command="{Binding RotPlus90Command}"  Margin="6,0,0,0" Padding="8,4" />
            <Button Grid.Column="3" Content="-90°" Command="{Binding RotMinus90Command}" Margin="4,0,0,0" Padding="8,4" />
            <Button Grid.Column="4" Content="Reset" Command="{Binding RotResetCommand}"  Margin="4,0,0,0" Padding="8,4" />
            <CheckBox Grid.Column="5"
                      Content="Skip Jacobian (≈2× faster, flat 3D)"
                      IsChecked="{Binding SkipJacobian, Mode=TwoWay}"
                      ToolTip.Tip="Drop the parallel-perturbation trajectory used to compute Hubbard–Douady surface normals. Doubles throughput on slow equations at the cost of flat 3D Phong shading."
                      Margin="12,0,0,0"
                      VerticalAlignment="Center" />
        </Grid>

        <!-- Row 3: tab control (fills) -->
        <TabControl Grid.Row="3"
                    SelectedIndex="{Binding ActiveTabIndex, Mode=TwoWay}"
                    Background="Transparent">

            <!-- Tab 1: User Equation (C# style, Roslyn live-compile) -->
            <TabItem Header="User Equation">
                <Grid RowDefinitions="Auto,Auto,*">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,6,0,6">
                        <TextBlock Grid.Column="0"
                                   Foreground="#B4B4B4"
                                   TextWrapping="Wrap">
                            <Run Text="C# expression body. Roslyn-compiled. Use System.Numerics.Complex syntax (Complex.Sin, Complex.Pow, etc.)." />
                            <LineBreak />
                            <Run Text="Example:  return z*z + c;" />
                        </TextBlock>
                        <Button Grid.Column="1"
                                Content="?"
                                Command="{Binding OpenUserEquationHelpCommand}"
                                ToolTip.Tip="Help for the User Equation tab"
                                Margin="8,0,0,0"
                                Width="28" Height="28"
                                VerticalAlignment="Top" />
                    </Grid>
                    <CheckBox Grid.Row="1"
                              Content="Validate for CalcGen"
                              IsChecked="{Binding ValidateForCalcGen, Mode=TwoWay}"
                              ToolTip.Tip="Flag C# constructs the CalcGen DSL can't accept (Complex.ImaginaryOne, Complex.Abs, new Complex(...), unsupported Complex.* members). Roslyn-compiles independently — leave on if you plan to Generate or hot-load via CalcGen."
                              Margin="0,0,0,6" />
                    <Border Grid.Row="2"
                            BorderBrush="#505050"
                            BorderThickness="1"
                            Background="#1C1C1C"
                            Classes.error="{Binding StatusIsError}">
                        <Border.Styles>
                            <Style Selector="Border.error">
                                <Setter Property="BorderBrush" Value="#FFCC00" />
                            </Style>
                        </Border.Styles>
                        <TextBox x:Name="UserEquationEditor"
                                 Text="{Binding Source, Mode=TwoWay}"
                                 AcceptsReturn="True"
                                 AcceptsTab="True"
                                 TextWrapping="NoWrap"
                                 FontFamily="Consolas, monospace"
                                 FontSize="14"
                                 Background="#1C1C1C"
                                 Foreground="White"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto" />
                    </Border>
                </Grid>
            </TabItem>

            <!-- Tab 2: DSL (bare CalcGen DSL, validate-on-type) -->
            <TabItem Header="DSL">
                <Grid RowDefinitions="Auto,*">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,6,0,6">
                        <TextBlock Grid.Column="0"
                                   Foreground="#B4B4B4"
                                   TextWrapping="Wrap">
                            <Run Text="Bare CalcGen DSL — lowercase keywords, no 'Complex.' prefix, no 'return'. Allowed: z c sin cos tan sinh cosh tanh exp log sqrt arg atan2 min max mod conj fold sqr abs re im prev iter pi e i, + - * / ^Int." />
                            <LineBreak />
                            <Run Text="Example:  z*z + c" />
                        </TextBlock>
                        <Button Grid.Column="1"
                                Content="?"
                                Command="{Binding OpenDslHelpCommand}"
                                ToolTip.Tip="Help for the DSL tab — grammar at a glance"
                                Margin="8,0,0,0"
                                Width="28" Height="28"
                                VerticalAlignment="Top" />
                    </Grid>
                    <Border Grid.Row="1"
                            BorderBrush="#505050"
                            BorderThickness="1"
                            Background="#1C1C1C"
                            Classes.error="{Binding StatusIsError}">
                        <Border.Styles>
                            <Style Selector="Border.error">
                                <Setter Property="BorderBrush" Value="#FFCC00" />
                            </Style>
                        </Border.Styles>
                        <TextBox x:Name="DslEditor"
                                 Text="{Binding DslSource, Mode=TwoWay}"
                                 AcceptsReturn="True"
                                 AcceptsTab="True"
                                 TextWrapping="NoWrap"
                                 FontFamily="Consolas, monospace"
                                 FontSize="14"
                                 Background="#1C1C1C"
                                 Foreground="White"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto" />
                    </Border>
                </Grid>
            </TabItem>

        </TabControl>

        <!-- Row 4: status / error + Apply Fix button (Ctrl+.) -->
        <Grid Grid.Row="4" ColumnDefinitions="*,Auto" Margin="0,8,0,0">
            <TextBlock Grid.Column="0"
                       Text="{Binding StatusText}"
                       FontFamily="Consolas, monospace"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Foreground="#64FF64"
                       VerticalAlignment="Center"
                       Classes.error="{Binding StatusIsError}">
                <TextBlock.Styles>
                    <Style Selector="TextBlock.error">
                        <Setter Property="Foreground" Value="#FFCC00" />
                    </Style>
                </TextBlock.Styles>
            </TextBlock>
            <Button Grid.Column="1"
                    Content="{Binding SuggestedFix, StringFormat='Apply fix: {0}  (Ctrl+.)'}"
                    Command="{Binding ApplyFixCommand}"
                    IsVisible="{Binding HasSuggestedFix}"
                    ToolTip.Tip="Replace the highlighted span with the suggested fix. Shortcut: Ctrl+."
                    Margin="8,0,0,0"
                    Padding="10,4" />
        </Grid>

    </Grid>

</Window>

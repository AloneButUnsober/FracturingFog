<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FracturingFog.UI.Avalonia.ViewModels"
        xmlns:m="using:FracturingFog.Models"
        xmlns:cp="using:Avalonia.Controls"
        x:Class="FracturingFog.UI.Avalonia.Views.ColorThemeEditorView"
        x:DataType="vm:ColorThemeEditorViewModel"
        Foreground="#DCDCDC">

    <UserControl.Styles>
        <Style Selector="TextBlock.section">
            <Setter Property="Foreground" Value="#C8C864" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="Foreground" Value="#B4B4B4" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.group">
            <Setter Property="BorderBrush" Value="#3A3A3A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style Selector="Button.action">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="0,0,4,0" />
        </Style>
        <Style Selector="Button.new">     <Setter Property="Background" Value="#37374B" /> </Style>
        <Style Selector="Button.revert">  <Setter Property="Background" Value="#503C1E" /> </Style>
        <Style Selector="Button.apply">   <Setter Property="Background" Value="#285028" /> </Style>
        <Style Selector="Button.save">    <Setter Property="Background" Value="#283C64" /> </Style>
        <Style Selector="Button.export">  <Setter Property="Background" Value="#3C325A" /> </Style>
        <Style Selector="Button.danger">  <Setter Property="Background" Value="#502323" /> </Style>
        <Style Selector="Button.add">     <Setter Property="Background" Value="#283C28" /> </Style>
        <Style Selector="Button.help">    <Setter Property="Background" Value="#283C64" /> </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="10">

        <!-- Title row -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0"
                       Text="{Binding TitleText}"
                       Foreground="#C8C864"
                       FontSize="14"
                       FontWeight="Bold"
                       VerticalAlignment="Center" />
            <!-- Phase D: scoped markdown help. HelpCommand still raises HelpRequested
                 for legacy host hooks (ShellViewModel listens), so VM contract unchanged. -->
            <Button Grid.Column="1"
                    Classes="action help"
                    Content="?"
                    Click="OnHelpClick"
                    ToolTip.Tip="Open the Colour Theme Editor guide"
                    Width="32" />
        </Grid>

        <!-- Action row -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,8" Spacing="0">
            <CheckBox Content="Live preview"
                      IsChecked="{Binding LivePreview}"
                      Foreground="#C8C878"
                      FontWeight="Bold"
                      VerticalAlignment="Center"
                      Margin="0,0,12,0" />
            <Button Classes="action new"     Content="New"          Command="{Binding NewBlankCommand}" />
            <Button Classes="action new"     Content="Copy current" Command="{Binding CopyCurrentCommand}" />
            <Button Classes="action revert"  Content="Revert"       Command="{Binding RevertCommand}" />
            <Button Classes="action apply"   Content="Apply"        Command="{Binding ApplyCommand}"      IsEnabled="{Binding CanApply}" />
            <Button Classes="action save"    Content="Save"         Command="{Binding SaveCommand}"       IsEnabled="{Binding CanApply}" />
            <Button Classes="action export"  Content="Export JSON…" Command="{Binding ExportJsonCommand}" IsEnabled="{Binding CanApply}" />
            <Button Classes="action export"  Content="Export C#…"   Command="{Binding ExportCSharpCommand}" IsEnabled="{Binding CanApply}" />
        </StackPanel>

        <!-- Main two-column content -->
        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <Grid ColumnDefinitions="*,12,*">

                <!-- LEFT COLUMN -->
                <StackPanel Grid.Column="0" Orientation="Vertical">

                    <!-- Target -->
                    <Border Classes="group">
                        <StackPanel Spacing="6">
                            <TextBlock Classes="section" Text="Target" />
                            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" Margin="0,4,0,0">
                                <TextBlock Classes="label" Grid.Row="0" Grid.Column="0" Text="Region:" Margin="0,0,8,4" />
                                <ComboBox x:Name="RegionCombo"
                                          Grid.Row="0" Grid.Column="1"
                                          ItemsSource="{Binding RegionNames}"
                                          SelectedItem="{Binding SelectedRegion}"
                                          Margin="0,0,0,4">
                                    <ComboBox.Styles>
                                        <Style Selector="ComboBox">
                                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                                        </Style>
                                    </ComboBox.Styles>
                                </ComboBox>
                                <TextBlock Classes="label" Grid.Row="1" Grid.Column="0" Text="Theme:" Margin="0,0,8,0" />
                                <ComboBox x:Name="ThemeCombo"
                                          Grid.Row="1" Grid.Column="1"
                                          ItemsSource="{Binding ThemeNames}"
                                          SelectedItem="{Binding SelectedTheme}"
                                          HorizontalAlignment="Stretch" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Identity -->
                    <Border Classes="group">
                        <StackPanel Spacing="6">
                            <TextBlock Classes="section" Text="Identity" />
                            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" Margin="0,4,0,0">
                                <TextBlock Classes="label" Grid.Row="0" Grid.Column="0" Text="Name:"     Margin="0,0,8,4" />
                                <TextBox   x:Name="NameField" Grid.Row="0" Grid.Column="1" Text="{Binding Name}"        Margin="0,0,0,4" />
                                <TextBlock Classes="label" Grid.Row="1" Grid.Column="0" Text="Category:" Margin="0,0,8,4" />
                                <TextBox   Grid.Row="1" Grid.Column="1" Text="{Binding Category}"    Margin="0,0,0,4" />
                                <TextBlock Classes="label" Grid.Row="2" Grid.Column="0" Text="Desc:"     Margin="0,0,8,4" />
                                <TextBox   Grid.Row="2" Grid.Column="1" Text="{Binding Description}" Margin="0,0,0,4" />
                                <TextBlock Classes="label" Grid.Row="3" Grid.Column="0" Text="Max zoom:" Margin="0,0,8,0" />
                                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                    <NumericUpDown Value="{Binding MaxRecommendedZoom}"
                                                   Minimum="0" Maximum="1000000000"
                                                   FormatString="0" Width="160"
                                                   IsEnabled="{Binding MaxZoomEnabled}" />
                                    <CheckBox Content="Limited" IsChecked="{Binding MaxZoomEnabled}" Foreground="#B4B4B4" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Kind -->
                    <Border Classes="group">
                        <StackPanel Spacing="6">
                            <TextBlock Classes="section" Text="Kind" />
                            <StackPanel Orientation="Horizontal" Spacing="14">
                                <RadioButton Content="Gradient" GroupName="kind" IsChecked="{Binding IsGradient}" Foreground="#DCDCDC" />
                                <RadioButton Content="Cycling"  GroupName="kind" IsChecked="{Binding IsCycling}"  Foreground="#DCDCDC" />
                                <RadioButton Content="Phong3D"  GroupName="kind" IsChecked="{Binding IsPhong}"    Foreground="#DCDCDC" />
                                <RadioButton Content="Pbr3D"    GroupName="kind" IsChecked="{Binding IsPbr}"      Foreground="#DCDCDC" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Stops -->
                    <Border Classes="group">
                        <StackPanel Spacing="6">
                            <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto">
                                <TextBlock Grid.Column="0" Classes="section" Text="Color stops" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Classes="action add"    Content="Add"   Command="{Binding AddStopCommand}" />
                                <Button Grid.Column="2" Classes="action export" Content="From image…" Command="{Binding FromImageCommand}" />
                                <Button Grid.Column="3" Classes="action save"   Content="Import…"     Command="{Binding ImportPaletteCommand}" />
                                <Button Grid.Column="4" Classes="action export" Content="Export…"     Command="{Binding ExportPaletteCommand}" />
                            </Grid>
                            <Grid ColumnDefinitions="Auto,Auto,*">
                                <CheckBox  Grid.Column="0" Content="Inspect"  IsChecked="{Binding InspectActive}"
                                           IsEnabled="{Binding InspectStopEnabled}"
                                           Foreground="#C8C878" FontWeight="Bold" VerticalAlignment="Center"
                                           ToolTip.Tip="Single-click the rendered fractal to highlight the closest matching stop." />
                                <Button    Grid.Column="1" Classes="action save"
                                           Margin="30,0,0,0"
                                           Command="{Binding SampleSelectedCommand}"
                                           Content="◎"
                                           ToolTip.Tip="Eyedropper: click a stop row first, then sample any pixel on the desktop to replace its color." />
                                    <!--<Image Source="avares://FracturingFog.UI.Avalonia/Assets/Sampler.png"
                                           Width="20" Height="20"/>-->
                                    <!--</Button>-->
                                <TextBlock Grid.Column="2" Text="(click a stop to select it)"
                                           Foreground="#808080" FontStyle="Italic"
                                           VerticalAlignment="Center" Margin="12,0,0,0" />
                            </Grid>
                            <Border BorderBrush="#2A2A2A" BorderThickness="1" Background="#1A1A1A" MaxHeight="260">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="StopsItems" ItemsSource="{Binding Stops}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="vm:ColorStopRowVm">
                                                <Border Background="{Binding RowBackground}" CornerRadius="2" Margin="2,1" Padding="2">
                                                    <Grid ColumnDefinitions="132,Auto,Auto,Auto" Margin="2,1">
                                                        <Grid.Styles>
                                                            <Style Selector="Grid">
                                                                <Setter Property="Background" Value="Transparent" />
                                                            </Style>
                                                        </Grid.Styles>
                                                        <NumericUpDown Grid.Column="0"
                                                                       Value="{Binding Position}"
                                                                       Minimum="0" Maximum="1"
                                                                       Increment="0.05"
                                                                       FormatString="0.###" Width="130" />
                                                        <!--<Border Grid.Column="1" Width="32" Height="22" Margin="6,0"
                                                                Background="{Binding SwatchBrush}"
                                                                BorderBrush="#444" BorderThickness="1" />-->
                                                        <ColorPicker Grid.Column="1" Color="{Binding StopColor, Mode=TwoWay}" 
                                                                     Margin="4,0" HorizontalAlignment="Left" Width="120" />
                                                        <Button Grid.Column="2" Content="◎" Width="32" Margin="2,0,12,0"
                                                                Background="#325A6E" Foreground="White" FontWeight="Bold"
                                                                Command="{Binding SampleCommand}"
                                                                ToolTip.Tip="Sample a color from anywhere on the desktop and apply to this stop." />
                                                        <Button Grid.Column="4" Classes="action danger" Content="X" Width="28"
                                                                Command="{Binding $parent[ItemsControl].((vm:ColorThemeEditorViewModel)DataContext).RemoveStopCommand}"
                                                                CommandParameter="{Binding}" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Cycle -->
                    <Border Classes="group">
                        <StackPanel Spacing="4" Orientation="Horizontal">
                                <StackPanel Spacing="6" IsEnabled="{Binding ShowCycle}">
                                    <TextBlock Classes="section" Text="Cycle" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Classes="label" Text="Speed:" />
                                        <NumericUpDown Value="{Binding CycleSpeed}"
                                                       Minimum="0.0001" Maximum="10" Increment="0.001"
                                                       FormatString="0.0000" Width="135" />
                                    </StackPanel>
                                </StackPanel>

                            <!-- In-set -->
                                <StackPanel Spacing="6" Margin="8,0,0,0">
                                    <TextBlock Classes="section" Text="In-set (interior)" />
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <CheckBox Content="Override" IsChecked="{Binding UseInSet}" Foreground="#B4B4B4" VerticalAlignment="Center" />
                                        <!--<Border Width="40" Height="22"
                                        Background="{Binding InSetSwatchBrush}"
                                        BorderBrush="#444" BorderThickness="1" />-->
                                        <ColorPicker Color="{Binding InSetColor, Mode=TwoWay}"
                                                     IsEnabled="{Binding UseInSet}" Width="130"/>
                                    </StackPanel>
                                </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Post-FX defaults -->
                    <Border Classes="group">
                        <StackPanel Spacing="4">
                            <TextBlock Classes="section" Text="Post-FX defaults" />
                            <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto" Margin="0,4,0,0">
                                <CheckBox Grid.Row="0" Grid.Column="0" Content="Brightness" IsChecked="{Binding UseBrightness}" 
                                          Foreground="#B4B4B4" Margin="0,0,12,4" VerticalAlignment="Center" />
                                <Slider Grid.Row="0" Grid.Column="1" Value="{Binding Brightness}" Minimum="-100" Maximum="100" 
                                        TickFrequency="10" IsSnapToTickEnabled="False" IsEnabled="{Binding UseBrightness}" 
                                        Margin="0,0,0,4" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding Brightness}" Foreground="#9B9B9B" 
                                           Width="32" TextAlignment="Right" VerticalAlignment="Center" Margin="6,0,0,4" />
                                
                                <CheckBox Grid.Row="1" Grid.Column="0" Content="Contrast" IsChecked="{Binding UseContrast}" Foreground="#B4B4B4" Margin="0,0,12,4" VerticalAlignment="Center" />
                                <Slider Grid.Row="1" Grid.Column="1" Value="{Binding Contrast}" Minimum="-100" Maximum="100" TickFrequency="10" IsSnapToTickEnabled="False" IsEnabled="{Binding UseContrast}" Margin="0,0,0,4" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Contrast}" Foreground="#9B9B9B" Width="32" TextAlignment="Right" VerticalAlignment="Center" Margin="6,0,0,4" />
                                
                                <CheckBox Grid.Row="2" Grid.Column="0" Content="Adaptive" IsChecked="{Binding UseAdaptive}" Foreground="#B4B4B4" Margin="0,0,12,0" VerticalAlignment="Center" />
                                <Slider Grid.Row="2" Grid.Column="1" Value="{Binding Adaptive}" Minimum="0" Maximum="100" TickFrequency="10" IsSnapToTickEnabled="False" IsEnabled="{Binding UseAdaptive}" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding Adaptive}" Foreground="#9B9B9B" Width="32" TextAlignment="Right" VerticalAlignment="Center" Margin="6,0,0,0" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- RIGHT COLUMN -->
                <StackPanel Grid.Column="2" Orientation="Vertical">

                    <!-- 3D shared -->
                    <Border Classes="group" IsVisible="{Binding Show3D}">
                        <StackPanel Spacing="6">
                            <TextBlock Classes="section" Text="3D lighting (Phong / PBR)" />
                            <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto,Auto" Margin="0,4,0,0">
                                <TextBlock Classes="label" Grid.Row="0" Grid.Column="0" Text="Steepness:" Margin="0,0,2,0" />
                                <NumericUpDown Grid.Row="0" Grid.Column="1" Value="{Binding Steepness}"
                                               Minimum="0.1" Maximum="10" Increment="0.05"
                                               FormatString="0.00" Width="130" Margin="0,0,16,0" />
                                <TextBlock Classes="label" Grid.Row="0" Grid.Column="2" Text="Ambient:" Margin="0,0,2,0" />
                                <NumericUpDown Grid.Row="0" Grid.Column="3" Value="{Binding Ambient}"
                                               Minimum="0" Maximum="1" Increment="0.01"
                                               FormatString="0.000" Width="130" />
                                <CheckBox Grid.Row="1" Grid.Column="1"
                                          Content="Inspect"
                                          IsChecked="{Binding Inspect3DActive}"
                                          IsEnabled="{Binding Inspect3DEnabled}"
                                          Foreground="#C8C878" FontWeight="Bold"
                                          Margin="0,4,0,0"
                                          ToolTip.Tip="Single-click the rendered fractal to highlight the light whose diffuse color best matches the sampled pixel." />
                            </Grid>

                            <!-- Key Light -->
                            <Border DataContext="{Binding KeyLight}"
                                    Background="{Binding RowBackground}"
                                    BorderBrush="#2A2A2A" BorderThickness="1" Padding="6" Margin="0,8,0,0">
                                <StackPanel Spacing="4" Orientation="Horizontal">
                                    <StackPanel Spacing="4" Orientation="Vertical">
                                        <TextBlock Foreground="#A0A0A0" FontWeight="Bold" Text="Key light" />
                                        <StackPanel Spacing="4" Orientation="Horizontal">
                                            <TextBlock Classes="label" Grid.Column="0" Text="X" Margin="8,0,4,0" />
                                            <NumericUpDown Grid.Column="1" Value="{Binding Lx}"
                                                           Minimum="-10" Maximum="10" Increment="0.05"
                                                           FormatString="0.000" Width="130" />
                                        </StackPanel>
                                        <StackPanel Spacing="4" Orientation="Horizontal">
                                            <TextBlock Classes="label" Grid.Column="2" Text="Y" Margin="8,0,4,0" />
                                            <NumericUpDown Grid.Column="3" Value="{Binding Ly}"
                                                           Minimum="-10" Maximum="10" Increment="0.05"
                                                           FormatString="0.000" Width="130" />
                                        </StackPanel>
                                        <StackPanel Spacing="4" Orientation="Horizontal">
                                            <TextBlock Classes="label" Grid.Column="4" Text="Z" Margin="8,0,4,0" />
                                            <NumericUpDown Grid.Column="5" Value="{Binding Lz}"
                                                           Minimum="-10" Maximum="10" Increment="0.05"
                                                           FormatString="0.000" Width="130" />
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Spacing="4" Orientation="Vertical">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock Classes="label" Text="Diffuse" Width="70" Margin="8,20,0,0"/>
                                            <ColorPicker Color="{Binding DiffColor, Mode=TwoWay}" Margin="0,22,0,0" Width="130"/>
                                            <Button Content="◎" Width="28" Margin="2,22,0,0"
                                                    Background="#325A6E" Foreground="White" FontWeight="Bold"
                                                    Command="{Binding SampleDiffCommand}"
                                                    ToolTip.Tip="Sample a color from anywhere on the desktop and apply to this light's diffuse." />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock Classes="label" Text="Specular" Width="70" Margin="8,0,0,0"/>
                                            <ColorPicker Color="{Binding SpecColor, Mode=TwoWay}" Width="130" />
                                            <Button Content="◎" Width="28" Margin="2,0,0,0"
                                                    Background="#325A6E" Foreground="White" FontWeight="Bold"
                                                    Command="{Binding SampleSpecCommand}"
                                                    ToolTip.Tip="Sample a color from anywhere on the desktop and apply to this light's specular." />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock Classes="label" Text="Shininess" Width="70" Margin="8,0,0,0"/>
                                            <NumericUpDown Value="{Binding Shininess}" Minimum="1" Maximum="512"
                                                           Width="130" />
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Fill Light -->
                            <Border DataContext="{Binding FillLight}"
                                    Background="{Binding RowBackground}"
                                    BorderBrush="#2A2A2A" BorderThickness="1" Padding="6" Margin="0,4,0,0">
                                <StackPanel Spacing="4" Orientation="Horizontal">
                                    <StackPanel Spacing="4" Orientation="Vertical">
                                        <TextBlock Foreground="#A0A0A0" FontWeight="Bold" Text="Fill light" />
                                        <StackPanel Spacing="4" Orientation="Horizontal">
                                            <TextBlock Classes="label" Grid.Column="0" Text="X" Margin="8,0,4,0" />
                                            <NumericUpDown Grid.Column="1" Value="{Binding Lx}" Minimum="-10" Maximum="10"
                                                           Increment="0.05" FormatString="0.000" Width="130" />
                                        </StackPanel>
                                        <StackPanel Spacing="4" Orientation="Horizontal">
                                            <TextBlock Classes="label" Grid.Column="2" Text="Y" Margin="8,0,4,0" />
                                            <NumericUpDown Grid.Column="3" Value="{Binding Ly}" Minimum="-10" Maximum="10"
                                                           Increment="0.05" FormatString="0.000" Width="130" />
                                        </StackPanel>
                                        <StackPanel Spacing="4" Orientation="Horizontal">
                                            <TextBlock Classes="label" Grid.Column="4" Text="Z" Margin="8,0,4,0" />
                                            <NumericUpDown Grid.Column="5" Value="{Binding Lz}" Minimum="-10" Maximum="10"
                                                           Increment="0.05" FormatString="0.000" Width="130" />
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Spacing="4" Orientation="Vertical">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock Classes="label" Text="Diffuse" Width="70" Margin="8,20,0,0"/>
                                            <ColorPicker Color="{Binding DiffColor, Mode=TwoWay}" Margin="0,22,0,0" Width="130"/>
                                            <Button Content="◎" Width="28" Margin="2,22,0,0"
                                                    Background="#325A6E" Foreground="White" FontWeight="Bold"
                                                    Command="{Binding SampleDiffCommand}"
                                                    ToolTip.Tip="Sample a color from anywhere on the desktop and apply to this light's diffuse." />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock Classes="label" Text="Specular" Width="70" Margin="8,0,0,0"/>
                                            <ColorPicker Color="{Binding SpecColor, Mode=TwoWay}" Width="130"/>
                                            <Button Content="◎" Width="28" Margin="2,0,0,0"
                                                    Background="#325A6E" Foreground="White" FontWeight="Bold"
                                                    Command="{Binding SampleSpecCommand}"
                                                    ToolTip.Tip="Sample a color from anywhere on the desktop and apply to this light's specular." />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock Classes="label" Text="Shininess" Width="70" Margin="8,0,0,0"/>
                                            <NumericUpDown Value="{Binding Shininess}" Minimum="1" Maximum="512" Width="130" />
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Rim Light -->
                            <CheckBox Content="Enable rim light" IsChecked="{Binding UseRim}" Foreground="#C8C878" FontWeight="Bold" Margin="0,8,0,0" />
                            <Border DataContext="{Binding RimLight}"
                                    Background="{Binding RowBackground}"
                                    BorderBrush="#2A2A2A" BorderThickness="1" Padding="6" IsEnabled="{Binding IsEnabled}">
                                <StackPanel Spacing="4" Orientation="Horizontal">
                                    <StackPanel Spacing="4" Orientation="Vertical">
                                        <TextBlock Foreground="#A0A0A0" FontWeight="Bold" Text="Rim light" />
                                        <StackPanel Spacing="4" Orientation="Horizontal">
                                            <TextBlock Classes="label" Grid.Column="0" Text="X" Margin="8,0,4,0" />
                                            <NumericUpDown Grid.Column="1" Value="{Binding Lx}" Minimum="-10" Maximum="10"
                                                           Increment="0.05" FormatString="0.000" Width="130" />
                                        </StackPanel>
                                        <StackPanel Spacing="4" Orientation="Horizontal">
                                            <TextBlock Classes="label" Grid.Column="2" Text="Y" Margin="8,0,4,0" />
                                            <NumericUpDown Grid.Column="3" Value="{Binding Ly}" Minimum="-10" Maximum="10"
                                                           Increment="0.05" FormatString="0.000" Width="130" />
                                        </StackPanel>
                                        <StackPanel Spacing="4" Orientation="Horizontal">
                                            <TextBlock Classes="label" Grid.Column="4" Text="Z" Margin="8,0,4,0" />
                                            <NumericUpDown Grid.Column="5" Value="{Binding Lz}" Minimum="-10" Maximum="10"
                                                           Increment="0.05" FormatString="0.000" Width="130" />
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Spacing="4" Orientation="Vertical">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock Classes="label" Text="Diffuse" Width="70" Margin="8,20,0,0"/>
                                            <ColorPicker Color="{Binding DiffColor, Mode=TwoWay}" Margin="0,22,0,0" Width="130"/>
                                            <Button Content="◎" Width="28" Margin="2,22,0,0"
                                                    Background="#325A6E" Foreground="White" FontWeight="Bold"
                                                    Command="{Binding SampleDiffCommand}"
                                                    ToolTip.Tip="Sample a color from anywhere on the desktop and apply to this light's diffuse." />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock Classes="label" Text="Specular" Width="70" Margin="8,0,0,0"/>
                                            <ColorPicker Color="{Binding SpecColor, Mode=TwoWay}" Width="130" />
                                            <Button Content="◎" Width="28" Margin="2,0,0,0"
                                                    Background="#325A6E" Foreground="White" FontWeight="Bold"
                                                    Command="{Binding SampleSpecCommand}"
                                                    ToolTip.Tip="Sample a color from anywhere on the desktop and apply to this light's specular." />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock Classes="label" Text="Shininess" Width="70" Margin="8,0,0,0"/>
                                            <NumericUpDown Value="{Binding Shininess}" Minimum="1" Maximum="512" Width="130" />
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Phong extras -->
                    <Border Classes="group" IsVisible="{Binding ShowPhongExtras}">
                        <StackPanel Spacing="4">
                            <TextBlock Classes="section" Text="Phong3D extras" />
                            <StackPanel Spacing="4" Orientation="Horizontal">
                                <StackPanel Spacing="4" Orientation="Vertical">
                                    <TextBlock Foreground="#A0A0A0" FontWeight="Bold" Text="Specular" />
                                    <StackPanel Spacing="4" Orientation="Horizontal">
                                        <TextBlock Classes="label" Grid.Row="0" Grid.Column="0" Text="Key:"
                                                   Margin="0,0,8,4" Width="25" />
                                        <NumericUpDown Grid.Row="0" Grid.Column="1" Value="{Binding KeySpec}"
                                                       Minimum="0" Maximum="10" Increment="0.05"
                                                       FormatString="0.000" Width="130"
                                                       HorizontalAlignment="Left" Margin="0,0,0,4" />
                                    </StackPanel>
                                    <StackPanel Spacing="4" Orientation="Horizontal">
                                        <TextBlock Classes="label" Grid.Row="1" Grid.Column="0" Text="Fill:"
                                                   Margin="0,0,8,4" Width="25"/>
                                        <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding FillSpec}"
                                                       Minimum="0" Maximum="10" Increment="0.05"
                                                       FormatString="0.000" Width="130"
                                                       HorizontalAlignment="Left" Margin="0,0,0,4" />
                                    </StackPanel>
                                    <StackPanel Spacing="4" Orientation="Horizontal">
                                        <TextBlock Classes="label" Grid.Row="3" Grid.Column="0" Text="Rim spec:"
                                                   Margin="0,0,8,4" Width="25"/>
                                        <NumericUpDown Grid.Row="3" Grid.Column="1" Value="{Binding RimSpec}"
                                                       Minimum="0" Maximum="10" Increment="0.05"
                                                       FormatString="0.000" Width="130"
                                                       HorizontalAlignment="Left" Margin="0,0,0,4" IsEnabled="{Binding UseRim}" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Spacing="4" Orientation="Vertical">
                                    <TextBlock Foreground="#A0A0A0" FontWeight="Bold" Text="Diffuse" />
                                    <StackPanel Spacing="4" Orientation="Horizontal">
                                        <TextBlock Classes="label" Grid.Row="2" Grid.Column="0" Text="Fill:"
                                                   Margin="8,0,8,4" Width="25" />
                                        <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding FillDiff}"
                                                       Minimum="0" Maximum="10" Increment="0.05"
                                                       FormatString="0.000" Width="130"
                                                       HorizontalAlignment="Left" Margin="0,0,0,4" />
                                    </StackPanel>
                                    <StackPanel Spacing="4" Orientation="Horizontal">
                                        <TextBlock Classes="label" Grid.Row="4" Grid.Column="0" Text="Rim:"
                                                   Margin="8,0,8,0" Width="25"/>
                                        <NumericUpDown Grid.Row="4" Grid.Column="1" Value="{Binding RimDiff}"
                                                       Minimum="0" Maximum="10" Increment="0.05"
                                                       FormatString="0.000" Width="130"
                                                       HorizontalAlignment="Left" IsEnabled="{Binding UseRim}" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" Margin="0,4,0,0">
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- PBR extras -->
                    <Border Classes="group" IsVisible="{Binding ShowPbrExtras}">
                        <StackPanel Spacing="6">
                            <TextBlock Classes="section" Text="Pbr3D extras" />
                            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" Margin="0,4,0,0">
                                <TextBlock Classes="label" Grid.Row="0" Grid.Column="0" Text="Lighting:" Margin="0,0,8,4" />
                                <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding PbrLightingModes}" SelectedItem="{Binding PbrLightingMode}" Width="220" HorizontalAlignment="Left" Margin="0,0,0,4" />
                                <TextBlock Classes="label" Grid.Row="1" Grid.Column="0" Text="Glow exp:" Margin="0,0,8,4" />
                                <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding GlowExponent}" Minimum="0" Maximum="50" 
                                               Increment="0.5" FormatString="0.00" Width="130" HorizontalAlignment="Left" Margin="0,0,0,4" />
                                <TextBlock Classes="label" Grid.Row="2" Grid.Column="0" Text="Glow scale:" Margin="0,0,8,0" />
                                <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding GlowScale}" Minimum="0" Maximum="10" 
                                               Increment="0.05" FormatString="0.000" Width="130" HorizontalAlignment="Left" />
                            </Grid>

                            <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                                <TextBlock Grid.Column="0" Classes="label" Text="Material bands (UpperT / Metal / Rough):" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Classes="action add" Content="+ Add band" Command="{Binding AddBandCommand}" />
                            </Grid>
                            <CheckBox Content="Inspect"
                                      IsChecked="{Binding InspectBandActive}"
                                      IsEnabled="{Binding InspectBandEnabled}"
                                      Foreground="#C8C878" FontWeight="Bold"
                                      Margin="0,2,0,2"
                                      ToolTip.Tip="Single-click the rendered fractal to highlight the material band whose UpperT range covers the sampled stop position." />
                            <Border BorderBrush="#2A2A2A" BorderThickness="1" Background="#1A1A1A" MaxHeight="200">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="BandsItems" ItemsSource="{Binding MaterialBands}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="vm:MaterialBandRowVm">
                                                <Border Background="{Binding RowBackground}" CornerRadius="2" Margin="2,1" Padding="2">
                                                    <Grid ColumnDefinitions="Auto,Auto,Auto,Auto" Margin="4,2">
                                                        <NumericUpDown Grid.Column="0" Value="{Binding UpperT}"    Minimum="0" Maximum="2"
                                                                       Increment="0.05" FormatString="0.###" Width="130" Margin="0,0,4,0" />
                                                        <NumericUpDown Grid.Column="1" Value="{Binding Metal}"     Minimum="0" Maximum="1"
                                                                       Increment="0.05" FormatString="0.###" Width="130" Margin="2,0" />
                                                        <NumericUpDown Grid.Column="2" Value="{Binding Roughness}" Minimum="0" Maximum="1"
                                                                       Increment="0.05" FormatString="0.###" Width="130" Margin="2,0,6,0" />
                                                        <Button Grid.Column="3" Classes="action danger" Content="X" Width="28"
                                                                Command="{Binding $parent[ItemsControl].((vm:ColorThemeEditorViewModel)DataContext).RemoveBandCommand}"
                                                                CommandParameter="{Binding}" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Footer: close hint -->
        <TextBlock Grid.Row="3"
                   Text="Tip: live preview pushes to the main view 150 ms after the last edit. Hit Apply to force, Save to commit to the user library."
                   Foreground="#808080"
                   FontStyle="Italic"
                   TextWrapping="Wrap"
                   Margin="0,6,0,0" />
    </Grid>
</UserControl>

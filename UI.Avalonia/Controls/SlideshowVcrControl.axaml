<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FracturingFog.UI.Avalonia.ViewModels"
             x:Class="FracturingFog.UI.Avalonia.Controls.SlideshowVcrControl"
             x:DataType="vm:SlideshowVcrViewModel"
             Background="#1C1C20"
             Foreground="Gainsboro">

    <!--
      Compact VCR-style button bar. All sizing in DIPs; the bar is Auto-height
      so larger system fonts grow the buttons rather than clipping their text.
      Hide checkbox lives on the right while expanded; collapses the row to
      just itself when checked.
    -->
    <Border BorderBrush="#5A5A64" BorderThickness="1" Padding="6">
        <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto" RowDefinitions="Auto">

            <Button Grid.Column="0"
                    Content="{Binding PlayPauseLabel}"
                    Command="{Binding PlayPauseCommand}"
                    IsEnabled="{Binding PlayPauseEnabled}"
                    IsVisible="{Binding IsExpanded}"
                    MinWidth="68" Padding="10,6" Margin="0,0,6,0"
                    FontWeight="Bold"
                    Background="#303038" Foreground="Gainsboro" />

            <Button Grid.Column="1"
                    Content="■ Stop"
                    Command="{Binding StopCommand}"
                    IsVisible="{Binding IsExpanded}"
                    MinWidth="64" Padding="10,6" Margin="0,0,6,0"
                    FontWeight="Bold"
                    Background="#303038" Foreground="Gainsboro" />

            <Button Grid.Column="2"
                    Content="⏭ Region"
                    Command="{Binding SkipRegionCommand}"
                    IsEnabled="{Binding SkipRegionEnabled}"
                    IsVisible="{Binding IsExpanded}"
                    MinWidth="80" Padding="10,6" Margin="0,0,6,0"
                    FontWeight="Bold"
                    Background="#303038" Foreground="Gainsboro" />

            <Button Grid.Column="3"
                    Content="⏭ Color"
                    Command="{Binding SkipThemeCommand}"
                    IsEnabled="{Binding SkipThemeEnabled}"
                    IsVisible="{Binding IsExpanded}"
                    MinWidth="80" Padding="10,6" Margin="0,0,6,0"
                    FontWeight="Bold"
                    Background="#303038" Foreground="Gainsboro" />

            <ToggleButton Grid.Column="5"
                          Content="{Binding HideLabel}"
                          IsChecked="{Binding IsCollapsed, Mode=TwoWay}"
                          MinWidth="72" Padding="10,6"
                          FontWeight="Bold"
                          Background="#303038" Foreground="Gainsboro" />

        </Grid>
    </Border>

</UserControl>

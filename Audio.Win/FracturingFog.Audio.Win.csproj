<Project Sdk="Microsoft.NET.Sdk">

  <!--
    FracturingFog.Audio.Win — Windows-only NAudio backend (WASAPI loopback,
    WaveOutEvent speaker output) implementing IAudioCaptureBackend. Phase X.B
    extracts the relevant code out of Audio/AudioEngine.cs into this project.

    Phase X.0 / Slice 0.5: scaffold only. No source files yet.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>false</UseWindowsForms>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Platforms>AnyCPU;x64</Platforms>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <RootNamespace>FracturingFog.Audio.Win</RootNamespace>
    <AssemblyName>FracturingFog.Audio.Win</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Abstractions\FracturingFog.Abstractions.csproj" />
    <ProjectReference Include="..\Audio\FracturingFog.Audio.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.3.0" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Phase 3 server + client unit tests. Targets the same TFM as the
      libraries under test. Excluded from the WinExe Publish config so
      installers don't ship test binaries. Stays UI-free so it builds on
      any platform with the .NET 10 SDK.
    -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>FracturingFog.Server.Tests</RootNamespace>
    <AssemblyName>FracturingFog.Server.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.6.0" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Abstractions\FracturingFog.Abstractions.csproj" />
    <ProjectReference Include="..\Server\FracturingFog.Server.csproj" />
    <ProjectReference Include="..\Client\FracturingFog.Client.csproj" />
    <!--
      D-6b — Engine ref added so cluster ref-orbit tests can compare a
      shared-orbit sub-rect render against a full-image render for pixel
      parity. Engine is the smallest superset that exposes MandelbrotCalculator.
    -->
    <ProjectReference Include="..\Engine\FracturingFog.Engine.csproj" />
    <!-- F16 (#603): cross-platform Rendering.Vulkan carries the shared,
         dependency-free MandelbrotKernelSource + DxcCompiler, so the GPU orbit
         kernel-generation tests can build it and (when dxc is present) compile
         it — without pulling the Windows-only Rendering.D3D closure. -->
    <ProjectReference Include="..\Rendering.Vulkan\FracturingFog.Rendering.Vulkan.csproj" />
    <!--
      #27 Phase 3c — ColorGen.Lib ref so the "no user text reaches Roslyn"
      audit can drive ColorGenApi.Generate and assert injection-shaped sources
      are rejected by the DSL parser before any Roslyn compile.
    -->
    <ProjectReference Include="..\ColorGen.Lib\ColorGen.Lib.csproj" />
    <!--
      Region Editor (Animation Roadmap Sub-goal B) — Hosting ref added so the
      RegionEditorServiceTests can drive HostColorThemeService.GetRegionForEdit
      / UpdateRegionMetadata. Hosting is net10.0 and cross-platform-safe.
    -->
    <ProjectReference Include="..\Hosting\FracturingFog.Hosting.csproj" />
  </ItemGroup>

</Project>

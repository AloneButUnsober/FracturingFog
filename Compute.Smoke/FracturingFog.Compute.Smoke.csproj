<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Cross-platform CLI smoke for the ILGPU compute backend. Tiny console exe
    (one Main) that constructs an ILGPU.Context, picks an accelerator, runs a
    64×64 Mandelbrot kernel, prints the device kind + per-row iter histogram,
    and exits 0 on success. Phase X.5 / Slice 5.1 — mirrors Rendering.Silk.Smoke
    so CI can hook it on every leg and the matrix asserts the expected device
    kind per RID:
       win-x64    : Cuda | OpenCL | Velocity128 | CPU
       linux-x64  : Cuda | OpenCL | Velocity128 | CPU
       linux-arm64: CPU (no GPU access on CI)
       osx-arm64  : CPU (ILGPU Metal backend pending upstream)
       osx-x64    : CPU
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Platforms>AnyCPU;x64;arm64</Platforms>
    <RootNamespace>FracturingFog.Compute.Smoke</RootNamespace>
    <AssemblyName>FracturingFog.Compute.Smoke</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ILGPU" Version="1.5.3" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>FracturingFog.Tools.DocSiteGen</RootNamespace>
    <AssemblyName>FracturingFog.DocSiteGen</AssemblyName>
    <!--
      Not part of the main solution build. Run from the repo root:
        dotnet run :: project Tools/DocSiteGen
      Output lands in `Docs/site/` (relative to the repo root).
    -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Markdig is the standard .NET markdown processor. AdvancedExtensions
         pulls in tables, footnotes, task lists, emphasis extras, etc. -->
    <PackageReference Include="Markdig" Version="0.37.0" />
  </ItemGroup>

</Project>

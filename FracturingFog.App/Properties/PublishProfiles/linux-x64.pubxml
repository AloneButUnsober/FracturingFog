<?xml version="1.0" encoding="utf-8"?>
<!--
  Phase X.6 / Slice 6.1 — self-contained single-file publish for linux-x64.
  Wrapped by Tools/Packaging/build-appimage.sh (Slice 6.2) for the
  shipping artifact; the raw publish output is also usable directly.

  Invoke with:
    dotnet publish FracturingFog.App -c Release -p:PublishProfile=linux-x64
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>x64</Platform>
    <PublishDir>publish/linux-x64</PublishDir>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <TargetFramework>net10.0</TargetFramework>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>
</Project>

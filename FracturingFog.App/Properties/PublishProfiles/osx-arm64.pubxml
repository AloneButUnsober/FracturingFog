<?xml version="1.0" encoding="utf-8"?>
<!--
  Phase X.6 / Slice 6.1 — self-contained single-file publish for osx-arm64
  (Apple Silicon — M1/M2/M3/M4). Wrapped by Tools/Packaging/build-mac-app.sh
  (Slice 6.3) into a FracturingFog.app bundle for distribution; the raw
  publish output is also usable directly via the command line.

  ReadyToRun is on — crossgen2 supports osx-arm64 native AOT codegen
  from the macos-latest CI leg (Apple Silicon GitHub runner).

  Invoke with:
    dotnet publish FracturingFog.App -c Release -p:PublishProfile=osx-arm64
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>arm64</Platform>
    <PublishDir>publish/osx-arm64</PublishDir>
    <RuntimeIdentifier>osx-arm64</RuntimeIdentifier>
    <TargetFramework>net10.0</TargetFramework>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>
</Project>

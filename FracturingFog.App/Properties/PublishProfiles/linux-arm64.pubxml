<?xml version="1.0" encoding="utf-8"?>
<!--
  Phase X.6 / Slice 6.1 — self-contained single-file publish for linux-arm64
  (Raspberry Pi OS, AWS Graviton, Apple Silicon under Asahi/QEMU).
  ReadyToRun is disabled — the Linux runner CI builds on x64 and ReadyToRun
  cross-AOT codegen for arm64 from x64 requires the crossgen2 ARM
  toolchain that ships separately. Re-enable once CI runs on a native
  arm64 leg.

  Invoke with:
    dotnet publish FracturingFog.App -c Release -p:PublishProfile=linux-arm64
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>arm64</Platform>
    <PublishDir>publish/linux-arm64</PublishDir>
    <RuntimeIdentifier>linux-arm64</RuntimeIdentifier>
    <TargetFramework>net10.0</TargetFramework>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
    <PublishReadyToRun>false</PublishReadyToRun>
  </PropertyGroup>
</Project>

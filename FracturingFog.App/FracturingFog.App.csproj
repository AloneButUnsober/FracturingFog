<Project Sdk="Microsoft.NET.Sdk">

  <!--
    FracturingFog.App — cross-platform exe. Builds on win-x64, linux-x64,
    linux-arm64, osx-arm64, osx-x64. Default Avalonia entry point post-Phase
    X.0; FracturingFogCLD.csproj (the legacy WinExe) stays as the Windows
    fallback until parity is reached.

    Phase X.0 / Slice 0.5: scaffold only. Stub Program.cs returns 0. Project
    references are placeholders; the full closure (Engine, Audio, Hosting,
    UI.Avalonia, Rendering.Silk/Skia, Server, Client, CalculatorGen, ColorGen)
    lights up as the file-move slices land.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!--
      S-X3 (2026-06-23) — multi-targeted. Cross-plat legs (linux-x64,
      linux-arm64, osx-arm64, osx-x64) publish from the net10.0 TFM; the
      Windows leg publishes from net10.0-windows so it can ProjectReference
      FracturingFog.Win directly and call WindowsBootstrap.Install without
      reflection. Two output trees on Windows; the cross-plat legs ignore the
      net10.0-windows TFM entirely (it carries Windows-flavoured BCL surface
      that doesn't load on Linux).
    -->
    <TargetFrameworks>net10.0;net10.0-windows</TargetFrameworks>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>FracturingFog.App</RootNamespace>
    <!--
      Temporary assembly name during scaffolding so it doesn't collide with
      the legacy WinExe (which still ships as FracturingFog.exe). Phase X.0
      file-move tail flips this to FracturingFog once the legacy WinExe is
      either retired or its AssemblyName is renamed.
    -->
    <AssemblyName>FracturingFog.App</AssemblyName>
  </PropertyGroup>

  <!--
    S-X6 (2026-06-23) — Windows manifest. Without supportedOS Id (Win10),
    Avalonia's Win32NativeControlHost.DumbWindow ctor throws "Unable to
    create child window for native control host. Application manifest with
    supported OS list might be required." → GpuSurfaceControl never produces
    a surface → renderer never wired → window draws nothing → black. Same
    failure mode the legacy WinExe avoided by shipping app.manifest. Cross-
    plat TFM (net10.0) ignores the manifest.
  -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <ApplicationManifest>..\app.manifest</ApplicationManifest>
  </PropertyGroup>

  <!--
    S-X3 (2026-06-23) — Windows-only ProjectReferences. FracturingFog.Win
    (net10.0-windows) owns WindowsBootstrap.Install which writes the
    Windows-only hook surface onto AvaloniaShellBootstrap (HardwareInfoProvider,
    GpuKernelFactoryHook, NativeVideoWriterFactoryHook, NativeInputBridge).
    Cross-plat TFM (net10.0) leaves these unwired and the bootstrap takes its
    no-op fallbacks. The Win leg's ColorSampleBridge + SyncDialogs still live
    on the legacy WinExe (UseWindowsForms=true closure) — moving them into
    FracturingFog.Win is a later slice.
  -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <ProjectReference Include="..\FracturingFog.Win\FracturingFog.Win.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Abstractions\FracturingFog.Abstractions.csproj" />
    <ProjectReference Include="..\Engine\FracturingFog.Engine.csproj" />
    <ProjectReference Include="..\Hosting\FracturingFog.Hosting.csproj" />
    <!--
      Phase X.B / Slice B.6 — FracturingFog.Audio flipped to net10.0. Hosts
      the cross-platform AudioCaptureDriver + NoopAudioBackend + BeatAnalyzer.
      The Win-only NAudio capture backend (WASAPI/WinMM) lives in
      FracturingFog.Audio.Win and is reflectively loaded by
      AvaloniaShellBootstrap.CreateAudioBackend on Windows hosts.
    -->
    <ProjectReference Include="..\Audio\FracturingFog.Audio.csproj" />
    <!--
      S-X2 (2026-06-23) — Rendering.Silk powers the cross-plat OpenGL backend
      and the silk-smoke entry point. Cross-plat net10.0; safe everywhere.
    -->
    <ProjectReference Include="..\Rendering.Silk\FracturingFog.Rendering.Silk.csproj" />

    <!--
      S-X7.1b (2026-06-23) — headless JSON-RPC server now cross-plat. HostFractalRenderEngine
      and ServerEntry are source-linked below; the protocol + transport ship
      from FracturingFog.Server.
    -->
    <ProjectReference Include="..\Server\FracturingFog.Server.csproj" />

    <!--
      D-2b (2026-06-27) — cluster mode needs the IClusterImageCodec
      Skia impl in ServerHost/SkiaClusterImageCodec.cs. Rendering.Skia
      already targets cross-plat net10.0 and pulls SkiaSharp transitively,
      so adding it here is zero-cost vs. carving a new package ref.
    -->
    <ProjectReference Include="..\Rendering.Skia\FracturingFog.Rendering.Skia.csproj" />
  </ItemGroup>

  <!--
    S-X7.1b (2026-06-23) — server entry + render engine sources linked from
    ServerHost/. Lives in the legacy WinExe project root which globs them via
    root *.cs; linking is lower-friction than carving a new project for two
    files. HostFractalRenderEngine routes through BootstrapHooks.NativeVideoWriterFactoryHook
    + ImageExport (SkiaSharp) so it has zero Win-only deps now.
    D-2b — added ClusterEntry, SkiaClusterImageCodec, ClusterParitySelfTest.
  -->
  <ItemGroup>
    <Compile Include="..\ServerHost\ServerEntry.cs" Link="ServerEntry.cs" />
    <Compile Include="..\ServerHost\HostFractalRenderEngine.cs" Link="HostFractalRenderEngine.cs" />
    <Compile Include="..\ServerHost\ClusterEntry.cs" Link="ClusterEntry.cs" />
    <Compile Include="..\ServerHost\SkiaClusterImageCodec.cs" Link="SkiaClusterImageCodec.cs" />
    <Compile Include="..\ServerHost\ClusterParitySelfTest.cs" Link="ClusterParitySelfTest.cs" />
    <Compile Include="..\ServerHost\ClusterScaleSelfTest.cs" Link="ClusterScaleSelfTest.cs" />
    <Compile Include="..\ServerHost\ClusterVideoParitySelfTest.cs" Link="ClusterVideoParitySelfTest.cs" />
  </ItemGroup>

  <!--
    VLAO audit #291 — headless batch subsystem. The Batch/ folder has no
    csproj of its own; the legacy WinExe root-globs it. Source-link it here so
    the cross-platform exe can dispatch the batch flag too. BatchRenderer's only
    Windows-only dependency (the Media-Foundation Mp4Writer in Rendering.D3D)
    is behind BootstrapHooks.BatchVideoWriterFactoryHook, so this closure
    compiles on the net10.0 (cross-plat) leg.
  -->
  <ItemGroup>
    <Compile Include="..\Batch\*.cs" LinkBase="Batch" />
  </ItemGroup>

  <!--
    ffmpeg is intentionally NOT bundled. Prebuilt ffmpeg binaries typically
    enable GPL codecs, so shipping one would drag GPL redistribution duties
    (license + corresponding-source offer) onto every release. Instead it is
    resolved at runtime: FfmpegEncoder.FindFfmpeg probes PATH / the app base /
    Tools/<rid>, and FfmpegInstaller can fetch it on demand. Linux/macOS users
    install via apt/brew. To bundle a licensed (e.g. LGPL) build per RID later,
    add a per-RID <None Include=... CopyToOutputDirectory> item here.
  -->

  <!--
    Windows-only project refs (Rendering.D3D, FracturingFog.Win, Audio.Win) are
    not wired in this scaffold pass because they target net10.0-windows and
    cannot be referenced by a plain net10.0 project even with MSBuild
    conditions (NuGet evaluates TFM compatibility before conditions resolve;
    NU1201 fires on Windows too).

    The plan's options for re-introducing them:
      (a) Multi-target the App as <TargetFrameworks>net10.0;net10.0-windows</TargetFrameworks>
          and put the Win-only refs inside <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">.
          Doubles the build output on Windows but is the cleanest split.
      (b) Multi-target each Win-only support project as net10.0;net10.0-windows
          with an empty net10.0 stub and the Win API surface inside <ItemGroup
          Condition="'$(TargetFramework)' == 'net10.0-windows'">. App stays
          single-target net10.0.
      (c) Load the Win-only assemblies via Assembly.LoadFrom at boot. Reflective
          access; loses compile-time API checks.

    Decision deferred to the file-move slices (X.0 / 0.4 + 0.5). For scaffold
    verification, the cross-platform closure (Engine + Audio + Hosting) is
    enough to prove the geometry.
  -->


</Project>

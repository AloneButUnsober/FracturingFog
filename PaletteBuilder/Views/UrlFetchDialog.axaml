<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PaletteBuilder.Views.UrlFetchDialog"
        Title="Load Image from URL"
        Width="520"
        Height="280"
        WindowStartupLocation="CenterOwner"
        Background="#161616"
        Foreground="#DCDCDC"
        CanResize="False">

    <Grid Margin="16" RowDefinitions="Auto,Auto,Auto,*,Auto">

        <TextBlock Grid.Row="0"
                   Text="HTTPS image URL"
                   FontWeight="Bold"
                   Foreground="#C8C864"
                   Margin="0,0,0,4" />

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
            <TextBox x:Name="UrlBox"
                     Grid.Column="0"
                     PlaceholderText="https://example.com/image.png"
                     Margin="0,0,8,0" />
            <Button x:Name="FetchButton"
                    Grid.Column="1"
                    Content="Fetch"
                    Click="OnFetchClick"
                    Background="#2D4164"
                    Foreground="White"
                    Padding="14,4" />
        </Grid>

        <TextBlock x:Name="StatusText"
                   Grid.Row="2"
                   Foreground="#A0A0A0"
                   TextWrapping="Wrap"
                   FontSize="11"
                   Text="HTTPS only. 25 MB cap. Server addresses on private/loopback/link-local networks are blocked." />

        <Border x:Name="ConfirmPanel"
                Grid.Row="3"
                Margin="0,12,0,0"
                Background="#1E1E1E"
                BorderBrush="#505050"
                BorderThickness="1"
                Padding="12"
                IsVisible="False">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="120,*">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Host"     Foreground="#B4B4B4" />
                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="HostText"        Foreground="#DCDCDC" />
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Content-Type" Foreground="#B4B4B4" />
                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="ContentTypeText" Foreground="#DCDCDC" />
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Size"     Foreground="#B4B4B4" />
                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="SizeText"        Foreground="#DCDCDC" />
            </Grid>
        </Border>

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button x:Name="LoadButton"
                    Content="Load"
                    Click="OnLoadClick"
                    Background="#28643C"
                    Foreground="White"
                    Padding="14,6"
                    FontWeight="Bold"
                    IsEnabled="False"
                    Margin="0,0,8,0" />
            <Button Content="Cancel"
                    Click="OnCancelClick"
                    Background="#463232"
                    Foreground="White"
                    Padding="14,6" />
        </StackPanel>
    </Grid>
</Window>

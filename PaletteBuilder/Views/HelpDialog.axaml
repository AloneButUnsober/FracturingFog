<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PaletteBuilder.Views.HelpDialog"
        Title="Palette Builder — Help"
        Width="900"
        Height="760"
        Background="#161616"
        Foreground="#DCDCDC"
        WindowStartupLocation="CenterOwner">
    <Grid RowDefinitions="Auto,*,Auto" Margin="12">
        <TextBlock Grid.Row="0"
                   Text="User Documentation"
                   Foreground="#C8C864"
                   FontSize="16"
                   FontWeight="Bold"
                   Margin="0,0,0,8" />

        <Border Grid.Row="1"
                Background="#1C1C1C"
                BorderBrush="#3C3C3C"
                BorderThickness="1">
            <ScrollViewer Name="HelpScroll"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          Padding="12">
                <StackPanel Name="HelpContent" Spacing="2" />
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8"
                    Margin="0,10,0,0">
            <Button Name="CopyBtn" Content="Copy all" Padding="14,4" />
            <Button Name="CloseBtn" Content="Close" Padding="14,4" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>

<?xml version="1.0" encoding="utf-8"?>
<!--
  Self-contained single-file publish for linux-x64, mirroring
  FracturingFog.App/Properties/PublishProfiles/linux-x64.pubxml so the same
  Tools/Packaging/build-appimage.sh pattern works for the standalone
  PaletteBuilder wrapper (net10.0, cross-platform since the TFM flip).

  Invoke with:
    dotnet publish PaletteBuilder -c Release -p:PublishProfile=linux-x64
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>x64</Platform>
    <PublishDir>publish/linux-x64</PublishDir>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <TargetFramework>net10.0</TargetFramework>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>
</Project>

<?xml version="1.0" encoding="utf-8"?>
<!--
  Self-contained single-file publish for linux-arm64, mirroring
  FracturingFog.App/Properties/PublishProfiles/linux-arm64.pubxml.
  ReadyToRun disabled — cross-AOT codegen for arm64 from an x64 build
  host needs the crossgen2 ARM toolchain, same reasoning as the App profile.

  Invoke with:
    dotnet publish PaletteBuilder -c Release -p:PublishProfile=linux-arm64
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>arm64</Platform>
    <PublishDir>publish/linux-arm64</PublishDir>
    <RuntimeIdentifier>linux-arm64</RuntimeIdentifier>
    <TargetFramework>net10.0</TargetFramework>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
    <PublishReadyToRun>false</PublishReadyToRun>
  </PropertyGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!--
      Phase X.6 / Slice 6.1: IsPublishable=false stops the host App's
      `dotnet publish` from emitting a separate Exe tree for this
      project. NETSDK1150 still trips when FracturingFog.App publishes
      self-contained because this Exe is consumed transitively as a
      library via UI.Avalonia. Resolution is parked behind a follow-up
      that splits ColorGen into a Lib + thin CLI wrapper Exe; for
      now `dotnet publish` of the App requires the workaround
      documented in Docs/Technical/CrossPlatform-SmokeTests.md.
    -->
    <IsPublishable>false</IsPublishable>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>FracturingFog.ColorGen</RootNamespace>
    <AssemblyName>ColorGen</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Templates\**" />
    <Compile Remove="SampleOutput\**" />
    <None Include="Templates\ColorMap.template.cs" />
    <EmbeddedResource Include="Templates\ColorMap.template.cs" />
  </ItemGroup>

  <!--
    Roslyn compiler — ColorGenHotLoad uses Microsoft.CodeAnalysis.CSharp to
    compile a freshly-rendered theme into an in-memory IColorMap so the
    ColorGenEditor can preview / apply without rebuilding the host.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.3.0" />
  </ItemGroup>

</Project>

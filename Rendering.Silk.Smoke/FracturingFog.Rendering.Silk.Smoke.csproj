<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Cross-platform CLI smoke for the Silk.NET OpenGL backend. Tiny console
      exe (one Main) that calls SilkStandaloneRunner.SmokeOneFrame and
      exits 0 on success. CI hooks it on linux-x64 (under xvfb-run) and
      osx-arm64 to validate that the native Silk.NET + libGL + GLFW chain
      loaded correctly per RID.

      Kept out of the main WinExe so the smoke binary publishes on platforms
      where the WinForms WinExe (net10.0-windows + Vortice) cannot build.
    -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Platforms>AnyCPU;x64;arm64</Platforms>
    <RootNamespace>FracturingFog.Rendering.Silk.Smoke</RootNamespace>
    <AssemblyName>FracturingFog.Rendering.Silk.Smoke</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Rendering.Silk\FracturingFog.Rendering.Silk.csproj" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <!--
    FracturingFog.Win — Windows-only-but-not-WinForms surface. Holds:
      * NativeMouseForwarder (HWND subclass via user32/comctl32)
      * ImageExportGdi: GDI+ watermark + ImageFormat-taking ImageExport
        overloads carved out of Engine.Imaging.ImageExport so the engine
        can drop its System.Drawing.Common reference (Phase X.A / Slice A.7).

    The legacy WinExe (FracturingFogCLD) keeps the WinForms shell; this
    project is referenced by the WinExe and (on Windows) by the
    cross-platform App.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>false</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Platforms>AnyCPU;x64</Platforms>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <RootNamespace>FracturingFog.Hosting</RootNamespace>
    <AssemblyName>FracturingFog.Win</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Abstractions\FracturingFog.Abstractions.csproj" />
    <ProjectReference Include="..\Engine\FracturingFog.Engine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      GDI+ watermark + legacy ImageFormat encode path. System.Drawing.Common
      and SkiaSharp live here so Engine can stay net10.0 + no GDI+. The Skia
      fallback inside the Windows-only ImageFormat overloads is dead code on
      Windows but kept for byte-for-byte parity with the pre-extraction code.
    -->
    <PackageReference Include="System.Drawing.Common" Version="10.0.8" />
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <!--
    FracturingFog.Hosting — cross-platform host glue. Owns AvaloniaShellBootstrap,
    HostColorThemeService, HostHelpContentProvider, and friends. Both shells
    (Avalonia FracturingFog.App and legacy FracturingFogCLD WinExe) reference
    this project for the boot graph.

    Windows-only host bits (NativeMouseForwarder HWND subclass, the WinForms
    FfmpegSetupDialog) live in FracturingFog.Win.

    Phase X.0 / Slice 0.3: scaffold only. EnableDefaultCompileItems=false so
    in-folder Hosting/*.cs keep compiling inside FracturingFogCLD until the
    file-move slice flips ownership.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>FracturingFog.Hosting</RootNamespace>
    <AssemblyName>FracturingFog.Hosting</AssemblyName>
  </PropertyGroup>

  <!--
    S-X1b.6 (2026-06-23) — AvaloniaShellBootstrap.cs flipped into Hosting.dll
    after the carve is complete:
      * RendererFactory cross-plat dispatch lives in Engine; the Win-only
        IntPtr Create + Probe stay in Rendering.D3D as WindowsDxRendererFactory.
      * WinForms PromptName/ConfirmYesNo/ShowInfo/PickOpenSync/PickSaveSync
        private helpers replaced by IHostSyncDialogs hook indirection.
      * UserBulbMeshExporter relocated to Engine\Export\.
      * HostPaletteExtractionService + PaletteFileIO now owned by Hosting.
    WinExe consumes the bootstrap across the Hosting ProjectReference; the
    matching Compile Remove in FracturingFogCLD.csproj drops the duplicate.
  -->

  <ItemGroup>
    <ProjectReference Include="..\Abstractions\FracturingFog.Abstractions.csproj" />
    <ProjectReference Include="..\Engine\FracturingFog.Engine.csproj" />
    <ProjectReference Include="..\Audio\FracturingFog.Audio.csproj" />
    <ProjectReference Include="..\UI.Avalonia\FracturingFog.UI.Avalonia.csproj">
      <ExcludeAssets>analyzers</ExcludeAssets>
    </ProjectReference>
    <!--
      Wave 1.C1 closure (2026-06-22) — PaletteBuilder.Lib needed by
      AvaloniaDialogs.ShowImagePalettePickerAsync (the "From Image…" picker).
      Lib flipped to net10.0 in Wave 1.8 (Slice 1.2) so it's now safe to
      consume from cross-platform Hosting.
    -->
    <ProjectReference Include="..\PaletteBuilder\PaletteBuilder.Lib.csproj">
      <ExcludeAssets>analyzers</ExcludeAssets>
    </ProjectReference>
    <!--
      S-X1b.6 — the bootstrap imports FracturingFog.Rendering.Silk for the
      Silk.NET OpenGL backend it wires into RendererFactory.NonWin32Backend.
    -->
    <ProjectReference Include="..\Rendering.Silk\FracturingFog.Rendering.Silk.csproj" />
  </ItemGroup>

  <!--
    Strip the Avalonia analyzer chain transitively imported via the
    UI.Avalonia project reference. Same workaround as FracturingFogCLD.csproj.
  -->
  <Target Name="StripAvaloniaAnalyzers" BeforeTargets="CoreCompile">
    <ItemGroup>
      <Analyzer Remove="@(Analyzer)" Condition="$([System.String]::Copy('%(Analyzer.Identity)').Contains('Avalonia'))" />
    </ItemGroup>
  </Target>

</Project>

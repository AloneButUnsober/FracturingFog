<Project Sdk="Microsoft.NET.Sdk">

  <!--
    FracturingFog.Rendering.D3D — Windows-only DirectX 11/12 renderer + Media
    Foundation MP4 writer. Carved out of the WinExe so the cross-platform App
    can reference it via an OS-conditional ProjectReference.

    Phase X.0 / Slice 0.4: scaffold only. No source files yet. The Vortice
    package refs land when DirectXRenderer.cs, DirectX12Renderer.cs,
    RenderFactory.cs and Imaging/MP4Writer.cs move in.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>false</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>FracturingFog.Rendering</RootNamespace>
    <AssemblyName>FracturingFog.Rendering.D3D</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Abstractions\FracturingFog.Abstractions.csproj" />
    <ProjectReference Include="..\Engine\FracturingFog.Engine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Phase X.0 / Slice 0.1b: MandelbrotGpuKernel (Direct3D 11 compute shader)
      relocated here from Engine. Owns Vortice D3D11 buffers + compute shader
      handles directly. Implements FracturingFog.Rendering.IGpuKernel so the
      Engine calculators can drive it across a cross-platform interface
      boundary. MP4Writer (Media Foundation P/Invoke) and the DirectX 11/12
      renderers themselves land here in Slice 0.4.
    -->
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.Direct3D12" Version="3.8.3" />
    <PackageReference Include="Vortice.DirectX" Version="3.8.3" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
    <PackageReference Include="Vortice.D3DCompiler" Version="3.8.3" />
    <PackageReference Include="Vortice.Mathematics" Version="2.1.1" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Platforms>x64;AnyCPU</Platforms>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Optimize>true</Optimize>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>FracturingFog</AssemblyName>
    <RootNamespace>FracturingFog</RootNamespace>
    <GenerateDocumentationFile>False</GenerateDocumentationFile>
    <Configurations>Debug;Release;Publish</Configurations>
    <ProduceReferenceAssembly>False</ProduceReferenceAssembly>
    <Title>Fracturing Fog</Title>
    <Version>0.6.2</Version>
    <ApplicationIcon>Resources\FracturingFog.ico</ApplicationIcon>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <DebugType>full</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DebugType>full</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <DebugType>full</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DebugType>full</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Publish|x64'">
    <DebugType>full</DebugType>
    <!--
      Tier 3: emit native ReadyToRun code alongside IL. Kills JIT-warmup
      tax on first frame after launch and on hot-reload of UserEquation /
      Sandbox / ColorGen assemblies. Publish-only (does nothing on Debug /
      Release `dotnet build`). PublishReadyToRunComposite=true compiles
      the full closure including dependent assemblies into one R2R image.
    -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishReadyToRunComposite>true</PublishReadyToRunComposite>
    <TieredCompilation>true</TieredCompilation>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Publish|AnyCPU'">
    <DebugType>full</DebugType>
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishReadyToRunComposite>true</PublishReadyToRunComposite>
    <TieredCompilation>true</TieredCompilation>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="formmain.txt" />
    <None Remove="MainForm - Copy.cs.20260416-" />
    <None Remove="MainForm - Copy.cs.orig" />
    <None Remove="MNDD3D-VRT383.zip" />
    <None Remove="Resources\FFLogo.bmp" />
    <None Remove="Resources\FFLogo.png" />
    <None Remove="Resources\ResolutionRatios.txt" />
  </ItemGroup>

  <!--
    Exclude the sibling projects' source trees from the WinExe's implicit SDK
    globbing. Without these excludes MSBuild compiles Abstractions/*.cs and
    UI.Avalonia/**/*.cs twice (once into their own assemblies via the
    ProjectReference, once into this WinExe via the default glob), producing
    CS0436 duplicate-type warnings and CS0579 duplicate assembly-attribute
    errors when the Avalonia project's obj/ files leak in.
  -->
  <ItemGroup>
    <Compile Remove="Abstractions\**" />
    <Compile Remove="UI.Avalonia\**" />
    <Compile Remove="PaletteBuilder\**" />
    <Compile Remove="Rendering.Silk\**" />
    <Compile Remove="Rendering.Silk.Smoke\**" />
    <Compile Remove="Rendering.Skia\**" />
    <Compile Remove="Server\**" />
    <Compile Remove="Server.Tests\**" />
    <Compile Remove="Client\**" />
    <Compile Remove="CalculatorGen\**" />
    <Compile Remove="ColorGen\**" />
    <!--
      Phase X.0 cross-platform scaffolding. These sibling projects sit under
      the WinExe's root folder and the SDK's default Compile glob would slurp
      their sources into the WinExe build. Engine/, Rendering.D3D/,
      FracturingFog.Win/, Audio.Win/, FracturingFog.App/ are scaffolding
      placeholders today (no .cs files yet beyond FracturingFog.App/Program.cs);
      the excludes stay in place as the file-move slices populate them.
    -->
    <Compile Remove="Engine\**" />
    <Compile Remove="Rendering.D3D\**" />
    <Compile Remove="FracturingFog.Win\**" />
    <Compile Remove="Audio.Win\**" />
    <Compile Remove="FracturingFog.App\**" />
    <!--
      Phase X.0 / Slice 0.3a — files moved into FracturingFog.Hosting.csproj.
      WinExe consumes them across the new assembly boundary via the
      ProjectReference below. AvaloniaShellBootstrap, NativeMouseForwarder,
      HostPaletteExtractionService, FfmpegSetupDialog, AvaloniaDialogs stay
      in WinExe for now (see FracturingFog.Hosting.csproj for the gating
      rationale).
    -->
    <Compile Remove="Hosting\HostColorThemeService.cs" />
    <Compile Remove="Hosting\ColorThemeDefAdapter.cs" />
    <Compile Remove="Hosting\PngSlideshowFrameRecorder.cs" />
    <!--
      Phase X.0 / Slice 0.2 — Audio files now owned by FracturingFog.Audio
      (temporary net10.0-windows TFM until Phase X.B introduces the backend
      abstraction). WinExe consumes them across the ProjectReference below.
    -->
    <Compile Remove="Audio\**" />
    <!--
      Audio/ and Hosting/ stay owned by this WinExe's default Compile glob
      during Phase X.0 scaffolding (their sibling FracturingFog.Audio.csproj
      / FracturingFog.Hosting.csproj set EnableDefaultCompileItems=false so
      they compile nothing). But each sibling project still writes its own
      obj/<config>/<tfm>/*.AssemblyInfo.cs into Audio\obj\ and Hosting\obj\,
      which THIS WinExe's glob then slurps -> CS0579 duplicate-attribute
      cascade. Exclude the sibling obj/ + bin/ subtrees explicitly so the
      WinExe ignores its neighbours' scratch state. These excludes go away
      with the file-move slices, which flip both folders to
      EnableDefaultCompileItems=true on the new projects and drop the WinExe
      ownership.
    -->
    <Compile Remove="Audio\obj\**" />
    <Compile Remove="Audio\bin\**" />
    <Compile Remove="Hosting\obj\**" />
    <Compile Remove="Hosting\bin\**" />
    <None Remove="Audio\obj\**" />
    <None Remove="Audio\bin\**" />
    <None Remove="Hosting\obj\**" />
    <None Remove="Hosting\bin\**" />
    <EmbeddedResource Remove="Audio\obj\**" />
    <EmbeddedResource Remove="Audio\bin\**" />
    <EmbeddedResource Remove="Hosting\obj\**" />
    <EmbeddedResource Remove="Hosting\bin\**" />
    <Content Remove="Audio\obj\**" />
    <Content Remove="Audio\bin\**" />
    <Content Remove="Hosting\obj\**" />
    <Content Remove="Hosting\bin\**" />
    <!--
      Tools/ holds sibling console projects (DocSiteGen) that have their own
      ImplicitUsings + obj/ trees. Without this exclude the WinExe glob slurps
      Tools/DocSiteGen/**/*.cs *and* its generated GlobalUsings.cs — which
      injects `global using System.Threading;` into this project and makes
      every legacy WinForms `Timer` reference ambiguous against
      System.Threading.Timer (CS0104). Also duplicates the AssemblyInfo
      attributes (CS0579) and demands Markdig (CS0246).
    -->
    <Compile Remove="Tools\**" />
    <!--
      The palette-extraction engine (extractors + BitmapSampler + stop
      builder + types under namespace FracturingFog.Imaging.PaletteExtraction)
      now lives in PaletteBuilder.Lib.dll. Stripping the in-tree copy here
      keeps the types in exactly one assembly so consumers that reference
      both the host and PaletteBuilder.Lib never hit CS0436. The Hosting/
      HostPaletteExtractionService.cs file (which uses these types) now
      resolves them through the ProjectReference below.
    -->
    <Compile Remove="Imaging\PaletteExtraction\**" />
    <None Remove="Abstractions\**" />
    <None Remove="UI.Avalonia\**" />
    <None Remove="PaletteBuilder\**" />
    <None Remove="Rendering.Silk\**" />
    <None Remove="Rendering.Silk.Smoke\**" />
    <None Remove="Rendering.Skia\**" />
    <None Remove="Server\**" />
    <None Remove="Server.Tests\**" />
    <None Remove="Client\**" />
    <None Remove="CalculatorGen\**" />
    <None Remove="ColorGen\**" />
    <None Remove="Tools\**" />
    <None Remove="Engine\**" />
    <None Remove="Rendering.D3D\**" />
    <None Remove="FracturingFog.Win\**" />
    <None Remove="Audio.Win\**" />
    <None Remove="FracturingFog.App\**" />
    <EmbeddedResource Remove="Abstractions\**" />
    <EmbeddedResource Remove="UI.Avalonia\**" />
    <EmbeddedResource Remove="PaletteBuilder\**" />
    <EmbeddedResource Remove="Rendering.Silk\**" />
    <EmbeddedResource Remove="Rendering.Silk.Smoke\**" />
    <EmbeddedResource Remove="Rendering.Skia\**" />
    <EmbeddedResource Remove="Server\**" />
    <EmbeddedResource Remove="Server.Tests\**" />
    <EmbeddedResource Remove="Client\**" />
    <EmbeddedResource Remove="CalculatorGen\**" />
    <EmbeddedResource Remove="ColorGen\**" />
    <EmbeddedResource Remove="Tools\**" />
    <EmbeddedResource Remove="Engine\**" />
    <EmbeddedResource Remove="Rendering.D3D\**" />
    <EmbeddedResource Remove="FracturingFog.Win\**" />
    <EmbeddedResource Remove="Audio.Win\**" />
    <EmbeddedResource Remove="FracturingFog.App\**" />
    <Content Remove="Abstractions\**" />
    <Content Remove="UI.Avalonia\**" />
    <Content Remove="PaletteBuilder\**" />
    <Content Remove="Rendering.Silk\**" />
    <Content Remove="Rendering.Silk.Smoke\**" />
    <Content Remove="Rendering.Skia\**" />
    <Content Remove="Server\**" />
    <Content Remove="Server.Tests\**" />
    <Content Remove="Client\**" />
    <Content Remove="CalculatorGen\**" />
    <Content Remove="ColorGen\**" />
    <Content Remove="Tools\**" />
    <Content Remove="Engine\**" />
    <Content Remove="Rendering.D3D\**" />
    <Content Remove="FracturingFog.Win\**" />
    <Content Remove="Audio.Win\**" />
    <Content Remove="FracturingFog.App\**" />
    <!--
      Avalonia's MSBuild targets add *.axaml as AvaloniaResource and AvaloniaXaml
      items automatically from anywhere under the project root. Strip the UI
      shell's tree from this WinExe — those files compile inside UI.Avalonia.dll.
    -->
    <AvaloniaResource Remove="UI.Avalonia\**" />
    <AvaloniaResource Remove="PaletteBuilder\**" />
    <AvaloniaXaml Remove="UI.Avalonia\**" />
    <AvaloniaXaml Remove="PaletteBuilder\**" />
    <ApplicationDefinition Remove="UI.Avalonia\**" />
    <ApplicationDefinition Remove="PaletteBuilder\**" />
    <Page Remove="UI.Avalonia\**" />
    <Page Remove="PaletteBuilder\**" />
    <AdditionalFiles Remove="UI.Avalonia\**" />
    <AdditionalFiles Remove="PaletteBuilder\**" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Resources\FracturingFog.ico" />
  </ItemGroup>

  <ItemGroup>
    <None Include="C:\Users\bradl\Documents\regions.json" Link="Resources\regions.json" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="5.3.0" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.Direct3D12" Version="3.8.3" />
    <PackageReference Include="Vortice.DirectX" Version="3.8.3" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
    <PackageReference Include="Vortice.D3DCompiler" Version="3.8.3" />
    <PackageReference Include="Vortice.Mathematics" Version="2.1.1" />
    <PackageReference Include="NAudio" Version="2.3.0" />
    <PackageReference Include="ILGPU" Version="1.5.3" />
  </ItemGroup>
  <ItemGroup>
    <!-- Shared UI-free contracts (IGpuSurface and future siblings). -->
    <ProjectReference Include="Abstractions\FracturingFog.Abstractions.csproj" />
    <!--
      Phase X.0 / Slice 0.1 — cross-platform engine assembly. Owns the
      calculator fleet, model types (color schemes, kernels, palettes),
      interface contracts, and FFMath (BLA + SA series). Moved out of the
      WinExe so a non-Windows host can reference it without dragging
      net10.0-windows / WinForms. WinExe continues to consume the same
      types through this ProjectReference; downstream sibling projects
      (UI.Avalonia, PaletteBuilder.Lib, Server) gain Engine references in
      later slices as they need them.
    -->
    <ProjectReference Include="Engine\FracturingFog.Engine.csproj" />
    <!--
      Phase X.0 / Slice 0.1b — Windows-only D3D11 compute backend that owns
      MandelbrotGpuKernel. Required so FractalRenderHost (still in this
      WinExe) can construct the kernel from a live ID3D11Device + immediate
      context. Slice 0.4 lands DirectXRenderer / DirectX12Renderer /
      RenderFactory + MP4Writer in this same assembly; until then it's
      MandelbrotGpuKernel-only.
    -->
    <ProjectReference Include="Rendering.D3D\FracturingFog.Rendering.D3D.csproj" />
    <!--
      Phase X.0 / Slice 0.3a — cross-platform host glue (HostColorThemeService,
      HostHelpContentProvider, ColorThemeDefAdapter, PngSlideshowFrameRecorder).
      The remaining Hosting/*.cs files stay compiled inside this WinExe via
      the SDK default glob.
    -->
    <ProjectReference Include="Hosting\FracturingFog.Hosting.csproj" />
    <!--
      Phase X.0 / Slice 0.2 — audio capture + beat analyzer + fractal synth.
      Temporary net10.0-windows TFM; Phase X.B flips to net10.0 after the
      backend abstraction lands.
    -->
    <ProjectReference Include="Audio\FracturingFog.Audio.csproj" />
    <!--
      Phase 2 Avalonia shell. Referenced so the avalonia CLI flag launches
      the new UI from the same WinExe during the migration. Remove when
      Phase 2.3 swaps to Avalonia as the primary entry point.

      ExcludeAssets=analyzers blocks the transitive Avalonia source generator
      (Avalonia.Generators.NameGenerator) from re-running inside this WinExe
      and emitting MainWindow.g.cs against types not referenced here. The
      generator already ran in UI.Avalonia.dll where the XAML lives.
    -->
    <ProjectReference Include="UI.Avalonia\FracturingFog.UI.Avalonia.csproj">
      <ExcludeAssets>analyzers</ExcludeAssets>
    </ProjectReference>
    <!--
      Phase 2.4 cross-platform renderer (Silk.NET OpenGL). Referenced so the
      WinExe ships the assembly alongside the DirectX backends; the host
      bootstrap registers it as RendererFactory.NonWin32Backend on Linux/macOS.
      No runtime cost on Windows (the DX path always wins).
    -->
    <ProjectReference Include="Rendering.Silk\FracturingFog.Rendering.Silk.csproj" />
    <!--
      Phase 2.4 sibling backend (Skia CPU). Referenced so the WinExe ships
      the assembly alongside the Silk + DX backends; bootstrap can pick it
      as an alternate NonWin32Backend on hosts with broken or absent GL
      drivers. Default behaviour is unchanged.
    -->
    <ProjectReference Include="Rendering.Skia\FracturingFog.Rendering.Skia.csproj" />
    <!--
      Phase 3 headless server engine. The WinExe hosts FFServer under
      the server CLI flag. Stays UI-free; no Avalonia bleed.
    -->
    <ProjectReference Include="Server\FracturingFog.Server.csproj" />
    <!--
      Phase 3 client lib (mTLS JSON-RPC consumer + persistence). Shared
      between the Avalonia FFClient dialog and the WinExe headless batch
      remote path.
    -->
    <ProjectReference Include="Client\FracturingFog.Client.csproj" />
    <!--
      CalculatorGen library reference. The CLI exe is still built
      separately by `dotnet build CalculatorGen\CalculatorGen.csproj`;
      this reference exposes CalculatorGenApi.Generate() so the
      UserEquation dialog can render a calculator from inside the app
      in addition to the CLI workflow.
    -->
    <ProjectReference Include="CalculatorGen\CalculatorGen.csproj" />
    <!--
      ColorGen library reference. Exposes ColorGenApi.Generate() +
      ColorGenHotLoad.TryCompileAndLoad() so the ColorGen editor can
      render an algorithmic colour theme and hot-load it without a rebuild.
    -->
    <ProjectReference Include="ColorGen\ColorGen.csproj" />
    <!--
      Palette Builder lib. Provides the standalone palette UI (MainWindow)
      that the host opens in picker mode for the "From Image…" flow, plus
      the palette-extraction engine (extractors + BitmapSampler + stop
      builder under FracturingFog.Imaging.PaletteExtraction). The host
      strips its own copy of Imaging\PaletteExtraction\** from the SDK
      Compile glob above so those types live in PaletteBuilder.Lib.dll
      only — Hosting/HostPaletteExtractionService.cs resolves them through
      this reference. ExcludeAssets=analyzers blocks the transitive
      Avalonia name-generator (same workaround as UI.Avalonia ref above).
    -->
    <ProjectReference Include="PaletteBuilder\PaletteBuilder.Lib.csproj" SetPlatform="Platform=x64">
      <ExcludeAssets>analyzers</ExcludeAssets>
    </ProjectReference>
  </ItemGroup>

  <!--
    Belt-and-braces: strip any analyzer assembly whose path contains
    "Avalonia" from this project's analyzer set before CoreCompile runs.
    Avalonia's XAML name-generator (Avalonia.NameGenerator) is delivered
    as a NuGet analyzer that leaks transitively through the ProjectReference
    above despite ExcludeAssets/PrivateAssets — see
    https://github.com/AvaloniaUI/Avalonia/issues/14438 — and emits a
    generated partial for FracturingFog.UI.Avalonia.Views.MainWindow into
    this WinExe's obj/ tree, failing to compile because the Avalonia
    runtime types it references are not in scope here.
  -->
  <Target Name="StripAvaloniaAnalyzers" BeforeTargets="CoreCompile">
    <ItemGroup>
      <Analyzer Remove="@(Analyzer)" Condition="$([System.String]::Copy('%(Analyzer.Identity)').Contains('Avalonia'))" />
    </ItemGroup>
  </Target>
  <ItemGroup>
    <None Update="Resources\colorthemes.json">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </None>
    <None Update="Resources\ColorThemes\colorthemes.json">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </None>
    <None Update="Resources\ColorThemes\colorthemes.json.20260513">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </None>
    <None Update="Resources\copythemesregions.bat">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </None>
    <None Update="Resources\FracturingFog.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Resources\regions.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Resources\regions.json.20260514">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </None>
    <None Update="Resources\reset.bmp">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>

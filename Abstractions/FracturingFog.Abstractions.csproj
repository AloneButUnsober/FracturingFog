<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Tiny shared-contracts library. Holds only the interfaces both the
      Avalonia shell and the legacy WinForms shell need to talk about renderer
      hosting (IGpuSurface today; IRendererFactory and friends as Phase 2
      progresses). Keeping this assembly UI-free and platform-free is what
      breaks the otherwise-circular ProjectReference between the WinForms
      WinExe and the Avalonia UI library.
    -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>FracturingFog.Abstractions</RootNamespace>
    <AssemblyName>FracturingFog.Abstractions</AssemblyName>
  </PropertyGroup>

</Project>

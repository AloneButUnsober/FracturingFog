<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>FracturingFog.CalculatorGen</RootNamespace>
    <AssemblyName>CalculatorGen</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Templates\**" />
    <Compile Remove="SampleOutput\**" />
    <None Include="Templates\Calculator.template.cs" />
    <None Include="Templates\SelfTest.template.cs" />
    <EmbeddedResource Include="Templates\Calculator.template.cs" />
    <EmbeddedResource Include="Templates\SelfTest.template.cs" />
  </ItemGroup>

</Project>

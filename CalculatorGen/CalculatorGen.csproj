<Project Sdk="Microsoft.NET.Sdk">

  <!--
    CalculatorGen CLI Exe. Thin wrapper around Program.cs that
    dispatches into CalculatorGen.Lib. Library form lives in the
    sibling ..\CalculatorGen.Lib\ project; UI.Avalonia + the legacy
    WinExe reference the Lib so a self-contained publish of
    FracturingFog.App no longer trips NETSDK1150.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>FracturingFog.CalculatorGen</RootNamespace>
    <AssemblyName>CalculatorGen</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <!--
      Sibling Lib pulls every other .cs in this directory via a glob
      Include. Disable the default Compile glob so the Exe consumes
      ONLY Program.cs here; everything else compiles in the Lib.
    -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <EnableDefaultNoneItems>false</EnableDefaultNoneItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CalculatorGen.Lib\CalculatorGen.Lib.csproj" />
  </ItemGroup>

</Project>

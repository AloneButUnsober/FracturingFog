<Project Sdk="Microsoft.NET.Sdk">

  <!--
    FracturingFog.Audio — cross-platform audio capture driver + beat analyzer.
    The Win-only NAudio WASAPI backend lives in the sibling FracturingFog.Audio.Win
    project. Phase X.B introduces the IAudioCaptureBackend abstraction; until
    then this csproj is a scaffold.

    Phase X.0 / Slice 0.2: scaffold only. EnableDefaultCompileItems=false so
    the in-folder Audio/*.cs files keep compiling inside FracturingFogCLD.csproj
    (the WinExe) via its default SDK glob. File ownership flips to this csproj
    when the audio-abstraction slices land.
  -->

  <PropertyGroup>
    <!--
      Phase X.0 / Slice 0.2 — temporary net10.0-windows TFM. The current
      AudioEngine + FractalSynth + BeatAnalyzer use NAudio.CoreAudioApi
      (WASAPI loopback) and WaveOutEvent (WinMM speaker output), both of
      which only resolve on Windows. Phase X.B introduces IAudioCaptureBackend
      and splits these files: backend-neutral analyzer driver lands in this
      assembly (then flips to net10.0), Windows WASAPI/WinMM backend lands
      in FracturingFog.Audio.Win.
    -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>false</UseWindowsForms>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>FracturingFog.Audio</RootNamespace>
    <AssemblyName>FracturingFog.Audio</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Abstractions\FracturingFog.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.3.0" />
  </ItemGroup>

</Project>

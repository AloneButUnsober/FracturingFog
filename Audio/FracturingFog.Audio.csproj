<Project Sdk="Microsoft.NET.Sdk">

  <!--
    FracturingFog.Audio — cross-platform audio capture driver + beat analyzer.
    The Win-only NAudio WASAPI backend lives in the sibling FracturingFog.Audio.Win
    project. Phase X.B introduces the IAudioCaptureBackend abstraction; until
    then this csproj is a scaffold.

    Phase X.0 / Slice 0.2: scaffold only. EnableDefaultCompileItems=false so
    the in-folder Audio/*.cs files keep compiling inside FracturingFogCLD.csproj
    (the WinExe) via its default SDK glob. File ownership flips to this csproj
    when the audio-abstraction slices land.
  -->

  <PropertyGroup>
    <!--
      Phase X.B / Slice B.6 — TFM flipped to net10.0. AudioEngine + FractalSynth
      (NAudio WASAPI/WinMM dependents) now live in FracturingFog.Audio.Win.
      What stays here: BeatAnalyzer (MathNet FFT, no NAudio), AudioCaptureDriver
      (IAudioCaptureBackend consumer), NoopAudioBackend (NAudio.AudioFileReader
      is cross-platform for WAV/MP3/AIFF), AudioSettingsStore.
    -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>FracturingFog.Audio</RootNamespace>
    <AssemblyName>FracturingFog.Audio</AssemblyName>
    <!-- #271 — OpenAlAudioBackend uses Device*/short* with the ALC capture API. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Abstractions\FracturingFog.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- #271 — SampleProviderPump is internal; unit tests exercise it directly. -->
    <InternalsVisibleTo Include="FracturingFog.Server.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.3.0" />
    <!--
      Phase X.B / Slice B.5 — MathNet.Numerics FFT replaces NAudio.Dsp.Fft.FFT
      in BeatAnalyzer. Already shipping via PaletteBuilder.Lib's closure, no
      new RID-specific native lands.
    -->
    <PackageReference Include="MathNet.Numerics" Version="5.0.0" />
    <!--
      #271 (parent #58) — cross-platform live audio (mic + Linux loopback) via
      OpenAL. Silk.NET.OpenAL wraps ALC capture with per-RID native name
      resolution; Silk.NET.OpenAL.Soft.Native bundles the OpenAL Soft runtime
      per RID so the common desktop case needs no user install (Tier A). The
      Enumeration extension lists capture devices to find the PulseAudio /
      PipeWire ".monitor" sink for system loopback on Linux.

      LICENSE: OpenAL Soft is LGPL v2.1. It is consumed here as a dynamically
      linked native library (no static link, no source modification), which the
      LGPL permits for a differently-licensed application. Attribution + a copy
      of the LGPL text ship in Docs/Licenses/OpenAL-Soft-LGPL.txt.
    -->
    <PackageReference Include="Silk.NET.OpenAL" Version="2.23.0" />
    <!-- Extensions.EXT owns ALC_EXT_CAPTURE (mic/loopback) + capture-device
         enumeration used to locate the Linux ".monitor" sink for loopback. -->
    <PackageReference Include="Silk.NET.OpenAL.Extensions.EXT" Version="2.23.0" />
    <PackageReference Include="Silk.NET.OpenAL.Soft.Native" Version="1.23.1" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <!--
    FracturingFog.Engine — cross-platform engine assembly. Carved out of the
    Windows WinExe so the calculator fleet, FractalRenderHost, and engine-side
    Imaging surface can build under linux-x64 / osx-arm64.

    Phase X.0 / Slice 0.1: scaffold only. No source files yet. WinExe
    (FracturingFogCLD.csproj) continues to own the engine source via its
    default SDK glob until file-move slices land.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>FracturingFog</RootNamespace>
    <AssemblyName>FracturingFog.Engine</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Abstractions\FracturingFog.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      ILGPU is the GPU-compute JIT used by the UserBulb GPU calculator,
      the Sandbox GPU compiler/spike, MandelbrotGpuKernel and AcceleratorProbe.
      Cross-platform (CPU fallback when no CUDA/OpenCL device); no Windows
      native dependency.
    -->
    <PackageReference Include="ILGPU" Version="1.5.3" />
    <!--
      Roslyn scripting drives UserEquationCalculator and UserBulbCalculator
      hot-load paths. Cross-platform.
    -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="5.3.0" />
    <!--
      System.Drawing.Common is brought in transitionally for the engine's
      ColorScheme files (which use System.Drawing.Color as a struct, not GDI+
      APIs). The Color struct itself lives in System.Drawing.Primitives and
      is cross-platform; the Common package adds GDI+ which is not.
      Phase X.A swaps these references to System.Drawing.Primitives (already
      a BCL transitive ref) and drops the Common package, then swaps the
      surface that actually touches GDI+ (Imaging/ image save) to SkiaSharp.
    -->
    <PackageReference Include="System.Drawing.Common" Version="10.0.8" />
    <!--
      Phase X.0 / Slice 0.1b: Vortice package refs removed. MandelbrotGpuKernel
      now lives in FracturingFog.Rendering.D3D and is consumed across the
      Engine boundary only through IGpuKernel (Engine\Interefaces\IGpuKernel.cs).
      Engine no longer pulls any Windows-specific native dependency.
    -->
  </ItemGroup>

</Project>

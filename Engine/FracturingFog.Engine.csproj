<Project Sdk="Microsoft.NET.Sdk">

  <!--
    FracturingFog.Engine — cross-platform engine assembly. Carved out of the
    Windows WinExe so the calculator fleet, FractalRenderHost, and engine-side
    Imaging surface can build under linux-x64 / osx-arm64.

    Phase X.0 / Slice 0.1: scaffold only. No source files yet. WinExe
    (FracturingFogCLD.csproj) continues to own the engine source via its
    default SDK glob until file-move slices land.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>FracturingFog</RootNamespace>
    <AssemblyName>FracturingFog.Engine</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Abstractions\FracturingFog.Abstractions.csproj" />
  </ItemGroup>

</Project>

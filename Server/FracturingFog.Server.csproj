<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Phase 3 headless server engine. JSON-RPC over mTLS TCP. References
      Abstractions for FractalType / QualityPreset DTOs only. Stays UI-free
      and platform-free so the WinExe can host it under the server CLI flag
      and the cross-platform Avalonia shell can spawn it as a child process.
    -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>FracturingFog.Server</RootNamespace>
    <AssemblyName>FracturingFog.Server</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Abstractions\FracturingFog.Abstractions.csproj" />
  </ItemGroup>

</Project>
